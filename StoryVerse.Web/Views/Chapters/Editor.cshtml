        async function submitCharacter() {
            const nameInput = document.getElementById('qcName');
            if (!nameInput || !nameInput.value.trim()) return;
            const name = nameInput.value.trim();

            // Duplicate protection check against StoryEntityCache
            const existing = StoryEntityCache.characters.find(c => c.name.toLowerCase() === name.toLowerCase() || (c.nicknames && c.nicknames.map(n=>n.toLowerCase()).includes(name.toLowerCase())));
            if (existing) {
                showToast(`"${existing.name}" already exists in this story.`);
                return;
            }

            const dto = {
                storyId,
                chapterId,
                name: name,
                role: document.getElementById('qcRole').value,
                occupation: document.getElementById('qcOccupation').value,
                oneLineDescription: document.getElementById('qcDescription').value
            };

            try {
                const resp = await fetch('/Chapters/QuickCreateCharacter', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto)
                });
                const data = await resp.json();
                if (data.success && data.character) {
                    // 1. Close drawer
                    closeDrawer();

                    // 2. Add to StoryEntityCache
                    StoryEntityCache.characters.push({
                        id: data.character.id,
                        name: data.character.name,
                        role: data.character.role || "Character",
                        nicknames: data.character.nicknames || [],
                        oneLineDescription: data.character.oneLineDescription || "",
                        avatarUrl: data.character.avatarUrl,
                        age: data.character.age,
                        occupation: data.character.occupation,
                        status: data.character.status || "Active",
                        isLinked: true
                    });

                    // 3. Update right panel tabs
                    updateRightPanelTabs();

                    // 4. Restore editor selection & focus
                    restoreEditorSelection();

                    showToast(data.notification || `${data.character.name} added successfully.`);
                    setUnsavedState();
                    scheduleDebouncedAutoSave();
                    analyzeManuscriptEntities();
                } else if (data.isDuplicate) {
                    showToast(data.message || `${name} already exists in story.`);
                }
            } catch (e) {
                console.error("Submit character error:", e);
            }
        }

