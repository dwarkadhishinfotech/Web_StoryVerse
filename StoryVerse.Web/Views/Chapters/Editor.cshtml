                allCharContainer.innerHTML = html;
            }

            // ----------------------------------------------------
            // WORLD TAB RENDER (LOCATIONS & WORLD ENTITIES)
            // ----------------------------------------------------
            const worldListContainer = document.getElementById('worldEntitiesList');
            if (worldListContainer) {
                let html = '';

                // Render AMBIGUOUS CANDIDATES if any
                html += renderAmbiguousCardsHtml(detectedAmbiguousEntities);

                // Render DETECTED LOCATIONS & WORLD ENTITIES
                if (detectedLocs.length > 0 || detectedWorld.length > 0) {
                    html += `
                        <div class="detected-section-header amber">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-dark" style="width: 18px; height: 18px; font-size: 10px; background: #F59E0B;">✨</span>
                            <span>DETECTED IN WRITING</span>
                        </div>
                    `;
                    
                    detectedLocs.forEach(dl => {
                        html += `
                            <div class="detected-card detected-card-amber">
                                <div>
                                    <div class="fw-bold text-amber-950 d-flex align-items-center gap-1.5" style="font-size: 12.5px;">📍 ${escapeHtml(dl.name)}</div>
                                    <div class="detected-ref-badge">Likely Location • <span class="detected-ref-count text-amber-900">${dl.occurrences} ref${dl.occurrences > 1 ? 's' : ''}</span></div>
                                </div>
                                <div class="d-flex align-items-center gap-1 ms-2">
                                    <button class="btn btn-xs btn-amber rounded-pill px-3 py-1 fw-bold text-nowrap" onclick="openDrawer('location', '${escapeJsStr(dl.name)}')" style="font-size: 10.5px;">
                                        + Add Location
                                    </button>
                                    <button class="btn btn-xs btn-light border rounded-circle p-1 text-muted" onclick="ignoreCandidate('${escapeJsStr(dl.name)}')" title="Ignore for this chapter" style="line-height:1;">✕</button>
                                </div>
                            </div>
                        `;
                    });

                    detectedWorld.forEach(dw => {
                        html += `
                            <div class="detected-card detected-card-blue">
                                <div>
                                    <div class="fw-bold text-blue-950 d-flex align-items-center gap-1.5" style="font-size: 12.5px;">🌍 ${escapeHtml(dw.name)}</div>
                                    <div class="detected-ref-badge">Likely World Entity • <span class="detected-ref-count text-blue-900">${dw.occurrences} ref${dw.occurrences > 1 ? 's' : ''}</span></div>
                                </div>
                                <div class="d-flex align-items-center gap-1 ms-2">
                                    <button class="btn btn-xs btn-blue text-white rounded-pill px-3 py-1 fw-bold text-nowrap" onclick="openDrawer('world', '${escapeJsStr(dw.name)}')" style="font-size: 10.5px;">
                                        + Add Entity
                                    </button>
                                    <button class="btn btn-xs btn-light border rounded-circle p-1 text-muted" onclick="ignoreCandidate('${escapeJsStr(dw.name)}')" title="Ignore for this chapter" style="line-height:1;">✕</button>
                                </div>
                            </div>
                        `;
                    });
                }

                // Render ALL LOCATIONS & WORLD ENTITIES IN STORY
                html += `<div class="mt-3 mb-2 fw-bold text-slate-800 text-uppercase tracking-wider" style="font-size: 10.5px; letter-spacing: 0.04em;">ALL WORLD & LOCATIONS IN STORY</div>`;
                const allWorld = [...StoryEntityCache.locations, ...StoryEntityCache.worldEntities];
                if (allWorld.length > 0) {
                    allWorld.forEach(w => {
                        html += `
                            <div class="context-card p-2.5 rounded-3 bg-white border mb-2 ${w.isLinked ? "border-teal" : ""}" data-name="${w.name.toLowerCase()}">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="cursor-pointer" onclick="openEntityProfileDrawer('${w.typeName === 'Location' ? 'location' : 'world'}', '${w.id}')">
                                        <span class="badge bg-amber-subtle text-amber-800 fw-bold me-1.5" style="font-size: 9.5px;">${escapeHtml(w.typeName)}</span>
                                        <span class="fw-bold text-slate-800" style="font-size: 12.5px;">${escapeHtml(w.name)}</span>
                                    </div>
                                    <button class="btn btn-xs ${w.isLinked ? "btn-teal" : "btn-light border"} rounded-pill px-2.5 py-1 fw-bold" onclick="toggleEntityLink('world', '${w.id}')" style="font-size: 10.5px;">
                                        ${w.isLinked ? "Linked ✓" : "+ Link"}
                                    </button>
                                </div>
