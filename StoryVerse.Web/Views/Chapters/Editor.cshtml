                                        ${c.avatarUrl ? `<img src="${c.avatarUrl}" class="rounded-circle w-100 h-100" style="object-fit:cover;" />` : c.name.substring(0, Math.min(2, c.name.length)).toUpperCase()}
                                    </div>
