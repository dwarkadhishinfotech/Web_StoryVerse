                // Render DETECTED TIMELINE EVENTS
                if (detectedTimeline.length > 0) {
                    html += `
                        <div class="detected-section-header purple">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-white" style="width: 18px; height: 18px; font-size: 10px; background: #7C3AED;">✨</span>
                            <span>DETECTED IN WRITING</span>
                        </div>
                    `;
                    detectedTimeline.forEach(dt => {
                        html += `
                            <div class="detected-card detected-card-purple">
                                <div>
                                    <div class="fw-bold text-purple-950 d-flex align-items-center gap-1.5" style="font-size: 12.5px;">⏱ ${escapeHtml(dt.name)}</div>
                                    <div class="detected-ref-badge">Likely Timeline Event • <span class="detected-ref-count text-purple-900">${dt.occurrences} ref${dt.occurrences > 1 ? 's' : ''}</span></div>
                                </div>
                                <div class="d-flex align-items-center gap-1 ms-2">
                                    <button class="btn btn-xs btn-purple text-white rounded-pill px-3 py-1 fw-bold text-nowrap" onclick="openDrawer('timeline', '${escapeJsStr(dt.name)}')" style="font-size: 10.5px;">
                                        + Add Event
                                    </button>
                                    <button class="btn btn-xs btn-light border rounded-circle p-1 text-muted" onclick="ignoreCandidate('${escapeJsStr(dt.name)}')" title="Ignore for this chapter" style="line-height:1;">✕</button>
                                </div>
                            </div>
                        `;
                    });
                }

                // Render ALL TIMELINE EVENTS IN STORY
                html += `<div class="mt-3 mb-2 fw-bold text-slate-800 text-uppercase tracking-wider" style="font-size: 10.5px;">ALL TIMELINE EVENTS IN STORY</div>`;
                if (StoryEntityCache.timelineEvents.length > 0) {
                    StoryEntityCache.timelineEvents.forEach(t => {
                        html += `
                            <div class="context-card p-2 rounded-3 bg-white border mb-2 ${t.isLinked ? "border-teal" : ""}" data-name="${t.title.toLowerCase()}">
