        // 6. STORY INTELLIGENCE FLYOUT PANEL
        function toggleStoryIntelligenceFlyout() {
            const flyout = document.getElementById('storyIntelligenceFlyout');
            if (!flyout) return;
            const isHidden = flyout.style.display === 'none' || !flyout.style.display;
            flyout.style.display = isHidden ? 'block' : 'none';
            if (isHidden) {
                updateStoryIntelligenceFlyout();
            }
        }

        function updateStoryIntelligenceFlyout() {
            const charsLinked = StoryEntityCache.characters.filter(c => c.isLinked).length;
            const locsLinked = StoryEntityCache.locations.filter(l => l.isLinked).length;
            const worldLinked = StoryEntityCache.worldEntities.filter(w => w.isLinked).length;
            const timelineLinked = StoryEntityCache.timelineEvents.filter(t => t.isLinked).length;

            if (document.getElementById('siCountChars')) document.getElementById('siCountChars').textContent = `${charsLinked} linked`;
            if (document.getElementById('siCountLocs')) document.getElementById('siCountLocs').textContent = `${locsLinked} linked`;
            if (document.getElementById('siCountWorld')) document.getElementById('siCountWorld').textContent = `${worldLinked} linked`;
            if (document.getElementById('siCountTimeline')) document.getElementById('siCountTimeline').textContent = `${timelineLinked} linked`;

            const detHeaderTitle = document.getElementById('siDetectedHeaderTitle');
            const detList = document.getElementById('siDetectedList');

            if (detList) {
                const totalDetected = detectedUnknownEntities.length + detectedAmbiguousEntities.length;
                if (totalDetected > 0) {
                    if (detHeaderTitle) {
                        detHeaderTitle.innerHTML = `✨ NEW THINGS DETECTED (${totalDetected} found)`;
                    }
                    let html = '';
                    detectedUnknownEntities.forEach(item => {
                        const icon = item.type === 'character' ? '👤' : (item.type === 'location' ? '📍' : (item.type === 'world' ? '🌍' : (item.type === 'timeline' ? '⏱' : '✨')));
                        const label = item.type === 'character' ? 'Character' : (item.type === 'location' ? 'Location' : (item.type === 'world' ? 'World Entity' : (item.type === 'timeline' ? 'Timeline Event' : 'Entity')));
                        const cardClass = item.type === 'character' ? 'detected-card-teal' : (item.type === 'location' ? 'detected-card-amber' : (item.type === 'world' ? 'detected-card-blue' : (item.type === 'timeline' ? 'detected-card-purple' : 'detected-card-amber')));
                        const btnClass = item.type === 'character' ? 'btn-teal' : (item.type === 'location' ? 'btn-amber' : (item.type === 'world' ? 'btn-blue' : (item.type === 'timeline' ? 'btn-purple' : 'btn-amber')));
                        
                        html += `
                            <div class="detected-card ${cardClass}">
                                <div>
                                    <div class="fw-bold text-slate-900 d-flex align-items-center gap-1.5" style="font-size: 12.5px;">${icon} ${escapeHtml(item.name)}</div>
                                    <div class="detected-ref-badge">Likely ${label} • <span class="detected-ref-count">${item.occurrences} ref${item.occurrences > 1 ? 's' : ''}</span></div>
                                </div>
                                <div class="d-flex align-items-center gap-1 ms-2">
                                    <button class="btn btn-xs ${btnClass} rounded-pill px-3 py-1 fw-bold text-nowrap" onclick="openDrawer('${item.type === 'Unknown' ? 'character' : item.type}', '${escapeJsStr(item.name)}')" style="font-size: 10.5px;">
                                        + Add ${label}
                                    </button>
                                    <button class="btn btn-xs btn-light border rounded-circle p-1 text-muted" onclick="ignoreCandidate('${escapeJsStr(item.name)}')" style="line-height:1;">✕</button>
                                </div>
                            </div>
                        `;
                    });
                    detList.innerHTML = html;
                } else {
                    if (detHeaderTitle) {
                        detHeaderTitle.textContent = 'NEW THINGS DETECTED';
                    }
                    detList.innerHTML = `<div class="text-muted fst-italic py-2" style="font-size: 11.5px;">✓ All mentioned entities match your story database!</div>`;
                }
            }
        }

