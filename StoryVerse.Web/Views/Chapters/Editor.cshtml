        // 9. ZERO-RELOAD ENTITY LINK TOGGLE
        async function toggleEntityLink(type, entityId) {
            if (document.body.classList.contains('read-mode')) return;
            let endpoint = '';
            if (type === 'character') endpoint = '/Chapters/ToggleLinkCharacter';
            else if (type === 'world') endpoint = '/Chapters/ToggleLinkWorldEntity';
            else if (type === 'timeline') endpoint = '/Chapters/ToggleLinkTimelineEvent';

            try {
                const resp = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ chapterId, entityId })
                });
                const data = await resp.json();
                if (data.success) {
                    // Update cache state
                    if (type === 'character') {
                        const item = StoryEntityCache.characters.find(c => c.id === entityId);
                        if (item) item.isLinked = data.isLinked;
                    } else if (type === 'world') {
                        const item = StoryEntityCache.locations.find(l => l.id === entityId) || StoryEntityCache.worldEntities.find(w => w.id === entityId);
                        if (item) item.isLinked = data.isLinked;
                    } else if (type === 'timeline') {
                        const item = StoryEntityCache.timelineEvents.find(t => t.id === entityId);
                        if (item) item.isLinked = data.isLinked;
                    }

                    updateRightPanelTabs();
                    showToast(data.isLinked ? "Linked to chapter!" : "Unlinked from chapter.");
                }
            } catch (e) {
                console.error("Toggle entity link error:", e);
            }
        }

        // 10. EDITOR CORE BEHAVIOR (Autosave & Formatting)
        function updateCounts() {
            const text = editor ? (editor.innerText || editor.textContent || "") : "";
            const words = text.trim().split(/\s+/).filter(w => w.length > 0);
            const wordCount = words.length;
            const charCount = text.length;
            const readTime = Math.max(1, Math.ceil(wordCount / 200));

            if (document.getElementById('barWordCount')) document.getElementById('barWordCount').textContent = wordCount.toLocaleString();
            if (document.getElementById('barCharCount')) document.getElementById('barCharCount').textContent = charCount.toLocaleString();
            if (document.getElementById('barReadTime')) document.getElementById('barReadTime').textContent = `~${readTime} min`;

            return { wordCount, charCount };
        }

        if (editor) {
            ['input', 'beforeinput', 'paste', 'compositionend', 'change'].forEach(evtType => {
                editor.addEventListener(evtType, () => {
                    if (document.body.classList.contains('read-mode')) return;
                    updateCounts();
                    setUnsavedState();
                    scheduleDebouncedAutoSave();
                    scheduleDebouncedEntityScan();
                });
            });
        }

        if (titleInput) {
            titleInput.addEventListener('input', () => {
                if (document.body.classList.contains('read-mode')) return;
                setUnsavedState();
                scheduleDebouncedAutoSave();
            });
        }

        function setUnsavedState() {
            saveStatus = "unsaved";
            if (saveStatusText) {
                saveStatusText.textContent = "● Unsaved changes";
                saveStatusText.style.color = "#D97706";
            }
        }

        function setSavedState() {
            saveStatus = "saved";
            if (saveStatusText) {
                saveStatusText.textContent = "✓ Saved just now";
                saveStatusText.style.color = "#0D9488";
            }
        }

        function scheduleDebouncedAutoSave() {
            clearTimeout(autoSaveTimer);
            autoSaveTimer = setTimeout(() => {
                saveContent(false);
            }, 1500);
        }

        async function saveContent(isManual = false) {
            if (isSaving || document.body.classList.contains('read-mode')) return;
            isSaving = true;

            const counts = updateCounts();
            const payload = {
                chapterId: chapterId,
                storyId: storyId,
                title: titleInput.value,
                content: editor.innerHTML,
                wordCount: counts.wordCount,
                characterCount: counts.charCount,
                version: currentVersion
            };

            try {
                const resp = await fetch('/Chapters/SaveDraft', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-Skip-Loader': 'true'
                    },
                    skipLoader: true,
                    showLoader: false,
                    body: JSON.stringify(payload)
                });
                const data = await resp.json();
                if (data.success) {
                    currentVersion = data.version;
                    setSavedState();
                    if (isManual) showToast("✓ Chapter saved successfully!");
                }
            } catch (err) {
                console.error("Save error:", err);
            } finally {
                isSaving = false;
            }
        }

        // View Mode Switcher
        function switchViewMode(mode) {
            document.querySelectorAll('.mode-btn').forEach(btn => {
                btn.classList.remove('active');
                const icon = btn.querySelector('i');
                if (icon) icon.style.color = '#334155';
            });

            if (mode === 'write') {
                const btn = document.getElementById('btnModeWrite');
                if (btn) {
                    btn.classList.add('active');
                    const icon = btn.querySelector('i');
                    if (icon) icon.style.color = '#0E7490';
                }
                document.body.classList.remove('focus-mode', 'read-mode');
                if (editor) editor.contentEditable = "true";
                if (titleInput) {
                    titleInput.readOnly = false;
                    titleInput.style.pointerEvents = "auto";
                }
                showToast("✏️ Write mode enabled.");
            } else if (mode === 'focus') {
                const btn = document.getElementById('btnModeFocus');
                if (btn) {
                    btn.classList.add('active');
                    const icon = btn.querySelector('i');
                    if (icon) icon.style.color = '#0E7490';
                }
                document.body.classList.remove('read-mode');
                document.body.classList.add('focus-mode');
                if (editor) editor.contentEditable = "true";
                if (titleInput) {
                    titleInput.readOnly = false;
                    titleInput.style.pointerEvents = "auto";
                }
                showToast("👁 Focus mode enabled.");
            } else if (mode === 'read') {
                window.location.href = `/Chapters/Read?storyId=${storyId}&chapterId=${chapterId}`;
                return;
            }
        }

        function execCmd(command, value = null) {
            if (document.body.classList.contains('read-mode')) return;
            if (editor) editor.focus();
            restoreEditorSelection();
            document.execCommand(command, false, value);
            saveEditorSelection();
        }

        function switchTab(tabName) {
            document.querySelectorAll('.context-tab-item').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-pane-content').forEach(pane => pane.classList.add('d-none'));

            const tabBtn = document.getElementById(`tabBtn-${tabName}`);
            if (tabBtn) tabBtn.classList.add('active');
            const tabContent = document.getElementById(`tabContent-${tabName}`);
            if (tabContent) tabContent.classList.remove('d-none');
        }

        function toggleLeftPanelMobile() {
            const leftPanel = document.getElementById('leftPanel');
            const rightPanel = document.getElementById('rightPanel');
            const backdrop = document.getElementById('mobilePanelBackdrop');
            if (rightPanel) rightPanel.classList.remove('show-mobile');
            if (leftPanel) {
                const isOpen = leftPanel.classList.toggle('show-mobile');
                if (backdrop) backdrop.classList.toggle('show', isOpen);
            }
        }

        function toggleRightPanelMobile() {
            const leftPanel = document.getElementById('leftPanel');
            const rightPanel = document.getElementById('rightPanel');
            const backdrop = document.getElementById('mobilePanelBackdrop');
            if (leftPanel) leftPanel.classList.remove('show-mobile');
            if (rightPanel) {
                const isOpen = rightPanel.classList.toggle('show-mobile');
                if (backdrop) backdrop.classList.toggle('show', isOpen);
            }
        }

        function closeMobilePanels() {
            const leftPanel = document.getElementById('leftPanel');
            const rightPanel = document.getElementById('rightPanel');
            const backdrop = document.getElementById('mobilePanelBackdrop');
            if (leftPanel) leftPanel.classList.remove('show-mobile');
            if (rightPanel) rightPanel.classList.remove('show-mobile');
            if (backdrop) backdrop.classList.remove('show');
        }

        function showToast(msg) {
            const toast = document.getElementById('svToast');
            if (!toast) return;
            document.getElementById('svToastMsg').textContent = msg;
            toast.style.display = 'flex';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 3500);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        // Keyboard Shortcut Ctrl+S
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                saveContent(true);
            }
        });

        // Initialize Counts, Right Panel & Entity Scan on Load
        updateCounts();
        updateRightPanelTabs();
        analyzeManuscriptEntities();
    </script>
    <script src="~/js/loader.js" asp-append-version="true"></script>
</body>
</html>
