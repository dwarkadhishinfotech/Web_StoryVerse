                            <div class="fw-bold text-slate-800 mb-1" style="font-size: 12.5px;">No locations or world entities created yet</div>
                            <div class="text-muted small mb-3" style="font-size: 11px; max-width: 220px; margin: 0 auto;">Add world entities or start typing in your manuscript to auto-detect places.</div>
                            <button class="btn btn-xs btn-outline-teal rounded-pill px-3 py-1 fw-bold" onclick="openDrawer('world')" style="font-size: 11px;">
                                + Add Entity
                            </button>
                        </div>
                    `;
                }
                worldListContainer.innerHTML = html;
