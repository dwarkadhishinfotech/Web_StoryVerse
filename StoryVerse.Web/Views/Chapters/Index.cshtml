@foreach (var ch in Model)
{
    <div class="modal fade" id="deleteChapterModal_@ch.Id" tabindex="-1" aria-labelledby="deleteChapterModalLabel_@ch.Id" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden position-relative p-4" style="background: linear-gradient(165deg, #FFFFFF 0%, #FAF6F0 60%, #F5EFE6 100%);">
                <div class="position-absolute top-0 start-0 end-0" style="height: 4px; background: linear-gradient(90deg, #E11D48 0%, #D4AF37 50%, #13A8A6 100%);"></div>
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                
                <div class="text-center pt-2">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; background: rgba(254, 226, 226, 0.65); border: 1px solid rgba(225, 29, 72, 0.2);">
                        <i data-lucide="alert-triangle" style="width: 30px; height: 30px; color: #E11D48;"></i>
                    </div>
                    <h4 class="fw-bold font-serif text-slate-900 mb-2" style="font-family: 'Playfair Display', serif; font-size: 1.45rem;">Delete Chapter?</h4>
                    <p class="text-secondary small mb-4" style="font-size: 0.9rem; line-height: 1.55;">
                        Are you sure you want to delete <strong>"@ch.Title"</strong>? All written text and chapter data will be permanently removed.
                    </p>
                    
                    <div class="d-flex flex-column gap-2">
                        <form asp-action="Delete" method="post" class="w-100">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@ch.Id" />
                            <button type="submit" class="btn text-white w-100 rounded-pill py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #E11D48 0%, #BE123C 100%); border: none; font-size: 0.925rem;">
                                <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i>
                                <span>Delete Chapter</span>
                            </button>
                        </form>
                        <button type="button" class="btn btn-outline-secondary w-100 rounded-pill py-2.5 fw-bold" data-bs-dismiss="modal" style="font-size: 0.9rem; border-color: #E2E8F0;">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

