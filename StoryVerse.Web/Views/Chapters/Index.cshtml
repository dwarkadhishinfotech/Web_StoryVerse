                                            @if (!string.IsNullOrWhiteSpace(ch.Summary))
                                            {
                                                <div class="text-muted small text-truncate" style="max-width: 320px; font-size: 11.5px;">@ch.Summary</div>
                                            }
                                        </td>

                                        <td>
                                            <span class="badge bg-slate-100 text-slate-700 rounded-pill border" style="font-size: 10px; border-color: #cbd5e1 !important;">@partTitle</span>
                                        </td>

                                        <td class="text-end fw-semibold text-slate-700">
                                            @(ch.WordCount > 0 ? $"{ch.WordCount.ToString("N0")}" : "0") <span class="text-muted font-normal small">w</span>
                                        </td>

                                        <td class="text-center">
                                            <span class="cs-status-badge @statusBadgeClass">@statusText</span>
                                        </td>

                                        <td class="text-muted small" style="font-size: 11.5px;">
                                            @ch.UpdatedAt.ToString("MMM dd, yyyy")
                                        </td>

                                        <td class="pe-3 text-end">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <a href="@Url.Action("Editor", "Chapters", new { storyId = story?.Id, chapterId = ch.Id })" class="btn btn-light btn-sm border rounded-circle p-1.5 shadow-sm" title="Edit in Editor">
                                                    <i data-lucide="edit-3" style="width: 14px; height: 14px; color: #0d9488;"></i>
                                                </a>
                                                <button type="button" class="btn btn-light btn-sm border rounded-circle p-1.5 shadow-sm text-danger" title="Delete Chapter" data-bs-toggle="modal" data-bs-target="#deleteChapterModal_@ch.Id">
                                                    <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ========================================================================= -->
                <!-- VIEW 4: OUTLINE VIEW (Story Architecture & Synopsis Tree View) -->
                <!-- ========================================================================= -->
                <div id="csViewOutline" class="cs-view-container p-3 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: #f1f5f9 !important;">
                        <span class="text-muted small fw-semibold" style="font-size: 12px;">Manuscript Architecture & Plot Outline</span>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-light btn-sm border rounded-pill px-3" style="font-size: 11px;" onclick="toggleAllOutline(true)">
                                <i data-lucide="chevrons-down" style="width: 13px; height: 13px;"></i> Expand All
                            </button>
                            <button type="button" class="btn btn-light btn-sm border rounded-pill px-3" style="font-size: 11px;" onclick="toggleAllOutline(false)">
                                <i data-lucide="chevrons-up" style="width: 13px; height: 13px;"></i> Collapse All
                            </button>
                        </div>
                    </div>

                    @foreach (var part in storyParts)
                    {
                        var partChapters = Model.Where(c => c.PartId == part.Id).OrderBy(c => c.Order).ToList();
                        
                        <div class="cs-outline-part mb-4" data-part-id="@part.Id">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2 p-2.5 rounded-3 bg-teal-50 border border-teal-100" style="background: #f0fdfa; border-color: #ccfbf1 !important;">
                                <div class="d-flex align-items-center gap-2">
                                    <i data-lucide="bookmark" style="width: 16px; height: 16px; color: #0d9488;"></i>
                                    <h6 class="fw-bold mb-0 text-teal-900 text-uppercase" style="font-size: 13px; letter-spacing: 0.05em; color: #0f766e;">@part.Title</h6>
                                    <span class="badge bg-white text-teal-700 border" style="font-size: 10px; border-color: #99f6e4 !important;">@partChapters.Count chapters</span>
                                </div>

                                <form asp-action="Create" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storyId" value="@story?.Id" />
                                    <input type="hidden" name="partId" value="@part.Id" />
                                    <button type="submit" class="btn btn-teal btn-sm rounded-pill px-3 py-1 fw-bold" style="font-size: 11px;">
                                        + Add Chapter
                                    </button>
                                </form>
                            </div>

                            <div class="cs-outline-nodes ms-2 border-start ps-3" style="border-color: #cbd5e1 !important;">
                                @foreach (var ch in partChapters)
                                {
                                    string statusBadgeClass = ch.Status == "Completed" ? "cs-badge-completed" : (ch.Status == "InProgress" ? "cs-badge-inprogress" : (ch.Status == "Outlining" ? "cs-badge-outlining" : (ch.Status == "OnHold" ? "cs-badge-onhold" : (ch.Status == "Archived" ? "cs-badge-archived" : "cs-badge-planned"))));
                                    string statusText = ch.Status == "Completed" ? "Completed" : (ch.Status == "InProgress" ? "In Progress" : (ch.Status == "Outlining" ? "Outlining" : (ch.Status == "OnHold" ? "On Hold" : (ch.Status == "Archived" ? "Archived" : "Planned"))));

                                    <div class="cs-chapter-item cs-outline-card mb-3 p-3 rounded-3 border bg-white shadow-sm" 
                                         data-title="@ch.Title.ToLower()" 
                                         data-summary="@((ch.Summary ?? "").ToLower())" 
                                         data-pov="@((ch.PointOfView ?? "").ToLower())" 
                                         data-part-id="@part.Id" 
                                         data-status="@ch.Status"
                                         style="border-color: #e2e8f0 !important;">
                                        
                                        <div class="d-flex align-items-center justify-content-between mb-2 cursor-pointer" data-bs-toggle="collapse" data-bs-target="#outlineDetails_@ch.Id">
                                            <div class="d-flex align-items-center gap-2 min-w-0">
                                                <i data-lucide="chevron-down" class="cs-outline-chevron" style="width: 16px; height: 16px; color: #64748b;"></i>
                                                <span class="badge bg-slate-900 text-white rounded-2 fw-bold" style="font-size: 10px; font-family: monospace;">CH @ch.Order</span>
                                                <h6 class="fw-bold mb-0 text-slate-800 text-truncate" style="font-size: 14px; font-family: 'Playfair Display', Georgia, serif;">@ch.Title</h6>
                                            </div>

                                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                <span class="text-muted small" style="font-size: 11px;">@ch.WordCount.ToString("N0") words</span>
                                                <span class="cs-status-badge @statusBadgeClass">@statusText</span>
                                                <a href="@Url.Action("Editor", "Chapters", new { storyId = story?.Id, chapterId = ch.Id })" class="btn btn-sm btn-teal rounded-3 py-1 px-2.5 fw-semibold ms-2" style="font-size: 11px;" onclick="event.stopPropagation();">
                                                    Edit <i data-lucide="arrow-right" style="width: 12px; height: 12px;"></i>
                                                </a>
                                            </div>
                                        </div>

                                        <div class="collapse show mt-2 pt-2 border-top" id="outlineDetails_@ch.Id" style="border-color: #f1f5f9 !important;">
                                            <!-- Summary Callout Box -->
                                            <div class="p-2.5 rounded-3 mb-2" style="background-color: #f8fafc; border-left: 3px solid #0d9488;">
                                                <div class="d-flex align-items-center gap-1.5 text-teal-700 fw-bold small mb-1" style="font-size: 11px;">
                                                    <i data-lucide="feather" style="width: 13px; height: 13px;"></i> Chapter Synopsis
                                                </div>
                                                <p class="text-secondary mb-0" style="font-size: 12px; line-height: 1.55;">
                                                    @(!string.IsNullOrWhiteSpace(ch.Summary) ? ch.Summary : "No synopsis added for this chapter yet. You can add goals, POV, and summary notes in the Chapter Studio Editor.")
                                                </p>
                                            </div>

                                            <!-- Metadata Elements Grid -->
                                            <div class="row g-2">
                                                @if (!string.IsNullOrWhiteSpace(ch.Goal) || !string.IsNullOrWhiteSpace(ch.Purpose))
                                                {
                                                    <div class="col-12 col-md-6">
                                                        <div class="p-2 rounded-2 border bg-light" style="font-size: 11.5px; border-color: #e2e8f0 !important;">
                                                            <span class="fw-bold text-slate-700 d-block mb-0.5">🎯 Goal / Purpose:</span>
                                                            <span class="text-slate-600">@(ch.Goal ?? ch.Purpose)</span>
                                                        </div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ch.PointOfView) || !string.IsNullOrWhiteSpace(ch.EmotionalTone))
                                                {
                                                    <div class="col-12 col-md-6">
                                                        <div class="p-2 rounded-2 border bg-light d-flex flex-wrap gap-2" style="font-size: 11.5px; border-color: #e2e8f0 !important;">
                                                            @if (!string.IsNullOrWhiteSpace(ch.PointOfView))
                                                            {
                                                                <div><span class="fw-bold text-slate-700">👁 POV:</span> <span class="text-slate-600">@ch.PointOfView</span></div>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(ch.EmotionalTone))
                                                            {
                                                                <div><span class="fw-bold text-slate-700">🎭 Tone:</span> <span class="text-slate-600">@ch.EmotionalTone</span></div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @{
                        var unassignedOutline = Model.Where(c => c.PartId == null).OrderBy(c => c.Order).ToList();
                    }
                    @if (unassignedOutline.Any())
                    {
                        <div class="cs-outline-part mb-4" data-part-id="UNASSIGNED">
                            <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded-3 bg-slate-100 border border-slate-200">
                                <i data-lucide="file-stack" style="width: 16px; height: 16px; color: #475569;"></i>
                                <h6 class="fw-bold mb-0 text-slate-800 text-uppercase" style="font-size: 13px; letter-spacing: 0.05em;">Unassigned Chapters</h6>
                                <span class="badge bg-white text-slate-700 border ms-auto" style="font-size: 10px;">@unassignedOutline.Count chapters</span>
                            </div>

                            <div class="cs-outline-nodes ms-2 border-start ps-3" style="border-color: #cbd5e1 !important;">
                                @foreach (var ch in unassignedOutline)
                                {
                                    string statusBadgeClass = ch.Status == "Completed" ? "cs-badge-completed" : (ch.Status == "InProgress" ? "cs-badge-inprogress" : (ch.Status == "Outlining" ? "cs-badge-outlining" : (ch.Status == "OnHold" ? "cs-badge-onhold" : (ch.Status == "Archived" ? "cs-badge-archived" : "cs-badge-planned"))));
                                    string statusText = ch.Status == "Completed" ? "Completed" : (ch.Status == "InProgress" ? "In Progress" : (ch.Status == "Outlining" ? "Outlining" : (ch.Status == "OnHold" ? "On Hold" : (ch.Status == "Archived" ? "Archived" : "Planned"))));

                                    <div class="cs-chapter-item cs-outline-card mb-3 p-3 rounded-3 border bg-white shadow-sm" 
                                         data-title="@ch.Title.ToLower()" 
                                         data-summary="@((ch.Summary ?? "").ToLower())" 
                                         data-pov="@((ch.PointOfView ?? "").ToLower())" 
                                         data-part-id="UNASSIGNED" 
                                         data-status="@ch.Status"
                                         style="border-color: #e2e8f0 !important;">
                                        
                                        <div class="d-flex align-items-center justify-content-between mb-2 cursor-pointer" data-bs-toggle="collapse" data-bs-target="#outlineDetails_@ch.Id">
                                            <div class="d-flex align-items-center gap-2 min-w-0">
                                                <i data-lucide="chevron-down" class="cs-outline-chevron" style="width: 16px; height: 16px; color: #64748b;"></i>
                                                <span class="badge bg-slate-900 text-white rounded-2 fw-bold" style="font-size: 10px; font-family: monospace;">CH @ch.Order</span>
                                                <h6 class="fw-bold mb-0 text-slate-800 text-truncate" style="font-size: 14px; font-family: 'Playfair Display', Georgia, serif;">@ch.Title</h6>
                                            </div>

                                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                <span class="text-muted small" style="font-size: 11px;">@ch.WordCount.ToString("N0") words</span>
                                                <span class="cs-status-badge @statusBadgeClass">@statusText</span>
                                                <a href="@Url.Action("Editor", "Chapters", new { storyId = story?.Id, chapterId = ch.Id })" class="btn btn-sm btn-teal rounded-3 py-1 px-2.5 fw-semibold ms-2" style="font-size: 11px;" onclick="event.stopPropagation();">
                                                    Edit <i data-lucide="arrow-right" style="width: 12px; height: 12px;"></i>
                                                </a>
                                            </div>
                                        </div>

                                        <div class="collapse show mt-2 pt-2 border-top" id="outlineDetails_@ch.Id" style="border-color: #f1f5f9 !important;">
                                            <div class="p-2.5 rounded-3 mb-2" style="background-color: #f8fafc; border-left: 3px solid #0d9488;">
                                                <div class="d-flex align-items-center gap-1.5 text-teal-700 fw-bold small mb-1" style="font-size: 11px;">
                                                    <i data-lucide="feather" style="width: 13px; height: 13px;"></i> Chapter Synopsis
                                                </div>
                                                <p class="text-secondary mb-0" style="font-size: 12px; line-height: 1.55;">
                                                    @(!string.IsNullOrWhiteSpace(ch.Summary) ? ch.Summary : "No synopsis added for this chapter yet. You can add goals, POV, and summary notes in the Chapter Studio Editor.")
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- GLOBAL EMPTY SEARCH / FILTER STATE -->
                <div id="csEmptySearchState" class="p-5 text-center d-none">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; background: rgba(13, 148, 136, 0.1); color: #0d9488;">
                        <i data-lucide="search-x" style="width: 28px; height: 28px;"></i>
                    </div>
                    <h5 class="fw-bold text-slate-800 mb-1" style="font-family: 'Playfair Display', Georgia, serif;">No Matching Chapters</h5>
                    <p class="text-muted small mb-3" style="max-width: 360px; margin: 0 auto;">No chapters match your current search query or filter selections.</p>
                    <button type="button" class="btn btn-outline-teal rounded-pill px-4 py-1.5 fw-semibold" style="font-size: 12.5px;" onclick="resetFilters()">
                        Clear Filters
                    </button>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDEBAR COLUMN: Widgets Stack -->
        <div class="col-12 col-xl-4 d-flex flex-column gap-4">
            <!-- Widget 1: Chapter Status Donut Chart & Legend -->
            <div class="cs-card p-3">
                <h6 class="cs-widget-title mb-3">Chapter Status</h6>
                
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <!-- SVG Donut Chart -->
                    <div class="cs-donut-wrapper flex-shrink-0">
                        <svg width="120" height="120" viewBox="0 0 42 42" class="cs-donut-svg">
                            <circle class="donut-hole" cx="21" cy="21" r="15.91549430918954" fill="#fff"></circle>
                            <circle class="donut-ring" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#E2E8F0" stroke-width="5"></circle>

                            <!-- Segment Completed (Green) -->
                            <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#10B981" stroke-width="5" stroke-dasharray="@completedPercent @(100 - completedPercent)" stroke-dashoffset="25"></circle>
                            <!-- Segment In Progress (Blue) -->
                            <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#2563EB" stroke-width="5" stroke-dasharray="@inProgressPercent @(100 - inProgressPercent)" stroke-dashoffset="@(25 - completedPercent)"></circle>
                            <!-- Segment Planned (Orange) -->
                            <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#F97316" stroke-width="5" stroke-dasharray="@plannedPercent @(100 - plannedPercent)" stroke-dashoffset="@(25 - completedPercent - inProgressPercent)"></circle>
                        </svg>
                    </div>

                    <!-- Legend List -->
                    <div class="flex-grow-1 cs-legend-list" style="font-size: 12.5px;">
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="cs-dot" style="background-color: #10B981;"></span>
                                <span class="text-slate-700 fw-medium">Completed</span>
                            </div>
                            <span class="fw-bold text-slate-900">@completedCount (@completedPercent%)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="cs-dot" style="background-color: #2563EB;"></span>
                                <span class="text-slate-700 fw-medium">In Progress</span>
                            </div>
                            <span class="fw-bold text-slate-900">@inProgressCount (@inProgressPercent%)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="cs-dot" style="background-color: #9333EA;"></span>
                                <span class="text-slate-700 fw-medium">Outlining</span>
                            </div>
                            <span class="fw-bold text-slate-900">@outliningCount (@outliningPercent%)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="cs-dot" style="background-color: #F97316;"></span>
                                <span class="text-slate-700 fw-medium">Planned</span>
                            </div>
                            <span class="fw-bold text-slate-900">@plannedCount (@plannedPercent%)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="cs-dot" style="background-color: #94A3B8;"></span>
                                <span class="text-slate-700 fw-medium">On Hold</span>
                            </div>
                            <span class="fw-bold text-slate-900">@onHoldCount (@onHoldPercent%)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="cs-dot" style="background-color: #475569;"></span>
                                <span class="text-slate-700 fw-medium">Archived</span>
                            </div>
                            <span class="fw-bold text-slate-900">@archivedCount (@archivedPercent%)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 2: Recent Chapters -->
            <div class="cs-card p-3">
                <h6 class="cs-widget-title mb-3">Recent Chapters</h6>
                <div class="d-flex flex-column gap-2 mb-3">
                    @if (recentChapters.Any())
                    {
                        foreach (var ch in recentChapters)
                        {
                            var timeAgo = (DateTime.UtcNow - ch.UpdatedAt).Days == 0 ? "Updated today" : $"{ (DateTime.UtcNow - ch.UpdatedAt).Days }d ago";
                            string badgeClass = ch.Status == "Completed" ? "cs-badge-completed" : (ch.Status == "InProgress" ? "cs-badge-inprogress" : "cs-badge-planned");

                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 hover-bg-light">
                                <div class="d-flex align-items-center gap-2 min-w-0">
                                    <i data-lucide="check-circle-2" style="width: 16px; height: 16px; color: #0d9488;"></i>
                                    <div class="min-w-0">
                                        <a href="@Url.Action("Editor", "Chapters", new { storyId = story?.Id, chapterId = ch.Id })" class="fw-bold text-slate-800 text-decoration-none text-truncate d-block" style="font-size: 13px;">
                                            @ch.Title
                                        </a>
                                        <div class="text-muted" style="font-size: 11px;">Chapter @ch.Order • @timeAgo</div>
                                    </div>
                                </div>
                                <span class="cs-status-badge @badgeClass" style="font-size: 9.5px;">@ch.Status</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small py-2 text-center">No recent chapters</div>
                    }
                </div>
                <div class="text-center pt-2 border-top" style="border-color: #e2e8f0 !important;">
                    <a href="@Url.Action("Index", "Chapters", new { storyId = story?.Id })" class="fw-bold text-decoration-none small" style="color: #0d9488;">
                        View All Chapters →
                    </a>
                </div>
            </div>

            <!-- Widget 3: Quick Actions -->
            <div class="cs-card p-3">
                <h6 class="cs-widget-title mb-3">Quick Actions</h6>
                <div class="d-flex flex-column gap-1.5">
                    <form asp-action="Create" method="post" class="w-100">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="storyId" value="@story?.Id" />
                        <button type="submit" class="cs-quick-action-link w-100 border-0 bg-transparent text-start">
                            <span class="d-flex align-items-center gap-2"><i data-lucide="plus" style="width: 15px; height: 15px;"></i> New Chapter</span>
                            <i data-lucide="chevron-right" style="width: 14px; height: 14px;"></i>
                        </button>
                    </form>
                    <a href="javascript:void(0)" onclick="openNewPartModal()" class="cs-quick-action-link">
                        <span class="d-flex align-items-center gap-2"><i data-lucide="folder-plus" style="width: 15px; height: 15px;"></i> New Part</span>
                        <i data-lucide="chevron-right" style="width: 14px; height: 14px;"></i>
                    </a>
                    @if (currentlyWriting != null && story != null)
                    {
                        <a href="@Url.Action("Editor", "Chapters", new { storyId = story.Id, chapterId = currentlyWriting.Id })" class="cs-quick-action-link">
                            <span class="d-flex align-items-center gap-2"><i data-lucide="pen-tool" style="width: 15px; height: 15px;"></i> Continue Writing</span>
                            <i data-lucide="chevron-right" style="width: 14px; height: 14px;"></i>
                        </a>
                    }
                    <a href="javascript:void(0)" onclick="openImportModal()" class="cs-quick-action-link">
                        <span class="d-flex align-items-center gap-2"><i data-lucide="upload" style="width: 15px; height: 15px;"></i> Chapter Import</span>
                        <i data-lucide="chevron-right" style="width: 14px; height: 14px;"></i>
                    </a>
                </div>
            </div>

            <!-- Widget 4: Quick Filters Sidebar -->
            <div class="cs-card p-3">
                <h6 class="cs-widget-title mb-3">Quick Filters</h6>
                <div class="d-flex flex-column gap-2 mb-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm text-start rounded-3 d-flex align-items-center justify-content-between" style="font-size: 12px;" onclick="filterByStatus('Completed')">
                        <span><i data-lucide="check-circle" class="me-1.5 text-success" style="width: 14px; height: 14px;"></i> Completed Only</span>
                        <span class="badge bg-slate-200 text-slate-700">@completedCount</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm text-start rounded-3 d-flex align-items-center justify-content-between" style="font-size: 12px;" onclick="filterByStatus('InProgress')">
                        <span><i data-lucide="pen-tool" class="me-1.5 text-primary" style="width: 14px; height: 14px;"></i> In Progress Only</span>
                        <span class="badge bg-slate-200 text-slate-700">@inProgressCount</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm text-start rounded-3 d-flex align-items-center justify-content-between" style="font-size: 12px;" onclick="filterByStatus('Planned')">
                        <span><i data-lucide="clock" class="me-1.5 text-warning" style="width: 14px; height: 14px;"></i> Planned Only</span>
                        <span class="badge bg-slate-200 text-slate-700">@plannedCount</span>
                    </button>
                </div>
