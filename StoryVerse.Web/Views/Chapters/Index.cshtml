@model IEnumerable<StoryVerse.Core.Entities.Chapter>
@{
    var story = ViewBag.Story as StoryVerse.Core.Entities.Story;
    var userStories = ViewBag.Stories as List<StoryVerse.Core.Entities.Story> ?? new List<StoryVerse.Core.Entities.Story>();
    var storyParts = ViewBag.StoryParts as List<StoryVerse.Core.Entities.StoryPart> ?? new List<StoryVerse.Core.Entities.StoryPart>();
    var recentChapters = ViewBag.RecentChapters as List<StoryVerse.Core.Entities.Chapter> ?? new List<StoryVerse.Core.Entities.Chapter>();
    var currentlyWriting = ViewBag.CurrentlyWritingChapter as StoryVerse.Core.Entities.Chapter;

    ViewData["Title"] = $"Chapter Studio - {story?.Title ?? "StoryVerse"}";

    int totalChapters = ViewBag.TotalChapters ?? 0;
    int completedCount = ViewBag.CompletedCount ?? 0;
    int inProgressCount = ViewBag.InProgressCount ?? 0;
    int outliningCount = ViewBag.OutliningCount ?? 0;
    int plannedCount = ViewBag.PlannedCount ?? 0;
    int onHoldCount = ViewBag.OnHoldCount ?? 0;
    int archivedCount = ViewBag.ArchivedCount ?? 0;

    int totalWords = ViewBag.TotalWords ?? 0;
    int targetWords = ViewBag.TargetWords ?? 0;
    int progressPercent = ViewBag.ProgressPercent ?? 0;
    int avgWordsPerChapter = ViewBag.AvgWordsPerChapter ?? 0;
    int totalParts = ViewBag.TotalParts ?? 0;
    int writingStreak = ViewBag.WritingStreak ?? 0;

    int completedPercent = totalChapters > 0 ? (int)Math.Round((double)completedCount / totalChapters * 100) : 0;
    int inProgressPercent = totalChapters > 0 ? (int)Math.Round((double)inProgressCount / totalChapters * 100) : 0;
    int plannedPercent = totalChapters > 0 ? (int)Math.Round((double)plannedCount / totalChapters * 100) : 0;
    int outliningPercent = totalChapters > 0 ? (int)Math.Round((double)outliningCount / totalChapters * 100) : 0;
    int onHoldPercent = totalChapters > 0 ? (int)Math.Round((double)onHoldCount / totalChapters * 100) : 0;
    int archivedPercent = totalChapters > 0 ? (int)Math.Round((double)archivedCount / totalChapters * 100) : 0;

    string genresString = "";
    if (story != null)
    {
        if (story.StoryGenres != null && story.StoryGenres.Any())
        {
            genresString = string.Join(" • ", story.StoryGenres.Select(g => g.Genre?.Name).Where(n => !string.IsNullOrEmpty(n)));
        }
#pragma warning disable CS0618
        else if (!string.IsNullOrEmpty(story.Genre))
        {
            genresString = story.Genre;
        }
#pragma warning restore CS0618
    }

    int chapterTargetWords = totalChapters > 0 && targetWords > 0 ? (targetWords / totalChapters) : 3000;
}

<div class="chapter-studio-page">
    <!-- Top Header Navigation & Action Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 text-muted small fw-medium mb-1" style="font-size: 12px;">
                <a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-secondary">Dashboard</a>
                <i data-lucide="chevron-right" style="width: 12px; height: 12px;"></i>
                <span>Chapter Studio</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="fw-bold mb-0 text-slate-900" style="font-size: 1.85rem; font-family: 'Playfair Display', Georgia, serif;">Chapter Studio</h1>
                <div class="d-flex align-items-center justify-content-center rounded-circle p-1.5 ms-1" style="background-color: rgba(13, 148, 136, 0.1); color: #0d9488;">
                    <i data-lucide="book-open" style="width: 22px; height: 22px;"></i>
                </div>
            </div>
            <p class="text-secondary mb-0" style="font-size: 0.925rem;">Shape your story, one chapter at a time.</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap cs-header-actions">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-white bg-white border rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm text-slate-700 hover-lift-subtle" style="font-size: 0.875rem; border-color: #e2e8f0;" onclick="openImportModal()">
                    <i data-lucide="upload" style="width: 16px; height: 16px; color: #64748b;"></i>
                    <span>Import Chapters</span>
                </button>

                <div class="dropdown d-inline-block">
                    <button class="btn btn-teal rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm dropdown-toggle no-arrow" type="button" data-bs-toggle="dropdown" style="font-size: 0.875rem;">
                        <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
                        <span>New Chapter</span>
                        <i data-lucide="chevron-down" style="width: 14px; height: 14px; margin-left: 2px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end rounded-3 shadow-lg border-0">
                        <li>
                            <form asp-action="Create" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="storyId" value="@story?.Id" />
                                <button type="submit" class="dropdown-item fw-semibold py-2">
                                    <i data-lucide="file-plus" class="me-2 text-teal-600" style="width: 15px; height: 15px;"></i> Quick New Chapter
                                </button>
                            </form>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item fw-semibold py-2" href="javascript:void(0)" onclick="openNewPartModal()">
                                <i data-lucide="folder-plus" class="me-2 text-blue-600" style="width: 15px; height: 15px;"></i> New Part
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 ms-sm-1 mt-sm-0 mt-2">
                <button class="action-btn shadow-sm position-relative" disabled title="Notifications (Coming Soon)" style="opacity: 0.65; cursor: not-allowed; width: 38px; height: 38px; border-radius: 50%; background: white; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; justify-content: center;">
                    <i data-lucide="bell" style="width: 18px; height: 18px; color: #64748b;"></i>
                    <span class="badge-soon-light position-absolute" style="top: -5px; right: -5px; font-size: 7.5px; padding: 1px 4px; background: #64748b; color: white; border-radius: 4px; z-index: 10;">SOON</span>
                </button>

                <button class="action-btn shadow-sm position-relative" disabled title="Toggle Theme (Coming Soon)" style="opacity: 0.65; cursor: not-allowed; width: 38px; height: 38px; border-radius: 50%; background: white; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; justify-content: center;">
                    <i data-lucide="moon" style="width: 18px; height: 18px; color: #64748b;"></i>
                    <span class="badge-soon-light position-absolute" style="top: -5px; right: -5px; font-size: 7.5px; padding: 1px 4px; background: #64748b; color: white; border-radius: 4px; z-index: 10;">SOON</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ROW 1 — HERO METRICS BANNER (3 Cards) -->
    <div class="row g-3 mb-4 align-items-stretch">
        <!-- Card 1: Current Story -->
        <div class="col-12 col-lg-4 d-flex">
            <div class="cs-hero-card flex-grow-1 d-flex align-items-center gap-3">
                <div class="cs-cover-box flex-shrink-0">
                    @if (!string.IsNullOrEmpty(story?.CoverImageUrl))
                    {
                        <img src="@story.CoverImageUrl" alt="@story.Title" class="cs-cover-img" />
                    }
                    else
                    {
                        <div class="cs-cover-placeholder">
                            <span>@(story?.Title != null && story.Title.Length >= 2 ? story.Title.Substring(0,2).ToUpper() : "ST")</span>
                        </div>
                    }
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="cs-hero-label">CURRENT STORY</span>
                    <h5 class="cs-hero-story-title text-truncate mb-1 d-flex align-items-center gap-1.5">
                        <span>@(story?.Title ?? "No Story Selected")</span>
                        @if (story != null && story.IsBookmarked)
                        {
                            <i data-lucide="crown" style="width: 16px; height: 16px; color: #d97706;" class="flex-shrink-0"></i>
                        }
                    </h5>
                    @if (!string.IsNullOrEmpty(genresString))
                    {
                        <div class="cs-hero-genre mb-1 text-truncate">@genresString</div>
                    }
                    <div class="cs-hero-meta">@totalChapters Chapters • @totalParts Parts</div>
                </div>
            </div>
        </div>

        <!-- Card 2: Manuscript Progress -->
        <div class="col-12 col-lg-4 d-flex">
            <div class="cs-hero-card flex-grow-1 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="cs-hero-label">MANUSCRIPT PROGRESS</span>
                    <span class="cs-hero-percent">@progressPercent%</span>
                </div>
                
                <div class="progress cs-progress-bar mb-3">
                    <div class="progress-bar cs-progress-fill" role="progressbar" style="width: @progressPercent%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="cs-hero-words">
                        @totalWords.ToString("N0") / @(targetWords > 0 ? targetWords.ToString("N0") : "--") words
                    </span>
                    @if (story != null)
                    {
                        <a href="@Url.Action("Details", "Stories", new { id = story.Id })" class="cs-hero-link">View Details</a>
                    }
                </div>
            </div>
        </div>

        <!-- Card 3: Currently Writing -->
        <div class="col-12 col-lg-4 d-flex">
            <div class="cs-hero-card flex-grow-1 d-flex flex-column justify-content-between">
                <span class="cs-hero-label mb-2">CURRENTLY WRITING</span>
                
                @if (currentlyWriting != null && story != null)
                {
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap flex-sm-nowrap">
                        <div class="d-flex align-items-center gap-2.5 min-w-0">
                            <div class="cs-writing-icon-box flex-shrink-0">
                                <i data-lucide="pen-tool" style="width: 18px; height: 18px; color: #0d9488;"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="cs-writing-chapter-no text-truncate">Chapter @currentlyWriting.Order</div>
                                <div class="cs-writing-chapter-title text-truncate">@currentlyWriting.Title</div>
                                <div class="cs-writing-words">@currentlyWriting.WordCount.ToString("N0") / @chapterTargetWords.ToString("N0") words</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-1.5 flex-shrink-0 mt-sm-0 mt-2">
                            <a href="@Url.Action("Editor", "Chapters", new { storyId = story.Id, chapterId = currentlyWriting.Id })" class="btn btn-teal btn-sm rounded-3 px-3 py-1.5 fw-bold" style="font-size: 12px;">
                                Continue Writing
                            </a>
                            <a href="@Url.Action("Editor", "Chapters", new { storyId = story.Id, chapterId = currentlyWriting.Id })" class="btn btn-light btn-sm border rounded-circle p-1.5" title="Edit Chapter">
                                <i data-lucide="edit-3" style="width: 14px; height: 14px; color: #64748b;"></i>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2.5 min-w-0">
                            <div class="cs-writing-icon-box flex-shrink-0" style="background-color: #f1f5f9; color: #64748b;">
                                <i data-lucide="book-open" style="width: 18px; height: 18px;"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="cs-writing-chapter-no text-truncate">No Active Chapter</div>
                                <div class="cs-writing-words text-muted">Create or select a chapter</div>
                            </div>
                        </div>

                        @if (story != null)
                        {
                            <form asp-action="Create" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="storyId" value="@story.Id" />
                                <button type="submit" class="btn btn-teal btn-sm rounded-3 px-3 py-1.5 fw-bold" style="font-size: 12px;">
                                    + Start Writing
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ROW 2 — 8 METRIC STAT CARDS GRID (4 Column Grid on Desktop) -->
    <div class="row row-cols-2 row-cols-md-4 row-cols-xl-4 g-3 mb-4">
        <!-- 1. TOTAL CHAPTERS -->
        <div class="col">
            <div class="cs-stat-card">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="cs-stat-icon-box" style="background-color: rgba(8, 145, 178, 0.1); color: #0891b2;">
                        <i data-lucide="book-open" style="width: 16px; height: 16px;"></i>
                    </div>
                    <span class="cs-stat-title">TOTAL CHAPTERS</span>
                </div>
                <div class="cs-stat-value">@totalChapters</div>
                <div class="cs-stat-sub">Across @totalParts parts</div>
            </div>
        </div>

        <!-- 2. COMPLETED -->
        <div class="col">
            <div class="cs-stat-card">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="cs-stat-icon-box" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i data-lucide="check-circle-2" style="width: 16px; height: 16px;"></i>
                    </div>
                    <span class="cs-stat-title">COMPLETED</span>
                </div>
                <div class="cs-stat-value">@completedCount</div>
                <div class="cs-stat-sub">@completedPercent% completed</div>
            </div>
        </div>

        <!-- 3. IN PROGRESS -->
        <div class="col">
            <div class="cs-stat-card">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="cs-stat-icon-box" style="background-color: rgba(37, 99, 235, 0.1); color: #2563eb;">
                        <i data-lucide="pen-tool" style="width: 16px; height: 16px;"></i>
                    </div>
                    <span class="cs-stat-title">IN PROGRESS</span>
                </div>
                <div class="cs-stat-value">@inProgressCount</div>
                <div class="cs-stat-sub">@inProgressPercent% of total</div>
            </div>
        </div>

        <!-- 4. PLANNED -->
        <div class="col">
            <div class="cs-stat-card">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="cs-stat-icon-box" style="background-color: rgba(249, 115, 22, 0.1); color: #f97316;">
                        <i data-lucide="list-checks" style="width: 16px; height: 16px;"></i>
                    </div>
                    <span class="cs-stat-title">PLANNED</span>
                </div>
                <div class="cs-stat-value">@plannedCount</div>
                <div class="cs-stat-sub">@plannedPercent% remaining</div>
            </div>
        </div>

        <!-- 5. TOTAL WORDS -->
        <div class="col">
            <div class="cs-stat-card">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="cs-stat-icon-box" style="background-color: rgba(147, 51, 234, 0.1); color: #9333ea;">
                        <span class="fw-bold" style="font-size: 12px;">Aa</span>
                    </div>
                    <span class="cs-stat-title">TOTAL WORDS</span>
                </div>
                <div class="cs-stat-value">@totalWords.ToString("N0")</div>
                <div class="cs-stat-sub">Total manuscript</div>
            </div>
        </div>

        <!-- 6. TARGET WORDS -->
        <div class="col">
            <div class="cs-stat-card">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="cs-stat-icon-box" style="background-color: rgba(225, 29, 72, 0.1); color: #e11d48;">
                        <i data-lucide="target" style="width: 16px; height: 16px;"></i>
                    </div>
                    <span class="cs-stat-title">TARGET WORDS</span>
                </div>
                <div class="cs-stat-value">@(targetWords > 0 ? targetWords.ToString("N0") : "Not Set")</div>
                <div class="cs-stat-sub">@(targetWords > 0 ? "Manuscript target" : "Set story target")</div>
            </div>
        </div>

        <!-- 7. AVERAGE CHAPTER -->
        <div class="col">
            <div class="cs-stat-card">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="cs-stat-icon-box" style="background-color: rgba(37, 99, 235, 0.1); color: #2563eb;">
                        <i data-lucide="trending-up" style="width: 16px; height: 16px;"></i>
                    </div>
                    <span class="cs-stat-title">AVERAGE CHAPTER</span>
                </div>
                <div class="cs-stat-value">@avgWordsPerChapter.ToString("N0")</div>
                <div class="cs-stat-sub">Words per chapter</div>
            </div>
        </div>

        <!-- 8. WRITING STREAK -->
        <div class="col">
            <div class="cs-stat-card">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="cs-stat-icon-box" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                        <i data-lucide="flame" style="width: 16px; height: 16px;"></i>
                    </div>
                    <span class="cs-stat-title">WRITING STREAK</span>
                </div>
                <div class="cs-stat-value">@writingStreak days</div>
                <div class="cs-stat-sub">@(writingStreak > 0 ? "Keep it up!" : "Start writing today")</div>
            </div>
        </div>
    </div>

    <!-- ROW 3 — MAIN CONTENT LAYOUT (Left Manuscript Explorer + Right Sidebar Widgets) -->
    <div class="row g-4">
        <!-- LEFT WIDE COLUMN: Manuscript Explorer -->
        <div class="col-12 col-xl-8">
            <div class="cs-card overflow-hidden shadow-sm border-0" style="border-radius: 16px; background: #ffffff;">
                <!-- Header with Title, View Tabs & Search Filter -->
                <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom p-3 gap-2" style="border-color: #e2e8f0 !important; background: #ffffff;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded-2 p-1.5" style="background: rgba(13, 148, 136, 0.1); color: #0d9488;">
                            <i data-lucide="layers" style="width: 18px; height: 18px;"></i>
                        </div>
                        <div>
                            <h5 class="cs-card-title mb-0" style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.15rem;">Manuscript Explorer</h5>
                            <span class="text-muted small" style="font-size: 11px;">@totalChapters chapters across @(totalParts > 0 ? totalParts.ToString() : "1") part(s)</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- VIEW SWITCHER PILLS -->
                        <div class="cs-view-pills" id="manuscriptViewPills">
                            <button type="button" class="cs-pill-btn active" data-view="manuscript" onclick="switchView('manuscript')">
                                <i data-lucide="list-tree" style="width: 14px; height: 14px; margin-right: 4px;"></i> Manuscript View
                            </button>
                            <button type="button" class="cs-pill-btn" data-view="grid" onclick="switchView('grid')">
                                <i data-lucide="layout-grid" style="width: 14px; height: 14px; margin-right: 4px;"></i> Grid View
                            </button>
                            <button type="button" class="cs-pill-btn" data-view="list" onclick="switchView('list')">
                                <i data-lucide="table" style="width: 14px; height: 14px; margin-right: 4px;"></i> List View
                            </button>
                            <button type="button" class="cs-pill-btn" data-view="outline" onclick="switchView('outline')">
                                <i data-lucide="file-text" style="width: 14px; height: 14px; margin-right: 4px;"></i> Outline View
                            </button>
                        </div>
                        
                        <button type="button" class="btn btn-light btn-sm border rounded-3 p-1.5 shadow-sm" title="Toggle Search & Filters" onclick="toggleFilterBar()" style="border-color: #e2e8f0 !important;">
                            <i data-lucide="sliders-horizontal" style="width: 15px; height: 15px; color: #64748b;"></i>
                        </button>
                    </div>
                </div>

                <!-- LIVE FILTER BAR -->
                <div id="csFilterBar" class="p-3 bg-light border-bottom" style="border-color: #e2e8f0 !important;">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-5">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted"><i data-lucide="search" style="width: 14px; height: 14px;"></i></span>
                                <input type="text" id="csSearchInput" class="form-control border-start-0 rounded-end-3" placeholder="Search chapters by title, summary, or POV..." style="font-size: 12px; border-color: #cbd5e1;" oninput="applyFilters()" />
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <select id="csFilterPartSelect" class="form-select form-select-sm rounded-3" style="font-size: 12px; border-color: #cbd5e1;" onchange="applyFilters()">
                                <option value="ALL" selected>All Parts</option>
                                @foreach (var p in storyParts)
                                {
                                    <option value="@p.Id">@p.Title</option>
                                }
                                <option value="UNASSIGNED">Unassigned Chapters</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <select id="csFilterStatusSelect" class="form-select form-select-sm rounded-3" style="font-size: 12px; border-color: #cbd5e1;" onchange="applyFilters()">
                                <option value="ALL" selected>All Statuses</option>
                                <option value="Completed">Completed</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Outlining">Outlining</option>
                                <option value="Planned">Planned</option>
                                <option value="OnHold">On Hold</option>
                                <option value="Archived">Archived</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1 text-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 rounded-3 p-1 text-muted" title="Reset Filters" onclick="resetFilters()" style="font-size: 11px;">
                                Reset
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ========================================================================= -->
                <!-- VIEW 1: MANUSCRIPT VIEW (Tree / Collapsible Hierarchy View) -->
                <!-- ========================================================================= -->
                <div id="csViewManuscript" class="cs-view-container p-3">
                    @if (storyParts.Any())
                    {
                        @foreach (var part in storyParts)
                        {
                            var partChapters = Model.Where(c => c.PartId == part.Id).OrderBy(c => c.Order).ToList();
                            var partWordCount = partChapters.Sum(c => c.WordCount);

                            <div class="cs-part-block mb-4" data-part-id="@part.Id">
                                <!-- Part Header Bar -->
                                <div class="cs-part-header d-flex align-items-center justify-content-between p-3 rounded-3 shadow-xs" 
                                     data-bs-toggle="collapse" 
                                     data-bs-target="#partBlock_@part.Id" 
                                     style="cursor: pointer; background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 1px solid #e2e8f0;">
                                    
                                    <div class="d-flex align-items-center gap-2.5 cs-part-title-group min-w-0">
                                        <i data-lucide="chevron-down" class="cs-part-chevron text-slate-500 flex-shrink-0" style="width: 18px; height: 18px;"></i>
                                        <div class="d-flex align-items-center justify-content-center rounded-2 p-1.5 bg-teal-50 text-teal-700 flex-shrink-0" style="background: rgba(13, 148, 136, 0.12); color: #0d9488;">
                                            <i data-lucide="folder" style="width: 16px; height: 16px;"></i>
                                        </div>
                                        <div class="min-w-0 flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
