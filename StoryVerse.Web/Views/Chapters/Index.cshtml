<!-- ========================================================================= -->
<!-- JAVASCRIPT: VIEW SWITCHING & INTERACTIVE FILTERING -->
<!-- ========================================================================= -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Load saved view from localStorage or default to 'manuscript'
        var savedView = localStorage.getItem('storyverse_chapter_view') || 'manuscript';
        switchView(savedView);
    });

    function switchView(viewName) {
        // Update active tab buttons
        var buttons = document.querySelectorAll('#manuscriptViewPills .cs-pill-btn');
        buttons.forEach(function (btn) {
            if (btn.getAttribute('data-view') === viewName) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });

        // Hide all views
        var manuscriptView = document.getElementById('csViewManuscript');
        var gridView = document.getElementById('csViewGrid');
        var listView = document.getElementById('csViewList');
        var outlineView = document.getElementById('csViewOutline');

        if (manuscriptView) manuscriptView.classList.add('d-none');
        if (gridView) gridView.classList.add('d-none');
        if (listView) listView.classList.add('d-none');
        if (outlineView) outlineView.classList.add('d-none');

        // Show selected view
        if (viewName === 'manuscript' && manuscriptView) manuscriptView.classList.remove('d-none');
        if (viewName === 'grid' && gridView) gridView.classList.remove('d-none');
        if (viewName === 'list' && listView) listView.classList.remove('d-none');
        if (viewName === 'outline' && outlineView) outlineView.classList.remove('d-none');

        // Save preference
        localStorage.setItem('storyverse_chapter_view', viewName);

        // Re-initialize Lucide Icons if available
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
            window.lucide.createIcons();
        }

        // Apply filters to newly visible view
        applyFilters();
    }

    function toggleFilterBar() {
        var filterBar = document.getElementById('csFilterBar');
        if (filterBar) {
            filterBar.classList.toggle('d-none');
        }
    }

    function applyFilters() {
        var searchVal = (document.getElementById('csSearchInput')?.value || '').toLowerCase().trim();
        var partVal = document.getElementById('csFilterPartSelect')?.value || 'ALL';
        var statusVal = document.getElementById('csFilterStatusSelect')?.value || 'ALL';

        var chapterItems = document.querySelectorAll('.cs-chapter-item');
        var totalVisible = 0;

        chapterItems.forEach(function (item) {
            var title = item.getAttribute('data-title') || '';
            var summary = item.getAttribute('data-summary') || '';
            var pov = item.getAttribute('data-pov') || '';
            var partId = item.getAttribute('data-part-id') || '';
            var status = item.getAttribute('data-status') || '';

            var matchesSearch = !searchVal || title.includes(searchVal) || summary.includes(searchVal) || pov.includes(searchVal);
            var matchesPart = partVal === 'ALL' || partId === partVal;
            var matchesStatus = statusVal === 'ALL' || status === statusVal;

            if (matchesSearch && matchesPart && matchesStatus) {
                item.classList.remove('d-none');
                totalVisible++;
            } else {
                item.classList.add('d-none');
            }
        });

        // Hide empty part headers in manuscript & outline view if all chapters inside are hidden
        var partBlocks = document.querySelectorAll('.cs-part-block, .cs-outline-part');
        partBlocks.forEach(function (block) {
            var visibleChildren = block.querySelectorAll('.cs-chapter-item:not(.d-none)');
            if (visibleChildren.length === 0 && (searchVal || partVal !== 'ALL' || statusVal !== 'ALL')) {
                block.classList.add('d-none');
            } else {
                block.classList.remove('d-none');
            }
        });

        // Toggle Empty State UI
        var emptyState = document.getElementById('csEmptySearchState');
        if (emptyState) {
            if (totalVisible === 0 && chapterItems.length > 0) {
                emptyState.classList.remove('d-none');
            } else {
                emptyState.classList.add('d-none');
            }
        }
    }

    function resetFilters() {
        var searchInput = document.getElementById('csSearchInput');
        var partSelect = document.getElementById('csFilterPartSelect');
        var statusSelect = document.getElementById('csFilterStatusSelect');

        if (searchInput) searchInput.value = '';
        if (partSelect) partSelect.value = 'ALL';
        if (statusSelect) statusSelect.value = 'ALL';

        applyFilters();
    }

    function filterByStatus(statusName) {
        var statusSelect = document.getElementById('csFilterStatusSelect');
        if (statusSelect) {
            statusSelect.value = statusName;
            applyFilters();
        }
    }

    function toggleAllOutline(expand) {
        var collapses = document.querySelectorAll('#csViewOutline .collapse');
        collapses.forEach(function (el) {
            if (window.bootstrap) {
                var bsCollapse = bootstrap.Collapse.getInstance(el) || new bootstrap.Collapse(el, { toggle: false });
                if (expand) bsCollapse.show();
                else bsCollapse.hide();
            }
        });
    }

    function openNewPartModal() {
        var modalEl = document.getElementById('newPartModal');
        if (modalEl && window.bootstrap) {
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function openImportModal() {
        var modalEl = document.getElementById('importChapterModal');
        if (modalEl && window.bootstrap) {
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function openNewChapterForPart(partId, storyId) {
        var sid = storyId || '@story?.Id';
        if (!sid) return;
        
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("Create", "Chapters")';
        
        var csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (csrfToken) {
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = csrfToken;
            form.appendChild(tokenInput);
        }
        
        var storyInput = document.createElement('input');
        storyInput.type = 'hidden';
        storyInput.name = 'storyId';
        storyInput.value = sid;
        form.appendChild(storyInput);
        
        if (partId) {
            var partInput = document.createElement('input');
            partInput.type = 'hidden';
            partInput.name = 'partId';
            partInput.value = partId;
            form.appendChild(partInput);
        }
        
        document.body.appendChild(form);
        form.submit();
    }
</script>
