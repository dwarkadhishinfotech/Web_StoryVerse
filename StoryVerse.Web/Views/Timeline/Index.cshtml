                                    </div>
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar" role="progressbar" style="width: @arc.ProgressPercent%; background-color: @arc.Color;" aria-valuenow="@arc.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted small italic">No story arcs configured yet.</div>
                        }
                    </div>
                </div>

                <!-- Upcoming Events Widget -->
                <div class="timeline-side-panel">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i data-lucide="clock" style="width: 18px; height: 18px; color: #3B82F6;"></i>
                            <h6 class="fw-bold text-dark mb-0" style="font-size: 0.92rem;">Upcoming Events</h6>
                        </div>
                        <span class="text-muted small cursor-pointer">View All</span>
                    </div>

                    <div class="d-flex flex-column gap-2.5">
                        @if (Model.UpcomingEvents.Any())
                        {
                            @foreach (var u in Model.UpcomingEvents)
                            {
                                <div class="p-2.5 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-semibold text-dark small">@u.Title</div>
                                        <div class="text-muted" style="font-size: 11px;">@u.StoryDate</div>
                                    </div>
                                    <i data-lucide="bookmark" style="width: 16px; color: #94A3B8;"></i>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted small">No upcoming scheduled events.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ==================== EVENT WIZARD MODAL (10 STEPS) ==================== -->
<div class="modal fade" id="eventWizardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom px-4 py-3 bg-light">
                <h5 class="modal-title font-serif fw-bold text-dark">Create Timeline Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="eventWizardForm">
                    <input type="hidden" name="StoryId" value="@Model.SelectedStoryId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">1. Event Title</label>
                        <input type="text" id="wizardTitle" class="form-control rounded-3" placeholder="e.g. Sameer Meets Riya" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase">2. Category</label>
                            <select id="wizardCategory" class="form-select rounded-3">
                                <option value="Birth">Birth</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Career">Career</option>
                                <option value="Investigation">Investigation</option>
                                <option value="Incident">Incident</option>
                                <option value="Battle">Battle</option>
                                <option value="Discovery">Discovery</option>
                                <option value="Flashback">Flashback</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase">3. Story Date</label>
                            <input type="text" id="wizardStoryDate" class="form-control rounded-3" placeholder="e.g. 14 Feb 2020" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">4. Location</label>
                        <input type="text" id="wizardLocation" class="form-control rounded-3" placeholder="e.g. Silverbrook University" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">5. Summary / Details</label>
                        <textarea id="wizardSummary" class="form-control rounded-3" rows="3" placeholder="A chance meeting in the library changes everything..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase">6. Assign Characters</label>
                        <select id="wizardCharacters" class="form-select rounded-3" multiple style="height: 100px;">
                            @foreach (var c in Model.Characters)
                            {
                                <option value="@c.Id">@c.Name (@c.Role)</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn text-white fw-bold px-4 rounded-3" style="background-color: #13A8A6;" onclick="submitEventWizard()">Save Timeline Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ==================== STORY ARC MODAL ==================== -->
<div class="modal fade" id="storyArcModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title font-serif fw-bold text-dark">Create Story Arc</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="storyArcForm">
                    <input type="hidden" name="StoryId" value="@Model.SelectedStoryId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Arc Title</label>
                        <input type="text" id="arcTitle" class="form-control rounded-3" placeholder="e.g. Romance Arc" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Arc Type</label>
                        <select id="arcType" class="form-select rounded-3">
                            <option value="Main Story">Main Story</option>
                            <option value="Character Arc">Character Arc</option>
                            <option value="Romance Arc">Romance Arc</option>
                            <option value="Mystery Arc">Mystery Arc</option>
                            <option value="Crime Investigation">Crime Investigation</option>
                            <option value="Redemption Arc">Redemption Arc</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold small">Target Progress (%)</label>
                        <input type="number" id="arcProgress" class="form-control rounded-3" min="0" max="100" value="50" />
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn text-white fw-bold px-4 rounded-3" style="background-color: #13A8A6;" onclick="submitStoryArc()">Save Arc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateEventModal() {
            var modal = new bootstrap.Modal(document.getElementById('eventWizardModal'));
            modal.show();
        }

        function openCreateArcModal() {
            var modal = new bootstrap.Modal(document.getElementById('storyArcModal'));
            modal.show();
        }

        function submitEventWizard() {
            var title = $('#wizardTitle').val();
            if (!title) { alert('Title is required'); return; }

            var selectedCharEls = $('#wizardCharacters').val() || [];

            var payload = {
                storyId: '@Model.SelectedStoryId',
                title: title,
                category: $('#wizardCategory').val(),
                storyDate: $('#wizardStoryDate').val(),
                locationName: $('#wizardLocation').val(),
                summary: $('#wizardSummary').val(),
                selectedCharacterIds: selectedCharEls
            };

            $.ajax({
                url: '@Url.Action("CreateEvent", "Timeline")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                }
            });
        }

        function submitStoryArc() {
            var title = $('#arcTitle').val();
            if (!title) { alert('Title is required'); return; }

            var payload = {
                storyId: '@Model.SelectedStoryId',
                title: title,
                arcType: $('#arcType').val(),
                targetCompletionPercent: parseInt($('#arcProgress').val()) || 50
            };

            $.ajax({
                url: '@Url.Action("CreateStoryArc", "Timeline")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                }
            });
        }

        function toggleBookmark(id) {
            $.post('@Url.Action("ToggleBookmark", "Timeline")', { id: id }, function(res) {
                if (res.success) location.reload();
            });
        }

        function deleteEvent(id) {
            if (confirm('Delete this event?')) {
                $.post('@Url.Action("DeleteEvent", "Timeline")', { id: id }, function(res) {
                    if (res.success) location.reload();
                });
            }
        }

        function deleteTimelineItem(id) {
            if (confirm('Are you sure you want to delete this timeline?')) {
                $.post('@Url.Action("DeleteTimeline", "Timeline")', { id: id }, function(res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message || 'Error deleting timeline.');
                    }
                });
            }
        }
    </script>
}
