                        </div>
                        <div class="text-end">
                            <img src="/images/inspiration_book_clock.png" id="sidebarHelpImg" alt="Help Graphic" style="width: 105px; height: auto; object-fit: contain; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.08));" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

    <script>
        let currentStep = 1;

        document.addEventListener('DOMContentLoaded', function () {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
            updateSummary();
            updateSelectedArcsUI();
            populateReviewArcs();
        });

        function jumpToStep(step) {
            currentStep = step;
            for (let i = 1; i <= 5; i++) {
                const panel = document.getElementById('stepPanel' + i);
                const navItem = document.getElementById('stepNavItem' + i);
                const bubble = document.getElementById('stepBubble' + i);

                if (panel) {
                    if (i === step) {
                        panel.classList.remove('d-none');
                    } else {
                        panel.classList.add('d-none');
                    }
                }
                if (navItem) {
                    if (i === step) {
                        navItem.classList.add('active');
                        navItem.classList.remove('completed');
                    } else if (i < step) {
                        navItem.classList.remove('active');
                        navItem.classList.add('completed');
                    } else {
                        navItem.classList.remove('active', 'completed');
                    }
                }
                if (bubble) {
                    if (i < step) {
                        bubble.innerHTML = '<i data-lucide="check" style="width: 14px; height: 14px;"></i>';
                    } else {
                        bubble.innerText = i;
                    }
                }
            }
            const progressBar = document.getElementById('stepperProgressBar');
            if (progressBar) {
                const percent = ((step - 1) / 4) * 100;
                progressBar.style.width = percent + '%';
            }

            updateSidebarForStep(step);

            if (step === 5) {
                updateSummary();
                populateReviewArcs();
                // show reviewNeedHelpWidget on step 5
                const needHelp = document.getElementById('reviewNeedHelpWidget');
                if (needHelp) needHelp.classList.remove('d-none');
            } else {
                const needHelp = document.getElementById('reviewNeedHelpWidget');
                if (needHelp) needHelp.classList.add('d-none');
            }

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }
        window.jumpToStep = jumpToStep;

        function updateSidebarForStep(step) {
            const tipsContainer = document.getElementById('sidebarTipsContainer');
            const tipsWidget = tipsContainer ? tipsContainer.closest('.sidebar-widget') : null;
            const settingsPreviewWidget = document.getElementById('settingsPreviewWidget');
            const helpTitle = document.getElementById('sidebarHelpTitle');
            const helpDesc = document.getElementById('sidebarHelpDesc');
            const helpImg = document.getElementById('sidebarHelpImg');
            const helpBtn = document.getElementById('sidebarHelpBtn');
            const arcInfoWidget = document.getElementById('arcInfoWidget');
            const reviewChecklistWidget = document.getElementById('reviewChecklistWidget');
            const reviewGoodToGoWidget = document.getElementById('reviewGoodToGoWidget');

            // Show/hide Settings Preview widget
            if (settingsPreviewWidget) {
                settingsPreviewWidget.classList.toggle('d-none', step !== 3);
                if (step === 3) updateSettingsPreview();
            }
            // Show/hide Arc Info widget (step 4 only)
            if (arcInfoWidget) arcInfoWidget.classList.toggle('d-none', step !== 4);
            // Show/hide Review Checklist widget (step 5 only)
            if (reviewChecklistWidget) reviewChecklistWidget.classList.toggle('d-none', step !== 5);
            if (reviewGoodToGoWidget) reviewGoodToGoWidget.classList.toggle('d-none', step !== 5);

            // Show/hide Tips widget
            if (tipsWidget) tipsWidget.classList.toggle('d-none', step === 3 || step === 4 || step === 5);

            // Show/hide help/inspiration card
            const helpCard = document.getElementById('sidebarHelpCard');
            if (helpCard) helpCard.classList.toggle('d-none', step === 5);

            if (step === 2) {
                if (tipsContainer) {
                    tipsContainer.innerHTML = `
                        <div class="tip-bullet"><div class="tip-check-circle"><i data-lucide="check"></i></div><span>Chronological timeline is great for straightforward stories.</span></div>
                        <div class="tip-bullet"><div class="tip-check-circle"><i data-lucide="check"></i></div><span>Story arc timeline helps you focus on plot structure.</span></div>
                        <div class="tip-bullet"><div class="tip-check-circle"><i data-lucide="check"></i></div><span>Investigation board is ideal for crime and mystery stories.</span></div>
                        <div class="tip-bullet"><div class="tip-check-circle"><i data-lucide="check"></i></div><span>You can change timeline type later.</span></div>
                    `;
                }
                if (helpTitle) helpTitle.innerHTML = '<i data-lucide="help-circle" style="width: 16px; height: 16px; color: #D97706;" class="me-1"></i> Need Help?';
                if (helpDesc) helpDesc.innerText = 'Learn more about timeline types and how to use them effectively.';
                if (helpImg) helpImg.src = '/images/timeline_help_lantern.png';
                if (helpBtn) helpBtn.innerHTML = 'View Help Guide <i data-lucide="arrow-right" style="width: 14px; height: 14px;" class="ms-1"></i>';
            } else if (step === 3) {
                if (helpTitle) helpTitle.innerHTML = '<i data-lucide="help-circle" style="width: 16px; height: 16px; color: #D97706;" class="me-1"></i> Need Help?';
                if (helpDesc) helpDesc.innerText = 'You can always change these settings later from the timeline settings page.';
                if (helpImg) helpImg.src = '/images/timeline_help_lantern.png';
                if (helpBtn) helpBtn.innerHTML = 'View Help Guide <i data-lucide="arrow-right" style="width: 14px; height: 14px;" class="ms-1"></i>';
            } else if (step === 5) {
                // populate review checklist
                populateReviewChecklist();
            } else {
                if (tipsContainer) {
                    tipsContainer.innerHTML = `
                        <div class="tip-bullet"><div class="tip-check-circle"><i data-lucide="check"></i></div><span>Give your timeline a clear, meaningful name.</span></div>
                        <div class="tip-bullet"><div class="tip-check-circle"><i data-lucide="check"></i></div><span>Add a description to remember its purpose.</span></div>
                        <div class="tip-bullet"><div class="tip-check-circle"><i data-lucide="check"></i></div><span>You can link story arcs in step 4.</span></div>
                        <div class="tip-bullet"><div class="tip-check-circle"><i data-lucide="check"></i></div><span>Timeline events can be added anytime.</span></div>
                    `;
                }
                if (helpTitle) helpTitle.innerHTML = '<i data-lucide="sparkles" style="width: 16px; height: 16px; color: #D97706;" class="me-1"></i> Need Inspiration?';
                if (helpDesc) helpDesc.innerText = 'Explore timeline templates to get started quickly.';
                if (helpImg) helpImg.src = '/images/inspiration_book_clock.png';
                if (helpBtn) helpBtn.innerHTML = 'Browse Templates <i data-lucide="arrow-right" style="width: 14px; height: 14px;" class="ms-1"></i>';
            }
        }
        window.updateSidebarForStep = updateSidebarForStep;

        function updateSettingsPreview() {
            // Date Format — read from hidden input (set by dropdown)
            const dateFormatInput = document.getElementById('inputDateFormat');
            const dateFormatText = document.getElementById('ddDateFormatText');
            const dateFormatVal = (dateFormatInput && dateFormatInput.value) ? dateFormatInput.value : (dateFormatText ? dateFormatText.innerText : 'DD MMM YYYY (31 Dec 2025)');
            // Show only the short form e.g. "31 Dec 2025" extracted from parentheses
            const dateFormatShort = (() => {
                const m = dateFormatVal ? dateFormatVal.match(/\(([^)]+)\)/) : null;
                return m ? m[1] : dateFormatVal;
            })();
            const prevDateFormat = document.getElementById('prevDateFormat');
            if (prevDateFormat) prevDateFormat.innerText = dateFormatShort;

            // Time Format
            const timeFormatInput = document.getElementById('inputTimeFormat');
            const timeFormatText = document.getElementById('ddTimeFormatText');
            const timeFormatVal = (timeFormatInput && timeFormatInput.value) ? timeFormatInput.value : (timeFormatText ? timeFormatText.innerText : '12 Hour (AM/PM)');
            const prevTimeFormat = document.getElementById('prevTimeFormat');
            if (prevTimeFormat) prevTimeFormat.innerText = timeFormatVal;

            // Default View
            const defaultViewInput = document.getElementById('inputDefaultTimelineView');
            const defaultViewText = document.getElementById('ddDefaultViewText');
            const defaultViewVal = (defaultViewInput && defaultViewInput.value) ? defaultViewInput.value : (defaultViewText ? defaultViewText.innerText : 'Chronological Timeline');
            // Shorten to first word or two
            const defaultViewShort = defaultViewVal ? defaultViewVal.replace(' Timeline', '').trim() : '';
            const prevDefaultView = document.getElementById('prevDefaultView');
            if (prevDefaultView) prevDefaultView.innerText = defaultViewShort;

            // Event Grouping
            const groupingInput = document.getElementById('inputEventGrouping');
            const groupingText = document.getElementById('ddGroupingText');
            const groupingVal = (groupingInput && groupingInput.value) ? groupingInput.value : (groupingText ? groupingText.innerText : 'Group by Date');
            const groupingShort = groupingVal ? groupingVal.replace('Group by ', 'By ').replace('No Grouping', 'None') : '';
            const prevGrouping = document.getElementById('prevEventGrouping');
            if (prevGrouping) prevGrouping.innerText = groupingShort;

            // Overlapping Events toggle
            const overlapCb = document.getElementById('AllowOverlappingEvents');
            const prevOverlap = document.getElementById('prevOverlapping');
            if (prevOverlap && overlapCb) {
                const enabled = overlapCb.checked;
                prevOverlap.innerHTML = enabled
                    ? '<span class="badge rounded-pill px-2 py-1" style="background: #D1FAE5; color: #065F46; font-size: 0.72rem;">Enabled</span>'
                    : '<span class="badge rounded-pill px-2 py-1" style="background: #FEE2E2; color: #991B1B; font-size: 0.72rem;">Disabled</span>';
            }

            // Dependencies toggle
            const depCb = document.getElementById('EnableTimelineDependencies');
            const prevDep = document.getElementById('prevDependencies');
            if (prevDep && depCb) {
                const enabled = depCb.checked;
                prevDep.innerHTML = enabled
                    ? '<span class="badge rounded-pill px-2 py-1" style="background: #D1FAE5; color: #065F46; font-size: 0.72rem;">Enabled</span>'
                    : '<span class="badge rounded-pill px-2 py-1" style="background: #FEE2E2; color: #991B1B; font-size: 0.72rem;">Disabled</span>';
            }
        }
        window.updateSettingsPreview = updateSettingsPreview;

        function updateCharCount(inputId, counterId, maxLen) {
            const input = document.getElementById(inputId);
            const counter = document.getElementById(counterId);
            if (input && counter) {
                counter.innerText = input.value.length + '/' + maxLen;
            }
        }
        window.updateCharCount = updateCharCount;

        function selectColorSwatch(element, colorName) {
            document.querySelectorAll('.color-circle-btn').forEach(btn => {
                btn.classList.remove('selected');
                btn.innerHTML = '';
            });
            element.classList.add('selected');
            element.innerHTML = '<i data-lucide="check" style="width: 14px; height: 14px;"></i>';
            const inputColor = document.getElementById('inputColor');
            if (inputColor) inputColor.value = colorName;
            const sumColorText = document.getElementById('sumColorText');
            if (sumColorText) sumColorText.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background-color: ${element.style.backgroundColor}; display: inline-block;"></span> ${colorName}`;
            const reviewColor = document.getElementById('reviewColor');
            if (reviewColor) reviewColor.innerText = colorName;
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
        window.selectColorSwatch = selectColorSwatch;

        function selectTypeCard(element, typeName) {
            document.querySelectorAll('.type-card').forEach(card => card.classList.remove('selected'));
            element.classList.add('selected');
            const inputType = document.getElementById('inputTimelineType');
            if (inputType) inputType.value = typeName;
            const sumTypeText = document.getElementById('sumTypeText');
            if (sumTypeText) sumTypeText.innerText = typeName;
            const reviewType = document.getElementById('reviewType');
            if (reviewType) reviewType.innerText = typeName;
        }
        window.selectTypeCard = selectTypeCard;

        function toggleDropdown(wrapperId) {
            const wrapper = document.getElementById(wrapperId);
            if (!wrapper) return;
            document.querySelectorAll('.theme-dropdown-wrapper').forEach(w => {
                if (w !== wrapper) w.classList.remove('open');
            });
            wrapper.classList.toggle('open');
        }
        window.toggleDropdown = toggleDropdown;

        function selectDropdownVal(wrapperId, inputId, val) {
            const inputEl = document.getElementById(inputId);
            if (inputEl) inputEl.value = val;
            const textElem = document.getElementById(wrapperId.replace('Wrapper', 'Text'));
            if (textElem) textElem.innerText = val;
            const wrapper = document.getElementById(wrapperId);
            if (wrapper) wrapper.classList.remove('open');
            // Update Settings Preview if on step 3
            if (currentStep === 3) {
                updateSettingsPreview();
            }
        }
        window.selectDropdownVal = selectDropdownVal;

        function selectStoryOption(storyId, storyTitle, coverUrl) {
            const inputStory = document.getElementById('inputStoryId');
            if (inputStory) inputStory.value = storyId;
            const titleSpan = document.getElementById('storyTitleSpan');
            if (titleSpan) titleSpan.innerText = storyTitle;
            const sumStoryText = document.getElementById('sumStoryText');
            if (sumStoryText) sumStoryText.innerText = storyTitle;
            const reviewStory = document.getElementById('reviewStory');
            if (reviewStory) reviewStory.innerText = storyTitle;
            if (coverUrl) {
                const thumb = document.getElementById('sumStoryThumbnail');
                if (thumb) thumb.src = coverUrl;
            }
            const wrapper = document.getElementById('ddStoryWrapper');
            if (wrapper) wrapper.classList.remove('open');
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
        window.selectStoryOption = selectStoryOption;

        function updateSummary() {
            const nameInp = document.getElementById('timelineNameInput');
            const name = nameInp ? nameInp.value : '';
            const startInp = document.getElementById('startDateInput');
            const startDate = startInp ? startInp.value : '';
            const endInp = document.getElementById('endDateInput');
            const endDate = endInp ? endInp.value : '';
            const descInp = document.getElementById('timelineDescInput') || document.getElementById('Description');
            const desc = descInp ? descInp.value : '';

            // Sidebar summary (safely updated if present)
            const sumStart = document.getElementById('sumStartDateText');
            if (sumStart) sumStart.innerText = startDate ? formatDate(startDate) : 'Not set';
            const sumEnd = document.getElementById('sumEndDateText');
            if (sumEnd) sumEnd.innerText = endDate ? formatDate(endDate) : 'Not set';

            // Step 5 review cards — Basic Info
            const reviewNameEl = document.getElementById('reviewName');
            if (reviewNameEl) reviewNameEl.innerText = name || '—';
            const reviewDescEl = document.getElementById('reviewDescription');
            if (reviewDescEl) reviewDescEl.innerText = desc ? (desc.length > 30 ? desc.substring(0, 30) + '...' : desc) : 'No description';

            // Date/Time cards
            const dtFormatEl = document.getElementById('reviewDateFormat');
            const tmFormatEl = document.getElementById('reviewTimeFormat');
            const tmDefEl = document.getElementById('reviewDefaultTime');
            const tmZoneEl = document.getElementById('reviewTimeZone');
            if (dtFormatEl) {
                const dtInput = document.getElementById('inputDateFormat');
                const dtText = document.getElementById('ddDateFormatText');
                const dtVal = (dtInput && dtInput.value) ? dtInput.value : (dtText ? dtText.innerText : 'DD MMM YYYY (31 Dec 2025)');
                const m = dtVal ? dtVal.match(/^([^(]+)/) : null;
                dtFormatEl.innerText = m ? m[1].trim() : (dtVal || '—');
            }
            if (tmFormatEl) {
                const tmInput = document.getElementById('inputTimeFormat');
                const tmText = document.getElementById('ddTimeFormatText');
                tmFormatEl.innerText = (tmInput && tmInput.value) ? tmInput.value : (tmText ? tmText.innerText : '12 Hour (AM/PM)');
            }
            if (tmDefEl) {
                const defTimeInput = document.getElementById('DefaultTime');
                if (defTimeInput && defTimeInput.value) {
                    try {
                        const [h, min] = defTimeInput.value.split(':');
                        const hour = parseInt(h);
                        const ampm = hour >= 12 ? 'PM' : 'AM';
                        const h12 = hour % 12 || 12;
                        tmDefEl.innerText = `${h12}:${min} ${ampm}`;
                    } catch(e) { tmDefEl.innerText = defTimeInput.value; }
                } else { tmDefEl.innerText = '12:00 PM'; }
            }
            if (tmZoneEl) {
                const tzInput = document.getElementById('inputTimeZone');
                const tzText = document.getElementById('ddTimeZoneText');
                tmZoneEl.innerText = (tzInput && tzInput.value) ? tzInput.value : (tzText ? tzText.innerText : '(GMT+05:30) Asia/Kolkata');
            }

            // Grouping
            const grpEl = document.getElementById('reviewGrouping');
            if (grpEl) {
                const grpInput = document.getElementById('inputEventGrouping');
                const grpText = document.getElementById('ddGroupingText');
                grpEl.innerText = (grpInput && grpInput.value) ? grpInput.value : (grpText ? grpText.innerText : 'Group by Date');
            }

            // Display preference badges
            function yesNoBadge(checked) {
                return checked
                    ? '<span class="d-flex align-items-center gap-1"><i data-lucide="check-circle" style="width:13px;height:13px;color:#0D9488;"></i><span style="font-size:0.76rem;color:#0D9488;font-weight:600;">Yes</span></span>'
                    : '<span class="d-flex align-items-center gap-1"><i data-lucide="x-circle" style="width:13px;height:13px;color:#94A3B8;"></i><span style="font-size:0.76rem;color:#94A3B8;">No</span></span>';
            }
            const showTimeCb = document.getElementById('ShowTimeOnTimeline');
            const showIconsCb = document.getElementById('ShowEventIcons');
            const showDescsCb = document.getElementById('ShowEventDescriptions');
            const compactCb = document.getElementById('CompactMode');
            const revShowTime = document.getElementById('revShowTime');
            const revShowIcons = document.getElementById('revShowIcons');
            const revShowDescs = document.getElementById('revShowDescs');
            const revCompact = document.getElementById('revCompact');
            if (revShowTime && showTimeCb) revShowTime.innerHTML = yesNoBadge(showTimeCb.checked);
            if (revShowIcons && showIconsCb) revShowIcons.innerHTML = yesNoBadge(showIconsCb.checked);
            if (revShowDescs && showDescsCb) revShowDescs.innerHTML = yesNoBadge(showDescsCb.checked);
            if (revCompact && compactCb) revCompact.innerHTML = yesNoBadge(compactCb.checked);
            const revShowTimeCheck = document.getElementById('reviewShowTimeCheck');
            if (revShowTimeCheck && showTimeCb) {
                revShowTimeCheck.innerHTML = showTimeCb.checked
                    ? '<i data-lucide="check-circle" style="width:14px;height:14px;color:#0D9488;"></i> <span style="color:#0D9488;font-size:0.76rem;">Enabled</span>'
                    : '<i data-lucide="x-circle" style="width:14px;height:14px;color:#94A3B8;"></i> <span style="color:#94A3B8;font-size:0.76rem;">Disabled</span>';
            }
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
        window.updateSummary = updateSummary;

        // Populate the Review step Story Arcs list from checked arc cards
        function populateReviewArcs() {
            const checkboxes = document.querySelectorAll('.arc-checkbox:checked');
            const arcCountEl = document.getElementById('reviewArcCount');
            const arcsListEl = document.getElementById('reviewArcsList');
            if (!arcsListEl) return;
            if (arcCountEl) arcCountEl.innerText = checkboxes.length;

            // Sync sidebar
            const sumArcs = document.getElementById('sumArcsText');
            if (sumArcs) sumArcs.innerText = checkboxes.length + (checkboxes.length === 1 ? ' arc linked' : ' arcs linked');

            const arcIconMap = {
                'Main Story':          { icon: 'heart',     bg: '#FEE2E2', color: '#DC2626', label: 'Main Plot' },
                'Character Arc':       { icon: 'user',      bg: '#EDE9FE', color: '#7C3AED', label: 'Character Arc' },
                'Romance Arc':         { icon: 'heart',     bg: '#FCE7F3', color: '#DB2777', label: 'Romance' },
                'Mystery Arc':         { icon: 'search',    bg: '#FEF3C7', color: '#D97706', label: 'Mystery' },
                'Political Arc':       { icon: 'landmark',  bg: '#DBEAFE', color: '#2563EB', label: 'Political' },
                'War Arc':             { icon: 'shield',    bg: '#FEE2E2', color: '#DC2626', label: 'War' },
                'Crime Investigation': { icon: 'shield',    bg: '#F0FDF4', color: '#16A34A', label: 'Crime' },
                'Past Trauma Arc':     { icon: 'clock',     bg: '#F3F4F6', color: '#374151', label: 'Trauma' },
                'Redemption Arc':      { icon: 'sunrise',   bg: '#FFF7ED', color: '#EA580C', label: 'Redemption' },
                'Custom':              { icon: 'layers',    bg: '#F1F5F9', color: '#475569', label: 'Custom' },
            };

            if (checkboxes.length === 0) {
                arcsListEl.innerHTML = '<div class="text-muted" style="font-size: 0.8rem; font-style: italic; padding: 0.5rem 0;">No story arcs linked. You can link arcs in Step 4.</div>';
                return;
            }

            let html = '';
            checkboxes.forEach(cb => {
                const card = cb.closest('.arc-item-card');
                const title = card ? card.getAttribute('data-title') : 'Unknown Arc';
                const arcType = card ? card.getAttribute('data-arc-type') || 'Custom' : 'Custom';
                const arcColor = card ? card.getAttribute('data-arc-color') || '#475569' : '#475569';
                const info = arcIconMap[arcType] || { icon: 'git-branch', bg: '#F1F5F9', color: '#475569', label: arcType };
                const pb = card ? card.querySelector('.arc-progress-bar') : null;
                const progressW = pb ? pb.style.width : '0%';
                const isMain = arcType === 'Main Story';

                html += `
                    <div class="d-flex align-items-center gap-3 p-3 rounded-3 border" style="background: #FAFCFF; border-color: #E8EDF5 !important;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px; background: ${info.bg};">
                            <i data-lucide="${info.icon}" style="width: 15px; height: 15px; color: ${info.color};"></i>
                        </div>
                        <div class="flex-grow-1 min-width-0">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-bold text-slate-800" style="font-size: 0.85rem;">${title}</span>
                                ${isMain ? '<span class="badge rounded-pill" style="font-size:0.68rem; background:#FEF3C7; color:#D97706; padding:2px 7px;"><i data-lucide="star" style="width:9px;height:9px;"></i> Primary</span>' : ''}
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <span class="badge rounded-pill" style="font-size: 0.72rem; background: ${info.bg}; color: ${info.color}; padding: 3px 10px; font-weight: 600;">${info.label}</span>
                            <i data-lucide="chevron-down" style="width: 14px; height: 14px; color: #94A3B8;"></i>
                        </div>
                    </div>
                `;
            });
            arcsListEl.innerHTML = html;
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
        window.populateReviewArcs = populateReviewArcs;

        // Populate Review Checklist in sidebar
        function populateReviewChecklist() {
            const nameEl = document.getElementById('timelineNameInput');
            const name = nameEl ? nameEl.value.trim() : '';
            const typeEl = document.getElementById('inputTimelineType');
            const type = typeEl ? typeEl.value : '';
            const startDateEl = document.getElementById('startDateInput');
            const startDate = startDateEl ? startDateEl.value : '';
            const arcCount = document.querySelectorAll('.arc-checkbox:checked').length;

            function checkItem(ok, label) {
                return `<div class="d-flex align-items-center gap-2 mb-2">
                    <i data-lucide="${ok ? 'check-circle' : 'circle'}" style="width:15px;height:15px;color:${ok ? '#0D9488' : '#CBD5E1'};flex-shrink:0;"></i>
                    <span style="font-size:0.78rem;color:${ok ? '#0F172A' : '#94A3B8'};">${label}</span>
                </div>`;
            }

            const checklistEl = document.getElementById('reviewChecklistItems');
            if (checklistEl) {
                checklistEl.innerHTML =
                    checkItem(!!name, 'Timeline details are correct') +
                    checkItem(!!type, 'Timeline type is selected') +
                    checkItem(true, 'Settings are configured') +
                    checkItem(arcCount > 0, `Story arcs are linked (${arcCount})`) +
                    checkItem(!!name && !!type, 'Ready to create your timeline!');
                if (typeof lucide !== 'undefined') lucide.createIcons();
            }

            // All good to go state
            const goodToGoEl = document.getElementById('reviewGoodToGoMsg');
            if (goodToGoEl) {
                const allGood = !!name && !!type;
                goodToGoEl.innerHTML = allGood
                    ? '<div class="fw-bold mb-1" style="font-size:0.85rem;color:#065F46;"><i data-lucide="check-circle" style="width:15px;height:15px;color:#059669;" class="me-1"></i> All good to go!</div><p class="mb-0" style="font-size:0.76rem;color:#047857;">You can now create your timeline.</p>'
                    : '<div class="fw-bold mb-1" style="font-size:0.85rem;color:#92400E;"><i data-lucide="alert-circle" style="width:15px;height:15px;color:#D97706;" class="me-1"></i> Almost there!</div><p class="mb-0" style="font-size:0.76rem;color:#92400E;">Please fill in the required details.</p>';
                const goodToGoWidget = document.getElementById('reviewGoodToGoWidget');
                if (goodToGoWidget) {
                    goodToGoWidget.style.background = allGood ? '#D1FAE5' : '#FEF3C7';
                    goodToGoWidget.style.borderColor = allGood ? '#6EE7B7' : '#FDE68A';
                }
                if (typeof lucide !== 'undefined') lucide.createIcons();
            }
        }
        window.populateReviewChecklist = populateReviewChecklist;

        function saveDraft() {
            // Set a hidden field to indicate draft save, then submit
            const statusField = document.querySelector('input[name="Status"]');
            if (statusField) { statusField.value = 'Draft'; }
            else {
                const inp = document.createElement('input');
                inp.type = 'hidden'; inp.name = 'Status'; inp.value = 'Draft';
                const form = document.querySelector('form');
                if (form) form.appendChild(inp);
            }
            const form = document.querySelector('form');
            if (form) form.submit();
        }
        window.saveDraft = saveDraft;

        function formatDate(dateStr) {
            if (!dateStr) return 'Not set';
            try {
                const d = new Date(dateStr);
                return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            } catch (e) {
                return dateStr;
            }
        }
        window.formatDate = formatDate;

        // ── Arc Tab Switching ──────────────────────────────────────────────
        function switchArcTab(tab) {
            ['existing','create','templates'].forEach(function(t) {
                const pane = document.getElementById('arcPane' + t.charAt(0).toUpperCase() + t.slice(1));
                if (pane) pane.classList.add('d-none');
                const tabElem = document.getElementById('arcTab' + t.charAt(0).toUpperCase() + t.slice(1));
                if (tabElem) tabElem.classList.remove('active');
            });
            const activePane = document.getElementById('arcPane' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if (activePane) activePane.classList.remove('d-none');
            const activeTab = document.getElementById('arcTab' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if (activeTab) activeTab.classList.add('active');
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
        window.switchArcTab = switchArcTab;

        // ── Toggle Arc Card Selection ──────────────────────────────────────
        function toggleArcCard(card) {
            if (!card) return;
            const cb = card.querySelector('.arc-checkbox');
            const checkBox = card.querySelector('.arc-check-box');
            if (cb) cb.checked = !cb.checked;
            if (cb && cb.checked) {
                card.classList.add('arc-card-selected');
                if (checkBox) checkBox.classList.add('arc-check-box-checked');
            } else {
                card.classList.remove('arc-card-selected');
                if (checkBox) checkBox.classList.remove('arc-check-box-checked');
            }
            updateSelectedArcsUI();
        }
        window.toggleArcCard = toggleArcCard;

        // ── Remove Arc via Tag × button ────────────────────────────────────
        function removeArcTag(arcId) {
            const card = document.querySelector('.arc-item-card[data-arc-id="' + arcId + '"]');
            if (card) {
                const cb = card.querySelector('.arc-checkbox');
                if (cb) cb.checked = false;
                card.classList.remove('arc-card-selected');
                const checkBox = card.querySelector('.arc-check-box');
                if (checkBox) checkBox.classList.remove('arc-check-box-checked');
            }
            updateSelectedArcsUI();
        }
        window.removeArcTag = removeArcTag;

        // ── Refresh Selected Arcs Panel ────────────────────────────────────
        function updateSelectedArcsUI() {
            const checkboxes = document.querySelectorAll('.arc-checkbox:checked');
            const tagContainer = document.getElementById('selectedArcTags');
            const countElem = document.getElementById('selectedArcCount');
            if (countElem) countElem.innerText = checkboxes.length;
            const sumArcs = document.getElementById('sumArcsText');
            if (sumArcs) sumArcs.innerText = checkboxes.length + (checkboxes.length === 1 ? ' arc linked' : ' arcs linked');

            if (!tagContainer) return;

            if (checkboxes.length === 0) {
                tagContainer.innerHTML = '<span class="text-muted" style="font-size: 0.78rem; font-style: italic;">No arcs selected yet.</span>';
                return;
            }

            let html = '';
            checkboxes.forEach(function(cb) {
                const card = cb.closest('.arc-item-card');
                if (!card) return;
                const title = card.getAttribute('data-title') || 'Arc';
                const arcId = card.getAttribute('data-arc-id') || '';
                const arcColor = card.getAttribute('data-arc-color') || '#DC2626';
                const pb = card.querySelector('.arc-progress-bar');
                const progressW = pb ? pb.style.width : '0%';
                html += '<div class="arc-selected-tag" id="arcTag_' + arcId + '">' +
                    '<div class="d-flex align-items-center gap-1 min-width-0">' +
                    '<i data-lucide="heart" style="width: 11px; height: 11px; color: ' + arcColor + '; flex-shrink:0;"></i>' +
                    '<span class="text-truncate" style="font-size:0.78rem; max-width:110px;">' + title + '</span>' +
                    '<span class="fw-bold" style="color: #0D9488; font-size: 0.7rem; white-space:nowrap;">' + progressW + '</span>' +
                    '</div>' +
                    '<button type="button" class="arc-tag-remove" onclick="removeArcTag(\'' + arcId + '\')">' +
                    '<i data-lucide="x" style="width: 11px; height: 11px;"></i>' +
                    '</button>' +
                    '</div>';
            });
            tagContainer.innerHTML = html;
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
        window.updateSelectedArcsUI = updateSelectedArcsUI;

        // ── Filter Arc Cards by search query ──────────────────────────────
        function filterArcCards(query) {
            const q = query.toLowerCase().trim();
            document.querySelectorAll('.arc-item-card').forEach(function(card) {
                const title = (card.getAttribute('data-title') || '').toLowerCase();
                card.style.display = (!q || title.includes(q)) ? 'flex' : 'none';
            });
        }
        window.filterArcCards = filterArcCards;

        // ── Apply Arc Template ─────────────────────────────────────────────
        function applyArcTemplate(title, type, description) {
            switchArcTab('create');
            const newTitle = document.getElementById('newArcTitle');
            if (newTitle) newTitle.value = title;
            const newType = document.getElementById('newArcType');
            if (newType) newType.value = type;
            const newDesc = document.getElementById('newArcDesc');
            if (newDesc) newDesc.value = description;
        }
        window.applyArcTemplate = applyArcTemplate;

        // ── Create New Arc Inline ──────────────────────────────────────────
        function createNewArcInline() {
            const titleEl = document.getElementById('newArcTitle');
            const title = titleEl ? titleEl.value.trim() : '';
            const typeEl = document.getElementById('newArcType');
            const type = typeEl ? typeEl.value : '';
            const descEl = document.getElementById('newArcDesc');
            const desc = descEl ? descEl.value.trim() : '';
            const pctEl = document.getElementById('newArcPercent');
            const pct = (pctEl ? parseInt(pctEl.value) : 0) || 0;
            if (!title) {
                if (titleEl) titleEl.focus();
                return;
            }
            const container = document.getElementById('arcOptionsContainer');
            if (!container) return;
            const tempId = 'new_' + Date.now();
            const card = document.createElement('div');
            card.className = 'arc-item-card arc-card-new';
            card.setAttribute('data-title', title);
            card.setAttribute('data-arc-id', tempId);
            card.setAttribute('data-arc-color', '#0D9488');
            card.setAttribute('onclick', 'toggleArcCard(this)');
            card.innerHTML = '<div class="d-flex align-items-center gap-3 flex-grow-1">' +
                '<div class="arc-icon-circle flex-shrink-0" style="background: #CCFBF1; color: #0D9488;">' +
                '<i data-lucide="git-branch" style="width: 16px; height: 16px;"></i>' +
                '</div>' +
                '<div class="flex-grow-1">' +
                '<div class="d-flex align-items-center gap-2 mb-1">' +
                '<span class="fw-bold text-slate-800" style="font-size: 0.88rem;">' + title + '</span>' +
                '<span class="badge rounded-pill" style="font-size:0.68rem; background:#CCFBF1; color:#0D9488; padding:2px 7px;">New</span>' +
                '</div>' +
                '<p class="text-muted mb-1" style="font-size: 0.76rem;">' + (desc || 'No description provided.') + '</p>' +
                '<div class="d-flex align-items-center gap-2">' +
                '<span class="arc-type-badge" style="background:#CCFBF1; color:#0D9488;">' + type + '</span>' +
                '<div class="arc-progress-track"><div class="arc-progress-bar" style="width:' + pct + '%; background:#0D9488;"></div></div>' +
                '<span class="fw-bold" style="font-size:0.75rem; color:#0D9488;">' + pct + '%</span>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '<div class="arc-check-area flex-shrink-0">' +
                '<input type="checkbox" name="NewArcTitles" value="' + title + '" class="arc-checkbox d-none" checked />' +
                '<div class="arc-check-box arc-check-box-checked">' +
                '<i data-lucide="check" style="width: 13px; height: 13px;"></i>' +
                '</div>' +
                '</div>';
            container.appendChild(card);
            if (titleEl) titleEl.value = '';
            if (descEl) descEl.value = '';
            if (pctEl) pctEl.value = '0';
            switchArcTab('existing');
            card.classList.add('arc-card-selected');
            updateSelectedArcsUI();
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
        window.createNewArcInline = createNewArcInline;

        function handleFileSelect(input) {
            if (input && input.files && input.files[0]) {
                const fileName = input.files[0].name;
                const nameDisplay = document.getElementById('fileNameDisplay');
                if (nameDisplay) nameDisplay.innerText = 'Selected file: ' + fileName;
                const previewContainer = document.getElementById('filePreviewContainer');
                if (previewContainer) previewContainer.classList.remove('d-none');
            }
        }
        window.handleFileSelect = handleFileSelect;

        function clearFileSelect() {
            const input = document.getElementById('bannerFileInput');
            if (input) input.value = '';
            const previewContainer = document.getElementById('filePreviewContainer');
            if (previewContainer) previewContainer.classList.add('d-none');
        }
        window.clearFileSelect = clearFileSelect;

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.theme-dropdown-wrapper')) {
                document.querySelectorAll('.theme-dropdown-wrapper').forEach(function(w) { w.classList.remove('open'); });
            }
        });
    </script>
