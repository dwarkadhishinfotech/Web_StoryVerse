@model StoryVerse.Core.Entities.Character
@using System.Text.Json
@{
    var story = ViewBag.Story as StoryVerse.Core.Entities.Story;
    var chapterCount = (int)(ViewBag.ChapterCount ?? 0);
    var recentChapters = ViewBag.RecentChapters as List<StoryVerse.Core.Entities.Chapter> ?? new List<StoryVerse.Core.Entities.Chapter>();
    var siblingChars = ViewBag.SiblingCharacters as List<StoryVerse.Core.Entities.Character> ?? new List<StoryVerse.Core.Entities.Character>();
    var createdByName = ViewBag.CreatedByName as string ?? "Author";
    ViewData["Title"] = $"{Model.Name} - Character Profile";

    // Parse relationships JSON
    var relationships = new List<dynamic>();
    if (!string.IsNullOrWhiteSpace(Model.RelationshipsJson))
    {
        try
        {
            var doc = JsonDocument.Parse(Model.RelationshipsJson);
            if (doc.RootElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var elem in doc.RootElement.EnumerateArray())
                {
                    string rName = "";
                    string rType = "";
                    string rDesc = "";
                    string rAvatar = "";
                    string rSentiment = "";

                    if (elem.TryGetProperty("name", out var pN)) rName = pN.GetString() ?? "";
                    else if (elem.TryGetProperty("targetName", out var pTN)) rName = pTN.GetString() ?? "";

                    if (elem.TryGetProperty("relationship", out var pR)) rType = pR.GetString() ?? "";
                    else if (elem.TryGetProperty("relationType", out var pRT)) rType = pRT.GetString() ?? "";

                    if (elem.TryGetProperty("description", out var pD)) rDesc = pD.GetString() ?? "";
                    if (elem.TryGetProperty("avatar", out var pA)) rAvatar = pA.GetString() ?? "";
                    else if (elem.TryGetProperty("avatarUrl", out var pAU)) rAvatar = pAU.GetString() ?? "";

                    if (elem.TryGetProperty("sentiment", out var pS)) rSentiment = pS.GetString() ?? "";

                    if (!string.IsNullOrWhiteSpace(rName))
                    {
                        relationships.Add(new { Name = rName, Type = rType, Description = rDesc, Avatar = rAvatar, Sentiment = rSentiment });
                    }
                }
            }
        }
        catch { }
    }

    // Parse personality traits
    var traits = string.IsNullOrWhiteSpace(Model.PersonalityTraits)
        ? new string[0]
        : Model.PersonalityTraits.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries).Select(t => t.Trim()).ToArray();

    // Parse tags
    var tags = string.IsNullOrWhiteSpace(Model.Tags)
        ? new string[0]
        : Model.Tags.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries).Select(t => t.Trim()).ToArray();

    // Helper: initials
    string GetInitials(string name) {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}"
            : char.ToUpper(name[0]).ToString();
    }

    // Sentiment color helper
    string GetSentimentClass(string sentiment) {
        return sentiment?.ToLower() switch {
            "positive" => "cd-rel-positive",
            "negative" => "cd-rel-negative",
            "neutral" => "cd-rel-neutral",
            _ => "cd-rel-neutral"
        };
    }
    string GetSentimentLabel(string sentiment) {
        return sentiment?.ToLower() switch {
            "positive" => "Positive",
            "negative" => "Negative",
            "neutral" => "Neutral",
            _ => "Neutral"
        };
    }
}

<div class="cd-wrapper">

    <!-- ═══════════════════════════════ TOP BREADCRUMB / ACTION BAR ═════════════════════════════ -->
    <div class="cd-topbar">
        <div class="cd-breadcrumb">
            <a href="@Url.Action("Index","Characters", new { storyId = Model.StoryId })">Characters</a>
            <i data-lucide="chevron-right" class="cd-chevron"></i>
            <span>@Model.Name</span>
        </div>
        <div class="cd-topbar-actions">
            <button class="cd-btn-ghost"><i data-lucide="share-2"></i> Share</button>
            <button class="cd-btn-ghost"><i data-lucide="download"></i> Export</button>
            <a href="@Url.Action("Edit","Characters", new { id = Model.Id })" class="cd-btn-primary">
                <i data-lucide="edit-3"></i> Edit Profile
            </a>
            <button class="cd-btn-icon"><i data-lucide="more-horizontal"></i></button>
        </div>
    </div>

    <!-- ═══════════════════════════════════ HERO HEADER ═════════════════════════════════════════ -->
    <div class="cd-hero">
        <div class="cd-hero-identity">
            <h1 class="cd-hero-name">
                @Model.Name
                @if (!string.IsNullOrWhiteSpace(Model.Alignment) && (Model.Alignment.Contains("Good", StringComparison.OrdinalIgnoreCase) || Model.Role?.Contains("Protagonist", StringComparison.OrdinalIgnoreCase) == true))
                {
                    <i data-lucide="star" class="cd-star-icon"></i>
                }
            </h1>
            <div class="cd-hero-meta">
                @if (!string.IsNullOrWhiteSpace(Model.Role))
                {
                    <span class="cd-role-badge">@Model.Role</span>
                    <span class="cd-meta-dot">•</span>
                }
                @if (story != null)
                {
                    <a href="@Url.Action("Details","Stories", new { id = story.Id })" class="cd-story-link">@story.Title</a>
                }
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════ TABS ════════════════════════════════════════════════ -->
    <div class="cd-tabs-bar">
        <button class="cd-tab active" data-tab="overview">
            <i data-lucide="layout-dashboard"></i> Overview
        </button>
        <button class="cd-tab" data-tab="biography">
            <i data-lucide="book-open"></i> Biography
        </button>
        <button class="cd-tab" data-tab="personality">
            <i data-lucide="brain"></i> Personality
        </button>
        <button class="cd-tab" data-tab="background">
            <i data-lucide="map-pin"></i> Background
        </button>
        <button class="cd-tab" data-tab="relationships">
            <i data-lucide="users"></i> Relationships
        </button>
        <button class="cd-tab" data-tab="notes">
            <i data-lucide="sticky-note"></i> Notes
        </button>
    </div>

    <!-- ═══════════════════════════════════ MAIN BODY ════════════════════════════════════════════ -->
    <div class="cd-body">

        <!-- ─────────────── LEFT / MAIN CONTENT ─────────────── -->
        <div class="cd-main">

            <!-- ══════ OVERVIEW TAB ══════ -->
            <div class="cd-tab-panel active" id="tab-overview">

                <!-- Role & Summary -->
                <div class="cd-card">
                    <div class="cd-card-header">
                        <i data-lucide="user-circle-2" class="cd-card-icon"></i>
                        <h3>Role &amp; Summary</h3>
                    </div>
                    <div class="cd-role-summary-body">
                        <div class="cd-role-summary-text">
                            <p>
                                <strong class="cd-name-em">@Model.Name.ToUpper()</strong>
                                @if (!string.IsNullOrWhiteSpace(Model.BackgroundSummary))
                                {
                                    @Model.BackgroundSummary
                                }
                                else if (!string.IsNullOrWhiteSpace(Model.OneLineDescription))
                                {
                                    @($" is {Model.OneLineDescription}")
                                }
                                else
                                {
                                    @($" holds the position of {Model.Role ?? "Character"} in {story?.Title ?? "this story"}.")
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(Model.OneLineDescription) && !string.IsNullOrWhiteSpace(Model.BackgroundSummary))
                            {
                                <blockquote class="cd-quote">
                                    <i data-lucide="quote" class="cd-quote-icon"></i>
                                    "@Model.OneLineDescription"
                                </blockquote>
                            }
                        </div>
                        <div class="cd-role-stats">
                            <div class="cd-stat-item">
                                <span class="cd-stat-label">Status</span>
                                @{
                                    var statusVal = string.IsNullOrWhiteSpace(Model.Status) ? "Active" : Model.Status;
                                    var statusLower = statusVal.ToLower();
                                    var negativeStatuses = new[] { "inactive", "dead", "deceased", "retired", "archived", "dormant", "killed", "eliminated" };
                                    var statusClass = negativeStatuses.Any(s => statusLower.Contains(s)) ? "cd-status-inactive" : "cd-status-active";
                                }
                                <span class="cd-stat-value @statusClass">@statusVal</span>
                            </div>

                            <div class="cd-stat-item">
                                <span class="cd-stat-label">Appears In</span>
                                <span class="cd-stat-value">@chapterCount Chapter@(chapterCount != 1 ? "s" : "")</span>
                            </div>
                            <div class="cd-stat-item">
                                <span class="cd-stat-label">Added On</span>
                                <span class="cd-stat-value">@Model.CreatedAt.ToString("MM/dd/yyyy")</span>
                            </div>
                            <div class="cd-stat-item">
                                <span class="cd-stat-label">Created By</span>
                                <span class="cd-stat-value">@createdByName</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Visual & Aesthetic Profile -->
                <div class="cd-card">
                    <div class="cd-card-header">
                        <i data-lucide="palette" class="cd-card-icon"></i>
                        <h3>Visual &amp; Aesthetic Profile</h3>
                    </div>
                    <div class="cd-aesthetic-grid">
                        @if (!string.IsNullOrWhiteSpace(Model.ArcType))
                        {
                            <div class="cd-aesthetic-item">
                                <span class="cd-aes-label">Archetype</span>
                                <span class="cd-aes-value">@Model.ArcType</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Temperament))
                        {
                            <div class="cd-aesthetic-item">
                                <span class="cd-aes-label">Visual Tone</span>
                                <span class="cd-aes-value">@Model.Temperament</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Role))
                        {
                            <div class="cd-aesthetic-item">
                                <span class="cd-aes-label">Conflict Association</span>
                                <span class="cd-aes-value">
                                    @(Model.Role.Contains("Protagonist", StringComparison.OrdinalIgnoreCase) ? "Central Plot Arc" :
                                      Model.Role.Contains("Antagonist", StringComparison.OrdinalIgnoreCase) ? "Main Conflict Arc" :
                                      Model.Role.Contains("Mentor", StringComparison.OrdinalIgnoreCase) ? "Guiding Arc" :
                                      "Supporting Arc")
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ClothingStyle) || !string.IsNullOrWhiteSpace(Model.PreferredColors))
                        {
                            <div class="cd-aesthetic-item">
                                <span class="cd-aes-label">Symbol</span>
                                <span class="cd-aes-value">
                                    @(string.IsNullOrWhiteSpace(Model.ClothingStyle) ? Model.PreferredColors : Model.ClothingStyle)
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Personality Profile (Overview card) -->
                @if (traits.Length > 0 || !string.IsNullOrWhiteSpace(Model.PersonalityOverview) || !string.IsNullOrWhiteSpace(Model.Motivations))
                {
                    <div class="cd-card">
                        <div class="cd-card-header">
                            <i data-lucide="brain" class="cd-card-icon"></i>
                            <h3>Personality Profile</h3>
                        </div>
                        <div class="cd-personality-grid">
                            <div class="cd-pers-left">
                                @if (traits.Length > 0)
                                {
                                    <div class="cd-pers-section">
                                        <span class="cd-pers-label">Core Traits</span>
                                        <div class="cd-traits-row">
                                            @foreach (var t in traits)
                                            {
                                                <span class="cd-trait-badge">@t</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ValuesBeliefs))
                                {
                                    <div class="cd-pers-section">
                                        <span class="cd-pers-label">Values &amp; Beliefs</span>
                                        <span class="cd-pers-value-bold">@Model.ValuesBeliefs</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.PersonalityOverview))
                                {
                                    <div class="cd-pers-section">
                                        <span class="cd-pers-label">Personality Overview</span>
                                        <p class="cd-pers-text">@Model.PersonalityOverview</p>
                                    </div>
                                }
                            </div>
                            <div class="cd-pers-right">
                                @if (!string.IsNullOrWhiteSpace(Model.Motivations))
                                {
                                    <div class="cd-pers-section">
                                        <span class="cd-pers-label">Motivations</span>
                                        <p class="cd-pers-text">@Model.Motivations</p>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Strengths))
                                {
                                    <div class="cd-pers-section">
                                        <span class="cd-pers-label">Greatest Strength</span>
                                        <p class="cd-pers-text">@Model.Strengths</p>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Fears))
                                {
                                    <div class="cd-pers-section">
                                        <span class="cd-pers-label">Greatest Fear</span>
                                        <p class="cd-pers-text">@Model.Fears</p>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Flaws))
                                {
                                    <div class="cd-pers-section">
                                        <span class="cd-pers-label">Flaws</span>
                                        <p class="cd-pers-text">@Model.Flaws</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Background Snapshot -->
                @{
                    bool hasBackgroundData = !string.IsNullOrWhiteSpace(Model.PlaceOfBirth)
                        || !string.IsNullOrWhiteSpace(Model.Nationality)
                        || !string.IsNullOrWhiteSpace(Model.Languages)
                        || !string.IsNullOrWhiteSpace(Model.FamilyBackground)
                        || !string.IsNullOrWhiteSpace(Model.Education)
                        || !string.IsNullOrWhiteSpace(Model.Upbringing)
                        || !string.IsNullOrWhiteSpace(Model.KeyEvents)
                        || !string.IsNullOrWhiteSpace(Model.Backstory);
                }
                @if (hasBackgroundData)
                {
                    <div class="cd-card">
                        <div class="cd-card-header">
                            <i data-lucide="map" class="cd-card-icon"></i>
                            <h3>Background Snapshot</h3>
                        </div>
                        <div class="cd-bg-snap-row">
                            @if (!string.IsNullOrWhiteSpace(Model.PlaceOfBirth))
                            {
                                <div class="cd-bg-snap-item">
                                    <i data-lucide="map-pin" class="cd-bg-icon"></i>
                                    <span class="cd-bg-label">Place of Birth</span>
                                    <span class="cd-bg-val">@Model.PlaceOfBirth</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Nationality))
                            {
                                <div class="cd-bg-snap-item">
                                    <i data-lucide="globe" class="cd-bg-icon"></i>
                                    <span class="cd-bg-label">Nationality</span>
                                    <span class="cd-bg-val">@Model.Nationality</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Languages))
                            {
                                <div class="cd-bg-snap-item">
                                    <i data-lucide="message-circle" class="cd-bg-icon"></i>
                                    <span class="cd-bg-label">Languages</span>
                                    <span class="cd-bg-val">@Model.Languages</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.FamilyBackground))
                            {
                                <div class="cd-bg-snap-item">
                                    <i data-lucide="home" class="cd-bg-icon"></i>
                                    <span class="cd-bg-label">Family</span>
                                    <span class="cd-bg-val">@Model.FamilyBackground</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Education))
                            {
                                <div class="cd-bg-snap-item">
                                    <i data-lucide="graduation-cap" class="cd-bg-icon"></i>
                                    <span class="cd-bg-label">Education</span>
                                    <span class="cd-bg-val">@Model.Education</span>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Upbringing) || !string.IsNullOrWhiteSpace(Model.KeyEvents) || !string.IsNullOrWhiteSpace(Model.Backstory))
                        {
                            <div class="cd-bg-timeline">
                                @if (!string.IsNullOrWhiteSpace(Model.Upbringing))
                                {
                                    <div class="cd-bg-tl-item">
                                        <span class="cd-bg-tl-label">Childhood</span>
                                        <p class="cd-bg-tl-text">@Model.Upbringing</p>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Education))
                                {
                                    <div class="cd-bg-tl-item">
                                        <span class="cd-bg-tl-label">Education</span>
                                        <p class="cd-bg-tl-text">@Model.Education</p>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.KeyEvents))
                                {
                                    <div class="cd-bg-tl-item">
                                        <span class="cd-bg-tl-label">Turning Point</span>
                                        <p class="cd-bg-tl-text">@Model.KeyEvents</p>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Backstory))
                                {
                                    <div class="cd-bg-tl-item">
                                        <span class="cd-bg-tl-label">Current Stage</span>
                                        <p class="cd-bg-tl-text">@Model.Backstory</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Bottom Row: Recent Appearances + Author's Note + Tags -->
                <div class="cd-bottom-row">

                    <!-- Recent Appearances -->
                    @if (recentChapters.Count > 0)
                    {
                        <div class="cd-card cd-card-appearances">
                            <div class="cd-card-header-inline">
                                <h4>Recent Appearances</h4>
                                <a href="@Url.Action("Index","Chapters", new { storyId = Model.StoryId })" class="cd-view-all">View All</a>
                            </div>
                            <div class="cd-appearances-list">
                                @foreach (var ch in recentChapters)
                                {
                                    var daysAgo = (DateTime.UtcNow - ch.UpdatedAt).Days;
                                    var label = daysAgo == 0 ? "Today" : daysAgo == 1 ? "1 day ago" : $"{daysAgo} days ago";
                                    <div class="cd-appearance-item">
                                        <i data-lucide="book-open" class="cd-app-icon"></i>
                                        <span class="cd-app-title">@ch.Title</span>
                                        <span class="cd-app-meta @(daysAgo == 0 ? "cd-app-current" : "")">@label</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Author's Note -->
                    @if (!string.IsNullOrWhiteSpace(Model.AuthorNotes))
                    {
                        <div class="cd-card cd-card-author-note">
                            <div class="cd-card-header-inline">
                                <h4>Author's Note</h4>
                                <a href="@Url.Action("Edit","Characters", new { id = Model.Id })" class="cd-view-all">Edit</a>
                            </div>
                            <div class="cd-author-note-body">
                                <i data-lucide="feather" class="cd-feather-icon"></i>
                                <p>@Model.AuthorNotes</p>
                            </div>
                        </div>
                    }

                    <!-- Tags -->
                    @if (tags.Length > 0)
                    {
                        <div class="cd-card cd-card-tags">
                            <div class="cd-card-header-inline">
                                <h4>Tags</h4>
                                <a href="@Url.Action("Edit","Characters", new { id = Model.Id })" class="cd-view-all">Edit</a>
                            </div>
                            <div class="cd-tags-wrap">
                                @foreach (var tag in tags)
                                {
                                    <span class="cd-tag-chip">@tag</span>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div><!-- /overview tab -->

            <!-- ══════ BIOGRAPHY TAB ══════ -->
            <div class="cd-tab-panel" id="tab-biography">
                <div class="cd-card">
                    <div class="cd-card-header">
                        <i data-lucide="book-open" class="cd-card-icon"></i>
                        <h3>Biography</h3>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Backstory))
                    {
                        <p class="cd-bio-text">@Model.Backstory</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.BackgroundSummary))
                    {
                        <p class="cd-bio-text">@Model.BackgroundSummary</p>
                    }
                    @if (string.IsNullOrWhiteSpace(Model.Backstory) && string.IsNullOrWhiteSpace(Model.BackgroundSummary))
                    {
                        <p class="cd-empty-msg">No biography has been written yet. <a href="@Url.Action("Edit","Characters", new { id = Model.Id })">Add one →</a></p>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.AppearanceNotes))
                {
                    <div class="cd-card">
                        <div class="cd-card-header">
                            <i data-lucide="eye" class="cd-card-icon"></i>
                            <h3>Appearance Notes</h3>
                        </div>
                        <p class="cd-bio-text">@Model.AppearanceNotes</p>
                    </div>
                }
            </div>

            <!-- ══════ PERSONALITY TAB ══════ -->
            <div class="cd-tab-panel" id="tab-personality">
                <div class="cd-card">
                    <div class="cd-card-header">
                        <i data-lucide="brain" class="cd-card-icon"></i>
                        <h3>Personality Deep Dive</h3>
                    </div>
                    <div class="cd-personality-grid">
                        <div class="cd-pers-left">
                            @if (traits.Length > 0)
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Core Traits</span>
                                    <div class="cd-traits-row">
                                        @foreach (var t in traits)
                                        { <span class="cd-trait-badge">@t</span> }
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.ValuesBeliefs))
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Values &amp; Beliefs</span>
                                    <span class="cd-pers-value-bold">@Model.ValuesBeliefs</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PersonalityOverview))
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Personality Overview</span>
                                    <p class="cd-pers-text">@Model.PersonalityOverview</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Desires))
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Desires</span>
                                    <p class="cd-pers-text">@Model.Desires</p>
                                </div>
                            }
                        </div>
                        <div class="cd-pers-right">
                            @if (!string.IsNullOrWhiteSpace(Model.Motivations))
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Motivations</span>
                                    <p class="cd-pers-text">@Model.Motivations</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Strengths))
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Strengths</span>
                                    <p class="cd-pers-text">@Model.Strengths</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Flaws))
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Flaws</span>
                                    <p class="cd-pers-text">@Model.Flaws</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Fears))
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Greatest Fear</span>
                                    <p class="cd-pers-text">@Model.Fears</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Temperament))
                            {
                                <div class="cd-pers-section">
                                    <span class="cd-pers-label">Temperament</span>
                                    <p class="cd-pers-text">@Model.Temperament</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ══════ BACKGROUND TAB ══════ -->
            <div class="cd-tab-panel" id="tab-background">
                <div class="cd-card">
                    <div class="cd-card-header">
                        <i data-lucide="map-pin" class="cd-card-icon"></i>
                        <h3>Background Details</h3>
                    </div>
                    <div class="cd-detail-grid">
                        @if (!string.IsNullOrWhiteSpace(Model.PlaceOfBirth))
                        {
                            <div class="cd-detail-item">
                                <span class="cd-detail-label">Place of Birth</span>
                                <span class="cd-detail-val">@Model.PlaceOfBirth</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DateOfBirth))
                        {
                            <div class="cd-detail-item">
                                <span class="cd-detail-label">Date of Birth</span>
                                <span class="cd-detail-val">@Model.DateOfBirth</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Nationality))
                        {
                            <div class="cd-detail-item">
                                <span class="cd-detail-label">Nationality</span>
                                <span class="cd-detail-val">@Model.Nationality</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Languages))
                        {
                            <div class="cd-detail-item">
                                <span class="cd-detail-label">Languages</span>
                                <span class="cd-detail-val">@Model.Languages</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.FamilyBackground))
                        {
                            <div class="cd-detail-item">
                                <span class="cd-detail-label">Family Background</span>
                                <span class="cd-detail-val">@Model.FamilyBackground</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Education))
                        {
                            <div class="cd-detail-item">
                                <span class="cd-detail-label">Education</span>
                                <span class="cd-detail-val">@Model.Education</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SocioeconomicStatus))
                        {
                            <div class="cd-detail-item">
                                <span class="cd-detail-label">Socioeconomic Status</span>
                                <span class="cd-detail-val">@Model.SocioeconomicStatus</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentResidence))
                        {
                            <div class="cd-detail-item">
                                <span class="cd-detail-label">Current Residence</span>
                                <span class="cd-detail-val">@Model.CurrentResidence</span>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Upbringing))
                    {
                        <div class="cd-pers-section mt-4">
                            <span class="cd-pers-label">Upbringing</span>
                            <p class="cd-pers-text">@Model.Upbringing</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.KeyEvents))
                    {
                        <div class="cd-pers-section mt-3">
                            <span class="cd-pers-label">Key Events / Turning Points</span>
                            <p class="cd-pers-text">@Model.KeyEvents</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Backstory))
                    {
                        <div class="cd-pers-section mt-3">
                            <span class="cd-pers-label">Backstory</span>
                            <p class="cd-pers-text">@Model.Backstory</p>
                        </div>
                    }
                </div>
            </div>

            <!-- ══════ RELATIONSHIPS TAB ══════ -->
            <div class="cd-tab-panel" id="tab-relationships">
                @if (relationships.Count > 0)
                {
                    <div class="cd-card">
                        <div class="cd-card-header">
                            <i data-lucide="users" class="cd-card-icon"></i>
                            <h3>Key Relationships</h3>
                        </div>
                        <div class="cd-rel-list-full">
                            @foreach (var rel in relationships)
                            {
                                string rAvatar = rel.Avatar?.ToString() ?? "";
                                string rName = rel.Name?.ToString() ?? "";
                                string rType = rel.Type?.ToString() ?? "";
                                string rDesc = rel.Description?.ToString() ?? "";
                                string rSent = rel.Sentiment?.ToString() ?? "";
                                string sentClass = GetSentimentClass(rSent);
                                string sentLabel = GetSentimentLabel(rSent);

                                // Try to find matching sibling character
                                var matchChar = siblingChars.FirstOrDefault(c => c.Name.Equals(rName, StringComparison.OrdinalIgnoreCase));

                                <div class="cd-rel-card">
                                    <div class="cd-rel-avatar">
                                        @if (!string.IsNullOrWhiteSpace(rAvatar))
                                        {
                                            <img src="@rAvatar" alt="@rName" />
                                        }
                                        else if (!string.IsNullOrWhiteSpace(matchChar?.AvatarUrl))
                                        {
                                            <img src="@matchChar.AvatarUrl" alt="@rName" />
                                        }
                                        else
                                        {
                                            <div class="cd-rel-initials">@GetInitials(rName)</div>
                                        }
                                    </div>
                                    <div class="cd-rel-info">
                                        <div class="cd-rel-top">
                                            <span class="cd-rel-name">@rName</span>
                                            @if (!string.IsNullOrWhiteSpace(rSent))
                                            {
                                                <span class="cd-rel-sentiment @sentClass">@sentLabel</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(rType))
                                        {
                                            <span class="cd-rel-type">@rType</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(rDesc))
                                        {
                                            <p class="cd-rel-desc">@rDesc</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Allies) || !string.IsNullOrWhiteSpace(Model.Enemies) || !string.IsNullOrWhiteSpace(Model.LoveInterests) || !string.IsNullOrWhiteSpace(Model.Family))
                {
                    <div class="cd-card">
                        <div class="cd-card-header">
                            <i data-lucide="heart" class="cd-card-icon"></i>
                            <h3>Relationship Groups</h3>
                        </div>
                        <div class="cd-rel-groups">
                            @if (!string.IsNullOrWhiteSpace(Model.LoveInterests))
                            {
                                <div class="cd-rel-group"><span class="cd-rg-label">❤️ Love Interests</span><span class="cd-rg-val">@Model.LoveInterests</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Allies))
                            {
                                <div class="cd-rel-group"><span class="cd-rg-label">🤝 Allies</span><span class="cd-rg-val">@Model.Allies</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Enemies))
                            {
                                <div class="cd-rel-group"><span class="cd-rg-label">⚔️ Enemies</span><span class="cd-rg-val">@Model.Enemies</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Family))
                            {
                                <div class="cd-rel-group"><span class="cd-rg-label">🏠 Family</span><span class="cd-rg-val">@Model.Family</span></div>
                            }
                        </div>
                    </div>
                }
                @if (relationships.Count == 0 && string.IsNullOrWhiteSpace(Model.Allies) && string.IsNullOrWhiteSpace(Model.Enemies))
                {
                    <div class="cd-card">
                        <p class="cd-empty-msg">No relationships defined yet. <a href="@Url.Action("Edit","Characters", new { id = Model.Id })">Add some →</a></p>
                    </div>
                }
            </div>

            <!-- ══════ NOTES TAB ══════ -->
            <div class="cd-tab-panel" id="tab-notes">
                <div class="cd-card">
                    <div class="cd-card-header">
                        <i data-lucide="sticky-note" class="cd-card-icon"></i>
                        <h3>Author's Notes</h3>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.AuthorNotes))
                    {
                        <div class="cd-author-note-body">
                            <i data-lucide="feather" class="cd-feather-icon"></i>
                            <p>@Model.AuthorNotes</p>
                        </div>
                    }
                    else
                    {
                        <p class="cd-empty-msg">No notes added yet. <a href="@Url.Action("Edit","Characters", new { id = Model.Id })">Add a note →</a></p>
                    }
                </div>
            </div>

        </div><!-- /cd-main -->

        <!-- ─────────────── RIGHT SIDEBAR ─────────────── -->
        <aside class="cd-sidebar">

            <!-- Character Photo Card -->
            <div class="cd-photo-card">
                @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                {
                    <div class="cd-photo-wrap">
                        <img src="@Model.AvatarUrl" alt="@Model.Name" class="cd-photo-img" />
                        <a href="@Url.Action("Edit","Characters", new { id = Model.Id })" class="cd-photo-edit-btn" title="Edit">
                            <i data-lucide="edit-3"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="cd-photo-placeholder">
                        <div class="cd-photo-initials">@GetInitials(Model.Name)</div>
                        <a href="@Url.Action("Edit","Characters", new { id = Model.Id })" class="cd-photo-edit-btn" title="Edit">
                            <i data-lucide="edit-3"></i>
                        </a>
                    </div>
                }
                <div class="cd-photo-role-tag">
                    <i data-lucide="feather"></i> @(string.IsNullOrWhiteSpace(Model.Role) ? "Character" : Model.Role)
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.OneLineDescription))
                {
                    <blockquote class="cd-photo-quote">
                        "@Model.OneLineDescription"
                    </blockquote>
                }
            </div>

            <!-- Quick Info -->
            <div class="cd-sidebar-card">
                <div class="cd-sidebar-card-header">
                    <i data-lucide="info" class="cd-sc-icon"></i>
                    <h4>Quick Info</h4>
                </div>
                <div class="cd-quick-info-list">
                    <div class="cd-qi-row">
                        <i data-lucide="user" class="cd-qi-icon"></i>
                        <span class="cd-qi-label">Full Name</span>
                        <span class="cd-qi-val">@Model.Name</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Nicknames))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="at-sign" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Nickname</span>
                            <span class="cd-qi-val">@Model.Nicknames</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Age))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="calendar" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Age</span>
                            <span class="cd-qi-val">@Model.Age</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Gender))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="users" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Gender</span>
                            <span class="cd-qi-val">@Model.Gender</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Occupation))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="briefcase" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Occupation</span>
                            <span class="cd-qi-val">@Model.Occupation</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Alignment))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="compass" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Alignment</span>
                            <span class="cd-qi-val cd-qi-val--teal">@Model.Alignment</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Height))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="ruler" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Height</span>
                            <span class="cd-qi-val">@Model.Height</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.EyeColor))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="eye" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Eye Color</span>
                            <span class="cd-qi-val">@Model.EyeColor</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.HairColor))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="scissors" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Hair</span>
                            <span class="cd-qi-val">@(Model.HairColor + (string.IsNullOrWhiteSpace(Model.HairStyle) ? "" : $", {Model.HairStyle}"))</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Nationality))
                    {
                        <div class="cd-qi-row">
                            <i data-lucide="globe" class="cd-qi-icon"></i>
                            <span class="cd-qi-label">Nationality</span>
                            <span class="cd-qi-val">@Model.Nationality</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Key Relationships Sidebar -->
            @if (relationships.Count > 0)
            {
                <div class="cd-sidebar-card">
                    <div class="cd-sidebar-card-header">
                        <i data-lucide="users" class="cd-sc-icon"></i>
                        <h4>Key Relationships</h4>
                        <a href="#" onclick="document.querySelector('[data-tab=relationships]').click(); return false;" class="cd-view-all">View All</a>
                    </div>
                    <div class="cd-rel-sidebar-list">
                        @foreach (var rel in relationships.Take(3))
                        {
                            string rName = rel.Name?.ToString() ?? "";
                            string rType = rel.Type?.ToString() ?? "";
                            string rDesc = rel.Description?.ToString() ?? "";
                            string rAvatar = rel.Avatar?.ToString() ?? "";
                            string rSent = rel.Sentiment?.ToString() ?? "";
                            string sentClass = GetSentimentClass(rSent);
                            string sentLabel = GetSentimentLabel(rSent);

                            var matchChar = siblingChars.FirstOrDefault(c => c.Name.Equals(rName, StringComparison.OrdinalIgnoreCase));

                            <div class="cd-rel-sb-item">
                                <div class="cd-rel-sb-avatar">
                                    @if (!string.IsNullOrWhiteSpace(rAvatar))
                                    {
                                        <img src="@rAvatar" alt="@rName" />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(matchChar?.AvatarUrl))
                                    {
                                        <img src="@matchChar.AvatarUrl" alt="@rName" />
                                    }
                                    else
                                    {
                                        <div class="cd-rel-sb-initials">@GetInitials(rName)</div>
                                    }
                                </div>
                                <div class="cd-rel-sb-info">
                                    <div class="cd-rel-sb-top">
                                        <span class="cd-rel-sb-name">@rName</span>
                                        @if (!string.IsNullOrWhiteSpace(rSent))
                                        {
                                            <span class="cd-rel-sentiment @sentClass">@sentLabel</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(rType))
                                    {
                                        <span class="cd-rel-sb-type">@rType</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(rDesc))
                                    {
                                        <p class="cd-rel-sb-desc">@rDesc</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

        </aside>

    </div><!-- /cd-body -->
</div><!-- /cd-wrapper -->

<style>
/* ═══════════════════════════════════════════════════════════════
   CHARACTER DETAIL PAGE — FULL STYLESHEET
   Matches the first reference image layout exactly
═══════════════════════════════════════════════════════════════ */

/* Tokens */
:root {
    --cd-teal:       #0d9488;
    --cd-teal-light: #ccfbf1;
    --cd-teal-mid:   #5eead4;
    --cd-teal-dark:  #0f766e;
    --cd-gold:       #f59e0b;
    --cd-parch:      #fdf8f0;
    --cd-border:     #e5e7eb;
    --cd-text:       #1e293b;
    --cd-muted:      #64748b;
    --cd-red:        #ef4444;
    --cd-green:      #22c55e;
    --cd-card-bg:    #ffffff;
    --cd-sidebar-bg: #ffffff;
    --cd-radius:     14px;
    --cd-shadow:     0 1px 4px rgba(0,0,0,.07), 0 4px 16px rgba(0,0,0,.05);
}

/* Wrapper */
.cd-wrapper {
    width: 100%;
    font-family: 'Inter', 'Outfit', sans-serif;
    color: var(--cd-text);
}

/* ── TOP BAR ── */
.cd-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    flex-wrap: wrap;
    gap: 8px;
}
.cd-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--cd-muted);
}
.cd-breadcrumb a {
    color: var(--cd-muted);
    text-decoration: none;
    transition: color .2s;
}
.cd-breadcrumb a:hover { color: var(--cd-teal); }
.cd-chevron { width: 14px; height: 14px; }
.cd-topbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}
.cd-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 1px solid var(--cd-border);
    border-radius: 8px;
    background: #fff;
    font-size: 13px;
    font-weight: 500;
    color: var(--cd-text);
    cursor: pointer;
    transition: border-color .2s, background .2s;
}
.cd-btn-ghost:hover { border-color: var(--cd-teal); background: var(--cd-teal-light); }
.cd-btn-ghost i, .cd-btn-primary i { width: 15px; height: 15px; }
.cd-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 18px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--cd-teal) 0%, var(--cd-teal-dark) 100%);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity .2s, transform .15s;
    box-shadow: 0 2px 8px rgba(13,148,136,.25);
}
.cd-btn-primary:hover { opacity: .92; color: #fff; transform: translateY(-1px); }
.cd-btn-icon {
    width: 34px; height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cd-border);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    transition: border-color .2s;
}
.cd-btn-icon:hover { border-color: var(--cd-teal); }
.cd-btn-icon i { width: 16px; height: 16px; }

/* ── HERO ── */
.cd-hero { margin-bottom: 4px; }
.cd-hero-name {
    font-size: 28px;
    font-weight: 800;
    color: var(--cd-text);
    margin: 0 0 4px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Georgia', serif;
    letter-spacing: -.3px;
}
.cd-star-icon { width: 20px; height: 20px; color: var(--cd-gold); fill: var(--cd-gold); }
.cd-hero-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
}
.cd-role-badge {
    font-weight: 600;
    color: var(--cd-teal);
}
.cd-meta-dot { color: var(--cd-muted); }
.cd-story-link {
    color: var(--cd-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
}
.cd-story-link:hover { color: var(--cd-teal); }

/* ── TABS ── */
.cd-tabs-bar {
    display: flex;
    align-items: center;
    gap: 2px;
    border-bottom: 2px solid var(--cd-border);
    margin-bottom: 20px;
    flex-wrap: wrap;
}
.cd-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border: none;
    background: transparent;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--cd-muted);
    cursor: pointer;
    border-bottom: 2.5px solid transparent;
    margin-bottom: -2px;
    transition: color .2s, border-color .2s;
    border-radius: 4px 4px 0 0;
}
.cd-tab i { width: 14px; height: 14px; }
.cd-tab:hover { color: var(--cd-teal); }
.cd-tab.active {
    color: var(--cd-teal);
    border-bottom-color: var(--cd-teal);
    font-weight: 600;
}

/* ── BODY LAYOUT ── */
.cd-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 20px;
    align-items: start;
}
@@media (max-width: 900px) {
    .cd-body { grid-template-columns: 1fr; }
}

/* ── TAB PANELS ── */
.cd-tab-panel { display: none; }
.cd-tab-panel.active { display: block; }

/* ── CARDS ── */
.cd-card {
    background: var(--cd-card-bg);
    border: 1px solid var(--cd-border);
    border-radius: var(--cd-radius);
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: var(--cd-shadow);
}
.cd-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
}
.cd-card-header h3 {
    font-size: 15px;
    font-weight: 700;
    color: var(--cd-text);
    margin: 0;
}
.cd-card-icon { width: 18px; height: 18px; color: var(--cd-teal); }

.cd-card-header-inline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}
.cd-card-header-inline h4 {
    font-size: 14px;
    font-weight: 700;
    margin: 0;
    color: var(--cd-text);
}
.cd-view-all {
    font-size: 12px;
    color: var(--cd-teal);
    text-decoration: none;
    font-weight: 500;
}
.cd-view-all:hover { text-decoration: underline; }

/* Role & Summary */
.cd-role-summary-body {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: start;
}
@@media (max-width: 640px) {
    .cd-role-summary-body { grid-template-columns: 1fr; }
}
.cd-role-summary-text p {
    font-size: 13.5px;
    line-height: 1.7;
    color: #374151;
    margin: 0 0 10px;
}
.cd-name-em {
    font-weight: 700;
    color: var(--cd-teal-dark);
    letter-spacing: .3px;
}
.cd-quote {
    border-left: 3px solid var(--cd-teal-mid);
    padding: 10px 14px;
    margin: 10px 0 0;
    background: var(--cd-parch);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    font-size: 13px;
    color: var(--cd-muted);
    display: flex;
    align-items: flex-start;
    gap: 8px;
}
.cd-quote-icon { width: 16px; height: 16px; color: var(--cd-teal-mid); flex-shrink: 0; margin-top: 2px; }
.cd-role-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 20px;
    min-width: 260px;
}
@@media (max-width: 640px) {
    .cd-role-stats { grid-template-columns: repeat(4, 1fr); min-width: unset; }
}
.cd-stat-item { display: flex; flex-direction: column; gap: 3px; }
.cd-stat-label { font-size: 11.5px; color: var(--cd-muted); text-transform: uppercase; letter-spacing: .5px; font-weight: 500; }
.cd-stat-value { font-size: 13.5px; font-weight: 700; color: var(--cd-text); }
.cd-status-active { color: var(--cd-green) !important; }
