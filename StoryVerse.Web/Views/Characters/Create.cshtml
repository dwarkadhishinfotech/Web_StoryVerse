                avatar = characterRelationships[index].avatar;
            }

            var item = {
                id: (index >= 0 && characterRelationships[index]) ? characterRelationships[index].id : 'rel-' + Date.now(),
                name: name,
                subtitle: subtitle,
                role: role,
                avatar: avatar,
                relationship: relType,
                dynamicsType: dynType,
                dynamicsText: desc
            };

            if (index >= 0 && characterRelationships[index]) {
