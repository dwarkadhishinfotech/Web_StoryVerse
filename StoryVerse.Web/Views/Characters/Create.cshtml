                                                </div>
                                                <div class="theme-dropdown-menu" style="max-height: 200px; overflow-y: auto;">
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Brave')">
                                                        <div class="option-title">Brave</div>
                                                        <div class="option-desc">Ready to face danger or pain; courageous.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Loyal')">
                                                        <div class="option-title">Loyal</div>
                                                        <div class="option-desc">Giving firm and constant support or allegiance.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Intelligent')">
                                                        <div class="option-title">Intelligent</div>
                                                        <div class="option-desc">Having or showing intelligence and quick understanding.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Stubborn')">
                                                        <div class="option-title">Stubborn</div>
                                                        <div class="option-desc">Fixed in opinion, difficult to move or persuade.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Protective')">
                                                        <div class="option-title">Protective</div>
                                                        <div class="option-desc">Fiercely caring for friends and loved ones.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Compassionate')">
                                                        <div class="option-title">Compassionate</div>
                                                        <div class="option-desc">Feeling or showing sympathy and concern for others.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Cunning')">
                                                        <div class="option-title">Cunning</div>
                                                        <div class="option-desc">Skillful in achieving ends by deceit or evasion.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Ambitious')">
                                                        <div class="option-title">Ambitious</div>
                                                        <div class="option-desc">Strong desire and determination to succeed.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Empathetic')">
                                                        <div class="option-title">Empathetic</div>
                                                        <div class="option-desc">Ability to understand and share feelings.</div>
                                                    </div>
                                                    <div class="theme-dropdown-option" onclick="addTraitFromDropdown('Resourceful')">
                                                        <div class="option-title">Resourceful</div>
                                                        <div class="option-desc">Clever ways to overcome difficulties.</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Add Custom Trait Section -->
                                    <div>
                                        <label class="form-label-custom mb-1" style="font-size: 0.76rem;">Add custom trait</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" id="customTraitInput" class="form-control form-control-custom" placeholder="e.g., Compassionate" maxlength="30" onkeypress="if(event.key === 'Enter'){ event.preventDefault(); addCustomTrait(); }" />
                                            <button type="button" class="btn btn-outline-teal" style="border: 1px solid #13A8A6; color: #13A8A6; font-weight: 600; background: #F0FDFA;" onclick="addCustomTrait()">Add</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 2: Personality Overview -->
                            <div class="col-md-4">
                                <div class="personality-card">
                                    <div>
                                        <label asp-for="PersonalityOverview" class="form-label-custom">
                                            Personality Overview <span class="text-danger">*</span>
                                        </label>
                                        <p class="personality-card-subtitle mb-2">Describe your character's general personality.</p>
                                        <textarea asp-for="PersonalityOverview" id="PersonalityOverviewInput" class="form-control form-control-custom" rows="5"
                                                  placeholder="Determined and strong-willed, with a deep sense of justice. They value honor and loyalty above everything else. Though they appear confident, they struggle with self-doubt and fear of failure."
                                                  maxlength="500" oninput="updateCharCounter('PersonalityOverviewInput', 'overview-counter'); checkPersonalityChecklist();"></textarea>
                                    </div>
                                    <div id="overview-counter" class="input-char-counter text-end mt-1">0/500</div>
                                </div>
                            </div>

                            <!-- Card 3: Values & Beliefs -->
                            <div class="col-md-4">
                                <div class="personality-card">
                                    <div>
                                        <label class="form-label-custom">Values & Beliefs</label>
                                        <p class="personality-card-subtitle mb-2">What does your character believe in?</p>
                                        
                                        <div class="values-checkbox-grid">
                                            <label class="custom-check-item">
                                                <input type="checkbox" class="custom-check-input value-checkbox" value="Honesty" checked onchange="updateValuesBeliefs()" />
                                                <span>Honesty</span>
                                            </label>
                                            <label class="custom-check-item">
                                                <input type="checkbox" class="custom-check-input value-checkbox" value="Loyalty" checked onchange="updateValuesBeliefs()" />
                                                <span>Loyalty</span>
                                            </label>
                                            <label class="custom-check-item">
                                                <input type="checkbox" class="custom-check-input value-checkbox" value="Freedom" onchange="updateValuesBeliefs()" />
                                                <span>Freedom</span>
                                            </label>
                                            <label class="custom-check-item">
                                                <input type="checkbox" class="custom-check-input value-checkbox" value="Justice" checked onchange="updateValuesBeliefs()" />
                                                <span>Justice</span>
                                            </label>
                                            <label class="custom-check-item">
                                                <input type="checkbox" class="custom-check-input value-checkbox" value="Power" onchange="updateValuesBeliefs()" />
                                                <span>Power</span>
                                            </label>
                                            <label class="custom-check-item">
                                                <input type="checkbox" class="custom-check-input value-checkbox" value="Love" checked onchange="updateValuesBeliefs()" />
                                                <span>Love</span>
                                            </label>
                                            <label class="custom-check-item">
                                                <input type="checkbox" class="custom-check-input value-checkbox" value="Family" onchange="updateValuesBeliefs()" />
                                                <span>Family</span>
                                            </label>
                                            <label class="custom-check-item">
                                                <input type="checkbox" class="custom-check-input value-checkbox" id="chk-other-value" value="Other" onchange="toggleOtherValueInput(); updateValuesBeliefs();" />
                                                <span>Other</span>
                                            </label>
                                        </div>

                                        <div id="otherValueInputWrapper" class="mt-2" style="display: none;">
                                            <input type="text" id="otherValueInput" class="form-control form-control-custom form-control-sm" placeholder="Type custom value..." maxlength="50" oninput="updateValuesBeliefs()" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 2: Card 4 (Strengths), Card 5 (Motivations), Card 6 (Temperament) -->
                            
                            <!-- Card 4: Strengths (Optional) -->
                            <div class="col-md-4">
                                <div class="personality-card">
                                    <div>
                                        <label asp-for="Strengths" class="form-label-custom">Strengths <span class="text-muted fw-normal">(Optional)</span></label>
                                        <p class="personality-card-subtitle mb-2">What is your character good at?</p>
                                        <textarea asp-for="Strengths" id="StrengthsInput" class="form-control form-control-custom" rows="4"
                                                  placeholder="Strategic thinking, swordsmanship, inspiring others, solving complex problems."
                                                  maxlength="300" oninput="updateCharCounter('StrengthsInput', 'strengths-counter'); checkPersonalityChecklist();"></textarea>
                                    </div>
                                    <div id="strengths-counter" class="input-char-counter text-end mt-1">0/300</div>
                                </div>
                            </div>

                            <!-- Card 5: Motivations -->
                            <div class="col-md-4">
                                <div class="personality-card">
                                    <div>
                                        <label asp-for="Motivations" class="form-label-custom">
                                            Motivations <span class="text-danger">*</span>
                                        </label>
                                        <p class="personality-card-subtitle mb-2">What drives your character?</p>
                                        <textarea asp-for="Motivations" id="MotivationsInput" class="form-control form-control-custom" rows="4"
                                                  placeholder="To protect their kingdom and loved ones, and to prove their worth beyond their family name."
                                                  maxlength="300" oninput="updateCharCounter('MotivationsInput', 'motivations-counter'); checkPersonalityChecklist();"></textarea>
                                    </div>
                                    <div id="motivations-counter" class="input-char-counter text-end mt-1">0/300</div>
                                </div>
                            </div>

                            <!-- Card 6: Temperament -->
                            <div class="col-md-4">
                                <div class="personality-card">
                                    <div>
                                        <label class="form-label-custom">Temperament</label>
                                        <p class="personality-card-subtitle mb-2">How does your character usually react in different situations?</p>
                                        
                                        <div class="theme-dropdown-wrapper" id="dd-temperament-wrapper">
                                            <div class="theme-dropdown-trigger" onclick="toggleDropdown('dd-temperament-wrapper')">
                                                <span id="dd-temperament-trigger-text">Choleric (Leader)</span>
                                                <i data-lucide="chevron-down" style="width: 16px; height: 16px; color: #64748B;"></i>
                                            </div>
                                            <div class="theme-dropdown-menu">
                                                <div class="theme-dropdown-option active-option" onclick="selectTemperament('Choleric (Leader)', 'Choleric (Leader)', 'Natural leaders, goal-oriented, determined, and assertive.')">
                                                    <div class="option-title">Choleric (Leader)</div>
                                                    <div class="option-desc">Natural leaders, goal-oriented, determined, and assertive.</div>
                                                </div>
                                                <div class="theme-dropdown-option" onclick="selectTemperament('Sanguine (Enthusiast)', 'Sanguine (Enthusiast)', 'Lively, optimistic, buoyant, carefree, and social.')">
                                                    <div class="option-title">Sanguine (Enthusiast)</div>
                                                    <div class="option-desc">Lively, optimistic, buoyant, carefree, and social.</div>
                                                </div>
                                                <div class="theme-dropdown-option" onclick="selectTemperament('Phlegmatic (Peacemaker)', 'Phlegmatic (Peacemaker)', 'Calm, patient, easygoing, dependable, and passive.')">
                                                    <div class="option-title">Phlegmatic (Peacemaker)</div>
                                                    <div class="option-desc">Calm, patient, easygoing, dependable, and passive.</div>
                                                </div>
                                                <div class="theme-dropdown-option" onclick="selectTemperament('Melancholic (Thinker)', 'Melancholic (Thinker)', 'Analytical, detail-oriented, thoughtful, reserved, and sensitive.')">
                                                    <div class="option-title">Melancholic (Thinker)</div>
                                                    <div class="option-desc">Analytical, detail-oriented, thoughtful, reserved, and sensitive.</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Temperament description box below dropdown -->
                                        <div id="temperament-desc-box" class="temperament-desc-box mt-2">
                                            Natural leaders, goal-oriented, determined, and assertive.
                                        </div>

                                        <a href="https://en.wikipedia.org/wiki/Four_temperaments" target="_blank" rel="noopener noreferrer" class="temperament-learn-link mt-2">
                                            Learn more about temperaments <i data-lucide="external-link" style="width: 13px; height: 13px;"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 3: Card 7 (Flaws), Card 8 (Greatest Fear) -->
                            
                            <!-- Card 7: Flaws (Optional) -->
                            <div class="col-md-4">
                                <div class="personality-card">
                                    <div>
                                        <label asp-for="Flaws" class="form-label-custom">Flaws <span class="text-muted fw-normal">(Optional)</span></label>
                                        <p class="personality-card-subtitle mb-2">No one is perfect. What are their weaknesses?</p>
                                        <textarea asp-for="Flaws" id="FlawsInput" class="form-control form-control-custom" rows="4"
                                                  placeholder="Overthinks, difficulty trusting others, quick to anger."
                                                  maxlength="300" oninput="updateCharCounter('FlawsInput', 'flaws-counter'); checkPersonalityChecklist();"></textarea>
                                    </div>
                                    <div id="flaws-counter" class="input-char-counter text-end mt-1">0/300</div>
                                </div>
                            </div>

                            <!-- Card 8: Greatest Fear (Optional) -->
                            <div class="col-md-4">
                                <div class="personality-card">
                                    <div>
                                        <label asp-for="Fears" class="form-label-custom">Greatest Fear <span class="text-muted fw-normal">(Optional)</span></label>
                                        <p class="personality-card-subtitle mb-2">What is their biggest fear?</p>
                                        <textarea asp-for="Fears" id="FearsInput" class="form-control form-control-custom" rows="4"
                                                  placeholder="Losing the people they care about or becoming the very thing they fight against."
                                                  maxlength="300" oninput="updateCharCounter('FearsInput', 'fears-counter'); checkPersonalityChecklist();"></textarea>
                                    </div>
                                    <div id="fears-counter" class="input-char-counter text-end mt-1">0/300</div>
                                </div>
                            </div>
                        </div>

                        <!-- Writing Tip Box spanning full width below grid -->
                        <div class="writing-tip-box mt-4 p-3 rounded-3 d-flex align-items-center gap-3" style="background-color: #F0FDFA; border: 1px solid #CCFBF1;">
                            <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 36px; height: 36px; background-color: #CCFBF1; color: #0D9488;">
                                <i data-lucide="lightbulb" style="width: 20px; height: 20px;"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-slate-800" style="font-size: 0.85rem; color: #0F766E;">Writing Tip</h6>
                                <p class="mb-0 text-slate-600" style="font-size: 0.8rem; line-height: 1.35; color: #115E59;">
                                    Strong personalities create compelling stories. Show their traits through actions, decisions, and reactions.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 4: Background -->
                    <div id="step-pane-4" class="step-pane d-none">
                        <!-- Hidden inputs for model binding -->
                        <input type="hidden" asp-for="PlaceOfBirth" id="PlaceOfBirth" />
                        <input type="hidden" asp-for="Nationality" id="Nationality" />
                        <input type="hidden" asp-for="SocioeconomicStatus" id="SocioeconomicStatus" />
                        <input type="hidden" asp-for="CurrentResidence" id="CurrentResidence" />
                        <input type="hidden" asp-for="BackgroundDocumentUrl" id="BackgroundDocumentUrl" />

                        <div class="form-section-header">
                            <div class="form-section-title">
                                <div class="section-icon-badge">
                                    <i data-lucide="landmark" style="width: 18px; height: 18px;"></i>
                                </div>
                                Background
                            </div>
                            <span class="required-indicator">* Required fields</span>
                        </div>
                        <p class="form-section-subtitle">Build their past. The events, places, and people that shaped who they are today.</p>

                        <!-- Form Grid Layout -->
                        <!-- Row 1: Place of Birth *, Date of Birth / Age, Nationality -->
                        <div class="row g-3 mb-3">
                            <!-- Field 1: Place of Birth * -->
                            <div class="col-md-4">
                                <label class="form-label-custom">
                                    Place of Birth <span class="text-danger">*</span>
                                </label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">Select from World or type custom location</p>
                                
                                <div class="theme-dropdown-wrapper" id="dd-pob-wrapper">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-slate-400 rounded-start-2" style="border-color: #CBD5E1;">
                                            <i data-lucide="map-pin" style="width: 16px; height: 16px; color: #64748B;"></i>
                                        </span>
                                        <input type="text" id="PlaceOfBirthInput" class="form-control form-control-custom border-start-0 ps-0" 
                                               placeholder="Select or type a location" oninput="syncPlaceOfBirth(this.value); checkBackgroundChecklist();" 
                                               onclick="toggleDropdown('dd-pob-wrapper')" />
                                        <button class="btn btn-outline-secondary border border-start-0 bg-white" type="button" onclick="toggleDropdown('dd-pob-wrapper')">
                                            <i data-lucide="chevron-down" style="width: 16px; height: 16px; color: #64748B;"></i>
                                        </button>
                                    </div>
                                    <div class="theme-dropdown-menu" id="dd-pob-menu" style="max-height: 220px; overflow-y: auto;">
                                        @{
                                            var worldLocs = ViewBag.WorldLocations as List<StoryVerse.Core.Entities.Location> ?? new List<StoryVerse.Core.Entities.Location>();
                                        }
                                        @if (worldLocs.Any())
                                        {
                                            <div class="dropdown-header small text-uppercase text-teal-600 fw-bold px-3 py-1 bg-slate-50">World Locations</div>
                                            @foreach (var loc in worldLocs)
                                            {
                                                <div class="theme-dropdown-option" onclick="selectLocationOption('PlaceOfBirthInput', 'PlaceOfBirth', '@loc.Name', 'dd-pob-wrapper')">
                                                    <div class="option-title"><i data-lucide="globe" style="width:13px; height:13px;" class="me-1 text-teal-600"></i>@loc.Name</div>
                                                    <div class="option-desc">World location in @(story?.Title ?? "World")</div>
                                                </div>
                                            }
                                            <div class="dropdown-divider my-1"></div>
                                        }
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('PlaceOfBirthInput', 'PlaceOfBirth', 'High Citadel of Arcanis', 'dd-pob-wrapper')">
                                            <div class="option-title">High Citadel of Arcanis</div>
                                            <div class="option-desc">Majestic mountain spire & royal seat of magic.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('PlaceOfBirthInput', 'PlaceOfBirth', 'Oakhaven Village', 'dd-pob-wrapper')">
                                            <div class="option-title">Oakhaven Village</div>
                                            <div class="option-desc">Peaceful agrarian woodland settlement.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('PlaceOfBirthInput', 'PlaceOfBirth', 'Port Marinus Harbor', 'dd-pob-wrapper')">
                                            <div class="option-title">Port Marinus Harbor</div>
                                            <div class="option-desc">Bustling maritime trade hub and sea fortress.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('PlaceOfBirthInput', 'PlaceOfBirth', 'Ironhold Mines', 'dd-pob-wrapper')">
                                            <div class="option-title">Ironhold Mines</div>
                                            <div class="option-desc">Subterranean industrial mountain citadel.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('PlaceOfBirthInput', 'PlaceOfBirth', 'Sunstone Metropolis', 'dd-pob-wrapper')">
                                            <div class="option-title">Sunstone Metropolis</div>
                                            <div class="option-desc">Vast desert empire capital of wealth and trade.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Field 2: Date of Birth / Age -->
                            <div class="col-md-4">
                                <label class="form-label-custom">Date of Birth / Age</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">When were they born?</p>

                                <div class="d-flex align-items-center gap-2">
                                    <div class="input-group flex-grow-1">
                                        <span class="input-group-text bg-white border-end-0 text-slate-400 rounded-start-2" style="border-color: #CBD5E1;">
                                            <i data-lucide="calendar" style="width: 15px; height: 15px; color: #64748B;"></i>
                                        </span>
                                        <input type="text" asp-for="DateOfBirth" id="DateOfBirthInput" class="form-control form-control-custom border-start-0 ps-1" 
                                               placeholder="DD/MM/YYYY" oninput="onDobChange(this.value); checkBackgroundChecklist();" />
                                    </div>
                                    <span class="text-slate-400 fw-medium small">or</span>
                                    <div style="width: 38%;">
                                        <input type="text" id="AgeInputBg" class="form-control form-control-custom" 
                                               placeholder="e.g., 28" oninput="syncAgeFromBg(this.value); updateLivePreview(); checkBackgroundChecklist();" />
                                    </div>
                                </div>
                            </div>

                            <!-- Field 3: Nationality -->
                            <div class="col-md-4">
                                <label class="form-label-custom">Nationality</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">Select from World or type custom nationality</p>

                                <div class="theme-dropdown-wrapper" id="dd-nationality-wrapper">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-slate-400 rounded-start-2" style="border-color: #CBD5E1;">
                                            <i data-lucide="globe" style="width: 16px; height: 16px; color: #64748B;"></i>
                                        </span>
                                        <input type="text" id="NationalityInput" class="form-control form-control-custom border-start-0 ps-0" 
                                               placeholder="Select or type nationality" oninput="syncNationality(this.value); checkBackgroundChecklist();" 
                                               onclick="toggleDropdown('dd-nationality-wrapper')" />
                                        <button class="btn btn-outline-secondary border border-start-0 bg-white" type="button" onclick="toggleDropdown('dd-nationality-wrapper')">
                                            <i data-lucide="chevron-down" style="width: 16px; height: 16px; color: #64748B;"></i>
                                        </button>
                                    </div>
                                    <div class="theme-dropdown-menu" id="dd-nationality-menu" style="max-height: 220px; overflow-y: auto;">
                                        @if (worldLocs.Any())
                                        {
                                            <div class="dropdown-header small text-uppercase text-teal-600 fw-bold px-3 py-1 bg-slate-50">World Realms & Nations</div>
                                            @foreach (var loc in worldLocs)
                                            {
                                                <div class="theme-dropdown-option" onclick="selectNationalityOption('@loc.Name', '@loc.Name', 'dd-nationality-wrapper')">
                                                    <div class="option-title"><i data-lucide="shield" style="width:13px; height:13px;" class="me-1 text-teal-600"></i>@loc.Name</div>
                                                    <div class="option-desc">Realm / World nation in @(story?.Title ?? "World")</div>
                                                </div>
                                            }
                                            <div class="dropdown-divider my-1"></div>
                                        }
                                        <div class="dropdown-header small text-uppercase text-muted fw-bold px-3 py-1">Standard Nationalities</div>
                                        <div class="theme-dropdown-option" onclick="selectNationalityOption('Valorian', 'Valorian (Kingdom of Light)', 'dd-nationality-wrapper')">
                                            <div class="option-title">Valorian</div>
                                            <div class="option-desc">Proud citizen of the noble realm of chivalry and light.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectNationalityOption('Arcanian', 'Arcanian (Arcane Spire)', 'dd-nationality-wrapper')">
                                            <div class="option-title">Arcanian</div>
                                            <div class="option-desc">Hailing from the scholarly magical citadel.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectNationalityOption('Sunlandic', 'Sunlandic Empire', 'dd-nationality-wrapper')">
                                            <div class="option-title">Sunlandic</div>
                                            <div class="option-desc">From the vast southern desert merchant empire.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectNationalityOption('Nordlandic', 'Nordlandic Clans', 'dd-nationality-wrapper')">
                                            <div class="option-title">Nordlandic</div>
                                            <div class="option-desc">Hardy warrior of the northern frost mountains.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectNationalityOption('Eldorian', 'Eldorian Enclave', 'dd-nationality-wrapper')">
                                            <div class="option-title">Eldorian</div>
                                            <div class="option-desc">Ancient woodland realm of elven heritage.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectNationalityOption('Free Isles', 'Free Isles Republic', 'dd-nationality-wrapper')">
                                            <div class="option-title">Free Isles</div>
                                            <div class="option-desc">Seafaring independent island archipelagos.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectNationalityOption('Wanderer / None', 'Wanderer / None', 'dd-nationality-wrapper')">
                                            <div class="option-title">Wanderer / None</div>
                                            <div class="option-desc">No formal allegiance or fixed realm.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Row 2: Family Background (Full Width) -->
                        <div class="mb-3">
                            <label class="form-label-custom">Family Background</label>
                            <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">Tell us about their family, parents, siblings, or guardians.</p>
                            <textarea asp-for="FamilyBackground" id="FamilyBackgroundInput" class="form-control form-control-custom" rows="4" 
                                      placeholder="e.g., Grew up in a close-knit family with supportive parents and a younger sister." 
                                      maxlength="500" oninput="updateCharCounter('FamilyBackgroundInput', 'fam-bg-counter'); checkBackgroundChecklist();"></textarea>
                            <div id="fam-bg-counter" class="input-char-counter">0/500</div>
                        </div>

                        <!-- Row 3: Upbringing, Education, Life Events (3 Columns) -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label-custom">Upbringing</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">What was their childhood like?</p>
                                <textarea asp-for="Upbringing" id="UpbringingInput" class="form-control form-control-custom" rows="3" 
                                          placeholder="e.g., Raised in a small town where everyone knew each other... peaceful but limited." 
                                          maxlength="400" oninput="updateCharCounter('UpbringingInput', 'upbringing-counter'); checkBackgroundChecklist();"></textarea>
                                <div id="upbringing-counter" class="input-char-counter">0/400</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label-custom">Education</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">What education have they received?</p>
                                <textarea asp-for="Education" id="EducationInput" class="form-control form-control-custom" rows="3" 
                                          placeholder="e.g., Studied literature in college. Has a degree in Psychology." 
                                          maxlength="300" oninput="updateCharCounter('EducationInput', 'edu-counter'); checkBackgroundChecklist();"></textarea>
                                <div id="edu-counter" class="input-char-counter">0/300</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label-custom">Life Events</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">Key events that shaped their life.</p>
                                <textarea asp-for="KeyEvents" id="LifeEventsInput" class="form-control form-control-custom" rows="3" 
                                          placeholder="e.g., Lost a parent at a young age. Survived a major accident." 
                                          maxlength="400" oninput="updateCharCounter('LifeEventsInput', 'events-counter'); checkBackgroundChecklist();"></textarea>
                                <div id="events-counter" class="input-char-counter">0/400</div>
                            </div>
                        </div>

                        <!-- Row 4: Career / Occupation, Socioeconomic Status (2 Columns) -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label-custom">Career / Occupation</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">What do they do for a living?</p>
                                <input id="OccupationInputBg" class="form-control form-control-custom" 
                                       placeholder="e.g., Detective, Royal Guard, Teacher" 
                                       maxlength="100" oninput="syncOccupationFromBg(this.value); updateLivePreview(); checkBackgroundChecklist();" />
                                <div id="occ-counter-bg" class="input-char-counter">0/100</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Socioeconomic Status</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">What is their financial / social status?</p>

                                <div class="theme-dropdown-wrapper" id="dd-status-wrapper">
                                    <div class="theme-dropdown-trigger" onclick="toggleDropdown('dd-status-wrapper')">
                                        <span id="dd-status-trigger-text">Select status</span>
                                        <i data-lucide="chevron-down" style="width: 16px; height: 16px; color: #64748B;"></i>
                                    </div>
                                    <div class="theme-dropdown-menu" style="max-height: 220px; overflow-y: auto;">
                                        <div class="theme-dropdown-option" onclick="selectStatusOption('Royalty / Noble', 'Royalty / Noble Elite', 'dd-status-wrapper')">
                                            <div class="option-title">Royalty / Noble Elite</div>
                                            <div class="option-desc">Aristocratic birth with high political power & wealth.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectStatusOption('Wealthy / Upper Class', 'Wealthy / Upper Class', 'dd-status-wrapper')">
                                            <div class="option-title">Wealthy / Upper Class</div>
                                            <div class="option-desc">Affluent elite, merchants, or prosperous landowners.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectStatusOption('Middle Class', 'Middle Class (Comfortable)', 'dd-status-wrapper')">
                                            <div class="option-title">Middle Class (Comfortable)</div>
                                            <div class="option-desc">Respected tradesperson, scholar, or professional.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectStatusOption('Working Class / Commoner', 'Working Class / Commoner', 'dd-status-wrapper')">
                                            <div class="option-title">Working Class / Commoner</div>
                                            <div class="option-desc">Hardworking laborer, artisan, or small farm owner.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectStatusOption('Impoverished / Low Income', 'Impoverished / Low Income', 'dd-status-wrapper')">
                                            <div class="option-title">Impoverished / Low Income</div>
                                            <div class="option-desc">Struggling for basic needs, living in urban slums.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectStatusOption('Outcast / Destitute', 'Outcast / Destitute', 'dd-status-wrapper')">
                                            <div class="option-title">Outcast / Destitute</div>
                                            <div class="option-desc">Penniless wanderer, exile, or marginalized outcast.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectStatusOption('Self-Made Renegade', 'Self-Made Renegade', 'dd-status-wrapper')">
                                            <div class="option-title">Self-Made Renegade</div>
                                            <div class="option-desc">Scrappy adventurer with self-earned resources.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Row 5: Current Residence, Languages (2 Columns) -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label-custom">Current Residence</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">Where do they currently live?</p>

                                <div class="theme-dropdown-wrapper" id="dd-residence-wrapper">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-slate-400 rounded-start-2" style="border-color: #CBD5E1;">
                                            <i data-lucide="home" style="width: 16px; height: 16px; color: #64748B;"></i>
                                        </span>
                                        <input type="text" id="CurrentResidenceInput" class="form-control form-control-custom border-start-0 ps-0" 
                                               placeholder="Select from World or type residence" oninput="syncCurrentResidence(this.value); checkBackgroundChecklist();" 
                                               onclick="toggleDropdown('dd-residence-wrapper')" />
                                        <button class="btn btn-outline-secondary border border-start-0 bg-white" type="button" onclick="toggleDropdown('dd-residence-wrapper')">
                                            <i data-lucide="chevron-down" style="width: 16px; height: 16px; color: #64748B;"></i>
                                        </button>
                                    </div>
                                    <div class="theme-dropdown-menu" id="dd-residence-menu" style="max-height: 220px; overflow-y: auto;">
                                        @if (worldLocs.Any())
                                        {
                                            <div class="dropdown-header small text-uppercase text-teal-600 fw-bold px-3 py-1 bg-slate-50">World Residences & Cities</div>
                                            @foreach (var loc in worldLocs)
                                            {
                                                <div class="theme-dropdown-option" onclick="selectLocationOption('CurrentResidenceInput', 'CurrentResidence', '@loc.Name', 'dd-residence-wrapper')">
                                                    <div class="option-title"><i data-lucide="home" style="width:13px; height:13px;" class="me-1 text-teal-600"></i>@loc.Name</div>
                                                    <div class="option-desc">World residence in @(story?.Title ?? "World")</div>
                                                </div>
                                            }
                                            <div class="dropdown-divider my-1"></div>
                                        }
                                        <div class="dropdown-header small text-uppercase text-muted fw-bold px-3 py-1">Sample Residences</div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('CurrentResidenceInput', 'CurrentResidence', 'High Citadel of Arcanis', 'dd-residence-wrapper')">
                                            <div class="option-title">High Citadel of Arcanis</div>
                                            <div class="option-desc">Spire quarters in the royal capital.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('CurrentResidenceInput', 'CurrentResidence', 'Capital Grand Estate', 'dd-residence-wrapper')">
                                            <div class="option-title">Capital Grand Estate</div>
                                            <div class="option-desc">Luxurious manor in the noble district.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('CurrentResidenceInput', 'CurrentResidence', 'Oakhaven Cottage', 'dd-residence-wrapper')">
                                            <div class="option-title">Oakhaven Cottage</div>
                                            <div class="option-desc">Quaint rural homestead surrounded by nature.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('CurrentResidenceInput', 'CurrentResidence', 'Port Marinus Tavern Quarter', 'dd-residence-wrapper')">
                                            <div class="option-title">Port Marinus Tavern Quarter</div>
                                            <div class="option-desc">Lively waterfront lodgings in the port town.</div>
                                        </div>
                                        <div class="theme-dropdown-option" onclick="selectLocationOption('CurrentResidenceInput', 'CurrentResidence', 'Wandering Encampment', 'dd-residence-wrapper')">
                                            <div class="option-title">Wandering Encampment</div>
                                            <div class="option-desc">No fixed home; sleeps under the stars.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">Languages</label>
                                <p class="text-slate-500 mb-1" style="font-size: 0.75rem;">Languages they speak.</p>
                                <input asp-for="Languages" id="LanguagesInput" class="form-control form-control-custom" 
                                       placeholder="e.g., English, French, Latin" 
                                       maxlength="100" oninput="updateCharCounter('LanguagesInput', 'lang-counter'); checkBackgroundChecklist();" />
                                <div id="lang-counter" class="input-char-counter">0/100</div>
                            </div>
                        </div>

                        <!-- Row 6: Background Document & File Upload Box -->
                        <div class="p-3 mt-4 rounded-3" style="background: #F8FAFC; border: 1.5px dashed #CBD5E1;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: #F0FDFA; color: #13A8A6; border: 1px solid #CCFBF1;">
                                        <i data-lucide="file-text" style="width: 20px; height: 20px;"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-slate-800" style="font-size: 0.85rem;">Background Document / Backstory File</h6>
                                        <span class="text-slate-500 small" id="bgDocStatusText">Upload backstory notes, family tree chart, or lore document (PDF, DOCX, TXT, Images)</span>
                                    </div>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-teal px-3 rounded-pill fw-semibold" style="border: 1px solid #13A8A6; color: #13A8A6; background: #F0FDFA;" onclick="document.getElementById('bgDocFileInput').click();">
                                        <i data-lucide="upload" style="width: 14px; height: 14px;" class="me-1"></i> Upload & Save File
                                    </button>
                                    <input type="file" id="bgDocFileInput" accept=".pdf,.doc,.docx,.txt,.rtf,.png,.jpg,.jpeg,.webp" style="display: none;" onchange="uploadBackgroundDoc(event)" />
                                </div>
                            </div>
                            <div id="bgDocUploadedInfo" class="mt-2 text-teal-700 small fw-medium" style="display: none;">
                                <i data-lucide="paperclip" style="width: 14px; height: 14px;" class="me-1"></i> Attached: <a id="bgDocLink" href="#" target="_blank" class="text-teal-700 text-decoration-underline"></a>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 5: Relationships -->
                    <div id="step-pane-5" class="step-pane d-none">
                        <!-- Hidden inputs for model binding -->
                        <input type="hidden" asp-for="Allies" id="Allies" />
                        <input type="hidden" asp-for="Enemies" id="Enemies" />
                        <input type="hidden" asp-for="Family" id="Family" />
                        <input type="hidden" asp-for="LoveInterests" id="LoveInterests" />
                        <input type="hidden" asp-for="RelationshipsJson" id="RelationshipsJson" />
                        <input type="hidden" asp-for="RelationshipChartUrl" id="RelationshipChartUrl" />

                        <div class="form-section-header">
                            <div class="form-section-title">
                                <div class="section-icon-badge">
                                    <i data-lucide="users" style="width: 18px; height: 18px;"></i>
                                </div>
                                Relationships
                            </div>
                            <span class="required-indicator">* Required fields</span>
                        </div>
                        <p class="form-section-subtitle">Define their connections with other characters and how they influence each other.</p>

                        <!-- Sub-Nav Tabs -->
                        <div class="rel-subnav-container">
                            <button type="button" class="rel-subnav-btn active" id="rel-subnav-table-btn" onclick="switchRelSubTab('table')">
                                <i data-lucide="users" style="width: 16px; height: 16px;"></i>
                                Character Relationships
                            </button>
                            <button type="button" class="rel-subnav-btn" id="rel-subnav-tree-btn" onclick="switchRelSubTab('tree')">
                                <i data-lucide="git-fork" style="width: 16px; height: 16px;"></i>
                                Family Tree
                            </button>
                            <button type="button" class="rel-subnav-btn" id="rel-subnav-map-btn" onclick="switchRelSubTab('map')">
                                <i data-lucide="share-2" style="width: 16px; height: 16px;"></i>
                                Relationship Map
                            </button>
                        </div>

                        <!-- Sub-Pane 1: Character Relationships Table View -->
                        <div id="rel-subpane-table" class="rel-subpane">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="text-slate-600" style="font-size: 0.82rem;">Add and manage relationships between this character and others in your stories.</span>
                                <button type="button" class="btn btn-sm px-3 rounded-pill fw-semibold d-inline-flex align-items-center gap-1" 
                                        style="border: 1px solid #13A8A6; color: #13A8A6; background: #F0FDFA; font-size: 0.82rem;" 
                                        onclick="openAddRelationshipModal()">
                                    <i data-lucide="plus" style="width: 14px; height: 14px;"></i> Add Relationship
                                </button>
                            </div>

                            <div class="rel-table-container table-responsive mb-4">
                                <table class="rel-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 25%;">
                                                <div class="d-flex align-items-center gap-1">
                                                    Character <i data-lucide="chevron-down" style="width: 12px; height: 12px; transform: rotate(180deg);"></i>
                                                </div>
                                            </th>
                                            <th style="width: 22%;">Relationship</th>
                                            <th style="width: 40%;">Dynamics</th>
                                            <th style="width: 13%; text-align: right;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="rel-table-body">
                                        <!-- Populated via JavaScript dynamically -->
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Sub-Pane 2: Family Tree View -->
                        <div id="rel-subpane-tree" class="rel-subpane d-none">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h6 class="fw-bold mb-0 text-slate-800" style="font-size: 0.88rem;">Interactive Family Tree Visualizer</h6>
                                    <span class="text-slate-500" style="font-size: 0.78rem;">Build and visualize ancestral lines and family connections.</span>
                                </div>
                                <button type="button" class="btn btn-sm px-3 rounded-pill fw-semibold d-inline-flex align-items-center gap-1" 
                                        style="border: 1px solid #13A8A6; color: #13A8A6; background: #F0FDFA; font-size: 0.82rem;" 
                                        onclick="openAddRelationshipModal('Family')">
                                    <i data-lucide="plus" style="width: 14px; height: 14px;"></i> Add Family Member
                                </button>
                            </div>

                            <div class="p-4 rounded-3 border bg-slate-50 text-center mb-4" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
                                <div class="d-flex flex-column align-items-center gap-3">
                                    <!-- Parents Level -->
                                    <div class="d-flex align-items-center gap-4 justify-content-center">
                                        <div class="family-tree-node">
                                            <div class="fw-bold text-slate-800 small">Father / Guardian</div>
                                            <div class="text-slate-500" style="font-size: 0.72rem;">Father</div>
                                        </div>
                                        <div class="family-tree-node">
                                            <div class="fw-bold text-slate-800 small">Mother / Guardian</div>
                                            <div class="text-slate-500" style="font-size: 0.72rem;">Mother</div>
                                        </div>
                                    </div>

                                    <div class="family-tree-line"></div>

                                    <!-- Main Character Level -->
                                    <div class="d-flex align-items-center gap-4 justify-content-center">
                                        <div class="family-tree-node" style="border-color: #13A8A6; background: #F0FDFA;">
                                            <div class="fw-bold text-teal-800 small" id="ft-main-name">Unnamed Character</div>
                                            <div class="badge bg-teal text-white" style="font-size: 0.65rem; background-color: #13A8A6;">Main Subject</div>
                                        </div>
                                        <div class="family-tree-node">
                                            <div class="fw-bold text-slate-800 small">Spouse / Partner</div>
                                            <div class="text-slate-500" style="font-size: 0.72rem;">Defined in relationships</div>
                                        </div>
                                    </div>

                                    <div class="family-tree-line"></div>

                                    <!-- Children / Dependents Level -->
                                    <div class="d-flex align-items-center gap-4 justify-content-center">
                                        <div class="family-tree-node">
                                            <div class="fw-bold text-slate-800 small">Child / Successor</div>
                                            <div class="text-slate-500" style="font-size: 0.72rem;">Optional entry</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sub-Pane 3: Relationship Map View -->
                        <div id="rel-subpane-map" class="rel-subpane d-none">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h6 class="fw-bold mb-0 text-slate-800" style="font-size: 0.88rem;">Character Network Relationship Map</h6>
                                    <span class="text-slate-500" style="font-size: 0.78rem;">Visual network showing connections and emotional dynamics across story arcs.</span>
                                </div>
                            </div>

                            <div class="p-4 rounded-3 border text-center mb-4" style="background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%); border: 1px solid #E2E8F0; min-height: 220px;">
                                <div id="rel-map-visual-container" class="d-flex align-items-center justify-content-center flex-wrap gap-4 py-3">
                                    <!-- Populated dynamically with node connections -->
                                </div>
                            </div>
                        </div>

                        <!-- Upload & Save File Box (Relationship Chart / Family Tree) -->
                        <div class="p-3 mt-3 rounded-3" style="background: #F8FAFC; border: 1.5px dashed #CBD5E1;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: #F0FDFA; color: #13A8A6; border: 1px solid #CCFBF1;">
                                        <i data-lucide="upload-cloud" style="width: 20px; height: 20px;"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-slate-800" style="font-size: 0.85rem;">Relationship Chart / Family Tree File</h6>
                                        <span class="text-slate-500 small" id="relDocStatusText">Upload relationship diagram, mindmap, or family tree file (PDF, DOCX, TXT, Images, SVG)</span>
                                    </div>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-teal px-3 rounded-pill fw-semibold" style="border: 1px solid #13A8A6; color: #13A8A6; background: #F0FDFA;" onclick="document.getElementById('relDocFileInput').click();">
                                        <i data-lucide="upload" style="width: 14px; height: 14px;" class="me-1"></i> Upload & Save File
                                    </button>
                                    <input type="file" id="relDocFileInput" accept=".pdf,.doc,.docx,.txt,.rtf,.png,.jpg,.jpeg,.webp,.svg" style="display: none;" onchange="uploadRelationshipDoc(event)" />
                                </div>
                            </div>
                            <div id="relDocUploadedInfo" class="mt-2 text-teal-700 small fw-medium" style="display: none;">
                                <i data-lucide="paperclip" style="width: 14px; height: 14px;" class="me-1"></i> Attached: <a id="relDocLink" href="#" target="_blank" class="text-teal-700 text-decoration-underline"></a>
                            </div>
                        </div>

                        <!-- Writing Tip Box spanning full width below -->
                        <div class="writing-tip-box mt-4 p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #F0FDFA; border: 1px solid #CCFBF1;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 36px; height: 36px; background-color: #CCFBF1; color: #0D9488;">
                                    <i data-lucide="lightbulb" style="width: 20px; height: 20px;"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1 text-slate-800" style="font-size: 0.85rem; color: #0F766E;">Writing Tip</h6>
                                    <p class="mb-0 text-slate-600" style="font-size: 0.8rem; line-height: 1.35; color: #115E59;">
                                        Strong relationships create tension, drive conflict, and deepen your story. Consider how each relationship evolves over time.
                                    </p>
                                </div>
                            </div>
                            <!-- Ink Quill Decorative Icon -->
                            <div class="d-none d-md-block ms-3 flex-shrink-0" style="opacity: 0.85;">
                                <svg width="42" height="42" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M 44 8 C 30 18, 22 34, 18 52 C 22 46, 32 40, 48 36 C 42 28, 44 16, 44 8 Z" fill="#13A8A6" opacity="0.25"/>
                                    <path d="M 44 8 C 32 20, 24 38, 18 52" stroke="#0D9488" stroke-width="2.5" stroke-linecap="round"/>
                                    <rect x="12" y="48" width="12" height="10" rx="2" fill="#0F766E"/>
                                    <circle cx="18" cy="53" r="3" fill="#CCFBF1"/>
                                </svg>
                            </div>
                        </div>
                    </div>


                    <!-- STEP 6: Review -->
                    <div id="step-pane-6" class="step-pane d-none">
                        <div class="p-3 mb-4 rounded-4 d-flex align-items-center justify-content-between" style="background: #F0FDFA; border: 1px solid #CCFBF1;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #CCFBF1; color: #0D9488;">
                                    <i data-lucide="file-check-2" style="width: 22px; height: 22px;"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1 text-slate-900" style="font-size: 1rem;">Review Your Character</h5>
                                    <p class="text-slate-600 mb-0" style="font-size: 0.82rem;">Review all details below. You can go back and edit any section if needed.</p>
                                </div>
                            </div>
                            <span class="badge bg-white text-teal-700 border border-teal-200 px-3 py-2 rounded-pill fw-semibold d-none d-sm-inline-block" style="font-size: 0.75rem;">
                                Step 6 of 6 Complete
                            </span>
                        </div>

                        <!-- 6 Cards Grid (2 Columns x 3 Rows Layout) -->
                        <div class="row g-3">
                            <!-- Card 1: Basic Information -->
                            <div class="col-12 col-md-6">
                                <div class="review-section-card">
                                    <div class="review-card-header">
                                        <span class="review-card-title">Basic Information</span>
                                        <a href="javascript:void(0)" onclick="goToStep(1)" class="review-edit-link">
                                            <i data-lucide="pencil" style="width: 13px; height: 13px;"></i> Edit
                                        </a>
                                    </div>
                                    <div class="mb-3 p-2 rounded-3 d-flex align-items-center gap-2" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
