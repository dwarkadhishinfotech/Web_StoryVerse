        function renderRelationshipsTable() {
            var html = '';

            const relTypes = [
                { name: 'Best Friend', desc: 'Deep bond of trust, loyalty, and mutual protection.' },
                { name: 'Mentor', desc: 'Teaches, guides, and imparts vital wisdom.' },
                { name: 'Rival', desc: 'Friendly or intense competition driving growth.' },
                { name: 'Childhood Friend', desc: 'Longstanding history built from early youth.' },
                { name: 'Ally', desc: 'Strategic partnership with shared objectives.' },
                { name: 'Family', desc: 'Blood relation or adoptive family tie.' },
                { name: 'Love Interest', desc: 'Romantic feelings or profound affection.' },
                { name: 'Enemy', desc: 'Direct adversary, hostile opponent.' },
                { name: 'Acquaintance', desc: 'Casual connection or mutual associate.' }
            ];

            characterRelationships.forEach(function(rel, index) {
                var roleClass = 'rel-role-badge-main';
                if (rel.role === 'Supporting') roleClass = 'rel-role-badge-supporting';
                else if (rel.role === 'Antagonist') roleClass = 'rel-role-badge-antagonist';

                var dynClass = 'dynamics-pill-positive';
                var dynIcon = '↗';
                if (rel.dynamicsType === 'Complex') { dynClass = 'dynamics-pill-complex'; dynIcon = '⇆'; }
                else if (rel.dynamicsType === 'Negative') { dynClass = 'dynamics-pill-negative'; dynIcon = '↘'; }
                else if (rel.dynamicsType === 'Neutral') { dynClass = 'dynamics-pill-neutral'; dynIcon = '⚪'; }

                var optionsHtml = '';
                relTypes.forEach(function(t) {
                    var activeOpt = (t.name === rel.relationship) ? ' active-option' : '';
                    optionsHtml += `
                        <div class="theme-dropdown-option${activeOpt}" onclick="selectRelTypeOption(${index}, '${t.name.replace(/'/g, "\\'")}', 'dd-rel-type-${index}')">
                            <div class="option-title">${t.name}</div>
                            <div class="option-desc">${t.desc}</div>
                        </div>
                    `;
                });

                html += `
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="${rel.avatar}" alt="${escapeHtml(rel.name)}" class="rounded-circle" style="width: 38px; height: 38px; object-fit: cover; border: 1px solid #CBD5E1;" />
                                <div>
                                    <div class="fw-bold text-slate-800" style="font-size: 0.88rem;">${escapeHtml(rel.name)}</div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-slate-500" style="font-size: 0.72rem;">${escapeHtml(rel.subtitle || 'Story Character')}</span>
                                        <span class="${roleClass}">${escapeHtml(rel.role || 'Main')}</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="theme-dropdown-wrapper" id="dd-rel-type-${index}">
                                <div class="theme-dropdown-trigger" onclick="toggleDropdown('dd-rel-type-${index}')" style="padding: 0.45rem 0.75rem; font-size: 0.82rem;">
                                    <span>${escapeHtml(rel.relationship)}</span>
                                    <i data-lucide="chevron-down" style="width: 14px; height: 14px; color: #64748B;"></i>
                                </div>
                                <div class="theme-dropdown-menu" style="max-height: 200px;">
                                    ${optionsHtml}
                                </div>
                            </div>
                        </td>
                        <td>
                            <div>
                                <span class="dynamics-pill ${dynClass}">
                                    ${dynIcon} ${escapeHtml(rel.dynamicsType)}
                                </span>
                                <div class="text-slate-600" style="font-size: 0.76rem; line-height: 1.35;">
                                    ${escapeHtml(rel.dynamicsText)}
                                </div>
                            </div>
                        </td>
                        <td style="text-align: right;">
                            <div class="d-inline-flex align-items-center gap-1">
                                <button type="button" class="action-icon-btn" onclick="editRelationship(${index})" title="Edit Relationship">
                                    <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                                </button>
                                <button type="button" class="action-icon-btn delete-btn" onclick="deleteRelationship(${index})" title="Delete Relationship">
                                    <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            if (characterRelationships.length === 0) {
                html = `
                    <tr>
                        <td colspan="4" class="text-center py-4 text-slate-500">
                            No relationships added yet. Click <strong>+ Add Relationship</strong> to define connections.
                        </td>
                    </tr>
                `;
            }

            $('#rel-table-body').html(html);
            lucide.createIcons();
        }

