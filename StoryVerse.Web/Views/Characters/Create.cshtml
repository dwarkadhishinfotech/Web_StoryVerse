        function validateStep(step) {
            if (step === 1) {
                var valid = true;
                var name = $('#NameInput').val().trim();
                var role = $('#Role').val().trim();
                var storyId = $('#StoryId').val();

                if (!name) {
                    $('#NameInput').addClass('is-invalid');
                    valid = false;
                } else {
                    $('#NameInput').removeClass('is-invalid');
                }

                if (!role) {
                    $('#dd-role-wrapper .theme-dropdown-trigger').css('border-color', '#EF4444');
                    valid = false;
                } else {
                    $('#dd-role-wrapper .theme-dropdown-trigger').css('border-color', '');
                }

                if (!storyId || storyId === '00000000-0000-0000-0000-000000000000') {
                    $('#dd-story-wrapper .theme-dropdown-trigger').css('border-color', '#EF4444');
                    valid = false;
                } else {
                    $('#dd-story-wrapper .theme-dropdown-trigger').css('border-color', '');
                }

                return valid;
            }

            if (step === 3) {
                var valid = true;
                var overview = $('#PersonalityOverviewInput').val().trim();
                var motivations = $('#MotivationsInput').val().trim();

                if (activeTraits.length === 0) {
                    $('#core-traits-pills-container').parent().css('border-color', '#EF4444');
                    valid = false;
                } else {
                    $('#core-traits-pills-container').parent().css('border-color', '#CBD5E1');
                }

                if (!overview) {
                    $('#PersonalityOverviewInput').addClass('is-invalid');
                    valid = false;
                } else {
                    $('#PersonalityOverviewInput').removeClass('is-invalid');
                }

                if (!motivations) {
                    $('#MotivationsInput').addClass('is-invalid');
                    valid = false;
                } else {
                    $('#MotivationsInput').removeClass('is-invalid');
                }

                return valid;
            }

            if (step === 4) {
                var valid = true;
                var pob = $('#PlaceOfBirthInput').val().trim() || $('#PlaceOfBirth').val().trim();
                if (!pob) {
                    $('#PlaceOfBirthInput').addClass('is-invalid');
                    valid = false;
                } else {
                    $('#PlaceOfBirthInput').removeClass('is-invalid');
                }
                return valid;
            }

            return true;
        }

        function showStep(step) {
            currentStep = step;
            $('.step-pane').addClass('d-none');
            $('#step-pane-' + step).removeClass('d-none');

            $('.stepper-step').removeClass('active completed');
            for (var i = 1; i <= 6; i++) {
                var $btn = $('#step-btn-' + i);
                var $circle = $btn.find('.step-circle');
                if (i === step) {
                    $btn.addClass('active');
                    $circle.html(i);
                } else if (i < step) {
                    $btn.addClass('completed');
                    $circle.html('<i data-lucide="check" style="width: 15px; height: 15px;"></i>');
                } else {
                    $circle.html(i);
                }
            }

            if (step === 1) {
                $('#backStepBtn').css('visibility', 'hidden');
            } else {
                $('#backStepBtn').css('visibility', 'visible');
            }

            if (step === 2) {
                $('#sidebar-quicktips-card').hide();
                $('#sidebar-whatsnext-card').hide();
                $('#sidebar-checklist-card').show();
                $('#sidebar-personality-checklist-card').hide();
                $('#sidebar-background-checklist-card').hide();
                $('#sidebar-relationships-checklist-card').hide();
                $('#sidebar-review-checklist-card').hide();
                $('#sidebar-tips-card').show();
                checkAppearanceChecklist();
            } else if (step === 3) {
                $('#sidebar-quicktips-card').hide();
                $('#sidebar-whatsnext-card').show();
                $('#sidebar-checklist-card').hide();
                $('#sidebar-personality-checklist-card').show();
                $('#sidebar-background-checklist-card').hide();
                $('#sidebar-relationships-checklist-card').hide();
                $('#sidebar-review-checklist-card').hide();
                $('#sidebar-tips-card').hide();
                checkPersonalityChecklist();
            } else if (step === 4) {
                $('#sidebar-quicktips-card').hide();
                $('#sidebar-whatsnext-card').show();
                $('#sidebar-checklist-card').hide();
                $('#sidebar-personality-checklist-card').hide();
                $('#sidebar-background-checklist-card').show();
                $('#sidebar-relationships-checklist-card').hide();
                $('#sidebar-review-checklist-card').hide();
                $('#sidebar-tips-card').hide();
                checkBackgroundChecklist();
            } else if (step === 5) {
                $('#sidebar-quicktips-card').hide();
                $('#sidebar-whatsnext-card').show();
                $('#sidebar-checklist-card').hide();
                $('#sidebar-personality-checklist-card').hide();
                $('#sidebar-background-checklist-card').hide();
                $('#sidebar-relationships-checklist-card').show();
                $('#sidebar-review-checklist-card').hide();
                $('#sidebar-tips-card').hide();
                checkRelationshipsChecklist();
            } else if (step === 6) {
                $('#sidebar-quicktips-card').hide();
                $('#sidebar-whatsnext-card').show();
                $('#sidebar-checklist-card').hide();
                $('#sidebar-personality-checklist-card').hide();
                $('#sidebar-background-checklist-card').hide();
                $('#sidebar-relationships-checklist-card').hide();
                $('#sidebar-review-checklist-card').show();
                $('#sidebar-tips-card').hide();
            } else {
                $('#sidebar-quicktips-card').show();
                $('#sidebar-whatsnext-card').show();
                $('#sidebar-checklist-card').hide();
                $('#sidebar-personality-checklist-card').hide();
                $('#sidebar-background-checklist-card').hide();
                $('#sidebar-relationships-checklist-card').hide();
                $('#sidebar-review-checklist-card').hide();
                $('#sidebar-tips-card').hide();
            }

            if (step === 6) {
                $('#nextStepBtn').html('Save & Create Character <i data-lucide="check" style="width:16px; height:16px;"></i>');
                $('#topSaveBtn').html('Save & Create Character <i data-lucide="check" style="width:16px; height:16px;"></i>');
                populateReviewSummary();
            } else {
                $('#nextStepBtn').html('Save & Continue <i data-lucide="arrow-right" style="width:16px; height:16px;"></i>');
                $('#topSaveBtn').html('Save & Continue <i data-lucide="arrow-right" style="width:16px; height:16px;"></i>');
            }

            updateWhatNextCard(step);
            lucide.createIcons();
        }

        function updateWhatNextCard(step) {
            const stepTitles = {
                1: { num: 1, title: 'Appearance', desc: 'Add physical details, clothing, and distinctive features.' },
                2: { num: 2, title: 'Personality', desc: 'Define core traits, strengths, flaws, and desires.' },
                3: { num: 3, title: 'Background', desc: 'Detail origin, backstory, and pivotal life events.' },
                4: { num: 4, title: 'Relationships', desc: 'Establish connections with allies, enemies, and family.' },
                5: { num: 5, title: 'Review', desc: 'Perform final checks before saving your character.' },
                6: { num: 6, title: 'Complete!', desc: 'Submit and bring your character to life.' }
            };

            var data = stepTitles[step] || stepTitles[1];
            $('#next-card-step-circle').text(data.num);
            $('#next-card-step-title').text(data.title);
            $('#next-card-step-desc').text(data.desc);
        }

        function checkAppearanceChecklist() {
            function setCheckState(itemId, isComplete) {
                var $box = $('#' + itemId + ' .chk-icon-box');
                var $icon = $box.find('i');
                if (isComplete) {
                    $box.css({
                        'background-color': '#13A8A6',
                        'border-color': '#13A8A6',
                        'color': '#FFFFFF'
                    });
                    $icon.show();
                } else {
                    $box.css({
                        'background-color': 'transparent',
                        'border-color': '#CBD5E1',
                        'color': '#94A3B8'
                    });
                    $icon.hide();
                }
            }

            // 1. Portrait
            var hasPortrait = !!$('#AvatarUrl').val();
            setCheckState('chk-item-portrait', hasPortrait);

            // 2. Physical features
            var hasPhysical = !!($('#HeightInput').val() || $('#Build').val() || $('#EyeColor').val() || $('#HairColor').val() || $('#HairStyleInput').val());
            setCheckState('chk-item-physical', hasPhysical);

            // 3. Clothing and style
            var hasClothing = !!($('#ClothingStyle').val() || $('#PreferredColorsInput').val() || $('#AccessoriesInput').val());
            setCheckState('chk-item-clothing', hasClothing);

            // 4. Distinctive features
            var hasDistinctive = !!$('#DistinctiveFeaturesInput').val();
            setCheckState('chk-item-distinctive', hasDistinctive);

            // 5. Voice tone (optional)
            var hasVoice = !!($('#VoiceTone').val() || $('#AccentInput').val() || $('#SpeechPatternInput').val());
            setCheckState('chk-item-voice', hasVoice);
        }

        function checkPersonalityChecklist() {
            function setCheckState(itemId, isComplete) {
                var $box = $('#' + itemId + ' .chk-icon-box');
                var $icon = $box.find('i');
                if (isComplete) {
                    $box.css({
                        'background-color': '#13A8A6',
                        'border-color': '#13A8A6',
                        'color': '#FFFFFF'
                    });
                    $icon.show();
                } else {
                    $box.css({
                        'background-color': 'transparent',
                        'border-color': '#CBD5E1',
                        'color': '#94A3B8'
                    });
                    $icon.hide();
                }
            }

            setCheckState('chk-pers-traits', activeTraits.length > 0);
            setCheckState('chk-pers-overview', !!$('#PersonalityOverviewInput').val().trim());
            setCheckState('chk-pers-motivations', !!$('#MotivationsInput').val().trim());
            setCheckState('chk-pers-strengthsflaws', !!($('#StrengthsInput').val().trim() || $('#FlawsInput').val().trim()));
            setCheckState('chk-pers-fear', !!$('#FearsInput').val().trim());
        }

        function populateReviewSummary() {
            // 1. Basic Info Card
            var storyTitle = $('#dd-story-trigger-text span').text().trim() || 'No story selected';
            $('#rev-story-title').text(storyTitle);

            var name = $('#NameInput').val().trim();
            $('#rev-name').text(name || 'Not specified');

            var role = $('#Role').val().trim();
            $('#rev-role').text(role || 'Not specified');

            var arc = $('#ArcType').val().trim();
            $('#rev-arc').text(arc || 'Not specified');

            var nicknames = $('#NicknamesInput').val().trim();
            $('#rev-nicknames').text(nicknames || 'None');

            var age = $('#AgeInputBg').val().trim() || $('#AgeInput').val().trim();
            $('#rev-age').text(age || 'Not specified');

            var gender = $('#Gender').val().trim() || $('#PronounsInput').val().trim();
            $('#rev-gender').text(gender || 'Not specified');

            var occ = $('#OccupationInput').val().trim();
            $('#rev-occ').text(occ || 'Not specified');

            var status = $('#Status').val().trim() || 'Active';
            $('#rev-status').text(status);

            var align = $('#Alignment').val().trim();
            $('#rev-align').text(align || 'Not specified');

            var oneline = $('#OneLineDescInput').val().trim();
            $('#rev-oneline').text(oneline || 'No description provided.');

            // 2. Appearance Card
            var avatarUrl = $('#AvatarUrl').val() || $('#avatarUploadedImg').attr('src');
            if (avatarUrl && avatarUrl.trim().length > 0) {
                $('#rev-avatar-img').attr('src', avatarUrl).show();
                $('#rev-avatar-fallback').hide();
            } else {
                $('#rev-avatar-img').hide();
                $('#rev-avatar-fallback').show();
            }

            $('#rev-height').text($('#HeightInput').val().trim() || 'Not specified');
            $('#rev-build').text($('#Build').val().trim() || 'Not specified');
            $('#rev-eyecolor').text($('#EyeColor').val().trim() || 'Not specified');
            $('#rev-haircolor').text($('#HairColor').val().trim() || 'Not specified');
            $('#rev-distinctive').text($('#DistinctiveFeaturesInput').val().trim() || 'None');
            $('#rev-clothingstyle').text($('#ClothingStyle').val().trim() || 'Not specified');
            $('#rev-accessories').text($('#AccessoriesInput').val().trim() || 'None');
            $('#rev-overall-look').text($('#AppearanceNotesInput').val().trim() || 'No overall look notes.');

            // 3. Personality Card
            var traitsHtml = '';
            if (activeTraits && activeTraits.length > 0) {
                activeTraits.forEach(function(t) {
                    traitsHtml += `<span class="badge bg-light text-slate-800 border me-1 mb-1" style="font-size:0.72rem; padding: 3px 8px;">${escapeHtml(t)}</span>`;
                });
            } else {
                traitsHtml = '<span class="text-muted small">No traits selected</span>';
            }
            $('#rev-traits-pills').html(traitsHtml);

            $('#rev-strengths').text($('#StrengthsInput').val().trim() || 'Not specified');
            $('#rev-motivations').text($('#MotivationsInput').val().trim() || 'Not specified');
            $('#rev-fears').text($('#FearsInput').val().trim() || 'Not specified');
            $('#rev-flaws').text($('#FlawsInput').val().trim() || 'Not specified');
            $('#rev-temperament').text($('#Temperament').val() || 'Not specified');
            $('#rev-values').text($('#ValuesBeliefs').val() || 'Not specified');

            // 4. Background Card
            $('#rev-pob').text($('#PlaceOfBirthInput').val().trim() || $('#PlaceOfBirth').val().trim() || 'Not specified');
            
            var dob = $('#DateOfBirthInput').val().trim();
            var bgAge = $('#AgeInputBg').val().trim() || $('#AgeInput').val().trim();
            var dobAgeText = 'Not specified';
            if (dob && bgAge) { dobAgeText = dob + ' (' + bgAge + ')'; }
            else if (dob) { dobAgeText = dob; }
            else if (bgAge) { dobAgeText = bgAge + ' years old'; }
            $('#rev-dob-age').text(dobAgeText);

            $('#rev-nationality').text($('#Nationality').val().trim() || 'Not specified');
            $('#rev-fam-bg').text($('#FamilyBackgroundInput').val().trim() || 'Not specified');
            $('#rev-upbringing').text($('#UpbringingInput').val().trim() || 'Not specified');
            $('#rev-education').text($('#EducationInput').val().trim() || 'Not specified');
            $('#rev-residence').text($('#CurrentResidenceInput').val().trim() || $('#CurrentResidence').val().trim() || 'Not specified');
            $('#rev-languages').text($('#LanguagesInput').val().trim() || 'Not specified');

            // 5. Relationships Card
            var relsHtml = '';
            if (characterRelationships && characterRelationships.length > 0) {
                characterRelationships.forEach(function(rel) {
                    var badgeClass = 'bg-teal-subtle text-teal-800';
                    var dynSymbol = '↗';
                    if (rel.dynamicsType === 'Complex') { badgeClass = 'bg-primary-subtle text-primary'; dynSymbol = '⇆'; }
                    else if (rel.dynamicsType === 'Negative') { badgeClass = 'bg-danger-subtle text-danger'; dynSymbol = '↘'; }

                    relsHtml += `
                        <div class="p-2 rounded-3 border bg-slate-50 d-flex align-items-start gap-2">
                            <img src="${rel.avatar}" alt="${escapeHtml(rel.name)}" class="rounded-circle flex-shrink-0" style="width: 32px; height: 32px; object-fit: cover;" />
                            <div class="flex-grow-1 overflow-hidden" style="font-size: 0.76rem;">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="fw-bold text-slate-800 text-truncate">${escapeHtml(rel.name)}</span>
                                    <span class="badge ${badgeClass}" style="font-size: 0.65rem;">${dynSymbol} ${escapeHtml(rel.dynamicsType)}</span>
                                </div>
                                <div class="text-slate-500 fw-medium" style="font-size: 0.7rem;">${escapeHtml(rel.relationship)}</div>
                                <div class="text-slate-600 text-truncate mt-1" style="font-size: 0.72rem;">${escapeHtml(rel.dynamicsText)}</div>
                            </div>
                        </div>
                    `;
                });
            } else {
                relsHtml = '<div class="text-muted small py-2">No relationships added yet.</div>';
            }
            $('#rev-relationships-container').html(relsHtml);

            // 6. Additional Notes Card
            var authorsNotes = $('#BgSummaryInput').val().trim() || $('#Backstory').val().trim();
            $('#rev-authors-notes').text(authorsNotes || 'No additional notes provided.');
            $('#AuthorNotes').val(authorsNotes);

            var tagsVal = $('#TagsInput').val().trim();
            var tagsHtml = '';
            if (tagsVal) {
                tagsVal.split(',').forEach(function(tg) {
                    if (tg.trim()) {
                        tagsHtml += `<span class="badge bg-slate-100 text-slate-700 border me-1 mb-1" style="font-size: 0.72rem;">${escapeHtml(tg.trim())}</span>`;
                    }
                });
            } else {
                tagsHtml = `
                    <span class="badge bg-slate-100 text-slate-700 border me-1 mb-1" style="font-size: 0.72rem;">Warrior</span>
                    <span class="badge bg-slate-100 text-slate-700 border me-1 mb-1" style="font-size: 0.72rem;">Leader</span>
                    <span class="badge bg-slate-100 text-slate-700 border me-1 mb-1" style="font-size: 0.72rem;">Noble</span>
                    <span class="badge bg-slate-100 text-slate-700 border me-1 mb-1" style="font-size: 0.72rem;">Loyal</span>
                    <span class="badge bg-slate-100 text-slate-700 border me-1 mb-1" style="font-size: 0.72rem;">Haunted Past</span>
                `;
            }
            $('#rev-tags-list').html(tagsHtml);

            var crest = $('#FamilyCrest').val();
            $('#rev-family-crest').text(crest || 'Not specified');

            var themeColor = $('#ThemeColor').val() || '#142850';
            $('#rev-color-swatch').css('background-color', themeColor);
            $('#rev-theme-color-text').text(themeColor);
            $('#ThemeColor').val(themeColor);

            // Attached files rendering
            renderReviewAttachedFiles();
            lucide.createIcons();
        }

        function renderReviewAttachedFiles() {
            var filesHtml = '';

            var bgUrl = $('#BackgroundDocumentUrl').val();
            if (bgUrl) {
                filesHtml += `
                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-slate-50 border small">
                        <div class="d-flex align-items-center gap-2 text-truncate me-2">
                            <i data-lucide="file-text" style="width: 14px; height: 14px; color: #13A8A6;" class="flex-shrink-0"></i>
                            <a href="${bgUrl}" target="_blank" class="text-teal-700 text-decoration-underline text-truncate">Backstory Document</a>
                        </div>
                        <span class="badge bg-teal-subtle text-teal-800 flex-shrink-0" style="font-size:0.65rem;">Attached</span>
                    </div>
                `;
            }

            var relUrl = $('#RelationshipChartUrl').val();
            if (relUrl) {
                filesHtml += `
                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-slate-50 border small">
                        <div class="d-flex align-items-center gap-2 text-truncate me-2">
                            <i data-lucide="share-2" style="width: 14px; height: 14px; color: #13A8A6;" class="flex-shrink-0"></i>
                            <a href="${relUrl}" target="_blank" class="text-teal-700 text-decoration-underline text-truncate">Relationship Chart</a>
                        </div>
                        <span class="badge bg-teal-subtle text-teal-800 flex-shrink-0" style="font-size:0.65rem;">Attached</span>
                    </div>
                `;
            }

            var customUrl = $('#CustomDocumentUrl').val();
            if (customUrl) {
                filesHtml += `
                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-slate-50 border small">
                        <div class="d-flex align-items-center gap-2 text-truncate me-2">
                            <i data-lucide="paperclip" style="width: 14px; height: 14px; color: #13A8A6;" class="flex-shrink-0"></i>
                            <a href="${customUrl}" target="_blank" class="text-teal-700 text-decoration-underline text-truncate">Custom Document / Crest</a>
                        </div>
                        <span class="badge bg-teal-subtle text-teal-800 flex-shrink-0" style="font-size:0.65rem;">Attached</span>
                    </div>
                `;
            }

            if (!bgUrl && !relUrl && !customUrl) {
                filesHtml = '<div class="text-slate-400 small italic py-1">No additional document files attached yet. Click "Upload & Save File" above.</div>';
            }

            $('#rev-attached-files-list').html(filesHtml);
            lucide.createIcons();
        }

        async function uploadReviewCustomDoc(event) {
            const file = event.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch('/Characters/UploadCustomDoc', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    $('#CustomDocumentUrl').val(result.documentUrl);
                    renderReviewAttachedFiles();
                    alert('File uploaded & attached successfully!');
                } else {
                    alert('Upload error: ' + result.message);
                }
            } catch (err) {
                console.error('Custom document upload failed:', err);
            }
        }

        function submitCharacterForm() {
            if (validateStep(1)) {
                $('#characterForm').submit();
            } else {
                showStep(1);
            }
        }

        async function uploadPortraitImage(event) {
            const file = event.target.files[0];
            if (!file) return;

            const objectUrl = URL.createObjectURL(file);
            
            // Update Step 2 upload box preview
            $('#portraitPlaceholderArea').addClass('d-none');
            $('#portraitPreviewImg').attr('src', objectUrl);
            $('#portraitPreviewArea').removeClass('d-none');

            // Update Live Preview avatar circle
            $('#avatarUploadedImg').attr('src', objectUrl).css('display', 'block');
            $('#avatarDefaultSvg').css('display', 'none');

            // Upload to server asynchronously
            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch('/Characters/UploadAvatar', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    $('#AvatarUrl').val(result.avatarUrl);
                    $('#portraitPreviewImg').attr('src', result.avatarUrl);
                    $('#avatarUploadedImg').attr('src', result.avatarUrl);
                    checkAppearanceChecklist();
                } else {
                    alert('Portrait upload error: ' + result.message);
                }
            } catch (err) {
                console.error('Portrait upload failed:', err);
            }
        }

        async function uploadAvatarImage(event) {
            await uploadPortraitImage(event);
        }

        $(document).ready(function() {
            var initialAvatar = $('#AvatarUrl').val();
            if (initialAvatar) {
                $('#avatarUploadedImg').attr('src', initialAvatar).css('display', 'block');
                $('#avatarDefaultSvg').css('display', 'none');
                $('#portraitPlaceholderArea').addClass('d-none');
                $('#portraitPreviewImg').attr('src', initialAvatar);
                $('#portraitPreviewArea').removeClass('d-none');
            }
        });
    </script>
}
