        function goToStep(step) {
            if (step > currentStep) {
                if (!validateStep(currentStep)) return;
            }
            showStep(step);
        }

        function nextStep() {
            if (currentStep < 6) {
                if (validateStep(currentStep)) {
                    goToStep(currentStep + 1);
                }
            } else {
                submitCharacterForm();
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                goToStep(currentStep - 1);
            }
        }

