                if (result.success) {
                    $('#BackgroundDocumentUrl').val(result.documentUrl);
                    $('#bgDocStatusText').text('Document uploaded & saved successfully!');
                    $('#bgDocLink').attr('href', result.documentUrl).text(result.fileName + ' (' + Math.round(result.fileSize / 1024) + ' KB)');
