<!-- Modal: Add / Edit Relationship -->
<div class="modal fade" id="addRelationshipModal" tabindex="-1" aria-labelledby="addRelationshipModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-header-title fw-bold text-slate-800 d-flex align-items-center gap-2 mb-0" id="addRelationshipModalLabel">
                    <i data-lucide="user-plus" class="text-teal-600" style="width: 20px; height: 20px;"></i>
                    <span id="modalRelTitle">Add Relationship</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="editRelIndex" value="-1" />

                <!-- Character Name -->
                <div class="mb-3">
                    <label class="form-label-custom">Character Name <span class="text-danger">*</span></label>
                    <input type="text" id="modalRelName" class="form-control form-control-custom" placeholder="e.g. Character Name" />
                </div>

                <!-- Story / Origin Title & Role Badge -->
                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label-custom">Story / Origin Title</label>
                        <input type="text" id="modalRelSubtitle" class="form-control form-control-custom" placeholder="e.g. Story Title" />
                    </div>
                    <div class="col-5">
                        <label class="form-label-custom">Role</label>
                        <select id="modalRelRole" class="form-select form-control-custom">
                            <option value="Main">Main</option>
                            <option value="Supporting">Supporting</option>
                            <option value="Antagonist">Antagonist</option>
                            <option value="Minor">Minor</option>
                        </select>
                    </div>
                </div>

                <!-- Relationship Type -->
                <div class="mb-3">
                    <label class="form-label-custom">Relationship Type</label>
                    <select id="modalRelType" class="form-select form-control-custom">
                        <option value="Best Friend">Best Friend</option>
                        <option value="Mentor">Mentor</option>
                        <option value="Rival">Rival</option>
                        <option value="Childhood Friend">Childhood Friend</option>
                        <option value="Ally">Ally</option>
                        <option value="Family">Family Member</option>
                        <option value="Love Interest">Love Interest</option>
                        <option value="Enemy">Enemy / Nemesis</option>
                        <option value="Acquaintance">Acquaintance</option>
                    </select>
                </div>

                <!-- Dynamics Category -->
                <div class="mb-3">
                    <label class="form-label-custom">Dynamics Category</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="radio" name="modalDynamicsType" id="dynPos" value="Positive" checked>
                            <label class="form-check-label text-success fw-medium small" for="dynPos">↗ Positive</label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="radio" name="modalDynamicsType" id="dynComp" value="Complex">
                            <label class="form-check-label text-primary fw-medium small" for="dynComp">⇆ Complex</label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="radio" name="modalDynamicsType" id="dynNeg" value="Negative">
                            <label class="form-check-label text-danger fw-medium small" for="dynNeg">↘ Negative</label>
                        </div>
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="radio" name="modalDynamicsType" id="dynNeu" value="Neutral">
                            <label class="form-check-label text-secondary fw-medium small" for="dynNeu">⚪ Neutral</label>
                        </div>
                    </div>
                </div>

                <!-- Dynamics Description -->
                <div class="mb-3">
                    <label class="form-label-custom">Dynamics Description</label>
                    <textarea id="modalRelDesc" class="form-control form-control-custom" rows="3" placeholder="Describe their bond, conflict, history, or influence..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn text-white rounded-pill px-4 fw-bold" style="background-color: #13A8A6;" onclick="saveRelationshipFromModal()">Save Relationship</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentStep = 1;
        let activeTraits = ['Brave', 'Loyal', 'Intelligent', 'Stubborn', 'Protective'];

        // Initialize tooltips & character counts
        $(document.body).ready(function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Character counter initialization
            updateCharCounter('NameInput', 'name-counter');
            updateCharCounter('NicknamesInput', 'nick-counter');
            updateCharCounter('AgeInput', 'age-counter');
            updateCharCounter('PronounsInput', 'pronouns-counter');
            updateCharCounter('OccupationInput', 'occ-counter');
            updateCharCounter('OneLineDescInput', 'oneline-counter');
            updateCharCounter('BgSummaryInput', 'bg-counter');
            updateCharCounter('TagsInput', 'tags-counter');

            // Personality Step counters
            updateCharCounter('PersonalityOverviewInput', 'overview-counter');
            updateCharCounter('StrengthsInput', 'strengths-counter');
            updateCharCounter('MotivationsInput', 'motivations-counter');
            updateCharCounter('FlawsInput', 'flaws-counter');
            updateCharCounter('FearsInput', 'fears-counter');

            // Background Step counters & sync
            updateCharCounter('FamilyBackgroundInput', 'fam-bg-counter');
            updateCharCounter('UpbringingInput', 'upbringing-counter');
            updateCharCounter('EducationInput', 'edu-counter');
            updateCharCounter('LifeEventsInput', 'events-counter');
            updateCharCounter('OccupationInput', 'occ-counter');
            updateCharCounter('LanguagesInput', 'lang-counter');

            // Hydrate initial background field values
            var initPob = $('#PlaceOfBirth').val();
            if (initPob) $('#PlaceOfBirthInput').val(initPob);

            var initResidence = $('#CurrentResidence').val();
            if (initResidence) $('#CurrentResidenceInput').val(initResidence);

            var initAge = $('#AgeInput').val();
            if (initAge) $('#AgeInputBg').val(initAge);

            var initNationality = $('#Nationality').val();
            if (initNationality) {
                $('#NationalityInput').val(initNationality);
                $('#dd-nationality-trigger-text').text(initNationality);
            }

            var initStatus = $('#SocioeconomicStatus').val();
            if (initStatus) $('#dd-status-trigger-text').text(initStatus);

            var initDocUrl = $('#BackgroundDocumentUrl').val();
            if (initDocUrl) {
                $('#bgDocStatusText').text('Document attached');
                $('#bgDocLink').attr('href', initDocUrl).text('View Attached Background File');
                $('#bgDocUploadedInfo').show();
            }

            // Initialize Traits & Values
            var existingTraits = $('#PersonalityTraits').val();
            if (existingTraits && existingTraits.trim().length > 0) {
                activeTraits = existingTraits.split(',').map(function(t) { return t.trim(); }).filter(Boolean);
            }
            renderTraits();

            var initialTemp = $('#Temperament').val() || 'Choleric (Leader)';
            $('#Temperament').val(initialTemp);
            $('#dd-temperament-trigger-text').text(initialTemp);

            var initialValues = $('#ValuesBeliefs').val();
            if (initialValues) {
                var valArr = initialValues.split(',').map(function(v) { return v.trim(); });
                $('.value-checkbox').each(function() {
                    if (valArr.includes($(this).val())) {
                        $(this).prop('checked', true);
                    }
                });
            } else {
                updateValuesBeliefs();
            }

            updateLivePreview();
        });

        // Close dropdowns on click outside
        $(document).on('click', function (e) {
            if (!$(e.target).closest('.theme-dropdown-wrapper').length) {
                $('.theme-dropdown-wrapper').removeClass('open');
            }
        });

        function toggleDropdown(wrapperId) {
            $('.theme-dropdown-wrapper').not('#' + wrapperId).removeClass('open');
            $('#' + wrapperId).toggleClass('open');
        }

        function selectStoryOption(storyId, storyTitle) {
            loadWorldLocationsForStory(storyId);
            $('#StoryId').val(storyId);
            $('#dd-story-trigger-text').html('<i data-lucide="book" style="width:16px; height:16px; color:#13A8A6;"></i><span>' + storyTitle + '</span>');
            $('#dd-story-wrapper').removeClass('open');
            lucide.createIcons();
        }

        function selectThemeOption(hiddenFieldId, val, displayText, triggerSpanId, wrapperId) {
            $('#' + hiddenFieldId).val(val);
            $('#' + triggerSpanId).text(displayText).parent().addClass('selected');
            $('#' + wrapperId).removeClass('open');

            // Highlight selected option visually
            $('#' + wrapperId + ' .theme-dropdown-option').removeClass('active-option');
            $(event.currentTarget).addClass('active-option');

            updateLivePreview();
        }

        /* Personality Traits Functions */
        function renderTraits() {
            var html = '';
            activeTraits.forEach(function(t) {
                html += '<span class="trait-pill">' + escapeHtml(t) + ' <button type="button" class="trait-pill-remove" onclick="removeTrait(\'' + escapeHtml(t).replace(/'/g, "\\'") + '\')">&times;</button></span>';
            });
            $('#core-traits-pills-container').html(html);
            $('#PersonalityTraits').val(activeTraits.join(', '));
            checkPersonalityChecklist();
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function removeTrait(trait) {
            activeTraits = activeTraits.filter(function(t) { return t !== trait; });
            renderTraits();
        }

        function addTraitFromDropdown(trait) {
            if (!activeTraits.includes(trait)) {
                activeTraits.push(trait);
                renderTraits();
            }
            $('#dd-traits-wrapper').removeClass('open');
