                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="Fears" class="form-label-custom">Greatest Fear</label>
                                <textarea asp-for="Fears" class="form-control form-control-custom" rows="2" placeholder="Failing mission, losing loved ones..."></textarea>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="Desires" class="form-label-custom">Core Desires</label>
                                <textarea asp-for="Desires" class="form-control form-control-custom" rows="2" placeholder="Peace, fulfilling duty..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 4: BACKGROUND -->
                    <div class="tab-pane-content d-none" id="tab-step-4">
                        <div class="form-section-header">
                            <div class="form-section-title">
                                <div class="section-icon-badge">
                                    <i data-lucide="book-open" style="width: 18px; height: 18px;"></i>
                                </div>
                                <span>Origin & Backstory</span>
                            </div>
                        </div>
                        <p class="form-section-subtitle">Birthplace, upbringing, key life milestones, and full narrative backstory.</p>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="PlaceOfBirth" class="form-label-custom">Place of Birth</label>
                                <input asp-for="PlaceOfBirth" class="form-control form-control-custom" list="locationOptions" placeholder="e.g. Royal Palace, High Citadel" />
                                <datalist id="locationOptions">
                                    @foreach (var loc in worldLocations)
                                    {
                                        <option value="@loc.Name"></option>
                                    }
                                </datalist>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="DateOfBirth" class="form-label-custom">Date of Birth</label>
                                <input asp-for="DateOfBirth" class="form-control form-control-custom" placeholder="e.g. 14th August" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="Nationality" class="form-label-custom">Nationality / Realm</label>
                                <input asp-for="Nationality" class="form-control form-control-custom" placeholder="e.g. Indian, Valorian" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FamilyBackground" class="form-label-custom">Family Background</label>
                            <textarea asp-for="FamilyBackground" class="form-control form-control-custom" rows="2" placeholder="Belongs to a royal family..."></textarea>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="Upbringing" class="form-label-custom">Upbringing</label>
                                <textarea asp-for="Upbringing" class="form-control form-control-custom" rows="2" placeholder="Strict military and royal training..."></textarea>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="Education" class="form-label-custom">Education</label>
                                <textarea asp-for="Education" class="form-control form-control-custom" rows="2" placeholder="National Defense Academy, ETF Special Ops..."></textarea>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="KeyEvents" class="form-label-custom">Key Life Events</label>
                                <textarea asp-for="KeyEvents" class="form-control form-control-custom" rows="2" placeholder="Joined ETF, Secret Operation..."></textarea>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Backstory" class="form-label-custom">Full Backstory Narrative</label>
                            <textarea asp-for="Backstory" class="form-control form-control-custom" rows="4" placeholder="Detailed narrative of character's life story..."></textarea>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="SocioeconomicStatus" class="form-label-custom">Socioeconomic Status</label>
                                <input asp-for="SocioeconomicStatus" class="form-control form-control-custom" placeholder="e.g. Royal / Wealthy" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="CurrentResidence" class="form-label-custom">Current Residence</label>
                                <input asp-for="CurrentResidence" class="form-control form-control-custom" list="locationOptions" placeholder="e.g. ETF HQ, Capital City" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="Languages" class="form-label-custom">Languages Spoken</label>
                                <input asp-for="Languages" class="form-control form-control-custom" placeholder="e.g. Hindi, English" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BackgroundDocumentUrl" class="form-label-custom">Background Document File</label>
                            <div class="input-group">
                                <input asp-for="BackgroundDocumentUrl" id="inputBackgroundDocUrl" class="form-control form-control-custom" placeholder="/uploads/background_docs/file.pdf" />
                                <label for="bgDocFileInput" class="btn btn-outline-teal cursor-pointer mb-0">
                                    <i data-lucide="upload" style="width: 14px; height: 14px;" class="me-1"></i> Upload
                                </label>
                                <input type="file" id="bgDocFileInput" class="d-none" />
                            </div>
                        </div>
                    </div>

                    <!-- STEP 5: RELATIONSHIPS -->
                    <div class="tab-pane-content d-none" id="tab-step-5">
                        <div class="form-section-header">
                            <div class="form-section-title">
                                <div class="section-icon-badge">
                                    <i data-lucide="users" style="width: 18px; height: 18px;"></i>
                                </div>
                                <span>Character Relationships</span>
                            </div>
                            <button type="button" class="btn btn-teal px-3 py-1.5 rounded-3 fw-semibold shadow-xs" id="btnAddRelationship">
                                <i data-lucide="plus" style="width: 15px; height: 15px;" class="me-1"></i> Add Relationship
                            </button>
                        </div>
                        <p class="form-section-subtitle">Manage character ties, allies, rivals, family, and romantic relationships.</p>

                        <!-- Beautified Interactive Relationships Table Container -->
                        <div class="card border rounded-3 mb-4 overflow-hidden shadow-xs" style="border-color: #e2e8f0;">
                            <div class="card-header bg-slate-50 border-bottom py-2.5 px-3 d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-slate-800 small text-uppercase" style="letter-spacing: 0.5px;">
                                    <i data-lucide="link-2" style="width: 14px; height: 14px;" class="me-1 text-teal"></i>
                                    Defined Character Ties
                                </span>
                                <span class="badge bg-teal-subtle text-teal-800 rounded-pill px-2.5 py-1 small fw-semibold" id="relCountBadge">0 Relationships</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="relationshipsTable">
                                    <thead class="table-light text-slate-700" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                        <tr>
                                            <th style="width: 32%;">Related Character</th>
                                            <th style="width: 22%;">Relation Type</th>
                                            <th style="width: 32%;">Dynamics / Description</th>
                                            <th class="text-end" style="width: 14%;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="relationshipTableBody">
                                        <!-- Populated via JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- General Relationship Fields -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="Allies" class="form-label-custom">
                                    <i data-lucide="user-check" style="width: 14px; height: 14px; color: #10b981;"></i>
                                    Allies & Friends
                                </label>
                                <input asp-for="Allies" id="fieldAllies" class="form-control form-control-custom mb-1" placeholder="Names of key allies (e.g. Commander Roy, Priya)" />
                                <div id="alliesTagsContainer" class="d-flex flex-wrap gap-1"></div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Enemies" class="form-label-custom">
                                    <i data-lucide="user-x" style="width: 14px; height: 14px; color: #ef4444;"></i>
                                    Enemies & Antagonists
                                </label>
                                <input asp-for="Enemies" id="fieldEnemies" class="form-control form-control-custom mb-1" placeholder="Names of key enemies (e.g. Vikram, General Shadow)" />
                                <div id="enemiesTagsContainer" class="d-flex flex-wrap gap-1"></div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="Family" class="form-label-custom">
                                    <i data-lucide="users" style="width: 14px; height: 14px; color: #3b82f6;"></i>
                                    Family Members
                                </label>
                                <input asp-for="Family" id="fieldFamily" class="form-control form-control-custom mb-1" placeholder="Family relationships (e.g. Damsingh Rathore, Meera Rathore)" />
                                <div id="familyTagsContainer" class="d-flex flex-wrap gap-1"></div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="LoveInterests" class="form-label-custom">
                                    <i data-lucide="heart" style="width: 14px; height: 14px; color: #ec4899;"></i>
                                    Love Interests
                                </label>
                                <input asp-for="LoveInterests" id="fieldLoveInterests" class="form-control form-control-custom mb-1" placeholder="Romantic relationships..." />
                                <div id="loveInterestsTagsContainer" class="d-flex flex-wrap gap-1"></div>
                            </div>
                        </div>

                        <!-- Styled Relationship Diagram Upload Box -->
                        <div class="p-3.5 mt-4 rounded-3 border bg-slate-50" style="border: 1.5px dashed #cbd5e1; background-color: #f8fafc;">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background-color: #f0fdfa; color: #0d9488; border: 1px solid #ccfbf1;">
                                        <i data-lucide="share-2" style="width: 20px; height: 20px;"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-slate-900" style="font-size: 0.9rem;">Relationship Chart / Diagram File</h6>
                                        <span class="text-slate-500 small">Upload mindmap, diagram, or family tree file (SVG, PNG, PDF)</span>
                                    </div>
                                </div>
                                <div class="input-group" style="max-width: 360px;">
                                    <input asp-for="RelationshipChartUrl" id="inputRelChartUrl" class="form-control form-control-custom" placeholder="/uploads/relationship_docs/chart.svg" />
                                    <label for="relChartFileInput" class="btn btn-outline-teal cursor-pointer mb-0">
                                        <i data-lucide="upload" style="width: 14px; height: 14px;" class="me-1"></i> Upload
                                    </label>
                                    <input type="file" id="relChartFileInput" class="d-none" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 6: NOTES & LORE -->
                    <div class="tab-pane-content d-none" id="tab-step-6">
                        <div class="form-section-header">
                            <div class="form-section-title">
                                <div class="section-icon-badge">
                                    <i data-lucide="file-text" style="width: 18px; height: 18px;"></i>
                                </div>
                                <span>Author Notes & Lore</span>
                            </div>
                        </div>
                        <p class="form-section-subtitle">Writing reminders, insignia, custom lore documents, and theme customization.</p>

                        <div class="mb-3">
                            <label asp-for="AuthorNotes" class="form-label-custom">Author's Notes & Writing Hints</label>
                            <textarea asp-for="AuthorNotes" class="form-control form-control-custom" rows="4" placeholder="Personal writing notes, character voice reminders..."></textarea>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="FamilyCrest" class="form-label-custom">Family Crest / Insignia Name</label>
                                <input asp-for="FamilyCrest" class="form-control form-control-custom" placeholder="e.g. Royal Crest, Falcon Emblem" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ThemeColor" class="form-label-custom">Theme Color (Hex)</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input asp-for="ThemeColor" type="color" id="inputThemeColorPicker" class="form-control form-control-color" style="width: 45px; height: 38px; border-radius: 8px; padding: 2px;" value="@(string.IsNullOrWhiteSpace(Model.ThemeColor) ? "#0d9488" : Model.ThemeColor)" />
                                    <input asp-for="ThemeColor" id="inputThemeColorHex" class="form-control form-control-custom flex-grow-1" placeholder="#0d9488" />
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-2">
                                    <span class="small text-muted me-1">Swatches:</span>
                                    <div class="color-swatch-btn" style="background-color: #0d9488;" data-color="#0d9488"></div>
                                    <div class="color-swatch-btn" style="background-color: #3b82f6;" data-color="#3b82f6"></div>
                                    <div class="color-swatch-btn" style="background-color: #8b5cf6;" data-color="#8b5cf6"></div>
                                    <div class="color-swatch-btn" style="background-color: #ec4899;" data-color="#ec4899"></div>
                                    <div class="color-swatch-btn" style="background-color: #f59e0b;" data-color="#f59e0b"></div>
                                    <div class="color-swatch-btn" style="background-color: #ef4444;" data-color="#ef4444"></div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CustomDocumentUrl" class="form-label-custom">Custom Lore / Document File</label>
                            <div class="input-group">
                                <input asp-for="CustomDocumentUrl" id="inputCustomDocUrl" class="form-control form-control-custom" placeholder="/uploads/custom_docs/file.pdf" />
                                <label for="customDocFileInput" class="btn btn-outline-teal cursor-pointer mb-0">
                                    <i data-lucide="upload" style="width: 14px; height: 14px;" class="me-1"></i> Upload
                                </label>
                                <input type="file" id="customDocFileInput" class="d-none" />
                            </div>
                        </div>
                    </div>

                    <!-- Form Action Footer -->
                    <div class="d-flex align-items-center justify-content-between pt-4 mt-4 border-top">
                        <a href="@Url.Action("Index", "Characters", new { storyId = Model.StoryId })" class="btn btn-light border px-4 py-2 rounded-3 text-slate-700">
                            Cancel
                        </a>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-light border px-3 py-2 rounded-3 d-none" id="btnPrevStep">
                                <i data-lucide="arrow-left" style="width: 16px; height: 16px;" class="me-1"></i> Previous
                            </button>
                            <button type="button" class="btn btn-outline-teal px-3 py-2 rounded-3" id="btnNextStep">
                                Next Step <i data-lucide="arrow-right" style="width: 16px; height: 16px;" class="ms-1"></i>
                            </button>
                            <button type="submit" class="btn btn-teal px-4 py-2 rounded-3 shadow-sm">
                                <i data-lucide="save" style="width: 16px; height: 16px;" class="me-1"></i> Save Changes
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Sidebar: Live Preview Card (4-5 cols) -->
            <div class="col-12 col-lg-5 col-xl-4">
                <div class="preview-card">
                    <div class="d-flex align-items-center justify-content-between mb-3 text-start">
                        <span class="small fw-bold text-uppercase text-muted" style="letter-spacing: 0.5px;">Live Preview</span>
                        <i data-lucide="sparkles" style="width: 16px; height: 16px; color: #0d9488;"></i>
                    </div>

                    <div class="avatar-preview-container">
                        <div class="avatar-img-circle">
                            <img id="previewAvatar" src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? $"https://api.dicebear.com/7.x/avataaars/svg?seed={Uri.EscapeDataString(Model.Name ?? "Character")}" : Model.AvatarUrl)" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=Character';" />
                        </div>
                        <div class="avatar-pencil-edit" onclick="document.getElementById('avatarFileInput').click();" data-bs-toggle="tooltip" title="Change Avatar Image">
                            <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                        </div>
                    </div>

                    <h4 class="preview-name" id="previewName">@(string.IsNullOrWhiteSpace(Model.Name) ? "Character Name" : Model.Name)</h4>
                    <span class="preview-role-badge" id="previewRoleBadge">
                        <i data-lucide="shield" style="width: 12px; height: 12px;"></i>
                        <span id="previewRole">@(string.IsNullOrWhiteSpace(Model.Role) ? "Protagonist" : Model.Role)</span>
                    </span>

                    <p class="preview-one-line" id="previewHook">
                        "@(string.IsNullOrWhiteSpace(Model.OneLineDescription) ? "No one-line description set yet." : Model.OneLineDescription)"
                    </p>

                    <div class="preview-stats-grid">
                        <div class="preview-stat-item">
                            <div class="preview-stat-label">Age</div>
                            <div class="preview-stat-value" id="previewAge">@(string.IsNullOrWhiteSpace(Model.Age) ? "—" : Model.Age)</div>
                        </div>
                        <div class="preview-stat-item">
                            <div class="preview-stat-label">Gender</div>
                            <div class="preview-stat-value" id="previewGender">@(string.IsNullOrWhiteSpace(Model.Gender) ? "—" : Model.Gender)</div>
                        </div>
                        <div class="preview-stat-item">
                            <div class="preview-stat-label">Status</div>
                            <div class="preview-stat-value" id="previewStatus">@(string.IsNullOrWhiteSpace(Model.Status) ? "Active" : Model.Status)</div>
                        </div>
                        <div class="preview-stat-item">
                            <div class="preview-stat-label">Alignment</div>
                            <div class="preview-stat-value" id="previewAlignment">@(string.IsNullOrWhiteSpace(Model.Alignment) ? "—" : Model.Alignment)</div>
                        </div>
                    </div>

                    <div class="mt-3 text-start">
                        <div class="preview-stat-label mb-1">Occupation</div>
                        <div class="small fw-semibold text-slate-800" id="previewOccupation">@(string.IsNullOrWhiteSpace(Model.Occupation) ? "Not specified" : Model.Occupation)</div>
                    </div>

                    <div class="mt-3 text-start">
                        <div class="preview-stat-label mb-1">Personality Traits</div>
                        <div id="previewTraitsContainer" class="d-flex flex-wrap gap-1">
                            <!-- Populated via JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal: Preset Avatars -->
<div class="modal fade" id="avatarPresetsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">Select Preset Avatar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3" id="presetAvatarsGrid">
                    <!-- Preset avatars rendered via JS -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add / Edit Relationship -->
<div class="modal fade" id="addRelationshipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-slate-900 d-flex align-items-center gap-2" id="modalRelTitleHeader">
                    <i data-lucide="user-plus" class="text-teal" style="width: 20px; height: 20px; color: #0d9488;"></i>
                    <span>Add Character Relationship</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Duplicate / Error Warning Box -->
                <div id="modalRelError" class="alert alert-danger d-none py-2 px-3 small mb-3 align-items-center gap-2">
                    <i data-lucide="alert-circle" style="width: 16px; height: 16px;" class="flex-shrink-0"></i>
                    <span id="modalRelErrorText"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">
                            Select Existing Character
                            <i data-lucide="info" class="info-tooltip-icon" style="width: 13px; height: 13px;" data-bs-toggle="tooltip" title="Select a character from your story cast to auto-fill their info."></i>
                        </label>
                        <select id="modalRelTargetChar" class="form-select select2-themed form-select-custom mb-2" data-placeholder="Choose Existing Character...">
                            <option value="">-- Choose Existing Character --</option>
                            @foreach (var oc in otherCharacters)
                            {
                                <option value="@oc.Name" data-icon="user" data-avatar="@(string.IsNullOrEmpty(oc.AvatarUrl) ? $"https://api.dicebear.com/7.x/avataaars/svg?seed={Uri.EscapeDataString(oc.Name)}" : oc.AvatarUrl)" data-role="@oc.Role">@oc.Name (@oc.Role)</option>
                            }
                        </select>
                        
                        <label class="form-label-custom mt-2">Or Type New / Custom Character Name</label>
                        <input type="text" id="modalRelCustomName" class="form-control form-control-custom" placeholder="e.g. Damsingh Rathore" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">Role / Archetype</label>
                        <select id="modalRelRole" class="form-select select2-themed form-select-custom">
                            <option value="Supporting" selected data-icon="user-check">Supporting Character</option>
                            <option value="Protagonist" data-icon="star">Protagonist</option>
                            <option value="Antagonist" data-icon="shield-alert">Antagonist</option>
                            <option value="Mentor" data-icon="award">Mentor</option>
                            <option value="Sidekick" data-icon="user-plus">Sidekick</option>
                            <option value="Love Interest" data-icon="heart">Love Interest</option>
                            <option value="Rival" data-icon="swords">Rival</option>
                            <option value="Minor" data-icon="user font-size-12">Minor Character</option>
                        </select>
                    </div>
                </div>

                <!-- Avatar Upload Section for Relationship Character -->
                <div class="p-3 mb-3 border rounded-3 bg-light">
                    <label class="form-label-custom mb-2 d-block">Relationship Character Avatar</label>
                    <div class="d-flex align-items-center gap-3">
                        <img id="modalRelAvatarPreview" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Character" alt="Avatar Preview" class="rounded-circle border bg-white shadow-xs" style="width: 54px; height: 54px; object-fit: cover;" onerror="this.onerror=null; this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=Character';" />
                        <div class="flex-grow-1">
                            <input type="text" id="modalRelAvatarUrl" class="form-control form-control-custom mb-2" placeholder="https://images.unsplash.com/... or upload image below" />
                            <div class="d-flex align-items-center gap-2">
                                <label for="modalRelAvatarFileInput" class="btn btn-sm btn-outline-teal cursor-pointer mb-0">
                                    <i data-lucide="upload" style="width: 14px; height: 14px;" class="me-1"></i> Upload Image
                                </label>
                                <input type="file" id="modalRelAvatarFileInput" accept="image/*" class="d-none" />
                                <span class="small text-muted">Supports JPG, PNG, WebP</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">Relationship Title / Type</label>
                        <select id="modalRelType" class="form-select select2-themed form-select-custom">
                            <option value="Father" data-icon="user">Father</option>
                            <option value="Mother" data-icon="user">Mother</option>
                            <option value="Parent" data-icon="users">Parent</option>
                            <option value="Sibling" data-icon="users">Sibling / Brother / Sister</option>
                            <option value="Child" data-icon="user-plus">Son / Daughter</option>
                            <option value="Ally" data-icon="shield-check">Ally / Friend</option>
                            <option value="Enemy" data-icon="swords">Enemy / Adversary</option>
                            <option value="Love Interest" data-icon="heart">Love Interest / Spouse</option>
                            <option value="Mentor" data-icon="award">Mentor / Guide</option>
                            <option value="Rival" data-icon="zap">Rival</option>
                            <option value="Neutral" data-icon="minus-circle">Neutral / Associate</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label-custom">Dynamics Type</label>
                        <select id="modalRelDynamicsType" class="form-select select2-themed form-select-custom">
                            <option value="Positive" selected data-icon="thumbs-up">Positive (Friendly / Supportive)</option>
                            <option value="Negative" data-icon="thumbs-down">Negative (Hostile / Antagonistic)</option>
                            <option value="Neutral" data-icon="minus">Neutral (Professional / Distant)</option>
                            <option value="Complex" data-icon="git-commit">Complex (Complicated / Mixed)</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom">Dynamics / Relationship Description</label>
                    <textarea id="modalRelNotes" class="form-control form-control-custom" rows="2" placeholder="Standard relationship dynamics, history, or conflict notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-light border px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-teal px-4 rounded-3 shadow-sm" id="btnSaveModalRelationship">
                    <i data-lucide="check" style="width: 15px; height: 15px;" class="me-1"></i> <span id="modalSaveBtnText">Add Relationship</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Custom dropdown helpers
        function toggleDropdown(wrapperId) {
            const allWrappers = document.querySelectorAll('.theme-dropdown-wrapper');
            allWrappers.forEach(w => {
                if (w.id !== wrapperId) w.classList.remove('open');
            });
            const target = document.getElementById(wrapperId);
            if (target) target.classList.toggle('open');
        }

        function selectThemeOption(hiddenFieldId, value, labelText, triggerTextId, wrapperId) {
            const hiddenInput = document.getElementById(hiddenFieldId);
            if (hiddenInput) {
                hiddenInput.value = value;
                hiddenInput.dispatchEvent(new Event('input', { bubbles: true }));
                hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
            const triggerText = document.getElementById(triggerTextId);
            if (triggerText) {
                triggerText.textContent = labelText;
            }
            const wrapper = document.getElementById(wrapperId);
            if (wrapper) {
                wrapper.classList.remove('open');
                wrapper.querySelectorAll('.theme-dropdown-option').forEach(opt => {
                    if (opt.getAttribute('onclick')?.includes(`'${value}'`)) {
                        opt.classList.add('active-option');
                    } else {
                        opt.classList.remove('active-option');
                    }
                });
            }
        }

        // Close custom dropdowns on click outside
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.theme-dropdown-wrapper')) {
                document.querySelectorAll('.theme-dropdown-wrapper').forEach(w => w.classList.remove('open'));
            }
        });

        // Character counter update helper
        function updateCharCounter(inputId, counterId) {
            const input = document.getElementById(inputId);
            const counter = document.getElementById(counterId);
            if (input && counter) {
                const max = input.getAttribute('maxlength') || 100;
                counter.textContent = `${input.value.length}/${max}`;
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // Character counters initialization
            updateCharCounter('inputName', 'name-counter');
            updateCharCounter('inputNicknames', 'nick-counter');
            updateCharCounter('inputAge', 'age-counter');
            updateCharCounter('inputPronouns', 'pronouns-counter');
            updateCharCounter('inputOccupation', 'occ-counter');

            // Stepper Navigation
            const stepperSteps = document.querySelectorAll('.stepper-step');
            const tabContents = document.querySelectorAll('.tab-pane-content');
            const btnPrevStep = document.getElementById('btnPrevStep');
            const btnNextStep = document.getElementById('btnNextStep');

            let currentStep = 1;
            const totalSteps = 6;

            function goToStep(stepNum) {
                if (stepNum < 1) stepNum = 1;
                if (stepNum > totalSteps) stepNum = totalSteps;
                currentStep = stepNum;

                stepperSteps.forEach(btn => {
                    const s = parseInt(btn.getAttribute('data-step'));
                    if (s === stepNum) {
                        btn.classList.add('active');
                        btn.classList.remove('completed');
                    } else if (s < stepNum) {
                        btn.classList.remove('active');
                        btn.classList.add('completed');
                    } else {
                        btn.classList.remove('active');
                        btn.classList.remove('completed');
                    }
                });

                tabContents.forEach(c => {
                    if (c.id === `tab-step-${stepNum}`) {
                        c.classList.remove('d-none');
                    } else {
                        c.classList.add('d-none');
                    }
                });

                // Update Prev/Next buttons
                if (currentStep === 1) {
                    btnPrevStep.classList.add('d-none');
                } else {
                    btnPrevStep.classList.remove('d-none');
                }

                if (currentStep === totalSteps) {
                    btnNextStep.classList.add('d-none');
                } else {
                    btnNextStep.classList.remove('d-none');
                }

                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            stepperSteps.forEach(btn => {
                btn.addEventListener('click', function () {
                    const s = parseInt(this.getAttribute('data-step'));
                    goToStep(s);
                });
            });

            if (btnPrevStep) {
                btnPrevStep.addEventListener('click', function () {
                    goToStep(currentStep - 1);
                });
            }

            if (btnNextStep) {
                btnNextStep.addEventListener('click', function () {
                    goToStep(currentStep + 1);
                });
            }

            // Live Preview Syncing
            const inputName = document.getElementById('inputName');
            const hiddenRole = document.getElementById('Role');
            const hiddenStatus = document.getElementById('Status');
            const hiddenAlignment = document.getElementById('Alignment');
            const inputAge = document.getElementById('inputAge');
            const hiddenGender = document.getElementById('Gender');
            const inputOccupation = document.getElementById('inputOccupation');
            const inputAvatarUrl = document.getElementById('inputAvatarUrl');
            const inputHook = document.getElementById('inputHook');
            const inputTraits = document.getElementById('inputTraits');

            const previewName = document.getElementById('previewName');
            const previewRole = document.getElementById('previewRole');
            const headerRoleBadge = document.getElementById('headerRoleBadge');
            const previewAge = document.getElementById('previewAge');
            const previewGender = document.getElementById('previewGender');
            const previewStatus = document.getElementById('previewStatus');
            const previewAlignment = document.getElementById('previewAlignment');
            const previewOccupation = document.getElementById('previewOccupation');
            const previewAvatar = document.getElementById('previewAvatar');
            const avatarThumbnail = document.getElementById('avatarThumbnail');
            const previewHook = document.getElementById('previewHook');
            const hookCharCounter = document.getElementById('hookCharCounter');
            const previewTraitsContainer = document.getElementById('previewTraitsContainer');

            function updatePreview() {
                if (inputName && previewName) previewName.textContent = inputName.value.trim() || "Character Name";
                if (hiddenRole) {
                    const r = hiddenRole.value || "Protagonist";
                    if (previewRole) previewRole.textContent = r;
                    if (headerRoleBadge) headerRoleBadge.textContent = r;
                }
                if (inputAge && previewAge) previewAge.textContent = inputAge.value.trim() || "—";
                if (hiddenGender && previewGender) previewGender.textContent = hiddenGender.value.trim() || "—";
                if (hiddenStatus && previewStatus) previewStatus.textContent = hiddenStatus.value || "Active";
                if (hiddenAlignment && previewAlignment) previewAlignment.textContent = hiddenAlignment.value || "—";
                if (inputOccupation && previewOccupation) previewOccupation.textContent = inputOccupation.value.trim() || "Not specified";

                if (inputHook && previewHook) {
                    previewHook.textContent = inputHook.value.trim() ? `"${inputHook.value.trim()}"` : '"No one-line description set yet."';
                    if (hookCharCounter) hookCharCounter.textContent = `${inputHook.value.length} / 250`;
                }

                if (inputAvatarUrl) {
                    const url = inputAvatarUrl.value.trim() || `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(inputName?.value || "Character")}`;
                    if (previewAvatar) previewAvatar.src = url;
                    if (avatarThumbnail) avatarThumbnail.src = url;
                }

                if (inputTraits && previewTraitsContainer) {
                    previewTraitsContainer.innerHTML = '';
                    const traits = inputTraits.value.split(',').map(t => t.trim()).filter(t => t.length > 0);
                    if (traits.length === 0) {
                        previewTraitsContainer.innerHTML = '<span class="small text-muted italic">No traits added</span>';
                    } else {
                        traits.forEach(t => {
                            const pill = document.createElement('span');
                            pill.className = 'trait-pill';
                            pill.textContent = t;
                            previewTraitsContainer.appendChild(pill);
                        });
                    }
                }
            }

            [inputName, hiddenRole, hiddenStatus, hiddenAlignment, inputAge, hiddenGender, inputOccupation, inputAvatarUrl, inputHook, inputTraits].forEach(el => {
                if (el) {
                    el.addEventListener('input', updatePreview);
                    el.addEventListener('change', updatePreview);
                }
            });

            updatePreview();

            // Trait suggestions
            document.querySelectorAll('.trait-suggestion').forEach(btn => {
                btn.addEventListener('click', function () {
                    const trait = this.getAttribute('data-trait');
                    if (inputTraits && trait) {
                        let current = inputTraits.value.trim();
                        if (current) {
                            const list = current.split(',').map(s => s.trim());
                            if (!list.includes(trait)) {
                                inputTraits.value = current + ', ' + trait;
                            }
                        } else {
                            inputTraits.value = trait;
                        }
                        inputTraits.dispatchEvent(new Event('input'));
                        updatePreview();
                    }
                });
            });

            // Interactive Tag Chips Setup for Traits, Allies, Enemies, Family, and Love Interests
            function setupTagInput(inputId, containerId, chipClass) {
                const inputEl = document.getElementById(inputId);
                const containerEl = document.getElementById(containerId);
                if (!inputEl || !containerEl) return;

                function renderTags() {
                    containerEl.innerHTML = '';
                    const items = inputEl.value.split(',').map(s => s.trim()).filter(s => s.length > 0);
                    items.forEach((item, idx) => {
                        const chip = document.createElement('span');
                        chip.className = `tag-chip ${chipClass}`;
                        chip.innerHTML = `${item} <button type="button" class="tag-chip-remove" title="Remove">&times;</button>`;
                        chip.querySelector('.tag-chip-remove').addEventListener('click', function (e) {
                            e.stopPropagation();
                            items.splice(idx, 1);
                            inputEl.value = items.join(', ');
                            renderTags();
                            if (inputId === 'inputTraits') updatePreview();
                        });
                        containerEl.appendChild(chip);
                    });
                }

                inputEl.addEventListener('input', renderTags);
                inputEl.addEventListener('change', renderTags);
                renderTags();
            }

            setupTagInput('inputTraits', 'traitsTagsContainer', 'tag-chip-teal');
            setupTagInput('fieldAllies', 'alliesTagsContainer', 'tag-chip-green');
            setupTagInput('fieldEnemies', 'enemiesTagsContainer', 'tag-chip-red');
            setupTagInput('fieldFamily', 'familyTagsContainer', 'tag-chip-blue');
            setupTagInput('fieldLoveInterests', 'loveInterestsTagsContainer', 'tag-chip-pink');

            // AJAX File Upload Helper
            function setupFileUpload(fileInputId, urlInputId, endpoint, formDataKey, successCallback) {
                const fileInput = document.getElementById(fileInputId);
                const urlInput = document.getElementById(urlInputId);
                if (!fileInput) return;

                fileInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (!file) return;

                    const formData = new FormData();
                    formData.append(formDataKey, file);

                    fetch(endpoint, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            if (urlInput) urlInput.value = data.avatarUrl || data.documentUrl || '';
                            if (successCallback) successCallback(data);
                            updatePreview();
                        } else {
                            alert(data.message || 'Upload failed.');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        alert('Error uploading file.');
                    });
                });
            }

            setupFileUpload('avatarFileInput', 'inputAvatarUrl', '/Characters/UploadAvatar', 'file', function (data) {
                if (previewAvatar) previewAvatar.src = data.avatarUrl;
                if (avatarThumbnail) avatarThumbnail.src = data.avatarUrl;
            });

            setupFileUpload('bgDocFileInput', 'inputBackgroundDocUrl', '/Characters/UploadBackgroundDoc', 'file');
            setupFileUpload('relChartFileInput', 'inputRelChartUrl', '/Characters/UploadRelationshipDoc', 'file');
            setupFileUpload('customDocFileInput', 'inputCustomDocUrl', '/Characters/UploadCustomDoc', 'file');

            // Preset Avatars Generation
            const presetGrid = document.getElementById('presetAvatarsGrid');
            if (presetGrid) {
                const styles = ['avataaars', 'bottts', 'lorelei', 'micah', 'personas', 'adventurer'];
                presetGrid.innerHTML = '';
                styles.forEach((style, i) => {
                    for (let j = 1; j <= 2; j++) {
                        const seed = `seed_${style}_${j}`;
                        const imgUrl = `https://api.dicebear.com/7.x/${style}/svg?seed=${seed}`;
                        const col = document.createElement('div');
                        col.className = 'col-4 col-md-3 text-center';
                        col.innerHTML = `
                            <div class="p-2 border rounded-3 cursor-pointer preset-card hover-shadow" style="transition: all 0.2s ease;">
                                <img src="${imgUrl}" alt="${style}" class="rounded-circle mb-2" style="width: 64px; height: 64px; object-fit: cover;" />
                                <div class="small fw-semibold text-capitalize text-truncate">${style}</div>
                            </div>
                        `;
                        col.querySelector('.preset-card').addEventListener('click', function () {
                            if (inputAvatarUrl) inputAvatarUrl.value = imgUrl;
                            updatePreview();
                            const modal = bootstrap.Modal.getInstance(document.getElementById('avatarPresetsModal'));
                            if (modal) modal.hide();
                        });
                        presetGrid.appendChild(col);
                    }
                });
            }

            // Theme Color Picker Sync
            const themePicker = document.getElementById('inputThemeColorPicker');
            const themeHex = document.getElementById('inputThemeColorHex');
            if (themePicker && themeHex) {
                themePicker.addEventListener('input', function () {
                    themeHex.value = this.value;
                });
                themeHex.addEventListener('input', function () {
                    if (this.value.match(/^#[0-9A-Fa-f]{6}$/)) {
                        themePicker.value = this.value;
                    }
                });
            }

            document.querySelectorAll('.color-swatch-btn').forEach(swatch => {
                swatch.addEventListener('click', function () {
                    const color = this.getAttribute('data-color');
                    if (color && themePicker && themeHex) {
                        themePicker.value = color;
                        themeHex.value = color;
                    }
                });
            });

            // ==========================================
            // RELATIONSHIPS MANAGEMENT (WITH EDIT & BEAUTIFIED BADGES)
            // ==========================================
            let relationshipsList = [];
            let editingRelIndex = -1;

            const relJsonInput = document.getElementById('RelationshipsJsonInput');
            const relTableBody = document.getElementById('relationshipTableBody');
            const relCountBadge = document.getElementById('relCountBadge');

            if (relJsonInput && relJsonInput.value.trim()) {
                try {
                    relationshipsList = JSON.parse(relJsonInput.value.trim());
                } catch (e) {
                    relationshipsList = [];
                }
            }

            function renderRelationships() {
                if (!relTableBody) return;
                relTableBody.innerHTML = '';

                if (relCountBadge) {
                    relCountBadge.textContent = `${relationshipsList.length} Relationship${relationshipsList.length === 1 ? '' : 's'}`;
                }

                if (!Array.isArray(relationshipsList) || relationshipsList.length === 0) {
                    relTableBody.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <div class="d-flex flex-column align-items-center gap-2">
                                    <i data-lucide="users-round" style="width: 32px; height: 32px; color: #94a3b8;"></i>
                                    <div class="fw-semibold text-slate-700">No relationships added yet</div>
                                    <div class="small text-slate-500">Click "+ Add Relationship" above to connect this character with cast members.</div>
                                </div>
                            </td>
                        </tr>
                    `;
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                    return;
                }

                relationshipsList.forEach((rel, index) => {
                    const name = rel.name || rel.targetName || rel.TargetName || rel.characterName || 'Unknown Character';
                    const avatar = rel.avatar || rel.avatarUrl || rel.AvatarUrl || `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(name)}`;
                    const rawRelation = rel.relationship || rel.relationType || rel.RelationType || rel.relation || rel.Relation || rel.type || rel.Type || rel.title || rel.Title || '';
                    const relation = (rawRelation && rawRelation.trim().length > 0) ? rawRelation.trim() : 'Related';
                    const role = rel.role || rel.Role || '';
                    const notes = rel.dynamicsText || rel.notes || rel.Notes || rel.description || rel.Description || 'Standard relationship dynamics.';
                    const dynamicsType = rel.dynamicsType || rel.DynamicsType || 'Positive';

                    // Beautified badge for Dynamics Type
                    let dynamicsBadge = '';
                    if (dynamicsType === 'Positive') {
                        dynamicsBadge = '<span class="badge px-2.5 py-1 me-1 rounded-pill d-inline-flex align-items-center" style="background-color: #dcfce7; color: #15803d; border: 1px solid #86efac; font-size: 0.74rem; font-weight: 600;"><i data-lucide="smile" style="width:12px;height:12px;" class="me-1"></i> Positive</span>';
                    } else if (dynamicsType === 'Negative') {
                        dynamicsBadge = '<span class="badge px-2.5 py-1 me-1 rounded-pill d-inline-flex align-items-center" style="background-color: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; font-size: 0.74rem; font-weight: 600;"><i data-lucide="frown" style="width:12px;height:12px;" class="me-1"></i> Negative</span>';
                    } else if (dynamicsType === 'Neutral') {
                        dynamicsBadge = '<span class="badge px-2.5 py-1 me-1 rounded-pill d-inline-flex align-items-center" style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-size: 0.74rem; font-weight: 600;"><i data-lucide="minus-circle" style="width:12px;height:12px;" class="me-1"></i> Neutral</span>';
                    } else {
                        dynamicsBadge = '<span class="badge px-2.5 py-1 me-1 rounded-pill d-inline-flex align-items-center" style="background-color: #f3e8ff; color: #6b21a8; border: 1px solid #d8b4fe; font-size: 0.74rem; font-weight: 600;"><i data-lucide="shuffle" style="width:12px;height:12px;" class="me-1"></i> Complex</span>';
                    }

                    // Role pill HTML only rendered if role is non-empty
                    const roleBadgeHtml = (role && role.trim().length > 0)
                        ? `<span class="badge rounded-pill border mt-1 d-inline-flex align-items-center" style="background-color: #e2e8f0; color: #334155; border: 1px solid #cbd5e1; font-size: 0.68rem; font-weight: 600; padding: 2px 8px;"><i data-lucide="shield" style="width: 10px; height: 10px;" class="me-1"></i>${role.trim()}</span>`
                        : '';

                    // Relation badge (Guaranteed color & icon rendering)
                    const relationBadgeHtml = `<span class="badge px-2.5 py-1 fw-semibold border rounded-pill d-inline-flex align-items-center" style="background-color: #ccfbf1; color: #0f766e; border-color: #99f6e4; font-size: 0.78rem;"><i data-lucide="link-2" style="width: 12px; height: 12px;" class="me-1"></i>${relation}</span>`;

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>
                            <div class="d-flex align-items-center gap-2.5">
                                <img src="${avatar}" alt="${name}" class="rounded-circle border flex-shrink-0 bg-white shadow-xs" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.onerror=null; this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(name)}';" />
                                <div class="d-flex flex-column align-items-start">
                                    <div class="fw-bold text-slate-900" style="font-size: 0.9rem;">${name}</div>
                                    ${roleBadgeHtml}
                                </div>
                            </div>
                        </td>
                        <td>
                            ${relationBadgeHtml}
                        </td>
                        <td>
                            <div class="d-flex flex-column gap-1">
                                <div>${dynamicsBadge}</div>
                                <span class="small text-secondary" style="max-width: 280px; font-size: 0.82rem; line-height: 1.3;">${notes}</span>
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-1">
                                <button type="button" class="btn btn-sm btn-outline-teal py-1 px-2.5 rounded-2 edit-rel-btn" data-index="${index}" title="Edit Relationship">
                                    <i data-lucide="pencil" style="width: 13px; height: 13px;" class="me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 rounded-2 delete-rel-btn" data-index="${index}" title="Delete Relationship">
                                    <i data-lucide="trash-2" style="width: 13px; height: 13px;"></i>
                                </button>
                            </div>
                        </td>
                    `;

                    tr.querySelector('.edit-rel-btn').addEventListener('click', function () {
                        openEditModal(index);
                    });

                    tr.querySelector('.delete-rel-btn').addEventListener('click', function () {
                        if (confirm(`Are you sure you want to remove the relationship with ${name}?`)) {
                            relationshipsList.splice(index, 1);
                            syncRelationships();
                        }
                    });

                    relTableBody.appendChild(tr);
                });

                if (typeof lucide !== 'undefined') lucide.createIcons();
            }

            function syncRelationships() {
                if (relJsonInput) {
                    relJsonInput.value = JSON.stringify(relationshipsList);
                }
                renderRelationships();
            }

            renderRelationships();

            // Modal elements & error helpers
            const modalRelTargetChar = document.getElementById('modalRelTargetChar');
            const modalRelCustomName = document.getElementById('modalRelCustomName');
            const modalRelAvatarUrl = document.getElementById('modalRelAvatarUrl');
            const modalRelAvatarPreview = document.getElementById('modalRelAvatarPreview');
            const modalRelAvatarFileInput = document.getElementById('modalRelAvatarFileInput');
            const modalRelRole = document.getElementById('modalRelRole');
            const modalRelType = document.getElementById('modalRelType');
            const modalRelDynamicsType = document.getElementById('modalRelDynamicsType');
            const modalRelNotes = document.getElementById('modalRelNotes');
            const modalTitleHeader = document.getElementById('modalRelTitleHeader');
            const modalSaveBtnText = document.getElementById('modalSaveBtnText');
            const modalRelError = document.getElementById('modalRelError');
            const modalRelErrorText = document.getElementById('modalRelErrorText');

            function showModalError(msg) {
                if (modalRelErrorText && modalRelError) {
                    modalRelErrorText.textContent = msg;
                    modalRelError.classList.remove('d-none');
                    modalRelError.classList.add('d-flex');
                } else {
                    alert(msg);
                }
            }

            function clearModalError() {
                if (modalRelError) {
                    modalRelError.classList.add('d-none');
                    modalRelError.classList.remove('d-flex');
                }
                if (modalRelErrorText) modalRelErrorText.textContent = '';
            }

            // Open Modal in ADD mode
            const btnAddRel = document.getElementById('btnAddRelationship');
            if (btnAddRel) {
                btnAddRel.addEventListener('click', function () {
                    editingRelIndex = -1;
                    clearModalError();

                    if (modalTitleHeader) {
                        modalTitleHeader.innerHTML = '<i data-lucide="user-plus" class="text-teal" style="width: 20px; height: 20px; color: #0d9488;"></i> <span>Add Character Relationship</span>';
                    }
                    if (modalSaveBtnText) modalSaveBtnText.textContent = 'Add Relationship';

                    // Clear fields & enable inputs
                    if (modalRelTargetChar) modalRelTargetChar.value = '';
                    if (modalRelCustomName) {
                        modalRelCustomName.value = '';
                        modalRelCustomName.removeAttribute('disabled');
                    }
                    if (modalRelAvatarUrl) modalRelAvatarUrl.value = '';
                    if (modalRelAvatarPreview) modalRelAvatarPreview.src = 'https://api.dicebear.com/7.x/avataaars/svg?seed=Character';
                    if (modalRelRole) modalRelRole.value = 'Supporting';
                    if (modalRelType) modalRelType.value = 'Ally';
                    if (modalRelDynamicsType) modalRelDynamicsType.value = 'Positive';
                    if (modalRelNotes) modalRelNotes.value = '';

                    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('addRelationshipModal'));
                    modal.show();
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                });
            }

            // Open Modal in EDIT mode
            function openEditModal(index) {
                editingRelIndex = index;
                clearModalError();

                const rel = relationshipsList[index];
                if (!rel) return;

                const name = rel.name || rel.targetName || rel.TargetName || rel.characterName || '';
                const avatar = rel.avatar || rel.avatarUrl || rel.AvatarUrl || '';
                const relation = rel.relationship || rel.relationType || rel.RelationType || rel.relation || rel.Relation || rel.type || rel.Type || 'Father';
                const role = rel.role || rel.Role || 'Supporting';
                const dynamicsType = rel.dynamicsType || rel.DynamicsType || 'Positive';
                const notes = rel.dynamicsText || rel.notes || rel.Notes || rel.description || '';

                if (modalTitleHeader) {
                    modalTitleHeader.innerHTML = `<i data-lucide="pencil" class="text-teal" style="width: 20px; height: 20px; color: #0d9488;"></i> <span>Edit Relationship with ${name}</span>`;
                }
                if (modalSaveBtnText) modalSaveBtnText.textContent = 'Save Relationship';

                // Pre-fill dropdown or custom text
                let matchedDropdown = false;
                if (modalRelTargetChar) {
                    for (let i = 0; i < modalRelTargetChar.options.length; i++) {
                        if (modalRelTargetChar.options[i].value.toLowerCase() === name.toLowerCase()) {
                            modalRelTargetChar.selectedIndex = i;
                            matchedDropdown = true;
                            break;
                        }
                    }
                    if (!matchedDropdown) modalRelTargetChar.value = '';
                }

                if (modalRelCustomName) {
                    modalRelCustomName.value = name;
                    modalRelCustomName.removeAttribute('disabled');
                }

                if (modalRelRole) modalRelRole.value = role;
                if (modalRelAvatarUrl) modalRelAvatarUrl.value = avatar;
                if (modalRelAvatarPreview) {
                    modalRelAvatarPreview.src = avatar || `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(name)}`;
                }

                // Match relation dropdown option
                if (modalRelType) {
                    let matchedRelation = false;
                    for (let i = 0; i < modalRelType.options.length; i++) {
                        if (modalRelType.options[i].value.toLowerCase() === relation.toLowerCase() ||
                            modalRelType.options[i].text.toLowerCase().includes(relation.toLowerCase())) {
                            modalRelType.selectedIndex = i;
                            matchedRelation = true;
                            break;
                        }
                    }
                    if (!matchedRelation) modalRelType.value = 'Father';
                }

                if (modalRelDynamicsType) modalRelDynamicsType.value = dynamicsType;
                if (modalRelNotes) modalRelNotes.value = notes;

                const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('addRelationshipModal'));
                modal.show();
                if (typeof lucide !== 'undefined') lucide.createIcons();
            }

            // AUTO-FILL WHEN SELECTING FROM DROPDOWN
            if (modalRelTargetChar) {
                modalRelTargetChar.addEventListener('change', function () {
                    clearModalError();
                    const opt = this.selectedOptions[0];
                    if (opt && opt.value) {
                        // User selected an existing character: auto-fill custom name, avatar, and role!
                        if (modalRelCustomName) {
                            modalRelCustomName.value = opt.value;
                            modalRelCustomName.removeAttribute('disabled');
                        }
                        
                        const av = opt.getAttribute('data-avatar');
                        const r = opt.getAttribute('data-role');
                        if (av && modalRelAvatarUrl) {
                            modalRelAvatarUrl.value = av;
                            if (modalRelAvatarPreview) modalRelAvatarPreview.src = av;
                        }
                        if (r && modalRelRole) modalRelRole.value = r;
                    } else {
                        // User selected blank dropdown option
                        if (modalRelCustomName) {
                            modalRelCustomName.removeAttribute('disabled');
                            modalRelCustomName.focus();
                        }
                        if (modalRelAvatarUrl) modalRelAvatarUrl.value = '';
                        if (modalRelAvatarPreview) modalRelAvatarPreview.src = 'https://api.dicebear.com/7.x/avataaars/svg?seed=Character';
                    }
                });
            }

            // CLEAR DROPDOWN SELECTION WHEN TYPING CUSTOM NAME
            if (modalRelCustomName) {
                modalRelCustomName.addEventListener('input', function () {
                    clearModalError();
                    if (this.value.trim().length > 0) {
                        const nameVal = this.value.trim();
                        if (modalRelAvatarUrl && !modalRelAvatarUrl.value.trim()) {
                            if (modalRelAvatarPreview) {
                                modalRelAvatarPreview.src = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(nameVal)}`;
                            }
                        }
                    }
                });
            }

            if (modalRelAvatarUrl && modalRelAvatarPreview) {
                modalRelAvatarUrl.addEventListener('input', function () {
                    modalRelAvatarPreview.src = this.value || 'https://api.dicebear.com/7.x/avataaars/svg?seed=Character';
                });
            }

            if (modalRelAvatarFileInput) {
                modalRelAvatarFileInput.addEventListener('change', async function () {
                    if (!this.files || !this.files[0]) return;
                    const formData = new FormData();
                    formData.append('file', this.files[0]);
                    try {
                        const resp = await fetch('/Characters/UploadAvatar', {
                            method: 'POST',
                            body: formData
                        });
                        const data = await resp.json();
                        if (data.success && data.avatarUrl) {
                            if (modalRelAvatarUrl) modalRelAvatarUrl.value = data.avatarUrl;
                            if (modalRelAvatarPreview) modalRelAvatarPreview.src = data.avatarUrl;
                        }
                    } catch (e) {
                        console.error("Avatar upload failed:", e);
                    }
                });
            }

            // Save relationship with DUPLICATE CHECK & ALL ALIASES
            const btnSaveModalRel = document.getElementById('btnSaveModalRelationship');
            if (btnSaveModalRel) {
                btnSaveModalRel.addEventListener('click', function () {
                    clearModalError();

                    const selChar = modalRelTargetChar ? modalRelTargetChar.value.trim() : '';
                    const customChar = modalRelCustomName ? modalRelCustomName.value.trim() : '';
                    const targetName = customChar || selChar;
                    const currentName = (inputName ? inputName.value.trim() : '@Model.Name').trim();

                    if (!targetName) {
                        showModalError('Please select an existing character or enter a custom character name.');
                        return;
                    }

                    // 1. Prevent self-relationship
                    if (currentName && targetName.toLowerCase() === currentName.toLowerCase()) {
                        showModalError(`A character cannot have a relationship with themselves (${targetName}).`);
                        return;
                    }

                    // 2. Prevent duplicate character relationship
                    const duplicateIndex = relationshipsList.findIndex((rel, idx) => {
                        if (editingRelIndex >= 0 && idx === editingRelIndex) return false;
                        const relName = (rel.name || rel.targetName || rel.TargetName || rel.characterName || '').trim();
                        return relName.toLowerCase() === targetName.toLowerCase();
                    });

                    if (duplicateIndex >= 0) {
                        showModalError(`A relationship with "${targetName}" already exists! Please edit the existing entry in the table.`);
                        return;
                    }

                    const roleVal = modalRelRole ? modalRelRole.value : 'Supporting';
                    const relationType = modalRelType ? modalRelType.value : 'Father';
                    const dynamicsType = modalRelDynamicsType ? modalRelDynamicsType.value : 'Positive';
                    const notes = modalRelNotes ? modalRelNotes.value.trim() : '';
                    const avatarUrl = (modalRelAvatarUrl && modalRelAvatarUrl.value.trim()) || `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(targetName || 'Character')}`;

                    // Object containing all property name variants to guarantee compatibility across views
                    const relObj = {
                        id: editingRelIndex >= 0 ? (relationshipsList[editingRelIndex].id || ("rel-" + Date.now())) : ("rel-" + Date.now()),
                        name: targetName,
                        subtitle: "Story Character",
                        role: roleVal,
                        Role: roleVal,
                        avatar: avatarUrl,
                        avatarUrl: avatarUrl,
                        AvatarUrl: avatarUrl,
                        relationship: relationType,
                        relationType: relationType,
                        RelationType: relationType,
                        relation: relationType,
                        type: relationType,
                        Type: relationType,
                        dynamicsType: dynamicsType,
                        DynamicsType: dynamicsType,
                        dynamicsText: notes,
                        notes: notes,
                        Notes: notes,
                        description: notes,
                        targetName: targetName,
                        TargetName: targetName
                    };

                    if (editingRelIndex >= 0) {
                        relationshipsList[editingRelIndex] = relObj;
                    } else {
                        relationshipsList.push(relObj);
                    }

                    syncRelationships();

                    // Hide modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addRelationshipModal'));
                    if (modal) modal.hide();
                    editingRelIndex = -1;
                });
            }
        });
    </script>
}
