                            </div>
                        </div>

                        <div style="border-left: 1px solid rgba(255,255,255,0.12); padding-left: 1rem;">
                            <span class="text-slate-400 d-block text-uppercase fw-semibold" style="font-size: 10px; letter-spacing: 0.5px;">Reading Time</span>
                            <span class="text-white fw-bold d-block" style="font-size: 20px; line-height: 1.2;">@readingTimeStr</span>
                        </div>

                        <div style="border-left: 1px solid rgba(255,255,255,0.12); padding-left: 1rem;">
