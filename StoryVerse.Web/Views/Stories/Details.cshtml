        </div>

        <div class="action-card">
            <div class="action-icon-box" style="background: #FEF3C7; color: #D97706;">
                <i data-lucide="calendar" style="width: 20px; height: 20px;"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-0" style="font-size: 12.5px;">Timeline</h6>
            <span class="text-muted" style="font-size: 11px;">@Model.TimelineEvents.Count Events</span>
        </div>

        <div class="action-card">
            <div class="action-icon-box" style="background: #FFF7ED; color: #EA580C;">
                <i data-lucide="search" style="width: 20px; height: 20px;"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-0" style="font-size: 12.5px;">Research</h6>
            <span class="text-muted" style="font-size: 11px;">@Model.ResearchNotes.Count Items</span>
        </div>

        <!-- Notes — Soon -->
        <div class="action-card" style="opacity: 0.75; cursor: not-allowed;">
            <span class="soon-badge">Soon</span>
            <div class="action-icon-box" style="background: #FEF2F2; color: #DC2626;">
                <i data-lucide="sticky-note" style="width: 20px; height: 20px;"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-0" style="font-size: 12.5px;">Notes</h6>
            <span class="text-muted" style="font-size: 11px;">@(Model.ResearchNotes?.Count ?? 0) Notes</span>
        </div>

        <!-- Assets — Soon -->
        <div class="action-card" style="opacity: 0.75; cursor: not-allowed;">
            <span class="soon-badge">Soon</span>
            <div class="action-icon-box" style="background: #F5F3FF; color: #7C3AED;">
                <i data-lucide="folder" style="width: 20px; height: 20px;"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-0" style="font-size: 12.5px;">Assets</h6>
            <span class="text-muted" style="font-size: 11px;">@Model.Assets.Count Files</span>
        </div>
    </div>

    <!-- Middle Row: Synopsis, Tagline, At A Glance -->
    <div class="row g-3 g-lg-4 sv-section-gap info-cards-row">
        
        <!-- Story Synopsis -->
        <div class="col-lg-4">
            <div class="content-card">
                <!-- Pinned header -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-shrink-0">
                    <div class="d-flex align-items-center gap-2">
                        <i data-lucide="book-open" style="width: 18px; height: 18px; color: #0D9488;"></i>
                        <h6 class="fw-bold text-slate-900 mb-0" style="font-size: 15px;">Story Synopsis</h6>
                    </div>
                    <a href="@Url.Action("Edit", "Stories", new { id = Model.Id })" class="text-decoration-none fw-semibold flex-shrink-0" style="font-size: 12px; color: #0D9488;">Edit</a>
                </div>

                <!-- Scrollable body -->
                <div class="card-scroll-body">
                    @if (!string.IsNullOrWhiteSpace(Model.Synopsis))
                    {
                        <p class="text-slate-600 mb-0" style="font-size: 12.5px; line-height: 1.7; white-space: pre-line;">
                            @Model.Synopsis
                        </p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0" style="font-size: 12.5px;">No synopsis added yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Short Tagline with Feather Inkwell Art -->
        <div class="col-lg-4">
            <div class="content-card position-relative overflow-hidden tagline-card" style="background: linear-gradient(135deg, #FFFDF7 0%, #FFFBEE 100%);">
                <!-- Pinned header -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-shrink-0">
                    <div class="d-flex align-items-center gap-2">
                        <i data-lucide="quote" style="width: 18px; height: 18px; color: #D97706;"></i>
                        <h6 class="fw-bold text-slate-900 mb-0" style="font-size: 15px;">Short Tagline</h6>
                    </div>
                    <a href="@Url.Action("Edit", "Stories", new { id = Model.Id })" class="text-decoration-none fw-semibold flex-shrink-0" style="font-size: 12px; color: #0D9488;">Edit</a>
                </div>

                <!-- Scrollable body -->
                <div class="card-scroll-body d-flex flex-column py-1">
                    @if (!string.IsNullOrWhiteSpace(Model.Tagline))
                    {
                        var taglineLen = Model.Tagline.Length;
                        string fontSize = taglineLen > 140 ? "18.5px" : (taglineLen > 80 ? "22px" : "28px");
                        string lineHeight = taglineLen > 140 ? "1.45" : "1.3";
                        <div class="my-auto px-2">
                            <p class="font-calligraphy text-center mb-0" style="font-size: @fontSize; color: #92400E; line-height: @lineHeight;">
                                "@Model.Tagline"
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="my-auto">
                            <p class="text-muted text-center fst-italic mb-0" style="font-size: 13px;">No tagline added yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Story At A Glance -->
        <div class="col-lg-4">
            <div class="content-card">
                <!-- Pinned header -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-shrink-0">
                    <div class="d-flex align-items-center gap-2">
                        <i data-lucide="layout" style="width: 18px; height: 18px; color: #4F46E5;"></i>
                        <h6 class="fw-bold text-slate-900 mb-0" style="font-size: 15px;">Story At A Glance</h6>
                    </div>
                    <a href="@Url.Action("Edit", "Stories", new { id = Model.Id })" class="text-decoration-none fw-semibold flex-shrink-0" style="font-size: 12px; color: #0D9488;">Edit</a>
                </div>

                <!-- Scrollable body -->
                <div class="card-scroll-body">
                    <div class="d-flex flex-column gap-1" style="font-size: 12.5px;">
                        <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #F1F5F9 !important;">
                            <span class="text-slate-500 font-medium"><i data-lucide="compass" class="me-1.5 text-muted" style="width: 13px; height: 13px;"></i> POV</span>
                            <span class="fw-bold text-slate-800">@(string.IsNullOrEmpty(Model.PointOfView) ? "Not specified" : Model.PointOfView)</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #F1F5F9 !important;">
                            <span class="text-slate-500 font-medium"><i data-lucide="clock" class="me-1.5 text-muted" style="width: 13px; height: 13px;"></i> Time Period</span>
                            <span class="fw-bold text-slate-800">@(string.IsNullOrEmpty(Model.TimePeriod) ? "Not specified" : Model.TimePeriod)</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #F1F5F9 !important;">
                            <span class="text-slate-500 font-medium"><i data-lucide="globe" class="me-1.5 text-muted" style="width: 13px; height: 13px;"></i> Language</span>
                            <span class="fw-bold text-slate-800">@(string.IsNullOrEmpty(Model.Language) ? "Not specified" : Model.Language)</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #F1F5F9 !important;">
                            <span class="text-slate-500 font-medium"><i data-lucide="target" class="me-1.5 text-muted" style="width: 13px; height: 13px;"></i> Target Audience</span>
                            <span class="fw-bold text-slate-800">@(string.IsNullOrEmpty(Model.TargetAudience) ? "Not specified" : Model.TargetAudience)</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #F1F5F9 !important;">
                            <span class="text-slate-500 font-medium"><i data-lucide="layers" class="me-1.5 text-muted" style="width: 13px; height: 13px;"></i> Themes</span>
                            <span class="fw-bold text-slate-800 text-end" style="max-width: 160px;">@(string.IsNullOrEmpty(Model.Themes) ? "Not specified" : Model.Themes)</span>
                        </div>

                        <div class="d-flex justify-content-between py-2">
                            <span class="text-slate-500 font-medium"><i data-lucide="smile" class="me-1.5 text-muted" style="width: 13px; height: 13px;"></i> Tone</span>
                            <span class="fw-bold text-slate-800">@(string.IsNullOrEmpty(Model.Tone) ? "Not specified" : Model.Tone)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Main Content Grid: Manuscript Overview (Left) + Goals & Progress (Right) -->
            <span class="text-muted" style="font-size: 11px;">@Model.Assets.Count Assets</span>
        </div>

        <div class="action-card">
            <div class="action-icon-box" style="background: #F8FAFC; color: #475569;">
                <i data-lucide="pie-chart" style="width: 20px; height: 20px;"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-0" style="font-size: 12.5px;">Progress</h6>
            <span class="text-muted" style="font-size: 11px;">@completedPercent% Completed</span>
        </div>
    </div>

    <!-- MAIN TWO COLUMN CONTENT -->
    <div class="row g-4 mb-4">
        <!-- LEFT COLUMN: Manuscript Overview -->
        <div class="col-12 col-xl-8">
            <div class="detail-card h-100">
                <div class="detail-card-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i data-lucide="book" style="width: 18px; height: 18px; color: #0D9488;"></i>
                        <h5 class="fw-bold text-slate-900 mb-0" style="font-size: 16px;">Manuscript Overview</h5>
                    </div>
                    <a href="@Url.Action("Index", "Chapters", new { storyId = Model.Id })" class="text-decoration-none fw-bold d-inline-flex align-items-center" style="font-size: 12.5px; color: #0D9488;">
                        View All Chapters <i data-lucide="chevron-right" class="ms-1" style="width: 14px; height: 14px;"></i>
                    </a>
                </div>

                <!-- Scrollable accordion list -->
                <div class="card-scroll-body">

                <!-- Accordion Parts List -->
                @if (Model.StoryParts != null && Model.StoryParts.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var part in Model.StoryParts.OrderBy(p => p.Order))
                        {
                            var partChapters = part.Chapters?.OrderBy(c => c.Order).ToList() ?? new List<StoryVerse.Core.Entities.Chapter>();
                            bool isPart1 = part.Order == 1;

                            <div class="border rounded-3 overflow-hidden" style="border-color: #E2E8F0 !important;">
                                <div class="part-header d-flex justify-content-between align-items-center" 
                                     data-bs-toggle="collapse" 
                                     data-bs-target="#partCollapse_@part.Id" 
                                     aria-expanded="@(isPart1 ? "true" : "false")">
                                    <span class="fw-bold">@part.Title</span>
                                    <span class="text-muted small fw-normal">@partChapters.Count Chapters <i data-lucide="chevron-down" class="ms-1" style="width: 14px; height: 14px;"></i></span>
                                </div>

                                <div id="partCollapse_@part.Id" class="collapse @(isPart1 ? "show" : "")">
                                    <div class="bg-white">
                                        @foreach (var ch in partChapters)
                                        {
                                            string statusBadgeClass = ch.Status == "Completed" ? "badge-status-completed" : (ch.Status == "InProgress" ? "badge-status-inprogress" : "badge-status-planned");
                                            string statusText = ch.Status == "Completed" ? "Completed" : (ch.Status == "InProgress" ? "In Progress" : "Planned");

                                            <a href="@Url.Action("Editor", "Chapters", new { storyId = Model.Id, chapterId = ch.Id })" class="chapter-row text-decoration-none">
                                                <div class="d-flex align-items-center gap-3">
                                                    <span class="fw-bold text-slate-400" style="width: 20px;">@ch.Order.ToString("D2")</span>
                                                    <span class="fw-semibold text-slate-800">@ch.Title</span>
                                                </div>

                                                <div class="d-flex align-items-center gap-4">
                                                    <span class="text-muted" style="font-size: 12px;">@(ch.WordCount > 0 ? $"{ch.WordCount.ToString("N0")} words" : "--")</span>
                                                    <span class="@statusBadgeClass">@statusText</span>
                                                    <i data-lucide="edit-3" class="text-teal-600" style="width: 15px; height: 15px;"></i>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i data-lucide="book-open" class="text-muted mb-3" style="width: 36px; height: 36px; opacity: 0.3;"></i>
                        <h6 class="fw-bold text-slate-700 mb-1" style="font-size: 14px;">No Chapters Created Yet</h6>
                        <p class="text-muted small mb-4" style="font-size: 12px;">Start organizing your story by adding parts and chapters.</p>
                        <span class="d-inline-flex align-items-center gap-2 px-4 py-2 rounded-pill fw-bold" 
                              style="background: linear-gradient(135deg, #F59E0B22, #EF444422); border: 1.5px dashed #F59E0B; color: #D97706; font-size: 12.5px; cursor: default;">
                            <i data-lucide="clock" style="width: 15px; height: 15px;"></i>
                            Chapter Management — Coming Soon
                        </span>
                    </div>
                }
                </div><!-- end card-scroll-body -->
            </div>
        </div>

        <!-- Right Column: Writing Goals + Manuscript Progress -->
        <div class="col-lg-4 d-flex flex-column gap-3">
            
            <!-- Writing Goals Card -->
            <div class="content-card goals-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-slate-900 mb-0" style="font-size: 15px;">Writing Goals</h6>
                    <a href="#" class="text-decoration-none fw-semibold" style="font-size: 12px; color: #0D9488;">Edit Goals</a>
                </div>

                <div class="d-flex flex-column" style="gap: 0.9rem;">
                    <!-- Daily Goal -->
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <i data-lucide="sun" class="text-amber-500" style="width: 16px; height: 16px; color: #F59E0B;"></i>
                                <span class="fw-bold text-slate-800" style="font-size: 12.5px;">Daily Goal</span>
                            </div>
                            <span class="fw-bold text-slate-800" style="font-size: 12px;">
                                @dailyWrittenVal.ToString("N0") / @dailyGoalVal.ToString("N0") words
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress rounded-pill bg-slate-100 flex-grow-1" style="height: 6px;">
                                <div class="progress-bar rounded-pill" style="width: @(Math.Min(100, dailyPercent))%; background-color: #0D9488;"></div>
                            </div>
                            <span class="fw-bold text-teal" style="font-size: 11px; width: 34px; text-align: right; color: #0D9488;">@dailyPercent%</span>
                        </div>
                    </div>

                    <!-- Weekly Goal -->
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <i data-lucide="calendar" class="text-rose-500" style="width: 16px; height: 16px; color: #F43F5E;"></i>
                                <span class="fw-bold text-slate-800" style="font-size: 12.5px;">Weekly Goal</span>
                            </div>
                            <span class="fw-bold text-slate-800" style="font-size: 12px;">
                                @weeklyWrittenVal.ToString("N0") / @weeklyGoalVal.ToString("N0") words
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress rounded-pill bg-slate-100 flex-grow-1" style="height: 6px;">
                                <div class="progress-bar rounded-pill" style="width: @(Math.Min(100, weeklyPercent))%; background-color: #F43F5E;"></div>
                            </div>
                            <span class="fw-bold text-rose-500" style="font-size: 11px; width: 34px; text-align: right; color: #F43F5E;">@weeklyPercent%</span>
                        </div>
                    </div>

                    <!-- Monthly Goal -->
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <i data-lucide="target" class="text-purple-600" style="width: 16px; height: 16px; color: #9333EA;"></i>
                                <span class="fw-bold text-slate-800" style="font-size: 12.5px;">Monthly Goal</span>
                            </div>
                            <span class="fw-bold text-slate-800" style="font-size: 12px;">
                                @monthlyWrittenVal.ToString("N0") / @monthlyGoalVal.ToString("N0") words
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress rounded-pill bg-slate-100 flex-grow-1" style="height: 6px;">
                                <div class="progress-bar rounded-pill" style="width: @(Math.Min(100, monthlyPercent))%; background-color: #9333EA;"></div>
                            </div>
                            <span class="fw-bold text-purple-600" style="font-size: 11px; width: 34px; text-align: right; color: #9333EA;">@monthlyPercent%</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex align-items-center gap-2 text-amber-600 font-semibold" style="border-color: #F1F5F9 !important; font-size: 12.5px; color: #D97706;">
                    <i data-lucide="flame" style="width: 16px; height: 16px;"></i> Writing Streak: <strong>@(userGoal?.CurrentStreakDays ?? 0) days</strong>
                </div>
            </div>

            <!-- Manuscript Progress (Donut Chart) Card -->
            <div class="content-card">
                <h6 class="fw-bold text-slate-900 mb-3" style="font-size: 15px;">Manuscript Progress</h6>

                @{
                    int offsetComp = 0;
                    int offsetInProg = -completedPercent;
                    int offsetPlan = -(completedPercent + inProgressPercent);
                    int overallProgressDisplay = totalChaptersCount > 0 ? (int)Math.Round((double)completedCount / totalChaptersCount * 100) : progress;
                }

                <div class="d-flex align-items-center justify-content-between">
                    <!-- SVG Dynamic Donut Chart -->
                    <div class="donut-chart-container">
                        <svg viewBox="0 0 36 36" class="w-full h-full">
                            <path class="circle-bg"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                  fill="none"
                                  stroke="#F1F5F9"
                                  stroke-width="3.8" />
                            
                            @if (completedPercent > 0)
                            {
                                <path class="circle"
                                      stroke-dasharray="@completedPercent, 100"
                                      stroke-dashoffset="@offsetComp"
                                      d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                      fill="none"
                                      stroke="#0D9488"
                                      stroke-width="3.8"
                                      stroke-linecap="round" />
                            }

                            @if (inProgressPercent > 0)
                            {
                                <path class="circle"
                                      stroke-dasharray="@inProgressPercent, 100"
                                      stroke-dashoffset="@offsetInProg"
                                      d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                      fill="none"
                                      stroke="#2563EB"
                                      stroke-width="3.8"
                                      stroke-linecap="round" />
                            }

                            @if (plannedPercent > 0)
                            {
                                <path class="circle"
                                      stroke-dasharray="@plannedPercent, 100"
                                      stroke-dashoffset="@offsetPlan"
                                      d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                      fill="none"
                                      stroke="#F59E0B"
                                      stroke-width="3.8"
                                      stroke-linecap="round" />
                            }
                        </svg>

                        <div class="donut-center-label">
                            <span class="fw-bold text-slate-900" style="font-size: 22px; line-height: 1;">@overallProgressDisplay%</span>
                            <span class="text-muted" style="font-size: 9px; font-weight: 600;">Overall Progress</span>
                        </div>
                    </div>

                    <!-- Legend Breakdown -->
                    <div class="d-flex flex-column gap-2" style="font-size: 12px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width: 8px; height: 8px; background: #0D9488;"></span>
                            <span class="text-slate-600 font-medium">Completed</span>
                            <span class="fw-bold text-slate-900 ms-auto">@completedCount (@completedPercent%)</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width: 8px; height: 8px; background: #2563EB;"></span>
                            <span class="text-slate-600 font-medium">In Progress</span>
                            <span class="fw-bold text-slate-900 ms-auto">@inProgressCount (@inProgressPercent%)</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width: 8px; height: 8px; background: #F59E0B;"></span>
                            <span class="text-slate-600 font-medium">Planned</span>
                            <span class="fw-bold text-slate-900 ms-auto">@plannedCount (@plannedPercent%)</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width: 8px; height: 8px; background: #EF4444;"></span>
                            <span class="text-slate-600 font-medium">On Hold</span>
                            <span class="fw-bold text-slate-900 ms-auto">@onHoldCount (@onHoldPercent%)</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width: 8px; height: 8px; background: #94A3B8;"></span>
                            <span class="text-slate-600 font-medium">Archived</span>
                            <span class="fw-bold text-slate-900 ms-auto">@archivedCount (@archivedPercent%)</span>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- Story Elements Summary Row (7 Cards) -->
    <div class="content-card sv-section-gap">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-slate-900 mb-0" style="font-size: 15px;">Story Elements</h6>
        </div>

        <div class="elements-grid">
            <div class="element-card">
                <i data-lucide="users" class="mb-1 text-purple-600" style="width: 18px; height: 18px; color: #9333EA;"></i>
                <span class="text-slate-500 d-block" style="font-size: 11px;">Characters</span>
                <span class="fw-bold text-slate-900" style="font-size: 20px;">@Model.Characters.Count</span>
                <span class="text-muted d-block" style="font-size: 10px;">Developed</span>
            </div>

            <div class="element-card">
                <i data-lucide="map-pin" class="mb-1 text-teal" style="width: 18px; height: 18px; color: #0D9488;"></i>
                <span class="text-slate-500 d-block" style="font-size: 11px;">Locations</span>
                <span class="fw-bold text-slate-900" style="font-size: 20px;">@Model.Locations.Count</span>
                <span class="text-muted d-block" style="font-size: 10px;">Built</span>
            </div>

            <div class="element-card">
                <i data-lucide="calendar" class="mb-1 text-blue-600" style="width: 18px; height: 18px; color: #2563EB;"></i>
                <span class="text-slate-500 d-block" style="font-size: 11px;">Timeline Events</span>
                <span class="fw-bold text-slate-900" style="font-size: 20px;">@Model.TimelineEvents.Count</span>
                <span class="text-muted d-block" style="font-size: 10px;">Mapped</span>
            </div>

            <!-- Story Arcs — Soon -->
            <div class="element-card position-relative" style="opacity: 0.72; cursor: not-allowed;">
                <span class="soon-badge">Soon</span>
                <i data-lucide="git-branch" class="mb-1" style="width: 18px; height: 18px; color: #F43F5E;"></i>
                <span class="text-slate-500 d-block" style="font-size: 11px;">Story Arcs</span>
                <span class="fw-bold text-slate-900" style="font-size: 20px;">@Model.StoryArcs.Count</span>
                <span class="text-muted d-block" style="font-size: 10px;">Active</span>
            </div>

            <div class="element-card">
                <i data-lucide="file-text" class="mb-1 text-cyan-600" style="width: 18px; height: 18px; color: #0891B2;"></i>
                <span class="text-slate-500 d-block" style="font-size: 11px;">Research Items</span>
                <span class="fw-bold text-slate-900" style="font-size: 20px;">@Model.ResearchNotes.Count</span>
                <span class="text-muted d-block" style="font-size: 10px;">Collected</span>
            </div>

            <!-- Notes — Soon -->
            <div class="element-card position-relative" style="opacity: 0.72; cursor: not-allowed;">
                <span class="soon-badge">Soon</span>
                <i data-lucide="sticky-note" class="mb-1" style="width: 18px; height: 18px; color: #F59E0B;"></i>
                <span class="text-slate-500 d-block" style="font-size: 11px;">Notes</span>
                <span class="fw-bold text-slate-900" style="font-size: 20px;">@(Model.ResearchNotes?.Count ?? 0)</span>
                <span class="text-muted d-block" style="font-size: 10px;">Captured</span>
            </div>

            <!-- Assets — Soon -->
            <div class="element-card position-relative" style="opacity: 0.72; cursor: not-allowed;">
                <span class="soon-badge">Soon</span>
                <i data-lucide="folder" class="mb-1" style="width: 18px; height: 18px; color: #059669;"></i>
                <span class="text-slate-500 d-block" style="font-size: 11px;">Assets</span>
                <span class="fw-bold text-slate-900" style="font-size: 20px;">@Model.Assets.Count</span>
                <span class="text-muted d-block" style="font-size: 10px;">Files</span>
            </div>
        </div>
    </div>

    <!-- Story Roadmap Timeline Stepper -->
    <div class="content-card position-relative" style="overflow: hidden;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-slate-900 mb-0" style="font-size: 15px;">Story Roadmap</h6>
            <span class="soon-badge position-static" style="font-size: 10px; padding: 3px 10px;">Coming Soon</span>
        </div>

        <div class="roadmap-scroll-wrapper">
        <div class="roadmap-inner position-relative d-flex justify-content-between align-items-center px-3 py-2">
            <!-- Background connecting line -->
            <div class="position-absolute" style="top: 28px; left: 60px; right: 60px; height: 2px; background: #E2E8F0; z-index: 0;"></div>
            <div class="position-absolute" style="top: 28px; left: 60px; width: 22%; height: 2px; background: #0D9488; z-index: 0;"></div>

            <!-- Stage 1: Created -->
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="roadmap-node-circle completed">
                    <i data-lucide="check" style="width: 18px; height: 18px;"></i>
                </div>
                <span class="fw-bold text-slate-900" style="font-size: 12px;">Story Created</span>
                <span class="text-muted" style="font-size: 10px;">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
            </div>

            <!-- Stage 2: Planning -->
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="roadmap-node-circle active">
                    <i data-lucide="target" style="width: 18px; height: 18px;"></i>
                </div>
                <span class="fw-bold text-teal" style="font-size: 12px; color: #0D9488;">Planning</span>
                <span class="fw-bold text-teal" style="font-size: 10px; color: #0D9488;">In Progress</span>
            </div>

            <!-- Stage 3: Writing -->
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="roadmap-node-circle upcoming">
                    <i data-lucide="edit-2" style="width: 16px; height: 16px;"></i>
                </div>
                <span class="fw-semibold text-slate-600" style="font-size: 12px;">Writing</span>
                <span class="text-muted" style="font-size: 10px;">Upcoming</span>
            </div>

            <!-- Stage 4: Editing -->
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="roadmap-node-circle upcoming">
                    <i data-lucide="scissors" style="width: 16px; height: 16px;"></i>
                </div>
                <span class="fw-semibold text-slate-600" style="font-size: 12px;">Editing</span>
                <span class="text-muted" style="font-size: 10px;">Upcoming</span>
            </div>

            <!-- Stage 5: Review -->
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="roadmap-node-circle upcoming">
                    <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                </div>
                <span class="fw-semibold text-slate-600" style="font-size: 12px;">Review</span>
                <span class="text-muted" style="font-size: 10px;">Upcoming</span>
            </div>

            <!-- Stage 6: Publishing -->
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="roadmap-node-circle upcoming">
                    <i data-lucide="send" style="width: 16px; height: 16px;"></i>
                </div>
                <span class="fw-semibold text-slate-600" style="font-size: 12px;">Publishing</span>
                <span class="text-muted" style="font-size: 10px;">Upcoming</span>
            </div>

            <!-- Stage 7: Published -->
            <div class="d-flex flex-column align-items-center position-relative" style="z-index: 2;">
                <div class="roadmap-node-circle upcoming">
                    <i data-lucide="lock" style="width: 16px; height: 16px;"></i>
                </div>
                <span class="fw-semibold text-slate-600" style="font-size: 12px;">Published</span>
                <span class="text-muted" style="font-size: 10px;">Upcoming</span>
            </div>
        </div>
        </div><!-- end roadmap-scroll-wrapper -->

        <!-- Footer Motivational Banner Quote -->
        <div class="motivational-banner">
            "The story is yours. The power to write it is already within you." ✨
        </div>
    </div>

</div>
