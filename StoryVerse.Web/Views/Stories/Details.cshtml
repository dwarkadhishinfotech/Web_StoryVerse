        <div class="action-card">
            <div class="action-icon-box" style="background: #F0FDF4; color: #16A34A;">
                <i data-lucide="map-pin" style="width: 20px; height: 20px;"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-0" style="font-size: 12.5px;">World Building</h6>
