@model StoryVerse.Core.Entities.Story
@{
    ViewData["Title"] = Model.Title;
    
    // UserGoal from ViewBag
    var userGoal = ViewBag.UserGoal as StoryVerse.Core.Entities.UserGoal ?? new StoryVerse.Core.Entities.UserGoal();
    
    // User info
    var userInitials = ViewBag.UserInitials as string ?? "RP";
    var userName = ViewBag.UserName as string ?? "Rakshesh kumar";

    // Progress percentage
    var progress = Model.ProgressPercentage;
    if (Model.TargetWordCount > 0 && Model.CurrentWordCount > 0)
    {
        progress = (int)Math.Clamp(((double)Model.CurrentWordCount / Model.TargetWordCount) * 100, 0, 100);
    }

    // Reading time calculation (~4h 20m for 82,450 words)
    int totalWords = Model.CurrentWordCount;
    int totalMinutes = (int)Math.Round((double)totalWords / 317); 
    if (totalWords == 0) totalMinutes = 0;
    string readingTimeStr = totalMinutes >= 60 ? $"~ {totalMinutes / 60}h {totalMinutes % 60}m" : $"~ {totalMinutes} min";

    // Chapter breakdown calculations
    var allChapters = Model.Chapters?.ToList() ?? new List<StoryVerse.Core.Entities.Chapter>();
    int totalChaptersCount = allChapters.Count;
    int completedCount = allChapters.Count(c => c.Status == "Completed");
    int inProgressCount = allChapters.Count(c => c.Status == "InProgress");
    int plannedCount = allChapters.Count(c => c.Status == "Planned");
    int onHoldCount = allChapters.Count(c => c.Status == "OnHold");
    int archivedCount = allChapters.Count(c => c.Status == "Archived");

    int completedPercent = totalChaptersCount > 0 ? (int)Math.Round((double)completedCount / totalChaptersCount * 100) : 0;
    int inProgressPercent = totalChaptersCount > 0 ? (int)Math.Round((double)inProgressCount / totalChaptersCount * 100) : 0;
    int plannedPercent = totalChaptersCount > 0 ? (int)Math.Round((double)plannedCount / totalChaptersCount * 100) : 0;
    int onHoldPercent = totalChaptersCount > 0 ? (int)Math.Round((double)onHoldCount / totalChaptersCount * 100) : 0;
    int archivedPercent = totalChaptersCount > 0 ? (int)Math.Round((double)archivedCount / totalChaptersCount * 100) : 0;

    // Writing goals percentages
    int dailyGoalVal = userGoal.DailyWordCountGoal > 0 ? userGoal.DailyWordCountGoal : 1000;
    int dailyWrittenVal = userGoal.WordsWrittenToday;
    int dailyPercent = dailyGoalVal > 0 ? (int)Math.Round((double)dailyWrittenVal / dailyGoalVal * 100) : 0;

    int weeklyGoalVal = userGoal.WeeklyWordCountGoal > 0 ? userGoal.WeeklyWordCountGoal : 5000;
    int weeklyWrittenVal = userGoal.WordsWrittenThisWeek;
    int weeklyPercent = weeklyGoalVal > 0 ? (int)Math.Round((double)weeklyWrittenVal / weeklyGoalVal * 100) : 0;

    int monthlyGoalVal = userGoal.MonthlyWordCountGoal > 0 ? userGoal.MonthlyWordCountGoal : 20000;
    int monthlyWrittenVal = userGoal.WordsWrittenThisMonth;
    int monthlyPercent = monthlyGoalVal > 0 ? (int)Math.Round((double)monthlyWrittenVal / monthlyGoalVal * 100) : 0;

    // Parse Genres
    var genresList = !string.IsNullOrWhiteSpace(Model.Genre)
        ? Model.Genre.Split(new[] { ',', '•' }, StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        : (Model.StoryGenres != null && Model.StoryGenres.Any()
            ? Model.StoryGenres.Select(sg => sg.Genre?.Name).Where(n => !string.IsNullOrEmpty(n)).ToArray()!
            : Array.Empty<string>());
}

<!-- Custom Beautified Styles matching exact reference image -->
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Great+Vibes&display=swap');

    /* ========================================
       STORY DETAILS — RESPONSIVE & BEAUTIFIED
    ======================================== */
    .storyverse-workspace {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        color: #1E293B;
        background: transparent; /* No container background */
    }

    .font-serif-title {
        font-family: 'Playfair Display', Georgia, serif;
    }

    .font-calligraphy {
        font-family: 'Great Vibes', 'Playfair Display', cursive;
    }

    /* ===== Top Action Header ===== */
    .story-action-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .story-action-header .header-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    /* ===== Premium Hero Banner ===== */
    .hero-banner-card {
        border-radius: 20px;
        position: relative;
        overflow: hidden;
        color: #FFFFFF;
        box-shadow: 0 12px 40px rgba(11, 19, 41, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 1.25rem;
    }

    .hero-banner-overlay {
        background: linear-gradient(90deg, #0B132A 0%, #0B132AE6 50%, #0B132A55 82%, rgba(11, 19, 42, 0.1) 100%);
        padding: 2rem 2.5rem;
        position: relative;
        z-index: 2;
    }

    @@media (max-width: 991.98px) {
        .hero-banner-overlay {
            padding: 1.5rem 1.75rem;
        }
    }

    @@media (max-width: 575.98px) {
        .hero-banner-overlay {
            padding: 1.25rem 1.25rem;
            background: linear-gradient(160deg, #0B132A 0%, #0B132AEE 60%, #0B132A88 100%);
        }
        .hero-banner-card {
            border-radius: 16px;
        }
    }

    .book-cover-elevated {
        width: 145px;
        height: 205px;
        border-radius: 12px;
        object-fit: cover;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.12);
        transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        flex-shrink: 0;
    }

    .book-cover-elevated:hover {
        transform: scale(1.03) translateY(-3px);
    }

    @@media (max-width: 575.98px) {
        .book-cover-elevated {
            width: 100px;
            height: 145px;
            border-radius: 10px;
        }
    }

    .badge-novel {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #E2E8F0;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 3px 10px;
        border-radius: 100px;
    }

    .tag-pill {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #F1F5F9;
        font-size: 11px;
        font-weight: 500;
        padding: 4px 12px;
        border-radius: 100px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .tag-pill-add {
        background: rgba(255, 255, 255, 0.05);
        border: 1px dashed rgba(255, 255, 255, 0.3);
        color: #94A3B8;
        font-size: 11px;
        font-weight: 500;
        padding: 4px 12px;
        border-radius: 100px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .tag-pill-add:hover {
        background: rgba(255, 255, 255, 0.15);
        color: #FFFFFF;
    }

    /* ===== 8 Quick Action Grid ===== */
    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    @@media (max-width: 1199.98px) {
        .quick-actions-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .quick-actions-grid {
            grid-template-columns: repeat(4, 1fr);
            gap: 0.6rem;
        }
    }

    @@media (max-width: 575.98px) {
        .quick-actions-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.5rem;
        }
    }

    .action-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        padding: 1.1rem 0.6rem;
        text-align: center;
        transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
        text-decoration: none;
        cursor: pointer;
        position: relative;
    }

    /* ===== Soon Badge ===== */
    .soon-badge {
        position: absolute;
        top: 7px;
        right: 7px;
        background: linear-gradient(135deg, #F59E0B, #EF4444);
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.4px;
        padding: 2px 7px;
        border-radius: 100px;
        text-transform: uppercase;
        line-height: 1.4;
        pointer-events: none;
        box-shadow: 0 2px 6px rgba(245, 158, 11, 0.35);
    }

    /* Soon badge inside element-card */
    .element-card .soon-badge {
        top: 6px;
        right: 6px;
        font-size: 8.5px;
        padding: 2px 6px;
    }

    .action-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.08);
        border-color: #CBD5E1;
        background: #FFFFFF;
    }

    .action-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.6rem;
        transition: transform 0.25s ease;
    }

    .action-card:hover .action-icon-box {
        transform: scale(1.08);
    }

    @@media (max-width: 575.98px) {
        .action-card {
            padding: 0.85rem 0.5rem;
            border-radius: 12px;
        }
        .action-icon-box {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            margin-bottom: 0.45rem;
        }
    }

    /* ===== Content Cards ===== */
    .content-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(226, 232, 240, 0.7);
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
    }

    @@media (max-width: 575.98px) {
        .content-card {
            padding: 1.1rem;
            border-radius: 16px;
        }
    }

    /* ===== Scrollable card body ===== */
    /* Fixed-height content cards: header stays pinned, body scrolls */
    .card-scroll-body {
        overflow-y: auto;
        overflow-x: hidden;
        flex: 1 1 auto;
        /* Custom scrollbar inside cards */
        scrollbar-width: thin;
        scrollbar-color: rgba(13, 148, 136, 0.25) transparent;
    }
    .card-scroll-body::-webkit-scrollbar {
        width: 4px;
    }
    .card-scroll-body::-webkit-scrollbar-track {
        background: transparent;
    }
    .card-scroll-body::-webkit-scrollbar-thumb {
        background: rgba(13, 148, 136, 0.3);
        border-radius: 4px;
    }
    .card-scroll-body::-webkit-scrollbar-thumb:hover {
        background: rgba(13, 148, 136, 0.6);
    }

    /* Synopsis / Tagline / At-A-Glance row — equal height cards */
    .info-cards-row .content-card {
        height: 280px;   /* fixed height – equal across all 3 */
    }

    /* Manuscript Overview card */
    .manuscript-card {
        height: 100%;
        min-height: 480px;
    }

    /* Writing Goals card */
    .goals-card {
        min-height: 220px;
    }

    /* Manuscript Progress card */
    .progress-card {
        min-height: 220px;
    }

    @@media (max-width: 991.98px) {
        /* On tablet/mobile let cards grow naturally but cap at a max */
        .info-cards-row .content-card {
            height: auto;
            max-height: 300px;
        }
        .manuscript-card {
            height: auto;
            max-height: 420px;
        }
    }

    @@media (max-width: 575.98px) {
        .info-cards-row .content-card {
            max-height: 260px;
        }
    }

    /* Manuscript Chapter Accordion */
    .part-header {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 0.85rem 1.15rem;
        cursor: pointer;
        font-weight: 700;
        font-size: 13.5px;
        color: #1E293B;
        transition: background-color 0.2s ease;
    }

    .part-header:hover {
        background: #F1F5F9;
    }

    .chapter-row {
        padding: 0.85rem 1.15rem;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        transition: background 0.15s ease;
    }

    .chapter-row:hover {
        background: #F8FAFC;
    }

    .chapter-row:last-child {
        border-bottom: none;
    }

    /* Status Badges */
    .badge-status-completed {
        background-color: #E6F4EA;
        color: #137333;
        font-weight: 600;
        font-size: 10.5px;
        padding: 3px 10px;
        border-radius: 100px;
    }

    .badge-status-inprogress {
        background-color: #E8F0FE;
        color: #1A73E8;
        font-weight: 600;
        font-size: 10.5px;
        padding: 3px 10px;
        border-radius: 100px;
    }

    .badge-status-planned {
        background-color: #FEF7E0;
        color: #B06000;
        font-weight: 600;
        font-size: 10.5px;
        padding: 3px 10px;
        border-radius: 100px;
    }

    /* Dynamic Donut Chart */
    .donut-chart-container {
        position: relative;
        width: 140px;
        height: 140px;
    }

    .donut-center-label {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    /* ===== Story Elements 7 Grid ===== */
    .elements-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.75rem;
    }

    @@media (max-width: 1199.98px) {
        .elements-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .elements-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @@media (max-width: 575.98px) {
        .elements-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.5rem;
        }
    }

    .element-card {
        background: rgba(248, 250, 252, 0.7);
        border: 1px solid rgba(241, 245, 249, 0.9);
        border-radius: 14px;
        padding: 1rem 0.5rem;
        text-align: center;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .element-card:hover {
        background: rgba(255, 255, 255, 0.95);
        border-color: #CBD5E1;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.06);
    }

    /* ===== Stepper Roadmap ===== */
    .roadmap-node-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.55rem;
        z-index: 2;
        position: relative;
        background: #FFFFFF;
        border: 2px solid #CBD5E1;
        transition: all 0.25s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .roadmap-node-circle.completed {
        border-color: #0D9488;
        background: #F0FDFA;
        color: #0D9488;
        box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.1);
    }

    .roadmap-node-circle.active {
        border-color: #0D9488;
        background: linear-gradient(135deg, #0D9488, #0EA5E9);
        color: #FFFFFF;
        box-shadow: 0 4px 14px rgba(13, 148, 136, 0.35);
    }

    .roadmap-node-circle.upcoming {
        border-color: #E2E8F0;
        color: #94A3B8;
    }

    /* ===== Responsive Roadmap ===== */
    .roadmap-scroll-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: 0.5rem;
    }

    .roadmap-scroll-wrapper::-webkit-scrollbar {
        display: none;
    }

    .roadmap-inner {
        min-width: 560px;
    }

    /* ===== Row Gap / Section Spacing ===== */
    .sv-section-gap {
        margin-bottom: 1.25rem;
    }

    @@media (min-width: 768px) {
        .sv-section-gap {
            margin-bottom: 1.5rem;
        }
    }

    /* ===== Hero Stats Row on mobile ===== */
    @@media (max-width: 575.98px) {
        .hero-stats-row {
            gap: 0.75rem !important;
        }
        .hero-stats-row .col-6 {
            flex: 0 0 auto;
            width: auto;
        }
    }

    /* ===== Middle Cards (Synopsis/Tagline/Glance) ===== */
    @@media (max-width: 991.98px) {
        .tagline-card {
            min-height: 180px;
        }
    }

    /* ===== Writing Goals spacing ===== */
    .goal-row {
        margin-bottom: 1rem;
    }

    .goal-row:last-child {
        margin-bottom: 0;
    }

    /* ===== Motivational banner ===== */
    .motivational-banner {
        margin-top: 1.25rem;
        text-align: center;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        font-weight: 600;
        background: #F0FDFA;
        color: #0D9488;
        font-size: 12.5px;
        border: 1px solid #CCFBF1;
        transition: background 0.2s ease;
    }

    .motivational-banner:hover {
        background: #CCFBF1;
    }
</style>

<div class="storyverse-workspace w-full pb-4">
    
    <!-- Top Action Header -->
    <div class="story-action-header">
        <a href="@Url.Action("Index", "Stories")" 
           class="text-decoration-none text-slate-600 d-inline-flex align-items-center fw-semibold" 
           style="font-size: 13px;">
            <i data-lucide="arrow-left" class="me-1" style="width: 16px; height: 16px;"></i> Back to Library
        </a>

        <div class="header-right">
            <a href="@Url.Action("Edit", "Stories", new { id = Model.Id })" 
               class="btn btn-sm border fw-semibold d-flex align-items-center bg-white" 
               style="font-size: 12.5px; border-radius: 10px; border-color: #E2E8F0; padding: 6px 14px; box-shadow: 0 1px 4px rgba(0,0,0,0.05);">
                <i data-lucide="edit-3" class="me-1 text-muted" style="width: 14px; height: 14px;"></i>
                <span class="d-none d-sm-inline">Edit Story</span>
                <span class="d-sm-none">Edit</span>
            </a>

            <div class="dropdown">
                <button class="btn btn-sm border bg-white" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                        style="border-radius: 10px; border-color: #E2E8F0; padding: 6px 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.05);">
                    <i data-lucide="more-horizontal" style="width: 16px; height: 16px;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg" style="border-radius: 12px; font-size: 12.5px;">
                    <li><a class="dropdown-item py-2" href="#"><i data-lucide="settings" class="me-2 text-muted" style="width: 14px; height: 14px;"></i> Story Settings</a></li>
                    <li><a class="dropdown-item py-2 text-danger" href="#"><i data-lucide="trash-2" class="me-2" style="width: 14px; height: 14px;"></i> Delete Story</a></li>
                </ul>
            </div>

            <button class="btn btn-sm border bg-white" type="button" title="Bookmark"
                    style="border-radius: 10px; border-color: #E2E8F0; padding: 6px 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.05);">
                <i data-lucide="bookmark" style="width: 16px; height: 16px; color: #0D9488;"></i>
            </button>

            <a href="@Url.Action("Index", "Stories")" 
               class="btn btn-sm text-white fw-bold d-flex align-items-center" 
               style="background: linear-gradient(135deg, #0D9488, #0EA5E9); border: none; font-size: 12.5px; border-radius: 10px; padding: 6px 16px; box-shadow: 0 4px 12px rgba(13,148,136,0.25);">
                <span class="d-none d-sm-inline">Continue Writing</span>
                <span class="d-sm-none">Write</span>
                <i data-lucide="zap" class="ms-1" style="width: 14px; height: 14px;"></i>
            </a>
        </div>
    </div>

    <!-- Featured Hero Banner -->
    @{
        bool hasCustomBanner = !string.IsNullOrEmpty(Model.HeroBannerImageUrl);
        string bannerStyle = hasCustomBanner
            ? $"background-color: #0B1329; background-image: url('{Model.HeroBannerImageUrl}'); background-size: cover; background-position: center right;"
            : "background: linear-gradient(135deg, #0A1128 0%, #0F2A4A 35%, #0D4E5C 70%, #0D9488 100%);";
    }
    <div class="hero-banner-card" style="@bannerStyle">
        @if (!hasCustomBanner)
        {
            <!-- Mixed Gradient Glowing Orbs -->
            <div class="position-absolute" style="top: -60px; right: -60px; width: 400px; height: 400px; background: rgba(13, 148, 136, 0.28); border-radius: 50%; filter: blur(75px); pointer-events: none; z-index: 1;"></div>
            <div class="position-absolute" style="bottom: -50px; left: 15%; width: 350px; height: 350px; background: rgba(14, 165, 233, 0.22); border-radius: 50%; filter: blur(65px); pointer-events: none; z-index: 1;"></div>
        }
        <div class="hero-banner-overlay">
            <div class="row align-items-center g-4">
                
                <!-- Left: 3D Book Cover -->
                <div class="col-auto">
                    <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/dil_hai_ki_cover.png" : Model.CoverImageUrl)" 
                         alt="@Model.Title" 
                         class="book-cover-elevated" 
                         onerror="this.src='/images/dil_hai_ki_cover.png';" />
                </div>

                <!-- Right: Title, Metadata, Stats -->
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-novel">@Model.StoryType.ToUpper()</span>
                    </div>

                    <div class="d-flex align-items-center gap-2.5 mb-1">
                        <h1 class="font-serif-title fw-bold text-white mb-0" style="font-size: 32px; letter-spacing: -0.5px;">
                            @Model.Title
                        </h1>
                        <i data-lucide="feather" class="text-teal" style="width: 22px; height: 22px; color: #5EEAD4;"></i>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Tagline))
                    {
                        <p class="text-slate-300 mb-3 font-semibold" style="font-size: 14px; opacity: 0.9;">
                            @Model.Tagline
                        </p>
                    }

                    <!-- Genre Tags -->
                    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                        @foreach (var g in genresList)
