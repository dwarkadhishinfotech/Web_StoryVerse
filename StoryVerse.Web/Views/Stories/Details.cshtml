                            <span class="text-white fw-bold d-block" style="font-size: 16px; line-height: 1.3;">@Model.UpdatedAt.ToString("dd MMM yyyy")</span>
                            <span class="text-slate-400" style="font-size: 11px;">Today</span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- Quick Action Grid (8 Cards in 1 Row) -->
