                            <span class="text-slate-400 d-block text-uppercase fw-semibold" style="font-size: 10px; letter-spacing: 0.5px;">Words</span>
                            <span class="text-white fw-bold d-block" style="font-size: 20px; line-height: 1.2;">@Model.CurrentWordCount.ToString("N0")</span>
