        </div>

        <!-- View Chapters — Soon -->
        <div class="action-card" style="opacity: 0.75; cursor: not-allowed;">
            <span class="soon-badge">Soon</span>
            <div class="action-icon-box" style="background: #EFF6FF; color: #2563EB;">
                <i data-lucide="list" style="width: 20px; height: 20px;"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-0" style="font-size: 12.5px;">View Chapters</h6>
            <span class="text-muted" style="font-size: 11px;">@totalChaptersCount Chapters</span>
        </div>

        <div class="action-card">
            <div class="action-icon-box" style="background: #FAF5FF; color: #9333EA;">
                <i data-lucide="users" style="width: 20px; height: 20px;"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-0" style="font-size: 12.5px;">Characters</h6>
