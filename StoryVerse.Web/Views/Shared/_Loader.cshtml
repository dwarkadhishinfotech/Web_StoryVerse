@* Theme-wise Loader Partial View for StoryVerse *@

<!-- Top Peacock Glowing Progress Bar (for background API calls / AJAX) -->
<div id="svTopProgressBar"></div>

<!-- Full-Screen Theme Loader Overlay -->
<div id="svLoaderOverlay" class="sv-loader-overlay active">
    <div class="sv-loader-content">
        <div class="sv-loader-graphic">
            <div class="sv-loader-ring"></div>
            <img src="/images/CompanyLogo/apple-touch-icon.png" alt="StoryVerse Logo" class="sv-loader-logo" />
        </div>
        <h4 id="svLoaderText" class="sv-loader-text">Loading...</h4>
        <div class="sv-loader-subtext">
            <span>Please wait</span>
            <span class="sv-dot"></span>
            <span class="sv-dot"></span>
            <span class="sv-dot"></span>
        </div>
    </div>
</div>
