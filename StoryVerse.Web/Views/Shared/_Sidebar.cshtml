@using StoryVerse.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using StoryVerse.Core.Entities
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@{
    var user = await UserManager.GetUserAsync(User);
    
    string displayName;
    string initials = "A";
    
    if (user != null)
    {
        if (!string.IsNullOrWhiteSpace(user.FirstName) && !string.IsNullOrWhiteSpace(user.LastName))
        {
            displayName = $"{user.FirstName} {user.LastName}";
            initials = $"{user.FirstName[0]}{user.LastName[0]}".ToUpper();
        }
        else if (!string.IsNullOrWhiteSpace(user.DisplayName))
        {
            displayName = user.DisplayName;
            var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            initials = parts.Length > 1 
                ? $"{parts[0][0]}{parts[1][0]}".ToUpper() 
                : (parts.Length > 0 ? parts[0][0].ToString().ToUpper() : "A");
        }
        else if (!string.IsNullOrWhiteSpace(user.FirstName))
        {
            displayName = user.FirstName;
            initials = user.FirstName[0].ToString().ToUpper();
        }
        else if (!string.IsNullOrWhiteSpace(user.UserName))
        {
            displayName = user.UserName;
            initials = user.UserName[0].ToString().ToUpper();
        }
        else
        {
            displayName = "Author";
            initials = "A";
        }
    }
    else
    {
        displayName = User.Identity?.Name ?? "Author";
        initials = !string.IsNullOrEmpty(displayName) ? displayName[0].ToString().ToUpper() : "A";
    }

    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();

    // Calculate Writing Streak & Weekly Activity
    var streakDays = 0;
    var activeDaysOfWeek = new bool[7]; // Mon=0 .. Sun=6
    var todayUtc = DateTime.UtcNow.Date;
    int todayIndex = ((int)DateTime.UtcNow.DayOfWeek + 6) % 7; // Mon=0 .. Sun=6

    if (user != null)
    {
        var userId = user.Id;

        var activityDates = await DbContext.ActivityLogs
            .Where(a => a.UserId == userId)
            .Select(a => a.Timestamp.Date)
            .Distinct()
            .ToListAsync();

        var storyDates = await DbContext.Stories
            .Where(s => s.UserId == userId)
            .Select(s => s.UpdatedAt.Date)
            .Distinct()
            .ToListAsync();

        var chapterDates = await DbContext.Chapters
            .Where(c => c.Story.UserId == userId)
            .Select(c => c.UpdatedAt.Date)
            .Distinct()
            .ToListAsync();

        var characterDates = await DbContext.Characters
            .Where(c => c.Story != null && c.Story.UserId == userId)
            .Select(c => c.UpdatedAt.Date)
            .Distinct()
            .ToListAsync();

        var worldEntityDates = await DbContext.WorldEntities
            .Where(w => w.Story != null && w.Story.UserId == userId)
            .Select(w => w.UpdatedDate.Date)
            .Distinct()
            .ToListAsync();

        var timelineEventDates = await DbContext.TimelineEvents
            .Where(t => t.Story != null && t.Story.UserId == userId)
            .Select(t => t.UpdatedAt.Date)
            .Distinct()
            .ToListAsync();

        var allDates = new HashSet<DateTime>(activityDates);
        allDates.UnionWith(storyDates);
        allDates.UnionWith(chapterDates);
        allDates.UnionWith(characterDates);
        allDates.UnionWith(worldEntityDates);
        allDates.UnionWith(timelineEventDates);

        var checkDate = todayUtc;
        if (!allDates.Contains(checkDate))
        {
            checkDate = checkDate.AddDays(-1);
        }

        while (allDates.Contains(checkDate))
        {
            streakDays++;
            checkDate = checkDate.AddDays(-1);
        }

        var startOfWeek = todayUtc.AddDays(-todayIndex); // Monday of current week
        for (int i = 0; i < 7; i++)
        {
            var dayDate = startOfWeek.AddDays(i);
            activeDaysOfWeek[i] = allDates.Contains(dayDate);
        }

        // Also update UserGoals table if streak changed
        var userGoal = await DbContext.UserGoals.FirstOrDefaultAsync(ug => ug.UserId == userId);
        if (userGoal != null)
        {
            if (userGoal.CurrentStreakDays != streakDays)
            {
                userGoal.CurrentStreakDays = streakDays;
                userGoal.LastUpdated = DateTime.UtcNow;
                await DbContext.SaveChangesAsync();
            }
        }
        else
        {
            DbContext.UserGoals.Add(new UserGoal
            {
                UserId = userId,
                CurrentStreakDays = streakDays,
                LastUpdated = DateTime.UtcNow
            });
            await DbContext.SaveChangesAsync();
        }
    }

    var dayLabels = new[] { "M", "T", "W", "T", "F", "S", "S" };
}

