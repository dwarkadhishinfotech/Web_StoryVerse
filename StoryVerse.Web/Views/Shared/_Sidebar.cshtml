        <a href="javascript:void(0)" title="Maps (Coming Soon)" class="sidebar-nav-link disabled-link text-decoration-none d-flex align-items-center justify-content-between mb-1">
            <div class="d-flex align-items-center gap-3">
                <i data-lucide="map" style="width: 18px; height: 18px; flex-shrink: 0;"></i>
                <span class="sidebar-text-label" style="font-size: 0.85rem;">Maps</span>
            </div>
            <span class="badge-coming-soon sidebar-text-label">SOON</span>
        </a>
        <a href="javascript:void(0)" title="Notes (Coming Soon)" class="sidebar-nav-link disabled-link text-decoration-none d-flex align-items-center justify-content-between mb-1">
            <div class="d-flex align-items-center gap-3">
                <i data-lucide="file" style="width: 18px; height: 18px; flex-shrink: 0;"></i>
                <span class="sidebar-text-label" style="font-size: 0.85rem;">Notes</span>
            </div>
            <span class="badge-coming-soon sidebar-text-label">SOON</span>
        </a>
        <a href="javascript:void(0)" title="Assets (Coming Soon)" class="sidebar-nav-link disabled-link text-decoration-none d-flex align-items-center justify-content-between mb-1">
            <div class="d-flex align-items-center gap-3">
                <i data-lucide="folder-open" style="width: 18px; height: 18px; flex-shrink: 0;"></i>
                <span class="sidebar-text-label" style="font-size: 0.85rem;">Assets</span>
            </div>
            <span class="badge-coming-soon sidebar-text-label">SOON</span>
        </a>
        <a href="javascript:void(0)" title="Analytics (Coming Soon)" class="sidebar-nav-link disabled-link text-decoration-none d-flex align-items-center justify-content-between mb-1">
            <div class="d-flex align-items-center gap-3">
                <i data-lucide="bar-chart-2" style="width: 18px; height: 18px; flex-shrink: 0;"></i>
                <span class="sidebar-text-label" style="font-size: 0.85rem;">Analytics</span>
            </div>
            <span class="badge-coming-soon sidebar-text-label">SOON</span>
        </a>
    </div>

    <!-- Writing Streak -->
    <div class="px-4 mb-4 sidebar-streak-card flex-shrink-0">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-uppercase fw-bold text-white" style="font-size: 10px; letter-spacing: 0.05em; opacity: 0.6; font-family: 'Inter', sans-serif;">WRITING STREAK</span>
            <span style="font-size: 14px;">🔥</span>
        </div>
        <div class="d-flex align-items-baseline gap-1 mb-1">
            <span class="fw-bold text-white" style="font-size: 1.5rem; line-height: 1;">@streakDays</span>
            <span class="text-white-50 fw-medium" style="font-size: 0.75rem;">days</span>
        </div>
        <div class="text-white-50 mb-3" style="font-size: 0.75rem; font-family: 'Inter', sans-serif;">
            @(streakDays > 0 ? (streakDays == 1 ? "1 day streak! Keep it up!" : $"{streakDays} day streak! You're on fire!") : "Start your streak today!")
        </div>
        
        <div class="d-flex justify-content-between text-center" style="font-size: 9px; font-weight: 600; color: #64748B; font-family: 'Inter', sans-serif;">
            @for (int i = 0; i < 7; i++)
            {
                var isActive = activeDaysOfWeek[i];
                var isToday = i == todayIndex;
                <div>
                    <div class="streak-circle @(isActive ? "active" : "") @(isToday ? "today" : "")"></div>
                    <span style="@(isToday ? "color: #13A8A6; font-weight: 700;" : "")">@dayLabels[i]</span>
                </div>
            }
        </div>
    </div>

    <!-- User Profile Footer -->
    <div class="px-4 pb-4 flex-shrink-0 sidebar-footer-wrapper">
        <div class="d-flex align-items-center justify-content-between mb-3 sidebar-footer-profile">
            <div class="d-flex align-items-center gap-2 cursor-pointer p-1 sidebar-user-avatar-btn" data-bs-toggle="modal" data-bs-target="#logoutModal" title="Sign Out (@displayName)">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="height: 36px; width: 36px; background-color: #13A8A6; color: white; font-size: 0.9rem; font-family: 'Inter', sans-serif; flex-shrink: 0;" title="Sign Out (@displayName)">
                    @initials
                </div>
                <div class="d-flex flex-column sidebar-text-label">
                    <span class="text-white fw-bold lh-sm text-truncate" style="font-size: 0.85rem; max-width: 110px; font-family: 'Inter', sans-serif;">@displayName</span>
                    <span class="fw-medium mt-0.5" style="font-size: 11px; color: #64748B; font-family: 'Inter', sans-serif;">Author</span>
                </div>
            </div>
            <button type="button" class="btn border-0 p-0 d-flex align-items-center justify-content-center sidebar-profile-logout-btn" title="Sign Out" data-bs-toggle="modal" data-bs-target="#logoutModal">
                <i data-lucide="log-out" style="width: 18px; height: 18px; color: #F87171; transition: all 0.2s ease;"></i>
            </button>
        </div>

        <!-- Collapse Toggle Button -->
        <div id="sidebarCollapseBtn" class="d-flex align-items-center gap-2 text-white-50 cursor-pointer hover-text-white transition-all py-1 px-2 rounded-2" onclick="toggleSidebarCollapse()" style="user-select: none;" title="Toggle Sidebar Collapse">
            <i data-lucide="chevron-left" class="sidebar-collapse-icon" style="width: 16px; height: 16px; transition: transform 0.3s ease; flex-shrink: 0;"></i>
            <span class="sidebar-text-label" style="font-size: 0.85rem; font-weight: 500; font-family: 'Inter', sans-serif;">Collapse</span>
        </div>
    </div>
</nav>

<script>
    function toggleSidebarCollapse() {
        var sidebar = document.getElementById('mainSidebar');
        if (!sidebar) return;
        
        sidebar.classList.toggle('sidebar-collapsed');
        var isCollapsed = sidebar.classList.contains('sidebar-collapsed');
        localStorage.setItem('storyverse_sidebar_collapsed', isCollapsed ? 'true' : 'false');
    }

    function switchGlobalStory(storyId, storyTitle) {
        if (!storyId) return;

        // 1. Immediately update Sidebar Workspace Selector UI
        if (storyTitle) {
            var label = document.querySelector('#workspaceDropdown .active-story-title') || document.querySelector('#workspaceDropdown .sidebar-text-label');
            if (label) {
                label.textContent = storyTitle;
                label.setAttribute('title', storyTitle);
            }
        }

        // Update active class & checkmarks in dropdown items
        var items = document.querySelectorAll('.sidebar-workspace-dropdown .dropdown-item');
        items.forEach(function(item) {
            var onclickVal = item.getAttribute('onclick') || '';
            var checkIcon = item.querySelector('i[data-lucide="check"]');
            if (onclickVal.includes("'" + storyId + "'")) {
                item.classList.add('active');
                item.style.backgroundColor = 'rgba(19, 168, 166, 0.2)';
                item.style.color = '#13A8A6';
                var s = item.querySelector('span');
                if (s) { s.style.fontWeight = '600'; s.style.color = '#13A8A6'; }
                var i = item.querySelector('i[data-lucide="book"]');
                if (i) { i.style.color = '#13A8A6'; }
                if (!checkIcon && !item.getAttribute('href')?.includes('/Stories/Create')) {
                    var checkEl = document.createElement('i');
                    checkEl.setAttribute('data-lucide', 'check');
                    checkEl.style.width = '14px';
                    checkEl.style.height = '14px';
                    checkEl.style.color = '#13A8A6';
                    item.appendChild(checkEl);
                }
            } else if (!item.getAttribute('href')?.includes('/Stories/Create')) {
                item.classList.remove('active');
                item.style.backgroundColor = 'transparent';
                item.style.color = '#E2E8F0';
                var s = item.querySelector('span');
                if (s) { s.style.fontWeight = '400'; s.style.color = '#E2E8F0'; }
                var i = item.querySelector('i[data-lucide="book"]');
                if (i) { i.style.color = '#94A3B8'; }
                if (checkIcon) { checkIcon.remove(); }
            }
        });

        // Close dropdown
        var dropdownEl = document.getElementById('workspaceDropdown');
        if (dropdownEl && typeof bootstrap !== 'undefined') {
            var bsDropdown = bootstrap.Dropdown.getInstance(dropdownEl);
            if (bsDropdown) bsDropdown.hide();
        }

        // Update all sidebar navigation link hrefs to carry the selected storyId
        var navLinks = document.querySelectorAll('.sidebar-nav-link, #worldBuildingSubmenu a, #timelineSubmenu a');
        navLinks.forEach(function(link) {
            var href = link.getAttribute('href');
            if (href && href !== 'javascript:void(0)' && !href.startsWith('#')) {
                try {
                    var u = new URL(href, window.location.origin);
                    u.searchParams.set('storyId', storyId);
                    link.setAttribute('href', u.pathname + u.search);
                } catch(e) {}
            }
        });

        var currentPath = window.location.pathname;
        var currentUrl = new URL(window.location.href);
        
        var lowerPath = currentPath.toLowerCase();
        if (lowerPath.includes('/edit') || lowerPath.includes('/details') || lowerPath.includes('/create')) {
            if (lowerPath.includes('/characters')) {
                currentPath = '/Characters';
            } else if (lowerPath.includes('/worldbuilding')) {
                currentPath = '/WorldBuilding';
            } else if (lowerPath.includes('/timeline')) {
                currentPath = '/Timeline';
            } else if (lowerPath.includes('/chapters')) {
                currentPath = '/Chapters';
            } else if (lowerPath.includes('/stories')) {
                currentPath = '/Stories';
            }
        }
        
        currentUrl.pathname = currentPath;
        currentUrl.searchParams.set('storyId', storyId);

        var formData = new URLSearchParams();
        formData.append('storyId', storyId);
        formData.append('returnUrl', currentUrl.pathname + currentUrl.search);

        // 2. Persist active story in session/cookie via POST
        fetch('/Stories/SetGlobalStory', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: formData.toString()
        });

        // 3. Dynamic SPA-style content fetch without browser page refresh
        var targetUrl = currentUrl.toString();
        history.pushState({ storyId: storyId }, '', targetUrl);

        var mainWrapper = document.querySelector('.main-content-wrapper');
        if (mainWrapper) {
            mainWrapper.style.opacity = '0.65';
            mainWrapper.style.pointerEvents = 'none';

            fetch(targetUrl, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(res) { return res.text(); })
            .then(function(htmlText) {
                var parser = new DOMParser();
                var doc = parser.parseFromString(htmlText, 'text/html');
                var newContent = doc.querySelector('.main-content-wrapper');
                if (newContent) {
                    mainWrapper.innerHTML = newContent.innerHTML;
                }
                mainWrapper.style.opacity = '1';
                mainWrapper.style.pointerEvents = 'auto';

                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }

                // Execute embedded scripts
                var scripts = mainWrapper.querySelectorAll('script');
                scripts.forEach(function(oldScript) {
                    var newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(function(attr) {
                        newScript.setAttribute(attr.name, attr.value);
                    });
                    newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });
            })
            .catch(function(err) {
                mainWrapper.style.opacity = '1';
                mainWrapper.style.pointerEvents = 'auto';
                window.location.href = targetUrl;
            });
        } else {
            window.location.href = targetUrl;
        }
    }

    // Handle browser back/forward buttons seamlessly
    window.addEventListener('popstate', function(e) {
        var mainWrapper = document.querySelector('.main-content-wrapper');
        if (mainWrapper) {
            fetch(window.location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function(res) { return res.text(); })
                .then(function(htmlText) {
                    var parser = new DOMParser();
                    var doc = parser.parseFromString(htmlText, 'text/html');
                    var newContent = doc.querySelector('.main-content-wrapper');
                    if (newContent) {
                        mainWrapper.innerHTML = newContent.innerHTML;
                    }
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                });
        }
    });

    // Restore state on page load
    (function() {
        if (localStorage.getItem('storyverse_sidebar_collapsed') === 'true') {
            var sidebar = document.getElementById('mainSidebar');
            if (sidebar) {
                sidebar.classList.add('sidebar-collapsed');
            }
        }
    })();
</script>
