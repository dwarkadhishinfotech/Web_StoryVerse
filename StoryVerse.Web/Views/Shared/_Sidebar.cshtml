@using StoryVerse.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using StoryVerse.Core.Entities
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject StoryVerse.Web.Services.IActiveStoryService ActiveStoryService
@{
    var user = await UserManager.GetUserAsync(User);
    var userId = user?.Id ?? UserManager.GetUserId(User);
    
    List<Story> userStories = new();
    Story? activeStory = null;
    
    if (!string.IsNullOrEmpty(userId))
    {
        userStories = await ActiveStoryService.GetUserStoriesAsync(userId);

        Guid? reqStoryId = null;
        if (Context.Request.Query.TryGetValue("storyId", out var qStoryId) && Guid.TryParse(qStoryId, out var parsedGuid))
        {
            reqStoryId = parsedGuid;
        }

        var activeStoryId = await ActiveStoryService.GetActiveStoryIdAsync(Context, userId, reqStoryId);
        if (activeStoryId.HasValue)
        {
            activeStory = userStories.FirstOrDefault(s => s.Id == activeStoryId.Value);
        }
    }
    
    string displayName;
    string initials = "A";
    
    if (user != null)
    {
        if (!string.IsNullOrWhiteSpace(user.FirstName) && !string.IsNullOrWhiteSpace(user.LastName))
        {
            displayName = $"{user.FirstName} {user.LastName}";
            initials = $"{user.FirstName[0]}{user.LastName[0]}".ToUpper();
        }
        else if (!string.IsNullOrWhiteSpace(user.DisplayName))
        {
            displayName = user.DisplayName;
            var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            initials = parts.Length > 1 
                ? $"{parts[0][0]}{parts[1][0]}".ToUpper() 
                : (parts.Length > 0 ? parts[0][0].ToString().ToUpper() : "A");
        }
        else if (!string.IsNullOrWhiteSpace(user.FirstName))
        {
            displayName = user.FirstName;
            initials = user.FirstName[0].ToString().ToUpper();
        }
        else if (!string.IsNullOrWhiteSpace(user.UserName))
        {
            displayName = user.UserName;
            initials = user.UserName[0].ToString().ToUpper();
        }
        else
        {
            displayName = "Author";
            initials = "A";
        }
    }
    else
    {
        displayName = User.Identity?.Name ?? "Author";
        initials = !string.IsNullOrEmpty(displayName) ? displayName[0].ToString().ToUpper() : "A";
    }

    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();

    // Calculate Writing Streak & Weekly Activity (Lightweight, No DB Writes during View Render)
    var streakDays = 0;
    var activeDaysOfWeek = new bool[7]; // Mon=0 .. Sun=6
    var todayUtc = DateTime.UtcNow.Date;
    int todayIndex = ((int)DateTime.UtcNow.DayOfWeek + 6) % 7; // Mon=0 .. Sun=6

    if (!string.IsNullOrEmpty(userId))
    {
        var userGoal = await DbContext.UserGoals
            .AsNoTracking()
            .FirstOrDefaultAsync(ug => ug.UserId == userId);

        if (userGoal != null)
        {
            streakDays = userGoal.CurrentStreakDays;
        }

        var startOfWeek = todayUtc.AddDays(-todayIndex);
        var endOfWeek = startOfWeek.AddDays(7);

        var recentActivities = await DbContext.ActivityLogs
            .AsNoTracking()
            .Where(a => a.UserId == userId && a.Timestamp >= startOfWeek && a.Timestamp < endOfWeek)
            .Select(a => a.Timestamp.Date)
            .Distinct()
            .ToListAsync();

        var activitySet = new HashSet<DateTime>(recentActivities);
        for (int i = 0; i < 7; i++)
        {
            activeDaysOfWeek[i] = activitySet.Contains(startOfWeek.AddDays(i));
        }
    }

    var dayLabels = new[] { "M", "T", "W", "T", "F", "S", "S" };

    Func<Story?, string> getGenreDisplay = (s) =>
    {
        if (s == null) return "Romance • Mystery";
        if (s.StoryGenres != null && s.StoryGenres.Any(sg => sg.Genre != null))
        {
            var names = s.StoryGenres.Where(sg => sg.Genre != null).Select(sg => sg.Genre.Name).ToList();
            if (names.Any()) return string.Join(" • ", names);
        }
#pragma warning disable CS0618
        if (!string.IsNullOrWhiteSpace(s.Genre)) return s.Genre;
#pragma warning restore CS0618
        return "Romance • Mystery";
    };
}

