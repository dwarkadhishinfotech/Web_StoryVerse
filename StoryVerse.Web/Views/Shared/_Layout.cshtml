<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoryVerse</title>
    <link rel="shortcut icon" href="/images/CompanyLogo/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/images/CompanyLogo/favicon.ico" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/CompanyLogo/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/CompanyLogo/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/CompanyLogo/apple-touch-icon.png" />
    <link rel="manifest" href="/images/CompanyLogo/site.webmanifest" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        :root {
            --parchment-bg: #FAF5ED;
            --forest-green: #13A8A6; /* Peacock Teal */
            --forest-green-dark: #1E439B; /* Deep Blue/Indigo */
            --parchment-border: #EAE3D2;
            --parchment-card: rgba(253, 251, 247, 0.95);
            --gold-accent: #C5A880;
            --peacock-gradient: linear-gradient(135deg, #1E439B, #13A8A6);
        }
        /* Fractional margin & gap utilities for icon/text spacing */
        .me-0\.5 { margin-right: 0.125rem !important; }
        .ms-0\.5 { margin-left: 0.125rem !important; }
        .me-1\.5 { margin-right: 0.375rem !important; }
        .ms-1\.5 { margin-left: 0.375rem !important; }
        .me-2\.5 { margin-right: 0.625rem !important; }
        .ms-2\.5 { margin-left: 0.625rem !important; }
        .gap-0\.5 { gap: 0.125rem !important; }
        .gap-1\.5 { gap: 0.375rem !important; }
        .gap-2\.5 { gap: 0.625rem !important; }

        /* Story Tag Icon Spacing Fix */
        .story-name-tag {
            display: inline-flex !important;
            align-items: center !important;
            gap: 6px !important;
        }
        .story-name-tag i,
        .story-name-tag svg {
            margin-right: 5px !important;
            flex-shrink: 0 !important;
        }

        /* =============================================================
           PEACOCK THEME FOR FLATPICKR DATE RANGE PICKER
           ============================================================= */
        .flatpickr-calendar {
            background: #FFFFFF !important;
            border-radius: 16px !important;
            border: 1px solid #E2E8F0 !important;
            box-shadow: 0 14px 35px -5px rgba(19, 168, 166, 0.22), 0 8px 16px -6px rgba(15, 23, 42, 0.08) !important;
            font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
            padding: 10px !important;
            width: 325px !important;
            z-index: 99999 !important;
        }
        .flatpickr-calendar.animate.open {
            animation: flatpickrFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }
        @@keyframes flatpickrFadeIn {
            from { opacity: 0; transform: translateY(-6px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .flatpickr-months {
            position: relative !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            background: linear-gradient(135deg, #1E439B 0%, #13A8A6 100%) !important;
            border-radius: 12px !important;
            padding: 8px 12px !important;
            margin-bottom: 10px !important;
            height: 48px !important;
        }
        .flatpickr-months .flatpickr-month {
            flex: 1 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            height: 100% !important;
            color: #FFFFFF !important;
            fill: #FFFFFF !important;
        }
        .flatpickr-current-month {
            position: relative !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            width: auto !important;
            left: auto !important;
            right: auto !important;
            padding: 0 !important;
            height: 100% !important;
            color: #FFFFFF !important;
            font-weight: 700 !important;
            font-size: 0.95rem !important;
        }
        .flatpickr-current-month .flatpickr-monthDropdown-months {
            font-weight: 700 !important;
            color: #FFFFFF !important;
            background: transparent !important;
            padding: 2px 4px !important;
            border-radius: 6px !important;
            appearance: none !important;
            -webkit-appearance: none !important;
            cursor: pointer !important;
        }
        .flatpickr-current-month .flatpickr-monthDropdown-months option {
            background-color: #0F172A !important;
            color: #FFFFFF !important;
        }
        .flatpickr-current-month input.cur-year {
            font-weight: 700 !important;
            color: #FFFFFF !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .flatpickr-months .flatpickr-prev-month,
        .flatpickr-months .flatpickr-next-month {
            position: absolute !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 32px !important;
            height: 32px !important;
            padding: 0 !important;
            border-radius: 8px !important;
            color: #FFFFFF !important;
            fill: #FFFFFF !important;
            z-index: 10 !important;
            cursor: pointer !important;
            transition: background 0.2s ease !important;
        }
        .flatpickr-months .flatpickr-prev-month {
            left: 8px !important;
        }
        .flatpickr-months .flatpickr-next-month {
            right: 8px !important;
        }
        .flatpickr-months .flatpickr-prev-month:hover,
        .flatpickr-months .flatpickr-next-month:hover {
            background: rgba(255, 255, 255, 0.22) !important;
        }
        .flatpickr-months .flatpickr-prev-month svg,
        .flatpickr-months .flatpickr-next-month svg {
            width: 14px !important;
            height: 14px !important;
            fill: #FFFFFF !important;
            stroke: #FFFFFF !important;
            margin: 0 !important;
        }
        .flatpickr-weekdays {
            padding: 0 4px !important;
        }
        span.flatpickr-weekday {
            color: #64748B !important;
            font-weight: 700 !important;
            font-size: 11.5px !important;
            text-transform: uppercase !important;
            letter-spacing: 0.04em !important;
        }
        .flatpickr-days {
            padding: 4px !important;
            width: 100% !important;
        }
        .dayContainer {
            width: 100% !important;
            min-width: 100% !important;
            max-width: 100% !important;
            justify-content: space-around !important;
        }
        .flatpickr-day {
            border-radius: 8px !important;
            color: #334155 !important;
            font-weight: 600 !important;
            font-size: 13px !important;
            transition: all 0.15s ease !important;
            height: 36px !important;
            line-height: 36px !important;
            max-width: 38px !important;
            margin: 2px 0 !important;
        }
        .flatpickr-day:hover {
            background: #F0FDFA !important;
            color: #0D9488 !important;
            border-color: #99F6E4 !important;
        }
        .flatpickr-day.today {
            border-color: #13A8A6 !important;
            color: #13A8A6 !important;
            font-weight: 700 !important;
            background: #F0FDFA !important;
        }
        .flatpickr-day.selected, 
        .flatpickr-day.startRange, 
        .flatpickr-day.endRange,
        .flatpickr-day.selected.inRange,
        .flatpickr-day.startRange.inRange,
        .flatpickr-day.endRange.inRange {
            background: linear-gradient(135deg, #1E439B 0%, #13A8A6 100%) !important;
            border-color: transparent !important;
            color: #FFFFFF !important;
            font-weight: 700 !important;
            box-shadow: 0 3px 8px rgba(19, 168, 166, 0.35) !important;
            border-radius: 8px !important;
        }
        .flatpickr-day.inRange {
            background: #CCFBF1 !important;
            box-shadow: -5px 0 0 #CCFBF1, 5px 0 0 #CCFBF1 !important;
            color: #0F766E !important;
            border-color: transparent !important;
        }
        .flatpickr-day.flatpickr-disabled, 
        .flatpickr-day.flatpickr-disabled:hover {
            color: #CBD5E1 !important;
            background: transparent !important;
            border-color: transparent !important;
        }
        /* Custom thin peacock scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.02);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(19, 168, 166, 0.35);
            border-radius: 10px;
            transition: background 0.3s ease;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(19, 168, 166, 0.7);
        }
        * {
            scrollbar-width: thin;
            scrollbar-color: rgba(19, 168, 166, 0.35) rgba(0, 0, 0, 0.02);
        }
        html, body {
            height: 100%;
            max-height: 100vh;
            max-height: 100dvh;
            overflow: hidden !important;
        }
        body {
            background-color: #FAF5ED;
            background-image: url('/backgrounds/SiteBgPage.png') !important;
            background-size: cover;
            background-position: center top;
            background-attachment: fixed;
            background-repeat: no-repeat;
        }
        /* Global utility helpers */
        .transition-all { transition: all 0.2s ease; }

        /* -------------------------------------------------------------
           GLOBAL MOBILE VIEW - 20PX PAGE END MARGIN / PADDING FOR ALL PAGES
           ------------------------------------------------------------- */
        @@media (max-width: 767.98px) {
            .main-content-wrapper {
                padding-bottom: 20px !important;
            }
            .main-content-wrapper > div:last-child {
                padding-bottom: 20px !important;
                margin-bottom: 20px !important;
            }
            .main-content-wrapper .card:last-child,
            .main-content-wrapper .db-card:last-child,
            .main-content-wrapper .cs-card:last-child,
            .main-content-wrapper .row:last-child {
                margin-bottom: 20px !important;
            }
            .dashboard-page,
            .chapter-studio-page,
            .stories-page-container,
            .character-page-container,
            .world-building-page,
            .timeline-page,
            .story-details-page {
                padding-bottom: 20px !important;
                margin-bottom: 20px !important;
            }
        }
    </style>
</head>
<body class="text-slate-800 font-sans" style="margin: 0; padding: 0; height: 100vh; height: 100dvh; overflow: hidden; background-color: #FAF5ED;">
    <partial name="_Loader" />
    <div id="sidebarBackdrop" class="sidebar-overlay-backdrop" onclick="toggleMobileSidebar()"></div>
    <div class="d-flex sv-app-container" style="height: 100vh; height: 100dvh; max-height: 100vh; max-height: 100dvh; width: 100%; background: transparent; position: relative; overflow: hidden;">
        <partial name="_Sidebar" />
        <main class="main-content-wrapper">
            <partial name="_TopNavbar" />
            <div>
                @RenderBody()
            </div>
        </main>
    </div>
    <partial name="_LogoutModal" />
    <partial name="_SessionExpiredModal" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/loader.js" asp-append-version="true"></script>
    <!-- Global Select2 Peacock Theme Initialization -->
    <script>
      function formatSelect2Option(opt) {
          if (!opt.id) return opt.text;
          var $el = $(opt.element);
          var icon = $el.data('icon');
          var desc = $el.data('description');

          if (!icon && !desc) return opt.text;

          var html = '<div class="d-inline-flex align-items-center gap-2" style="width:100%; min-width:0;">';
          if (icon) {
              html += '<i data-lucide="' + icon + '" style="width:15px; height:15px; flex-shrink:0; color:#0d9488;"></i>';
          }
          html += '<div class="d-flex flex-column text-truncate" style="min-width:0;">';
          html += '<span class="select2-option-title fw-semibold">' + opt.text + '</span>';
          if (desc) {
              html += '<span class="select2-option-desc text-muted" style="font-size: 11px;">' + desc + '</span>';
          }
          html += '</div></div>';

          return $(html);
      }

      function initSelect2(context) {
          if (typeof $.fn.select2 !== 'function') return;
          var $scope = context ? $(context) : $(document);
          $scope.find('.select2-themed, .select2-filter, select.toolbar-select:not(.no-select2)').each(function () {
              var $select = $(this);
              if ($select.hasClass('select2-hidden-accessible')) return;

              var placeholder = $select.data('placeholder') || $select.attr('placeholder') || 'Select an option...';
              var disableSearch = $select.data('no-search') === true || $select.data('no-search') === 'true';

              $select.select2({
                  theme: 'default',
                  width: '100%',
                  placeholder: placeholder,
                  minimumResultsForSearch: disableSearch ? -1 : 0,
                  templateResult: formatSelect2Option,
                  templateSelection: formatSelect2Option,
                  dropdownAutoWidth: false
              }).on('select2:open', function () {
                  if (window.lucide) {
                      setTimeout(function() { lucide.createIcons(); }, 10);
                  }
              }).on('select2:select', function (e) {
                  if (this.onchange) {
                      this.onchange.call(this, e);
                  }
              });
          });
      }

      $(document).ready(function () {
          initSelect2();
      });

      lucide.createIcons();

      function toggleMobileSidebar() {
          var sidebar = document.getElementById('mainSidebar');
          var backdrop = document.getElementById('sidebarBackdrop');
          if (sidebar) {
              sidebar.classList.toggle('sidebar-mobile-open');
          }
          if (backdrop) {
              backdrop.classList.toggle('show');
          }
      }
    </script>
    <style>
        .modal-backdrop { z-index: 1050 !important; }
        .modal         { z-index: 1055 !important; }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.body.addEventListener('hidden.bs.modal', function () {
                setTimeout(function () {
                    document.querySelectorAll('.modal-backdrop').forEach(function (el) { el.remove(); });
                    if (!document.querySelector('.modal.show')) {
                        document.body.classList.remove('modal-open');
                        document.body.style.removeProperty('overflow');
                        document.body.style.removeProperty('padding-right');
                    }
                }, 50);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
