<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoryVerse</title>
    <!-- Favicon -->
    <link rel="shortcut icon" href="/images/CompanyLogo/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/images/CompanyLogo/favicon.ico" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/CompanyLogo/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/CompanyLogo/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/CompanyLogo/apple-touch-icon.png" />
    <link rel="manifest" href="/images/CompanyLogo/site.webmanifest" />
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        :root {
            --parchment-bg: #FAF5ED;
            --forest-green: #13A8A6; /* Peacock Teal */
            --forest-green-dark: #1E439B; /* Deep Blue/Indigo */
            --parchment-border: #EAE3D2;
            --parchment-card: rgba(253, 251, 247, 0.95);
            --gold-accent: #C5A880;
            --peacock-gradient: linear-gradient(135deg, #1E439B, #13A8A6);
        }
        /* Custom thin peacock scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.02);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(19, 168, 166, 0.35);
            border-radius: 10px;
            transition: background 0.3s ease;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(19, 168, 166, 0.7);
        }
        * {
            scrollbar-width: thin;
            scrollbar-color: rgba(19, 168, 166, 0.35) rgba(0, 0, 0, 0.02);
        }
        html, body {
            max-width: 100%;
            overflow-x: hidden !important;
        }
        body {
            background-color: #FAF5ED;
            background-image: url('/backgrounds/SiteBgPage.png') !important;
            background-size: cover;
            background-position: center top;
            background-attachment: fixed;
            background-repeat: no-repeat;
        }
        /* Global utility helpers */
        .transition-all { transition: all 0.2s ease; }
    </style>
</head>
<body class="text-slate-800 font-sans" style="margin: 0; padding: 0; overflow-x: hidden; background-color: #FAF5ED;">
    <div class="d-flex" style="height: 100vh; width: 100%; background: transparent; position: relative;">
        <!-- Sidebar -->
        <partial name="_Sidebar" />

        <!-- Main Content Wrapper -->
        <main class="flex-grow-1 d-flex flex-column" style="overflow-y: auto; overflow-x: hidden; background: transparent; min-width: 0; position: relative;">
            <div class="flex-grow-1" style="padding: 1.5rem 2.5rem;">
                <!-- Top Navbar -->
                <partial name="_TopNavbar" />

                <!-- Main Content Area -->
                <div>
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <!-- Initialize Icons -->
    <script>
      lucide.createIcons();
    </script>

    <!-- Fix: Bootstrap modal backdrop cleanup -->
    <style>
        /* Ensure modal backdrop always stacks above everything */
        .modal-backdrop { z-index: 1050 !important; }
        .modal         { z-index: 1055 !important; }
    </style>
    <script>
        // Robustly clean up any stale Bootstrap modal state on close
        document.addEventListener('DOMContentLoaded', function () {
            document.body.addEventListener('hidden.bs.modal', function () {
                // Safety net: remove any lingering backdrops
                setTimeout(function () {
                    document.querySelectorAll('.modal-backdrop').forEach(function (el) { el.remove(); });
                    if (!document.querySelector('.modal.show')) {
                        document.body.classList.remove('modal-open');
                        document.body.style.removeProperty('overflow');
                        document.body.style.removeProperty('padding-right');
                    }
                }, 50);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
