                                        <img id="revCoverImg" src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=800&auto=format&fit=crop&q=80" style="width: 100%; height: 100%; object-fit: cover;" alt="Cover" />
                                    </div>
                                    <div class="flex-grow-1" style="font-size: 0.825rem;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-muted">Name</span>
                                            <span class="fw-bold text-slate-900" id="revBasicName">Silverbrook City</span>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-muted">Type</span>
                                            <span class="badge bg-teal-subtle text-teal fw-semibold" id="revBasicType" style="background-color: #e6fffa; color: #0d9488;">City</span>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-muted">Story</span>
                                            <span class="fw-semibold text-slate-800" id="revBasicStory">Revenge for Love</span>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-muted">Status</span>
                                            <span class="badge bg-success-subtle text-success fw-semibold" id="revBasicStatus">• Active</span>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="text-muted">Importance</span>
                                            <span class="badge bg-purple-subtle text-purple fw-semibold" id="revBasicImportance" style="background-color: #f3e8ff; color: #7e22ce;">Major</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="pt-2 border-top">
                                    <label class="fw-semibold text-muted d-block mb-1" style="font-size: 0.775rem;">Short Description</label>
                                    <p class="text-slate-700 mb-0" id="revBasicSummary" style="font-size: 0.825rem; line-height: 1.5;">
                                        A thriving trade city known for its silver mines and bustling markets.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Details Card -->
                        <div class="col-md-6">
                            <div class="glass-form-card h-100 p-4 rounded-4 bg-white border">
                                <div class="form-section-header d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                    <div class="form-section-title d-flex align-items-center gap-2" style="font-size: 0.95rem; font-weight: 700; color: #0f172a;">
                                        <i data-lucide="sliders" style="width: 18px; height: 18px; color: #13A8A6;"></i>
                                        Details
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold d-flex align-items-center gap-1" data-jump-step="2" style="color: #13A8A6; font-size: 0.8rem;">
                                        <i data-lucide="pencil" style="width: 13px; height: 13px;"></i> Edit
                                    </button>
                                </div>

                                <div class="d-flex flex-column gap-2" style="font-size: 0.825rem;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-muted d-flex align-items-center gap-1.5">
                                            <i data-lucide="users" style="width: 14px; height: 14px; color: #94a3b8;"></i> Population
                                        </span>
                                        <span class="fw-semibold text-slate-800" id="revDetPopulation">~ 85,000</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
