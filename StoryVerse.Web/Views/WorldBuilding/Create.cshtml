                                            <div class="text-muted text-truncate" style="font-size: 0.7rem;">@typeName</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-teal rounded-circle p-1.5 flex-shrink-0 btn-quick-add-suggestion"
                                            data-id="@pe.Id"
                                            data-name="@pe.Name"
                                            data-kind="Entity"
                                            data-type-name="@typeName"
                                            data-icon="@iconName"
                                            data-description="@descText">
                                        <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted small text-center py-2">No other entities found in active story.</div>
                        }
                    </div>
                    <div class="mt-3 text-end">
                        <a href="javascript:void(0)" class="text-decoration-none text-teal fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 0.775rem;">
                            View More Suggestions <i data-lucide="arrow-right" style="width: 13px; height: 13px;"></i>
                        </a>
                    </div>
                </div>

                <!-- Live Preview Card -->
                <div class="preview-card mb-4 bg-white rounded-4" style="border: 1px solid #e2e8f0; box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03); padding: 1.25rem;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i data-lucide="eye" style="width: 18px; height: 18px; color: #13A8A6;"></i>
                        <h6 class="fw-bold mb-0 text-slate-800" style="font-size: 0.95rem;">Preview</h6>
                    </div>
                    <p class="text-muted mb-3" style="font-size: 0.775rem;">This is how your entity will look with current details.</p>

                    <div class="live-preview-box rounded-4 overflow-hidden border">
                        <div class="live-banner" id="liveCoverBanner" style="height: 130px; background-size: cover; background-position: center; background-image: url('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=800&auto=format&fit=crop&q=80'); position: relative;">
                            <div class="live-icon-circle" id="liveIconCircle" style="position: absolute; bottom: -18px; left: 16px; width: 48px; height: 48px; border-radius: 50%; background: #ffffff; border: 2px solid #ffffff; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); display: flex; align-items: center; justify-content: center; color: #13A8A6;">
                                <i data-lucide="building-2" id="liveLucideIcon" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>

                        <div class="live-content p-3 pt-4">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <h5 class="fw-bold text-slate-900 mb-0" id="liveTitle" style="font-family: 'Playfair Display', serif; font-size: 1.15rem;">Silverbrook City</h5>
                                <span class="badge-importance" id="liveImportanceBadge" style="background: #f3e8ff; color: #7e22ce; font-size: 0.7rem; font-weight: 600; padding: 2px 8px; border-radius: 10px;">Major</span>
                            </div>

                            <div class="live-meta-pills mb-2 text-teal fw-semibold" id="liveMetaLine" style="font-size: 0.75rem; color: #0d9488;">
                                City · Eldoria · Active
                            </div>

                            <div class="live-quote-box p-2.5 px-3 rounded-3 bg-light border-start border-3 border-teal mb-3" style="border-left-color: #13A8A6 !important;">
                                <p class="text-secondary italic mb-0" id="liveSummaryText" style="font-size: 0.8rem; font-style: italic; line-height: 1.4;">
                                    “ A thriving trade city known for its silver mines and bustling markets. ”
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Icon Select Modal -->
<div class="modal fade" id="iconSelectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-slate-800" style="font-size: 1.1rem;">Choose Entity Icon</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex flex-wrap gap-3 justify-content-center" id="iconSelectionGrid">
                    @{
                        var availableIcons = new[] { "castle", "building-2", "building", "landmark", "map-pin", "globe", "crown", "star", "shield", "fortress", "mountain", "trees", "tent", "ship", "anchor", "flame", "sparkles", "sun", "moon", "book-open", "skull", "heart", "users" };
                        foreach (var iconName in availableIcons)
                        {
                            <button type="button" class="icon-grid-btn @(iconName == "castle" ? "active" : "")" data-icon="@iconName">
                                <i data-lucide="@iconName" style="width: 22px; height: 22px;"></i>
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document) .ready(function() {
            // Select2 Custom Theme Formatter
            function formatSelect2Option(opt) {
                if (!opt.id) return opt.text;
                var $el = $(opt.element);
                var desc = $el.data('description') || '';
                var icon = $el.data('icon') || '';

                var html = '<div class="select2-option-wrapper">';
                if (icon) {
                    html += '<i data-lucide="' + icon + '" class="select2-option-icon"></i>';
                }
                html += '<div>';
                html += '<div class="select2-option-title">' + opt.text + '</div>';
                if (desc) {
                    html += '<div class="select2-option-desc">' + desc + '</div>';
                }
                html += '</div></div>';

                var $res = $(html);
                return $res;
            }

            function formatSelect2Selection(opt) {
                if (!opt.id) return opt.text;
                var $el = $(opt.element);
                var desc = $el.data('description') || '';
                if (desc) {
                    return $('<span><span class="select2-selection-title">' + opt.text + '</span> <span class="select2-selection-desc">(' + desc + ')</span></span>');
                }
                return $('<span class="select2-selection-title">' + opt.text + '</span>');
            }

            $('.select2-themed').select2({
                templateResult: formatSelect2Option,
                templateSelection: formatSelect2Selection,
                width: '100%'
            });

            // Multi-Select for Related Entities
            $('#relTargetSelect').select2({
                placeholder: 'Search and select entities...',
                allowClear: true,
                width: '100%',
                templateResult: function(opt) {
                    if (!opt.id) return opt.text;
                    var $el = $(opt.element);
                    var icon = $el.data('icon') || 'building-2';
                    var typeName = $el.data('type-name') || 'Entity';
                    var desc = $el.data('description') || '';
                    var html = '<div class="d-flex align-items-center gap-2 py-1">';
                    html += '<div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width:32px;height:32px;background:#f0fdfa;color:#13A8A6;">';
                    html += '<i data-lucide="' + icon + '" style="width:15px;height:15px;"></i>';
                    html += '</div>';
                    html += '<div><div class="fw-semibold" style="font-size:0.825rem;color:#1e293b;">' + opt.text + '</div>';
                    if (desc) html += '<div style="font-size:0.725rem;color:#64748b;">' + desc + '</div>';
                    html += '</div></div>';
                    var $res = $(html);
                    setTimeout(function() { if (typeof lucide !== 'undefined') lucide.createIcons(); }, 50);
                    return $res;
                },
                templateSelection: function(opt) {
                    if (!opt.id) return opt.text;
                    var $el = $(opt.element);
                    var icon = $el.data('icon') || 'building-2';
                    return $('<span class="d-flex align-items-center gap-1"><i data-lucide="' + icon + '" style="width:12px;height:12px;"></i>' + opt.text + '</span>');
                }
            }).on('select2:open', function() {
                setTimeout(function() { if (typeof lucide !== 'undefined') lucide.createIcons(); }, 30);
            });

            // Relationship Cards State
            var relCards = []; // [{id, targetId, targetName, targetIcon, targetKind, relType, importance}]

            function updateRelCountDisplay() {
                var count = relCards.length;
                $('#relCountDisplay').text(count);
                $('#relStartNum').text(count > 0 ? 1 : 0);
                $('#relEndNum').text(count);
                $('#relTotalNum').text(count);
                if (count > 0) {
                    $('#relEmptyState').hide();
                } else {
                    $('#relEmptyState').show();
                }
            }

            function renderRelCards() {
                var $container = $('#relCardsContainer');
                $container.find('.rel-card-item').remove();

                // Update hidden form inputs
                $container.find('input[name^="Relationships["]').remove();

                relCards.forEach(function(card, idx) {
                    var importanceColor = {
                        'Critical': '#ef4444', 'High': '#3b82f6', 'Major': '#8b5cf6',
                        'Medium': '#f59e0b', 'Minor': '#94a3b8'
                    }[card.importance] || '#f59e0b';

                    var kindIcon = card.targetKind === 'Character' ? 'user' : card.targetIcon;
                    var kindColor = card.targetKind === 'Character' ? '#4338ca' : '#0d9488';
                    var kindBg = card.targetKind === 'Character' ? '#e0e7ff' : '#e6fffa';

                    var html = `
                        <div class="rel-card-item d-flex align-items-center justify-content-between p-3 px-3 rounded-3 mb-2" 
                             style="background: #ffffff; border: 1px solid #e2e8f0; transition: box-shadow 0.15s;">
                            <div class="d-flex align-items-center gap-3 flex-grow-1 overflow-hidden">
                                <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" 
                                     style="width: 38px; height: 38px; background: ${kindBg}; color: ${kindColor};">
                                    <i data-lucide="${kindIcon}" style="width: 18px; height: 18px;"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <div class="fw-semibold text-slate-800 text-truncate" style="font-size: 0.875rem;">${card.targetName}</div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap mt-0.5">
                                        <span class="badge" style="background: #f0fdfa; color: #0d9488; font-size: 0.7rem; font-weight: 500; padding: 2px 8px; border-radius: 8px;">${card.relType}</span>
                                        <span class="badge" style="background: ${importanceColor}22; color: ${importanceColor}; font-size: 0.7rem; font-weight: 500; padding: 2px 8px; border-radius: 8px;">${card.importance}</span>
                                        <span class="badge" style="background: #f1f5f9; color: #64748b; font-size: 0.7rem; font-weight: 500; padding: 2px 8px; border-radius: 8px;">${card.targetKind}</span>
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-light border text-danger ms-2 flex-shrink-0 btn-remove-rel" data-rel-id="${card.id}" title="Remove" style="width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 8px;">
                                <i data-lucide="x" style="width: 14px; height: 14px;"></i>
                            </button>
                            <input type="hidden" name="Relationships[${idx}].TargetId" value="${card.targetId}" />
                            <input type="hidden" name="Relationships[${idx}].TargetKind" value="${card.targetKind}" />
                            <input type="hidden" name="Relationships[${idx}].RelationshipType" value="${card.relType}" />
                            <input type="hidden" name="Relationships[${idx}].Importance" value="${card.importance}" />
                        </div>
                    `;
                    $container.append(html);
                });

                updateRelCountDisplay();
                if (typeof lucide !== 'undefined') lucide.createIcons();
            }

            // Add Relationship Button Handler
            $('#btnAddRelCardBtn').on('click', function() {
                var selectedVals = $('#relTargetSelect').val();
                var relType = $('#relTypeSelect').val();
                var importance = $('#relImportanceSelect').val() || 'Medium';

                if (!selectedVals || selectedVals.length === 0) {
                    $('#relTargetSelect').next('.select2-container').find('.select2-selection').css('border-color', '#ef4444');
                    setTimeout(function() {
                        $('#relTargetSelect').next('.select2-container').find('.select2-selection').css('border-color', '');
                    }, 1500);
                    return;
                }
                if (!relType) {
                    $('#relTypeSelect').next('.select2-container').find('.select2-selection').css('border-color', '#ef4444');
                    setTimeout(function() {
                        $('#relTypeSelect').next('.select2-container').find('.select2-selection').css('border-color', '');
                    }, 1500);
                    return;
                }

                var addedCount = 0;
                selectedVals.forEach(function(val) {
                    // Prevent duplicates with the same rel type
                    var exists = relCards.some(function(c) { return c.targetId === val && c.relType === relType; });
                    if (exists) return;

                    var $opt = $('#relTargetSelect option[value="' + val + '"]');
                    var targetName = $opt.text().trim();
                    var targetIcon = $opt.data('icon') || 'building-2';
                    var targetKind = $opt.data('kind') || 'Entity';

                    relCards.push({
                        id: 'rel_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                        targetId: val,
                        targetName: targetName,
                        targetIcon: targetIcon,
                        targetKind: targetKind,
                        relType: relType,
                        importance: importance
                    });
                    addedCount++;
                });

                if (addedCount > 0) {
                    renderRelCards();
                    // Reset selects
                    $('#relTargetSelect').val(null).trigger('change');
                    $('#relTypeSelect').val('').trigger('change');
                }
            });

            // Remove relationship card
            $(document).on('click', '.btn-remove-rel', function() {
                var relId = $(this).data('rel-id');
                relCards = relCards.filter(function(c) { return c.id !== relId; });
                renderRelCards();
            });

            // Init display
            updateRelCountDisplay();

            // Live Preview Update Function
            function updateLivePreview() {
                var nameVal = $('#Name').val().trim();
                var storyVal = $('#StoryId option:selected').text().trim() || 'Revenge for Love';
                var typeVal = $('#EntityTypeId option:selected').text().trim() || 'Location';
                var importanceVal = $('#Importance').val() || 'Major';
                var statusVal = $('#Status').val() || 'Active';
                var summaryVal = $('#Summary').val().trim() || 'A brief one-line or two-line description.';
                var iconName = $('#entityIconInput').val() || 'map-pin';

                $('#pageHeaderTitle').text(nameVal ? 'Create ' + nameVal : 'Create ' + typeVal);
                $('#breadcrumbCurrent').text(nameVal ? 'Create ' + nameVal : 'Create ' + typeVal);

                $('#liveTitle').text(nameVal || 'Silverbrook City');
                $('#liveSummaryText').text(summaryVal);
                $('#liveImportanceBadge').text(importanceVal);
                $('#liveMetaLine').text(typeVal + ' · ' + storyVal + ' · ' + statusVal);

                $('#gridTypeVal').text(typeVal);
                $('#gridStoryVal').text(storyVal);
                $('#gridImportanceVal').text(importanceVal);
                $('#gridStatusVal').text(statusVal);

                // Review Pane values
                $('#revStory').text(storyVal);
                $('#revType').text(typeVal);
                $('#revName').text(nameVal || '—');
                $('#revImportance').text(importanceVal);
                $('#revStatus').text(statusVal);
                $('#revSummary').text(summaryVal);

                // Update Icon in preview
                var newIconHtml = '<i data-lucide="' + iconName + '" style="width: 24px; height: 24px; color: #13A8A6;"></i>';
                $('#liveIconCircle').html(newIconHtml);
                $('#iconPickerDisplay').replaceWith('<i data-lucide="' + iconName + '" id="iconPickerDisplay" style="width: 40px; height: 40px; color: #13A8A6;"></i>');

                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            }

            // Event Listeners for Live Updates
            $('#Name, #Summary').on('input keyup change', updateLivePreview);
            $('#StoryId, #EntityTypeId, #Importance, #Status').on('change', updateLivePreview);

            // Icon Picker Modal selection
            $('#iconSelectionGrid .icon-grid-btn').on('click', function() {
                $('#iconSelectionGrid .icon-grid-btn').removeClass('active');
                $(this).addClass('active');

                var chosenIcon = $(this).data('icon');
                $('#entityIconInput').val(chosenIcon);

                var modalEl = document.getElementById('iconSelectModal');
                var modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();

                updateLivePreview();
            });

            // Cover Image File Trigger & Preview
            $('#coverPickerBox').on('click', function() {
                $('#CoverFileInput').click();
            });

            $('#CoverFileInput').on('change', function(e) {
                if (e.target.files && e.target.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function(evt) {
                        $('#coverPreviewImg').attr('src', evt.target.result).show();
                        $('#liveCoverBanner').css('background-image', 'url("' + evt.target.result + '")');
                        $('#coverPlaceholder').hide();
                    };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });

            // Stepper Navigation Logic
            var currentStep = 1;

            function showPane(stepNum) {
                currentStep = parseInt(stepNum);
                $('.step-pane').addClass('d-none');
                $('#step-pane-' + currentStep).removeClass('d-none');

                $('.stepper-step').removeClass('active completed');
                $('.stepper-step').each(function() {
                    var s = parseInt($(this).data('step'));
                    if (s < currentStep) {
                        $(this).addClass('completed');
                        $(this).find('.stepper-number').html('<i data-lucide="check" style="width:16px;height:16px;"></i>');
                    } else if (s === currentStep) {
                        $(this).addClass('active');
                        $(this).find('.stepper-number').text(s);
                    } else {
                        $(this).find('.stepper-number').text(s);
                    }
                });

                if (currentStep === 5) {
                    $('.btn-next-top').addClass('d-none');
                } else {
                    $('.btn-next-top').removeClass('d-none');
                }

                // Toggle Sidebar Cards per Step
                if (currentStep === 3) {
                    $('#relationshipTipsCard, #suggestedRelCard').removeClass('d-none');
                    $('.details-tips-card, .suggested-details-card, #assetTipsCard, #uploadSummaryCard, #sidebarEntitySummaryCard').addClass('d-none');
                } else if (currentStep === 4) {
                    $('#assetTipsCard, #uploadSummaryCard').removeClass('d-none');
                    $('.details-tips-card, .suggested-details-card, #relationshipTipsCard, #suggestedRelCard, #sidebarEntitySummaryCard').addClass('d-none');
                } else if (currentStep === 5) {
                    $('#sidebarEntitySummaryCard').removeClass('d-none');
                    $('.details-tips-card, .suggested-details-card, #relationshipTipsCard, #suggestedRelCard, #assetTipsCard, #uploadSummaryCard').addClass('d-none');
                    updateReviewTab();
                } else {
                    $('.details-tips-card, .suggested-details-card').removeClass('d-none');
                    $('#relationshipTipsCard, #suggestedRelCard, #assetTipsCard, #uploadSummaryCard, #sidebarEntitySummaryCard').addClass('d-none');
                }

                window.scrollTo({ top: 0, behavior: 'smooth' });

                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            }

            // Click Handlers for Stepper Navigation
            $(document).on('click', '.stepper-step', function(e) {
                e.preventDefault();
                var step = $(this).data('step');
                if (step) {
                    showPane(step);
                }
            });

            $(document).on('click', '.btn-next-top', function(e) {
                e.preventDefault();
                if (currentStep < 5) {
                    showPane(currentStep + 1);
                }
            });

            $(document).on('click', '.btn-next-pane', function(e) {
                e.preventDefault();
                var nextStep = $(this).data('next');
                if (nextStep) {
                    showPane(nextStep);
                }
            });

            $(document).on('click', '.btn-prev-pane', function(e) {
                e.preventDefault();
                var prevStep = $(this).data('prev');
                if (prevStep) {
                    showPane(prevStep);
                }
            });

            $('#saveDraftBtn').on('click', function(e) {
                e.preventDefault();
                $('#Status').val('Draft');
                updateLivePreview();
                $('#createEntityForm').submit();
            });

            // Assets Tab State & Management
            var uploadedAssets = [];
            var currentAssetFilter = 'images';
            var currentAssetView = 'grid';

            // Tab switching for asset types
            $('#assetTypeTabs .nav-link').on('click', function() {
                $('#assetTypeTabs .nav-link').removeClass('active');
                $(this).addClass('active');

                currentAssetFilter = $(this).data('asset-type');
                updateDropzoneUI(currentAssetFilter);
                renderUploadedAssets();
            });

            function updateDropzoneUI(type) {
                var $icon = $('#dropzoneIcon');
                var $title = $('#dropzoneTitle');
                var $helper = $('#dropzoneHelper');
                var $input = $('#assetFileInput');
                var $fileZone = $('#fileUploadZoneSection');
                var $extZone = $('#externalLinksSection');

                if (type === 'links') {
                    $fileZone.addClass('d-none');
                    $extZone.removeClass('d-none');
                    $('#uploadedAssetsTitle').text('Uploaded Links');
                    return;
                } else {
                    $fileZone.removeClass('d-none');
                    $extZone.addClass('d-none');
                }

                if (type === 'images') {
                    $icon.attr('data-lucide', 'upload-cloud');
                    $title.text('Drag & drop images here');
                    $helper.text('Supports JPG, PNG, WEBP up to 10MB each. You can upload up to 20 files.');
                    $input.attr('accept', 'image/*');
                    $('#uploadedAssetsTitle').text('Uploaded Images');
                } else if (type === 'documents') {
                    $icon.attr('data-lucide', 'file-text');
                    $title.text('Drag & drop documents here');
                    $helper.text('Supports PDF, DOCX, TXT up to 25MB each. You can upload up to 10 files.');
                    $input.attr('accept', '.pdf,.doc,.docx,.txt,.md');
                    $('#uploadedAssetsTitle').text('Uploaded Documents');
                } else if (type === 'maps') {
                    $icon.attr('data-lucide', 'map');
                    $title.text('Drag & drop map files & overlays here');
                    $helper.text('Supports JPG, PNG, SVG, GeoJSON up to 20MB.');
                    $input.attr('accept', 'image/*,.json,.geojson,.svg');
                    $('#uploadedAssetsTitle').text('Uploaded Maps');
                } else if (type === 'audiovideo') {
                    $icon.attr('data-lucide', 'video');
                    $title.text('Drag & drop audio and video clips here');
                    $helper.text('Supports MP3, WAV, MP4, WEBM up to 50MB.');
                    $input.attr('accept', 'audio/*,video/*');
                    $('#uploadedAssetsTitle').text('Uploaded Media Clips');
                }

                if (typeof lucide !== 'undefined') lucide.createIcons();
            }

            // Browse button click
            $('#browseAssetsBtn, #assetDropZone').on('click', function(e) {
                if (e.target.id === 'browseAssetsBtn' || $(e.target).closest('#browseAssetsBtn').length || e.target.id === 'assetDropZone' || $(e.target).closest('#assetDropZone').length) {
                    $('#assetFileInput').click();
                }
            });

            // Prevent dropzone file input click propagation loop
            $('#assetFileInput').on('click', function(e) {
                e.stopPropagation();
            });

            // Drag and drop handlers
            var $dropZone = $('#assetDropZone');
            $dropZone.on('dragover dragenter', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).addClass('dragover');
            });

            $dropZone.on('dragleave drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).removeClass('dragover');
            });

            $dropZone.on('drop', function(e) {
                var files = e.originalEvent.dataTransfer.files;
                if (files && files.length) {
                    handleFileSelection(files);
                }
            });

            $('#assetFileInput').on('change', function(e) {
                if (e.target.files && e.target.files.length) {
                    handleFileSelection(e.target.files);
                }
            });

            function handleFileSelection(files) {
                for (var i = 0; i < files.length; i++) {
                    var file = files[i];
                    
                    var assetObj = {
                        id: 'asset_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                        name: file.name,
                        sizeBytes: file.size,
                        sizeFormatted: formatBytes(file.size),
                        category: currentAssetFilter,
                        file: file,
                        timestamp: new Date(),
                        isFav: false,
                        previewUrl: null
                    };

                    if (file.type.startsWith('image/')) {
                        assetObj.previewUrl = URL.createObjectURL(file);
                    }

                    uploadedAssets.push(assetObj);
                }

                renderUploadedAssets();
                updateUploadSummary();
            }

            function formatBytes(bytes, decimals) {
                if (typeof decimals === 'undefined') decimals = 1;
                if (bytes === 0) return '0 B';
                var k = 1024;
                var dm = decimals < 0 ? 0 : decimals;
                var sizes = ['B', 'KB', 'MB', 'GB'];
                var i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
            }

            // Add External Link
            $('#btnAddExtLink').on('click', function() {
                var title = $('#extLinkTitle').val().trim();
                var url = $('#extLinkUrl').val().trim();
                var type = $('#extLinkType').val();

                if (!title || !url) {
                    alert('Please enter both link title and URL.');
                    return;
                }

                var linkObj = {
                    id: 'link_' + Date.now(),
                    name: title,
                    url: url,
                    linkType: type,
                    sizeBytes: 0,
                    sizeFormatted: 'External Link',
                    category: 'links',
                    timestamp: new Date(),
                    isFav: false
                };

                uploadedAssets.push(linkObj);
                $('#extLinkTitle').val('');
                $('#extLinkUrl').val('');

                renderUploadedAssets();
                updateUploadSummary();
            });

            // View toggle (Grid / List)
            $('#btnGridView').on('click', function() {
                currentAssetView = 'grid';
                $(this).addClass('active').css({'background-color': '#f0fdfa', 'color': '#13A8A6'});
                $('#btnListView').removeClass('active').css({'background-color': 'transparent', 'color': '#64748b'});
                renderUploadedAssets();
            });

            $('#btnListView').on('click', function() {
                currentAssetView = 'list';
                $(this).addClass('active').css({'background-color': '#f0fdfa', 'color': '#13A8A6'});
                $('#btnGridView').removeClass('active').css({'background-color': 'transparent', 'color': '#64748b'});
                renderUploadedAssets();
            });

            // Sort dropdown listener
            $('#assetSortDropdown').on('change', function() {
                renderUploadedAssets();
            });

            // Delete asset handler
            $(document).on('click', '.btn-delete-asset', function(e) {
                e.stopPropagation();
                var id = $(this).data('asset-id');
                uploadedAssets = uploadedAssets.filter(function(a) { return a.id !== id; });
                renderUploadedAssets();
                updateUploadSummary();
            });

            // Fav toggle handler
            $(document).on('click', '.btn-fav-asset', function(e) {
                e.stopPropagation();
                var id = $(this).data('asset-id');
                var asset = uploadedAssets.find(function(a) { return a.id === id; });
                if (asset) {
                    asset.isFav = !asset.isFav;
                    renderUploadedAssets();
                }
            });

            function renderUploadedAssets() {
                var filtered = uploadedAssets.filter(function(a) { return a.category === currentAssetFilter; });
                var sortVal = $('#assetSortDropdown').val();

                if (sortVal === 'newest') {
                    filtered.sort(function(a, b) { return b.timestamp - a.timestamp; });
                } else if (sortVal === 'oldest') {
                    filtered.sort(function(a, b) { return a.timestamp - b.timestamp; });
                } else if (sortVal === 'name') {
                    filtered.sort(function(a, b) { return a.name.localeCompare(b.name); });
                } else if (sortVal === 'size') {
                    filtered.sort(function(a, b) { return b.sizeBytes - a.sizeBytes; });
                }

                $('#uploadedAssetsCount').text(filtered.length);

                var $container = $('#uploadedAssetsContainer');
                $container.empty();

                if (filtered.length === 0) {
                    $container.html(`
                        <div class="col-12 text-center py-5 px-3 border border-dashed rounded-4 bg-light-subtle" id="emptyAssetsState">
                            <i data-lucide="image-plus" style="width: 42px; height: 42px; color: #cbd5e1;" class="mb-2"></i>
                            <h6 class="fw-semibold text-slate-700 mb-1">No assets uploaded yet</h6>
                            <p class="text-muted small mb-0">Drag and drop files or select Browse Files above to add media to this entity.</p>
                        </div>
                    `);
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                    return;
                }

                filtered.forEach(function(item) {
                    var html = '';
                    if (currentAssetView === 'grid') {
                        if (item.category === 'images' || item.category === 'maps') {
                            var imgSrc = item.previewUrl || 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&auto=format&fit=crop&q=80';
                            html = `
                                <div class="col-md-4 col-sm-6">
                                    <div class="asset-item-card">
                                        <div class="asset-thumb-container">
                                            <img src="${imgSrc}" alt="${item.name}" />
                                            <button type="button" class="asset-fav-btn ${item.isFav ? 'active' : ''} btn-fav-asset" data-asset-id="${item.id}">
                                                <i data-lucide="star" style="width: 13px; height: 13px;"></i>
                                            </button>
                                            <button type="button" class="asset-delete-btn btn-delete-asset" data-asset-id="${item.id}" title="Remove Asset">
                                                <i data-lucide="trash-2" style="width: 13px; height: 13px;"></i>
                                            </button>
                                        </div>
                                        <div class="asset-footer">
                                            <div class="asset-name">${item.name}</div>
                                            <div class="asset-meta">${item.sizeFormatted}</div>
                                        </div>
                                    </div>
                                </div>
                            `;
                        } else if (item.category === 'links') {
                            html = `
                                <div class="col-md-6">
                                    <div class="doc-item-card">
                                        <div class="doc-icon-box other">
                                            <i data-lucide="link" style="width: 20px; height: 20px;"></i>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-semibold text-slate-800 text-truncate" style="font-size: 0.85rem;">${item.name}</div>
                                            <a href="${item.url}" target="_blank" class="text-teal text-truncate d-block small" style="color: #13A8A6;">${item.url}</a>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-light border p-1 text-danger btn-delete-asset" data-asset-id="${item.id}">
                                            <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                        </button>
                                    </div>
                                </div>
                            `;
                        } else {
                            var iconClass = item.name.endsWith('.pdf') ? 'pdf' : (item.name.endsWith('.doc') || item.name.endsWith('.docx') ? 'word' : 'txt');
                            var iconName = item.name.endsWith('.pdf') ? 'file-text' : 'file';
                            html = `
                                <div class="col-md-6">
                                    <div class="doc-item-card">
                                        <div class="doc-icon-box ${iconClass}">
                                            <i data-lucide="${iconName}" style="width: 20px; height: 20px;"></i>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-semibold text-slate-800 text-truncate" style="font-size: 0.85rem;">${item.name}</div>
                                            <div class="text-muted small">${item.sizeFormatted} · Uploaded just now</div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-light border p-1 text-danger btn-delete-asset" data-asset-id="${item.id}">
                                            <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                        </button>
                                    </div>
                                </div>
                            `;
                        }
                    } else {
                        // List View
                        html = `
                            <div class="col-12">
                                <div class="doc-item-card p-2 px-3">
                                    <div class="doc-icon-box other" style="width: 36px; height: 36px;">
                                        <i data-lucide="${item.category === 'images' ? 'image' : (item.category === 'links' ? 'link' : 'file-text')}" style="width: 18px; height: 18px;"></i>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold text-slate-800 text-truncate" style="font-size: 0.85rem;">${item.name}</div>
                                        <div class="text-muted small">${item.sizeFormatted}</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-light border p-1 text-danger btn-delete-asset" data-asset-id="${item.id}">
                                        <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                    </button>
                                </div>
                            </div>
                        `;
                    }
                    $container.append(html);
                });

                if (typeof lucide !== 'undefined') lucide.createIcons();
            }

            function updateUploadSummary() {
                var imgSize = 0;
                var docSize = 0;
                var otherSize = 0;

                uploadedAssets.forEach(function(a) {
                    if (a.category === 'images' || a.category === 'maps') imgSize += a.sizeBytes;
                    else if (a.category === 'documents') docSize += a.sizeBytes;
                    else otherSize += a.sizeBytes;
                });

                var totalBytes = imgSize + docSize + otherSize;
                var totalMB = totalBytes / (1024 * 1024);
                var imgMB = imgSize / (1024 * 1024);
                var docMB = docSize / (1024 * 1024);
                var otherMB = otherSize / (1024 * 1024);

                var maxMB = 100;
                var percent = Math.min(100, Math.round((totalMB / maxMB) * 100));

                $('#summaryTotalStorageText').text(totalMB.toFixed(1) + ' MB');
                $('#summaryImagesSizeText').text(imgMB.toFixed(1) + ' MB');
                $('#summaryDocsSizeText').text(docMB.toFixed(1) + ' MB');
                $('#summaryOthersSizeText').text(otherMB.toFixed(1) + ' MB');

                $('#summaryProgressText').text(totalMB.toFixed(1) + ' MB of 100 MB used');
                $('#summaryPercentBadge').text(percent + '%');
                $('#summaryProgressBar').css('width', percent + '%');

                // Donut SVG strokes
                var imgPct = (imgMB / maxMB) * 100;
                var docPct = (docMB / maxMB) * 100;
                var otherPct = (otherMB / maxMB) * 100;

                $('#donutSegmentImages').attr('stroke-dasharray', imgPct + ', 100');
                
                $('#donutSegmentDocs').attr('stroke-dasharray', docPct + ', 100');
                $('#donutSegmentDocs').attr('stroke-dashoffset', '-' + imgPct);

                $('#donutSegmentOthers').attr('stroke-dasharray', otherPct + ', 100');
                $('#donutSegmentOthers').attr('stroke-dashoffset', '-' + (imgPct + docPct));
            }

            // Quick Edit Step Jump Handler
            $(document).on('click', '[data-jump-step]', function(e) {
                e.preventDefault();
                var targetStep = $(this).data('jump-step');
                showPane(targetStep);
            });

            // Review Asset Sub-Tabs Switch Handler
            $(document).on('click', '#revAssetTypeTabs .nav-link', function(e) {
                e.preventDefault();
                $('#revAssetTypeTabs .nav-link').removeClass('active');
                $(this).addClass('active');
                var cat = $(this).data('rev-asset');
                renderReviewAssets(cat);
            });

            // Dynamic Review Tab Update Function
            function updateReviewTab() {
                // 1. Basic Info
                var nameVal = $('#Name').val().trim();
                var storyVal = $('#StoryId option:selected').val() ? $('#StoryId option:selected').text().trim() : '—';
                var typeVal = $('#EntityTypeId option:selected').val() ? $('#EntityTypeId option:selected').text().trim() : '—';
                var importanceVal = $('#Importance').val() || 'Major';
                var statusVal = $('#Status').val() || 'Active';
                var summaryVal = $('#Summary').val().trim() || '—';

                $('#revBasicName').text(nameVal || '—');
                $('#revBasicType').text(typeVal);
                $('#revBasicStory').text(storyVal);
                $('#revBasicStatus').html('• ' + statusVal);
                $('#revBasicImportance').text(importanceVal);
                $('#revBasicSummary').text(summaryVal);

                var coverSrc = $('#coverPreviewImg').attr('src');
                if (coverSrc && coverSrc.length > 0 && $('#coverPreviewImg').is(':visible')) {
                    $('#revCoverImg').attr('src', coverSrc).show();
                } else {
                    $('#revCoverImg').attr('src', 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=800&auto=format&fit=crop&q=80').show();
                }

                // 2. Details
                var popVal = $('#Population').val().trim();
                var foundVal = $('#Founded').val().trim();
                var govVal = $('#Government option:selected').val() ? $('#Government option:selected').text().trim() : '';
                var rulerVal = $('#Ruler').val().trim();
                var currVal = $('#Currency').val().trim();
                var climVal = $('#Climate option:selected').val() ? $('#Climate option:selected').text().trim() : '';
                var tzVal = $('#TimeZone').val().trim();

                $('#revDetPopulation').text(popVal || '—');
                $('#revDetFounded').text(foundVal || '—');
                $('#revDetGovernment').text(govVal || '—');
                $('#revDetRuler').text(rulerVal || '—');
                $('#revDetCurrency').text(currVal || '—');
                $('#revDetClimate').text(climVal || '—');
                $('#revDetTimeZone').text(tzVal || '—');

                // Languages pills
                var $langPills = $('#revDetLanguages');
                $langPills.empty();
                var selectedLangs = $('#Languages').val() || [];
                if (selectedLangs.length > 0) {
                    selectedLangs.forEach(function(lang) {
                        $langPills.append('<span class="badge bg-light text-slate-800 border fw-normal" style="font-size: 0.725rem;">' + lang + ' ×</span>');
                    });
                } else {
                    $langPills.append('<span class="text-muted">—</span>');
                }

                // 3. Relationships
                var $relContainer = $('#revRelationshipsContainer');
                $relContainer.empty();
                var totalRelsCount = 0;

                var entityName = nameVal || 'This Entity';

                // Character links
                $('#characterLinksContainer .character-link-row').each(function() {
                    var charSelect = $(this).find('select[name="LinkedCharacterId"]');
                    var charId = charSelect.val();
                    var charName = charSelect.find('option:selected').val() ? charSelect.find('option:selected').text().trim() : '';
                    var roleVal = $(this).find('select[name="CharacterRole"] option:selected').text().trim() || 'Connected';

                    if (charId && charName && charName !== 'Select character...') {
                        totalRelsCount++;
                        var html = `
                            <div class="d-flex align-items-center justify-content-between p-2.5 px-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-teal-subtle text-teal" style="width: 32px; height: 32px; background-color: #e6fffa; color: #0d9488;">
                                        <i data-lucide="building-2" style="width: 16px; height: 16px;"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-slate-800" style="font-size: 0.825rem;">${entityName}</div>
                                        <div class="text-muted" style="font-size: 0.725rem;">This Entity</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1 text-muted small px-2">
                                    <i data-lucide="arrow-right" style="width: 16px; height: 16px; color: #94a3b8;"></i>
                                </div>
                                <div class="d-flex align-items-center gap-2 text-end">
                                    <div>
                                        <div class="fw-semibold text-slate-800" style="font-size: 0.825rem;">${charName}</div>
                                        <span class="badge bg-indigo-subtle text-indigo" style="font-size: 0.7rem; background-color: #e0e7ff; color: #4338ca;">Character</span>
                                        <div class="text-muted" style="font-size: 0.725rem;">${roleVal}</div>
                                    </div>
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-indigo-subtle text-indigo" style="width: 32px; height: 32px; background-color: #e0e7ff; color: #4338ca;">
                                        <i data-lucide="user" style="width: 16px; height: 16px;"></i>
                                    </div>
                                </div>
                            </div>
                        `;
                        $relContainer.append(html);
                    }
                });

                // Entity relationships
                $('#entityRelationshipsContainer .relationship-row').each(function() {
                    var targetSelect = $(this).find('select[name="RelationshipTargetId"]');
                    var targetId = targetSelect.val();
                    var targetName = targetSelect.find('option:selected').val() ? targetSelect.find('option:selected').text().trim() : '';
                    var relTypeVal = $(this).find('select[name="RelationshipType"] option:selected').text().trim() || 'Connected To';
                    var notesVal = $(this).find('input[name="RelationshipDescription"]').val().trim();

                    if (targetId && targetName && targetName !== 'Select target entity...') {
                        totalRelsCount++;
                        var html = `
                            <div class="d-flex align-items-center justify-content-between p-2.5 px-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-teal-subtle text-teal" style="width: 32px; height: 32px; background-color: #e6fffa; color: #0d9488;">
                                        <i data-lucide="building-2" style="width: 16px; height: 16px;"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-slate-800" style="font-size: 0.825rem;">${entityName}</div>
                                        <div class="text-muted" style="font-size: 0.725rem;">This Entity</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1 text-muted small px-2">
                                    <i data-lucide="arrow-right" style="width: 16px; height: 16px; color: #94a3b8;"></i>
                                </div>
                                <div class="d-flex align-items-center gap-2 text-end">
                                    <div>
                                        <div class="fw-semibold text-slate-800" style="font-size: 0.825rem;">${targetName}</div>
                                        <span class="badge bg-purple-subtle text-purple" style="font-size: 0.7rem; background-color: #f3e8ff; color: #7e22ce;">${relTypeVal}</span>
                                        ${notesVal ? `<div class="text-muted" style="font-size: 0.725rem;">${notesVal}</div>` : ''}
                                    </div>
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-purple-subtle text-purple" style="width: 32px; height: 32px; background-color: #f3e8ff; color: #7e22ce;">
                                        <i data-lucide="landmark" style="width: 16px; height: 16px;"></i>
                                    </div>
                                </div>
                            </div>
                        `;
                        $relContainer.append(html);
                    }
                });

                if (totalRelsCount === 0) {
                    $relContainer.html('<div class="text-center py-4 text-muted small">No relationships connected yet. Click Edit to add connections.</div>');
                }

                $('#revRelCount').text(totalRelsCount);
                $('#sumTotalRelationships').text(totalRelsCount);

                // 4. Assets & Media
                var activeRevTab = $('#revAssetTypeTabs .nav-link.active').data('rev-asset') || 'images';
                renderReviewAssets(activeRevTab);

                // 5. Entity Summary Sidebar
                $('#sumEntityType').text(typeVal);
                $('#sumStoryTitle').text(storyVal);
                $('#sumStatusPill').html('• ' + statusVal);
                $('#sumImportanceBadge').text(importanceVal);

                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            }

            function renderReviewAssets(category) {
                var $container = $('#revAssetsContentContainer');
                $container.empty();

                var imgCount = 0, docCount = 0, mapCount = 0, avCount = 0, linkCount = 0;

                uploadedAssets.forEach(function(item) {
                    if (item.category === 'images') imgCount++;
                    else if (item.category === 'documents') docCount++;
                    else if (item.category === 'maps') mapCount++;
                    else if (item.category === 'audiovideo') avCount++;
                    else if (item.category === 'links') linkCount++;
                });

                $('#revImgCount').text(imgCount);
                $('#revDocCount').text(docCount);
                $('#revMapCount').text(mapCount);
                $('#revAVCount').text(avCount);
                $('#revLinkCount').text(linkCount);

                var totalAssets = uploadedAssets.length;
                $('#sumTotalAssets').text(totalAssets + ' Files');

                var filtered = uploadedAssets.filter(function(item) {
                    return item.category === category;
                });

                if (filtered.length === 0) {
                    $container.html('<div class="text-center py-4 text-muted small">No items in this category yet. Click Edit to add assets.</div>');
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                    return;
                }

                if (category === 'images') {
                    var gridHtml = '<div class="row g-3">';
                    filtered.forEach(function(item) {
                        var imgSrc = item.previewUrl || 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&auto=format&fit=crop&q=80';
                        gridHtml += `
                            <div class="col-6 col-sm-4 col-md-3">
                                <div class="rounded-3 overflow-hidden border shadow-sm" style="height: 100px; background-color: #f8fafc;">
                                    <img src="${imgSrc}" style="width:100%; height:100%; object-fit:cover;" alt="${item.name}" />
                                </div>
                            </div>
                        `;
                    });
                    gridHtml += '</div>';
                    $container.html(gridHtml);
                } else {
                    var listHtml = '<div class="d-flex flex-column gap-2">';
                    filtered.forEach(function(item) {
                        var iconName = item.category === 'documents' ? 'file-text' : (item.category === 'maps' ? 'map' : (item.category === 'audiovideo' ? 'video' : 'link'));
                        listHtml += `
                            <div class="d-flex align-items-center justify-content-between p-2.5 px-3 rounded-3 border bg-light">
                                <div class="d-flex align-items-center gap-2.5">
                                    <i data-lucide="${iconName}" style="width: 20px; height: 20px; color: #13A8A6;"></i>
                                    <div>
                                        <div class="fw-semibold text-slate-800" style="font-size: 0.85rem;">${item.name}</div>
                                        <div class="text-muted" style="font-size: 0.725rem;">${item.sizeFormatted || 'Link'}</div>
                                    </div>
                                </div>
                                ${item.url ? `<a href="${item.url}" target="_blank" class="btn btn-sm btn-link text-teal p-0"><i data-lucide="external-link" style="width:16px;height:16px;"></i></a>` : ''}
                            </div>
                        `;
                    });
                    listHtml += '</div>';
                    $container.html(listHtml);
                }

                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            }

            // Initial trigger
            updateLivePreview();
        });
    </script>
}
