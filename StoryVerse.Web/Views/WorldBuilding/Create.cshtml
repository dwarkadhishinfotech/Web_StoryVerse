                                <div class="col-12 text-center py-5 px-3 border border-dashed rounded-4 bg-light-subtle" id="emptyAssetsState">
                                    <i data-lucide="image-plus" style="width: 42px; height: 42px; color: #cbd5e1;" class="mb-2"></i>
                                    <h6 class="fw-semibold text-slate-700 mb-1">No assets uploaded yet</h6>
                                    <p class="text-muted small mb-0">Drag and drop files or select Browse Files above to add media to this entity.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <button type="button" class="btn btn-outline-teal d-flex align-items-center gap-2 btn-prev-pane" data-prev="3">
                            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i> Back
                        </button>
                        <button type="button" class="btn btn-teal d-flex align-items-center gap-2 btn-next-pane" data-next="5">
                            Next Step <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
                        </button>
                    </div>
                </div>

                <!-- STEP 5: Review & Submit -->
                <div class="step-pane d-none" id="step-pane-5">
                    <!-- Banner Header -->
                    <div class="glass-form-card mb-4 p-4 rounded-4" style="background: linear-gradient(135deg, #fffdfa 0%, #f0fdfa 100%); border: 1px solid #ccfbf1;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 28px; height: 28px; background-color: #fef3c7; color: #d97706;">
                                <i data-lucide="star" style="width: 16px; height: 16px;"></i>
