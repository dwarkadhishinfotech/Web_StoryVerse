                            Review all the information below before creating this entity. You can go back and edit any section if needed.
                        </p>
                    </div>

                    <!-- 2 Column Row for Basic Information and Details Cards -->
                    <div class="row g-4 mb-4">
                        <!-- Basic Information Card -->
                        <div class="col-md-6">
                            <div class="glass-form-card h-100 p-4 rounded-4 bg-white border">
                                <div class="form-section-header d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                    <div class="form-section-title d-flex align-items-center gap-2" style="font-size: 0.95rem; font-weight: 700; color: #0f172a;">
                                        <i data-lucide="building-2" style="width: 18px; height: 18px; color: #13A8A6;"></i>
                                        Basic Information
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold d-flex align-items-center gap-1" data-jump-step="1" style="color: #13A8A6; font-size: 0.8rem;">
